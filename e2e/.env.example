# Base URL of the running MrWhoOidc WebAuth instance
# Must match the target in docker-compose.dev.yml or local dev
BASE_URL=https://localhost:8443

# Example applications exercised by the E2E suite
EXAMPLE_RAZORCLIENT_URL=https://localhost:5003
EXAMPLE_TESTAPI_URL=https://localhost:7149

# ── LLM Vision Evaluation ────────────────────────────────────────────────────
# Select backend: "openai" (default) or "ollama"
LLM_BACKEND=openai

# OpenAI backend settings (used when LLM_BACKEND=openai)
# If OPENAI_API_KEY is not set, LLM evaluation is skipped (tests still run)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Ollama backend settings (used when LLM_BACKEND=ollama)
# Ollama must be running locally; no API key required
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:397b-cloud

# Admin credentials (seeded by TenantSeedingService on first start)
ADMIN_USERNAME=admin@mrwho.local
ADMIN_PASSWORD=Admin123!

# Optional: show browser window during test run (true/false)
HEADED=false

# Optional: slow down actions by N ms for visual debugging
SLOW_MO=0
