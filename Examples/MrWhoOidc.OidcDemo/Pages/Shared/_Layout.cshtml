<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MrWhoOidc Demo</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav>
            <div class="nav-brand">
                <a href="/">MrWhoOidc Demo</a>
            </div>
            <div class="nav-links">
                <a asp-page="/Index">Home</a>
                <a asp-page="/Secure">Secure Page</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="user-name">@User.Identity.Name</span>
                    <a asp-page="/Account/Logout">Logout</a>
                }
                else
                {
                    <a asp-page="/Account/Login">Login</a>
                }
            </div>
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer>
        <p>&copy; @DateTime.Now.Year MrWhoOidc Demo - OIDC Authentication Example</p>
    </footer>
</body>
</html>
