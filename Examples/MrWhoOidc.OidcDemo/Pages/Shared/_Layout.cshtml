<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MrWhoOidc Demo</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav>
            <div class="nav-brand">
                <a href="/">MrWhoOidc Demo</a>
            </div>
            <div class="nav-links">
                <a asp-page="/Index">Home</a>
                <a asp-page="/Secure">Secure Page</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="user-name">@User.Identity.Name</span>
                    <a asp-page="/Account/Logout">Logout</a>
                }
                else
                {
                    <a asp-page="/Account/Login">Login</a>
                }
            </div>
        </nav>
    </header>
    @{
        var impersonationId = User.FindFirst("impersonation_id")?.Value;
        var impersonationActor = User.FindFirst("act")?.Value;
    }
    @if (!string.IsNullOrEmpty(impersonationId))
    {
        <div data-testid="oidcdemo-impersonation-banner"
             style="background:#f8d7da;border:2px solid #dc3545;border-radius:6px;padding:12px 16px;margin:16px auto;max-width:960px;color:#842029;">
            <strong>Impersonation session.</strong>
            MrWhoOidc issued this application the impersonated user's identity
            (<code>@(User.Identity?.Name ?? "unknown")</code>).
            Actor: <code>@impersonationActor</code>.
            Session: <code>@impersonationId</code>.
        </div>
    }

    <main>
        @RenderBody()
    </main>
    <footer>
        <p>&copy; @DateTime.Now.Year MrWhoOidc Demo - OIDC Authentication Example</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
