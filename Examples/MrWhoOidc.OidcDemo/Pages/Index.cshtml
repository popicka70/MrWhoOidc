@page
@model MrWhoOidc.OidcDemo.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <h1>MrWhoOidc OIDC Demo</h1>
    <p>This Razor Pages application demonstrates OpenID Connect authentication using the MrWhoOidc identity provider.</p>
</section>

<section class="info-card">
    <h2>Configuration</h2>
    <dl>
        <dt>Identity Provider</dt>
        <dd><a href="@Model.Authority" target="_blank">@Model.Authority</a></dd>
        <dt>Client ID</dt>
        <dd><code>@Model.ClientId</code></dd>
        <dt>Tenant</dt>
        <dd>default</dd>
    </dl>
</section>

@{
    var impersonationId = User.FindFirst("impersonation_id")?.Value;
    var actor = User.FindFirst("act")?.Value;
    var assistanceId = User.FindFirst("assistance_id")?.Value;
    var assistanceMode = User.FindFirst("assistance_mode")?.Value;
    var targetSubject = User.FindFirst("sub")?.Value
        ?? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}
@if (!string.IsNullOrEmpty(assistanceId))
{
    <section class="info-card" data-testid="oidcdemo-assistance-details"
             style="border:2px solid #198754;background:#f0fff4;">
        <h2 style="color:#146c43;">Assistance details</h2>
        <dl>
            <dt>Requester subject (<code>sub</code>)</dt>
            <dd><code>@(targetSubject ?? "—")</code></dd>
            <dt>Helper actor (<code>act.sub</code>)</dt>
            <dd><code>@(actor ?? "—")</code></dd>
            <dt>Assistance session</dt>
            <dd><code>@assistanceId</code></dd>
            <dt>Assistance mode</dt>
            <dd><code>@assistanceMode</code></dd>
        </dl>
    </section>
}
@if (!string.IsNullOrEmpty(impersonationId))
{
    <section class="info-card" data-testid="oidcdemo-impersonation-details"
             style="border:2px solid #dc3545;background:#fff5f5;">
        <h2 style="color:#842029;">Impersonation details</h2>
        <dl>
            <dt>Target subject (<code>sub</code>)</dt>
            <dd><code>@(targetSubject ?? "—")</code></dd>
            <dt>Actor (<code>act.sub</code>)</dt>
            <dd><code>@(actor ?? "—")</code></dd>
            <dt>Impersonation session</dt>
            <dd><code>@impersonationId</code></dd>
        </dl>
    </section>
}

<section class="auth-status authenticated" hidden="@(User.Identity?.IsAuthenticated == true ? null : "hidden")">
        <h2>✅ You are authenticated</h2>
        <p>Welcome, <strong>@(User.Identity?.Name ?? "authenticated user")</strong>!</p>
        
        <h3>Your Claims</h3>
        <table class="claims-table">
            <thead>
                <tr>
                    <th>Claim Type</th>
                    <th>Value</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var claim in User.Claims)
                {
                    <tr>
                        <td><code>@claim.Type</code></td>
                        <td>@claim.Value</td>
                    </tr>
                }
            </tbody>
        </table>
        
        <div class="actions">
            <a asp-page="/Secure" class="btn btn-primary">View Secure Page</a>
            <a asp-page="/Account/Logout" class="btn btn-secondary">Logout</a>
        </div>
</section>

<section class="auth-status not-authenticated" hidden="@(User.Identity?.IsAuthenticated == true ? "hidden" : null)">
        <h2>🔒 You are not signed in</h2>
        <p>Click the button below to authenticate with the MrWhoOidc identity provider.</p>
        <div class="actions">
            <a asp-page="/Account/Login" class="btn btn-primary">Sign In with MrWhoOidc</a>
        </div>
</section>
