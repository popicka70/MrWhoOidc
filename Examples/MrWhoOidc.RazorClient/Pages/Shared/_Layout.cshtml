<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MrWhoOidc Razor Client</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <div class="navbar">
            <div class="navbar-brand">MrWhoOidc Razor Client</div>
            <nav>
                <a asp-page="/Index">Home</a>
                <a asp-page="/Secure">Secure Area</a>
                <a asp-page="/Delegated">Delegated Exchange</a>
            </nav>
            <div class="navbar-auth">
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <span>@User.Identity?.Name</span>
                    <a asp-page="/Auth/Logout">Sign out</a>
                }
                else
                {
                    <a asp-page="/Auth/Login">Sign in</a>
                }
            </div>
        </div>
    </header>

    @{
        var impersonationId = User.FindFirst("impersonation_id")?.Value;
        var impersonationActor = User.FindFirst("act")?.Value;
    }
    @if (!string.IsNullOrEmpty(impersonationId))
    {
        <div data-testid="razorclient-impersonation-banner"
             style="background:#f8d7da;border:2px solid #dc3545;border-radius:6px;padding:12px 16px;margin:12px auto;max-width:960px;color:#842029;">
            <strong>Impersonation session.</strong>
            This application received the impersonated user's identity
            (<code>@(User.Identity?.Name ?? "unknown")</code>).
            Actor: <code>@impersonationActor</code>.
            Session: <code>@impersonationId</code>.
        </div>
    }

    <main class="container">
        @RenderBody()
    </main>

    <footer>
        <p>&copy; @DateTimeOffset.UtcNow.Year - MrWhoOidc Razor Client</p>
    </footer>

    @RenderSection("Scripts", required: false)
</body>
</html>
