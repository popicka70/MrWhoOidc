@page
@model MrWhoOidc.RazorClient.Pages.SecureModel
@using System.Globalization
@{
    ViewData["Title"] = "Secure area";

    // Claims like iat/exp arrive as raw Unix epoch seconds; show them in a human-friendly
    // form (local time + UTC) instead of the bare number. Non-epoch strings pass through.
    static string FormatClaimTime(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "—";
        if (long.TryParse(raw.Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var epoch)
            && epoch > 0)
        {
            try
            {
                var instant = DateTimeOffset.FromUnixTimeSeconds(epoch).UtcDateTime;
                return $"{instant:yyyy-MM-dd HH:mm:ss} UTC";
            }
            catch (ArgumentOutOfRangeException)
            {
                return raw;
            }
        }
        return raw;
    }

    // Blank cells read as broken data; an explicit placeholder reads as "not provided".
    static string OrPlaceholder(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;
}

<h1>Secure area</h1>
<p>If you can read this, you authenticated through MrWhoOidc.WebAuth.</p>

<section>
    <h2>Downstream API Call (On-Behalf-Of)</h2>
    @if (Model.ApiCallSucceeded && Model.Profile is not null)
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <tbody>
                    <tr>
                        <th scope="row">Subject</th>
                        <td><code>@OrPlaceholder(Model.Profile.Subject)</code></td>
                    </tr>
                    <tr>
                        <th scope="row">Name</th>
                        <td>@OrPlaceholder(Model.Profile.Name)</td>
                    </tr>
                    <tr>
                        <th scope="row">Email</th>
                        <td>@OrPlaceholder(Model.Profile.Email)</td>
                    </tr>
                    <tr>
                        <th scope="row">Audience</th>
                        <td>@OrPlaceholder(Model.Profile.Audience)</td>
                    </tr>
                    <tr>
                        <th scope="row">Delegating Client</th>
                        <td>@OrPlaceholder(Model.Profile.ActorClient)</td>
                    </tr>
                    <tr>
                        <th scope="row">Scopes</th>
                        <td>
                            @{ var scopesText = Model.Profile.Scopes is { } scopes && scopes.Any() ? string.Join(" ", scopes) : "—"; }
                            @scopesText
                        </td>
                    </tr>
                    <tr>
                        <th scope="row">Issued</th>
                        <td>@FormatClaimTime(Model.Profile.IssuedAt)</td>
                    </tr>
                    <tr>
                        <th scope="row">Expires</th>
                        <td>@FormatClaimTime(Model.Profile.ExpiresAt)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            <strong>API call failed.</strong> @Model.ErrorMessage
        </div>
    }
</section>
