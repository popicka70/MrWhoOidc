@page "/introspection"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authentication
@using System.Net
@using System.Text.Json
@using System.Net.Http.Json
@inject AuthenticationStateProvider AuthStateProvider
@inject IHttpContextAccessor HttpContextAccessor
@inject ILogger<Introspection> Logger

<PageTitle>Introspection</PageTitle>

<h1>Token Introspection</h1>

<AuthorizeView>
    <Authorized>
        <p>
            This page sends your current access token to the AS `/introspect` endpoint and displays the result.
        </p>
        <button class="btn btn-primary" @onclick="IntrospectAsync" disabled="@isLoading">@((isLoading ? "Introspecting..." : "Run Introspection"))</button>
        @if (error is not null)
        {
            <div class="alert alert-danger mt-3">@error</div>
        }
        @if (resultJson is not null)
        {
            <details open class="mt-3">
                <summary>Result</summary>
                <pre>@resultJson</pre>
            </details>
        }
    </Authorized>
    <NotAuthorized>
        <p>You are not signed in.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool isLoading;
    private string? error;
    private string? resultJson;

    private async Task IntrospectAsync()
    {
        isLoading = true; error = null; resultJson = null;
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = state.User;
            if (user?.Identity?.IsAuthenticated != true)
            {
                error = "Not authenticated.";
                return;
            }

            var ctx = HttpContextAccessor.HttpContext;
            if (ctx is null)
            {
                error = "No HttpContext available.";
                return;
            }

            var accessToken = await ctx.GetTokenAsync("access_token");
            if (string.IsNullOrEmpty(accessToken))
            {
                error = "No access token available.";
                return;
            }

            // Discover introspection endpoint from authority metadata
            var config = ctx.RequestServices.GetRequiredService<IConfiguration>();
            var authority = config["Oidc:Authority"] ?? config["OIDC:Authority"];
            if (string.IsNullOrWhiteSpace(authority))
            {
                error = "Authority not configured.";
                return;
            }
            var authorityUri = new Uri(authority);
            var discoveryUri = new Uri(authorityUri, ".well-known/openid-configuration");

            using var http = new HttpClient();
            http.DefaultRequestVersion = HttpVersion.Version11;
            var metadata = await http.GetFromJsonAsync<JsonElement>(discoveryUri);
            var introspectUrl = metadata.GetProperty("introspection_endpoint").GetString();
            if (string.IsNullOrEmpty(introspectUrl))
            {
                error = "No introspection endpoint in discovery.";
                return;
            }

            // Use client_secret_post with the configured client credentials
            var clientId = config["Oidc:ClientId"] ?? "blazor-web";
            var clientSecret = config["Oidc:ClientSecret"]; // may be null for public clients

            var form = new Dictionary<string, string?>
            {
                ["token"] = accessToken,
                ["client_id"] = clientId,
                ["client_secret"] = clientSecret
            };

            var resp = await http.PostAsync(introspectUrl, new FormUrlEncodedContent(form!));
            var body = await resp.Content.ReadAsStringAsync();
            resultJson = body;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Introspection failed");
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
