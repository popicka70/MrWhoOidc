@page "/auth-debug"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using System.Security.Claims
@using System.IdentityModel.Tokens.Jwt
@using System.Text.Json
@inject AuthenticationStateProvider AuthStateProvider
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Auth Debug</PageTitle>

<h1>Authentication Debug</h1>

<AuthorizeView>
    <Authorized>
        @if (user is null)
        {
            <p><em>Loading…</em></p>
        }
        else
        {
            <h3>User</h3>
            <ul>
                <li>Name: @user.Identity?.Name</li>
                <li>Authenticated: @user.Identity?.IsAuthenticated</li>
                <li>Claims:</li>
                <ul>
                    @foreach (var c in user.Claims)
                    {
                        <li><code>@c.Type</code> = <code>@c.Value</code></li>
                    }
                </ul>
            </ul>

            <h3>Tokens (raw)</h3>
            @if (tokens is null)
            {
                <p>No tokens available.</p>
            }
            else
            {
                <ul>
                    @if (!string.IsNullOrEmpty(tokens.IdToken))
                    {
                        <li>ID Token: <details><summary>show</summary><pre>@tokens.IdToken</pre></details></li>
                    }
                    @if (!string.IsNullOrEmpty(tokens.AccessToken))
                    {
                        <li>Access Token: <details><summary>show</summary><pre>@tokens.AccessToken</pre></details></li>
                    }
                    @if (!string.IsNullOrEmpty(tokens.RefreshToken))
                    {
                        <li>Refresh Token: <details><summary>show</summary><pre>@tokens.RefreshToken</pre></details></li>
                    }
                </ul>
            }

            <h3>Tokens (parsed)</h3>
            <div>
                @if (!string.IsNullOrEmpty(tokens?.IdToken))
                {
                    <details open>
                        <summary>ID Token</summary>
                        @if (idParsed?.IsJwt == true)
                        {
                            @TokenView(idParsed!)
                        }
                        else
                        {
                            <p>Not a JWT or failed to parse.</p>
                        }
                    </details>
                }
                @if (!string.IsNullOrEmpty(tokens?.AccessToken))
                {
                    <details>
                        <summary>Access Token</summary>
                        @if (accessParsed?.IsJwt == true)
                        {
                            @TokenView(accessParsed!)
                        }
                        else
                        {
                            <p>Not a JWT or failed to parse.</p>
                        }
                    </details>
                }
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <p>You are not signed in.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private ClaimsPrincipal? user;
    private AuthenticationTokens? tokens;
    private ParsedJwt? idParsed;
    private ParsedJwt? accessParsed;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        user = state.User;

        var ctx = HttpContextAccessor.HttpContext;
        if (ctx is not null)
        {
            // Retrieve tokens stored by OIDC handler
            var authResult = await ctx.AuthenticateAsync(CookieAuthenticationDefaults.AuthenticationScheme);
            if (authResult.Succeeded)
            {
                tokens = new AuthenticationTokens
                {
                    IdToken = await ctx.GetTokenAsync("id_token"),
                    AccessToken = await ctx.GetTokenAsync("access_token"),
                    RefreshToken = await ctx.GetTokenAsync("refresh_token")
                };

                if (!string.IsNullOrEmpty(tokens.IdToken))
                {
                    idParsed = ParseJwt(tokens.IdToken);
                }
                if (!string.IsNullOrEmpty(tokens.AccessToken))
                {
                    accessParsed = ParseJwt(tokens.AccessToken);
                }
            }
        }
    }

    private static ParsedJwt ParseJwt(string token)
    {
        var parsed = new ParsedJwt { Raw = token };
        try
        {
            var handler = new JwtSecurityTokenHandler();
            if (!handler.CanReadToken(token))
            {
                parsed.Error = "Handler cannot read token";
                return parsed;
            }
            var jwt = handler.ReadJwtToken(token);
            parsed.IsJwt = true;
            parsed.Issuer = jwt.Issuer;
            parsed.Audiences = jwt.Audiences?.ToArray() ?? Array.Empty<string>();
            parsed.ValidFrom = jwt.ValidFrom;
            parsed.ValidTo = jwt.ValidTo;
            parsed.IssuedAt = jwt.IssuedAt;
            parsed.Alg = jwt.Header?.Alg;
            parsed.Kid = jwt.Header?.Kid;
            parsed.HeaderJson = JsonSerializer.Serialize(jwt.Header, new JsonSerializerOptions { WriteIndented = true });
            parsed.Claims = jwt.Claims.Select(c => new KeyValuePair<string, string>(c.Type, c.Value)).ToList();
        }
        catch (Exception ex)
        {
            parsed.Error = ex.Message;
        }
        return parsed;
    }

    private sealed class AuthenticationTokens
    {
        public string? IdToken { get; set; }
        public string? AccessToken { get; set; }
        public string? RefreshToken { get; set; }
    }

    private sealed class ParsedJwt
    {
        public bool IsJwt { get; set; }
        public string? Raw { get; set; }
        public string? Error { get; set; }
        public string? Issuer { get; set; }
        public string[] Audiences { get; set; } = Array.Empty<string>();
        public DateTime ValidFrom { get; set; }
        public DateTime ValidTo { get; set; }
        public DateTime? IssuedAt { get; set; }
        public string? Alg { get; set; }
        public string? Kid { get; set; }
        public string? HeaderJson { get; set; }
        public List<KeyValuePair<string, string>> Claims { get; set; } = new();
    }
}

@code {
    private static RenderFragment TokenView(ParsedJwt t) => builder =>
    {
        int seq = 0;
        if (!string.IsNullOrEmpty(t.Error))
        {
            builder.AddContent(seq++, $"Parse error: {t.Error}");
            return;
        }
        builder.OpenElement(seq++, "ul");
        builder.AddMarkupContent(seq++, $"<li>iss: <code>{t.Issuer}</code></li>");
        builder.AddMarkupContent(seq++, $"<li>aud: <code>{string.Join(" ", t.Audiences)}</code></li>");
        builder.AddMarkupContent(seq++, $"<li>nbf: <code>{t.ValidFrom:u}</code></li>");
        builder.AddMarkupContent(seq++, $"<li>iat: <code>{(t.IssuedAt.HasValue ? t.IssuedAt.Value.ToUniversalTime().ToString("u") : "")}</code></li>");
        builder.AddMarkupContent(seq++, $"<li>exp: <code>{t.ValidTo:u}</code></li>");
        builder.AddMarkupContent(seq++, $"<li>header: <details><summary>{t.Alg} / {t.Kid}</summary><pre>{t.HeaderJson}</pre></details></li>");
        builder.AddMarkupContent(seq++, "<li>claims:</li>");
        builder.OpenElement(seq++, "ul");
        foreach (var c in t.Claims)
        {
            builder.AddMarkupContent(seq++, $"<li><code>{c.Key}</code> = <code>{c.Value}</code></li>");
        }
        builder.CloseElement();
        builder.CloseElement();
    };
}
