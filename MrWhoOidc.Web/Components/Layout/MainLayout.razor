@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex align-items-center">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
            <div class="ms-auto">
                <AuthorizeView>
                    <Authorized>
                        <span class="me-3">Hello, @context.User.Identity?.Name</span>
                        <a href="/logout?returnUrl=/" target="_top" rel="external">Log out</a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" target="_top" rel="external">Log in</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
