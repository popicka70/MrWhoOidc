{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Bootstrap": {
    "Token": ""
  },
  "MultiTenancy": {
    "Enabled": true,
    "DefaultTenantSlug": "default"
  },
  "Security": {
    "HttpsRedirectMode": "Auto"
  },
  "Oidc": {
  },
  "Auth": {
    "AllowRefreshTokenIntrospection": true,
    "TokenValidationClockSkewSeconds": 60,
    "ClientAssertionClockSkewSeconds": 60,
    "CibaLoginHintTokenClockSkewSeconds": 60,
    "DpopIatLeewaySeconds": 60,
    "RestrictIdTokenClaimsToClaimsRequest": false,
    "DefaultClaimMappings": [
      { "ExternalClaim": "sub", "LocalClaim": "sub", "Order": 0 },
      { "ExternalClaim": "email", "LocalClaim": "email", "Order": 1 },
      { "ExternalClaim": "name", "LocalClaim": "name", "Order": 2 },
      { "ExternalClaim": "given_name", "LocalClaim": "first_name", "Transform": "copy", "Order": 10 },
      { "ExternalClaim": "family_name", "LocalClaim": "last_name", "Transform": "copy", "Order": 11 },
      { "ExternalClaim": "preferred_username", "LocalClaim": "username", "Transform": "copy", "Order": 12 },
      { "ExternalClaim": "amr", "LocalClaim": "amr", "Transform": "copy", "Order": 20 },
      { "ExternalClaim": "acr", "LocalClaim": "acr", "Transform": "copy", "Order": 21 }
    ]
  },
  "KeyRotation": {
    "RsaKeySizeBits": 3072
  },
  "QrLogin": {
    "Enabled": true,
    "SessionLifetimeSeconds": 300,
    "PollIntervalSeconds": 2,
    "CleanupIntervalSeconds": 60,
    "CleanupRetentionSeconds": 300,
    "BaseUrl": ""
  },
  "Features": {
    "UserAccount": {
      "UserAccountDecouplingEnabled": true,
      "TenantPickerUxEnabled": false
    }
  }
}
