@page
@model MrWhoOidc.WebAuth.Pages.DiscoverTenantModel
@using MrWhoOidc.Auth.IdentityProviders
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="card-body p-4">
        <div class="auth-card__header">
            <i class="ph ph-sign-in icon-xl icon-primary"></i>
            <h2 class="auth-card__title">Sign in to your account</h2>
            <p class="auth-card__subtitle">@(Model.TenantDiscoveryEnabled ? "Enter your email address to continue" : "Use your organization-specific sign-in URL")</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">
                <i class="ph ph-warning-fill me-2"></i>
                @Model.ErrorMessage
            </div>
        }

        @if (Model.PlatformProviders.Count > 0)
        {
            <div class="mb-4">
                @foreach (var provider in Model.PlatformProviders)
                {
                    var label = provider.DisplayName ?? provider.Name;
                    var returnUrl = Model.PlatformProviderReturnUrl;
                    var startUrl = $"/auth/external/start?provider={Uri.EscapeDataString(provider.Name)}&returnUrl={Uri.EscapeDataString(returnUrl)}&platform=true";
                    var style = string.Empty;
                    if (!string.IsNullOrWhiteSpace(provider.ButtonBackgroundColor) || !string.IsNullOrWhiteSpace(provider.ButtonTextColor))
                    {
                        style = $"{(!string.IsNullOrWhiteSpace(provider.ButtonBackgroundColor) ? $"background-color:{provider.ButtonBackgroundColor};border-color:{provider.ButtonBackgroundColor};" : string.Empty)}{(!string.IsNullOrWhiteSpace(provider.ButtonTextColor) ? $"color:{provider.ButtonTextColor};" : string.Empty)}";
                    }
                    <a href="@startUrl" class="btn btn-outline-primary w-100 auth-btn d-flex align-items-center justify-content-start mb-2" style="@style" data-provider-name="@provider.Name" aria-label="Sign in with @label">
                        <span class="me-2 d-flex align-items-center">
                            @if (provider.LogoStorageType == MrWhoOidc.Auth.Persistence.IdentityProviderLogoStorageType.Database && provider.LogoData != null)
                            {
                                <img src="/api/providers/@provider.Id/logo?v=@provider.UpdatedAt.ToUnixTimeSeconds()" alt="" style="max-width: 22px; max-height: 22px; object-fit: contain;" />
                            }
                            else if (!string.IsNullOrWhiteSpace(provider.LogoUrl))
                            {
                                <img src="@provider.LogoUrl" alt="" style="max-width: 22px; max-height: 22px; object-fit: contain;" />
                            }
                            else
                            {
                                <i class="ph ph-shield-check"></i>
                            }
                        </span>
                        <span class="flex-grow-1">Sign in with @label</span>
                    </a>
                }
            </div>

            @if (Model.TenantDiscoveryEnabled || Model.ShowQrLogin)
            {
                <div class="d-flex align-items-center my-3">
                    <hr class="flex-grow-1" />
                    <span class="mx-3 text-muted small">or use organization sign-in</span>
                    <hr class="flex-grow-1" />
                </div>
            }
        }

        @* QR Login Option - shown when enabled at platform level *@
        @if (Model.ShowQrLogin)
        {
            <div class="mb-4">
                @{
                    var qrReturnUrl = Model.ReturnUrl ?? "/";
                    var qrLoginUrl = $"/auth/qr?returnUrl={Uri.EscapeDataString(qrReturnUrl)}";
                }
                <a href="@qrLoginUrl" class="btn btn-outline-primary w-100 auth-btn d-flex align-items-center justify-content-start"
                   aria-label="Sign in with QR Code">
                    <span class="me-2 d-flex align-items-center">@Html.Raw(ProviderIcons.QrCode)</span>
                    <span class="flex-grow-1">Sign in with QR Code</span>
                </a>
            </div>
            
            <div class="d-flex align-items-center my-3">
                <hr class="flex-grow-1" />
                <span class="mx-3 text-muted small">or use email</span>
                <hr class="flex-grow-1" />
            </div>
        }

        @if (Model.TenantDiscoveryEnabled)
        {
            <form method="post" asp-antiforgery="true">
                <input type="hidden" asp-for="ReturnUrl" />
                
                <div class="form-group">
                    <label asp-for="Email" class="form-label">
                        <i class="ph ph-envelope-simple icon-sm"></i> Email address
                    </label>
                    <input asp-for="Email" 
                           class="form-control form-control-lg" 
                           type="email"
                           placeholder="your.email@example.com"
                           autocomplete="email"
                           autofocus 
                           required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2 mb-3">
                    <button type="submit" class="btn btn-primary btn-lg">
                        Continue
                        <i class="ph ph-arrow-right ms-2"></i>
                    </button>
                </div>
            </form>
        }
        else
        {
            <div class="alert alert-info" role="status">
                <i class="ph ph-info me-2"></i>
                Use your organization-specific sign-in URL to continue.
            </div>
        }

        <div class="text-center mt-4">
            <p class="text-muted small">
                Don't have an account? 
                <a href="/Registrations" class="text-decoration-none">Register here</a>
            </p>
        </div>
        
        @if (Model.ShowDirectLoginLink)
        {
            <div class="text-center mt-3">
                <hr />
                <p class="text-muted small mt-3">
                    <i class="ph ph-info me-1"></i>
                    Already know your organization? 
                    <a href="#" id="direct-login-link" class="text-decoration-none">
                        Sign in directly
                    </a>
                </p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script nonce="@(HttpContext.Items["csp-nonce"] as string ?? string.Empty)">
        function showTenantUrlHelp() {
            alert('To sign in directly to your organization, use:\nhttps://yourserver.com/t/your-org/login\n\nReplace "your-org" with your organization\'s name.');
        }
        var directLoginLink = document.getElementById('direct-login-link');
        if (directLoginLink) {
            directLoginLink.addEventListener('click', function(e) {
                e.preventDefault();
                showTenantUrlHelp();
            });
        }
    </script>
}
