@page "/discover-tenant"
@model MrWhoOidc.WebAuth.Pages.DiscoverTenantModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="card-body p-4">
        <div class="auth-card__header">
            <i class="bi bi-box-arrow-in-right icon-xl icon-primary"></i>
            <h2 class="auth-card__title">Sign in to your account</h2>
            <p class="auth-card__subtitle">Enter your email address to continue</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @Model.ErrorMessage
            </div>
        }

        <form method="post" asp-antiforgery="true">
            <input type="hidden" asp-for="ReturnUrl" />
            
            <div class="form-group">
                <label asp-for="Email" class="form-label">
                    <i class="bi bi-envelope icon-sm"></i> Email address
                </label>
                <input asp-for="Email" 
                       class="form-control form-control-lg" 
                       type="email"
                       placeholder="your.email@example.com"
                       autocomplete="email"
                       autofocus 
                       required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="d-grid gap-2 mb-3">
                <button type="submit" class="btn btn-primary btn-lg">
                    Continue
                    <i class="bi bi-arrow-right ms-2"></i>
                </button>
            </div>
        </form>

        <div class="text-center mt-4">
            <p class="text-muted small">
                Don't have an account? 
                <a href="/Registrations" class="text-decoration-none">Register here</a>
            </p>
        </div>
        
        @if (Model.ShowDirectLoginLink)
        {
            <div class="text-center mt-3">
                <hr />
                <p class="text-muted small mt-3">
                    <i class="bi bi-info-circle me-1"></i>
                    Already know your organization? 
                    <a href="#" onclick="showTenantUrlHelp(); return false;" class="text-decoration-none">
                        Sign in directly
                    </a>
                </p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function showTenantUrlHelp() {
            alert('To sign in directly to your organization, use:\nhttps://yourserver.com/t/your-org/login\n\nReplace "your-org" with your organization\'s name.');
        }
    </script>
}
