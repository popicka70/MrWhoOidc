@page
@model MrWhoOidc.WebAuth.Pages.DiscoverTenantModel
@using MrWhoOidc.Auth.IdentityProviders
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="card-body p-4">
        <div class="auth-card__header">
            <i class="bi bi-box-arrow-in-right icon-xl icon-primary"></i>
            <h2 class="auth-card__title">Sign in to your account</h2>
            <p class="auth-card__subtitle">Enter your email address to continue</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @Model.ErrorMessage
            </div>
        }

        @* QR Login Option - shown when enabled at platform level *@
        @if (Model.ShowQrLogin)
        {
            <div class="mb-4">
                @{
                    var qrReturnUrl = Model.ReturnUrl ?? "/";
                    var qrLoginUrl = $"/auth/qr?returnUrl={Uri.EscapeDataString(qrReturnUrl)}";
                }
                <a href="@qrLoginUrl" class="btn btn-outline-primary w-100 auth-btn d-flex align-items-center justify-content-start"
                   aria-label="Sign in with QR Code">
                    <span class="me-2 d-flex align-items-center">@Html.Raw(ProviderIcons.QrCode)</span>
                    <span class="flex-grow-1">Sign in with QR Code</span>
                </a>
            </div>
            
            @if (!Model.LoginIdps.Any())
            {
                <div class="d-flex align-items-center my-3">
                    <hr class="flex-grow-1" />
                    <span class="mx-3 text-muted small">or use email</span>
                    <hr class="flex-grow-1" />
                </div>
            }
        }

        @* External IdP Login Section *@
        @if (Model.LoginIdps.Any())
        {
            <div class="mb-4">
                <div class="d-grid gap-2 provider-list" role="list" aria-label="External identity providers for sign in">
                    @foreach (var idp in Model.LoginIdps)
                    {
                        // Construct the external start URL - login flow returns to DiscoverTenant with success
                        var callbackUrl = "/DiscoverTenant";
                        if (!string.IsNullOrEmpty(Model.ReturnUrl))
                        {
                            callbackUrl += $"?returnUrl={Uri.EscapeDataString(Model.ReturnUrl)}";
                        }
                        var startUrl = $"/Auth/External/Start?provider={Uri.EscapeDataString(idp.Name)}&returnUrl={Uri.EscapeDataString(callbackUrl)}";
                        
                        var buttonStyle = "";
                        if (!string.IsNullOrEmpty(idp.ButtonBackgroundColor))
                        {
                            buttonStyle += $"background-color: {idp.ButtonBackgroundColor};";
                        }
                        if (!string.IsNullOrEmpty(idp.ButtonTextColor))
                        {
                            buttonStyle += $"color: {idp.ButtonTextColor}; border-color: {idp.ButtonTextColor};";
                        }
                        else if (!string.IsNullOrEmpty(idp.ButtonBackgroundColor))
                        {
                            buttonStyle += $"border-color: {idp.ButtonBackgroundColor};";
                        }

                        <a class="btn btn-outline-primary w-100 auth-btn d-flex align-items-center justify-content-start provider-btn"
                           href="@startUrl"
                           role="listitem"
                           aria-label="Sign in with @idp.DisplayName"
                           data-provider-name="@idp.Name"
                           style="@buttonStyle">
                            @if (idp.HasLogoData)
                            {
                                <img src="/api/providers/@idp.Id/logo?v=@idp.UpdatedAt.ToUnixTimeSeconds()" alt="" class="me-2 auth-provider-logo" style="width: 24px; height: 24px; object-fit: contain;" />
                            }
                            else if (!string.IsNullOrEmpty(idp.LogoUrl))
                            {
                                <img src="@idp.LogoUrl" alt="" class="me-2 auth-provider-logo" style="width: 24px; height: 24px; object-fit: contain;" />
                            }
                            else
                            {
                                <i class="bi bi-shield-lock me-2 text-secondary" style="font-size:1.5rem;"></i>
                            }
                            <span class="flex-grow-1">Continue with @idp.DisplayName</span>
                        </a>
                    }
                </div>
            </div>

            <div class="d-flex align-items-center my-3">
                <hr class="flex-grow-1" />
                <span class="mx-3 text-muted small">or use email</span>
                <hr class="flex-grow-1" />
            </div>
        }

        <form method="post" asp-antiforgery="true">
            <input type="hidden" asp-for="ReturnUrl" />
            
            <div class="form-group">
                <label asp-for="Email" class="form-label">
                    <i class="bi bi-envelope icon-sm"></i> Email address
                </label>
                <input asp-for="Email" 
                       class="form-control form-control-lg" 
                       type="email"
                       placeholder="your.email@example.com"
                       autocomplete="email"
                       autofocus 
                       required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="d-grid gap-2 mb-3">
                <button type="submit" class="btn btn-primary btn-lg">
                    Continue
                    <i class="bi bi-arrow-right ms-2"></i>
                </button>
            </div>
        </form>

        <div class="text-center mt-4">
            <p class="text-muted small">
                Don't have an account? 
                <a href="/Registrations" class="text-decoration-none">Register here</a>
            </p>
        </div>
        
        @if (Model.ShowDirectLoginLink)
        {
            <div class="text-center mt-3">
                <hr />
                <p class="text-muted small mt-3">
                    <i class="bi bi-info-circle me-1"></i>
                    Already know your organization? 
                    <a href="#" onclick="showTenantUrlHelp(); return false;" class="text-decoration-none">
                        Sign in directly
                    </a>
                </p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function showTenantUrlHelp() {
            alert('To sign in directly to your organization, use:\nhttps://yourserver.com/t/your-org/login\n\nReplace "your-org" with your organization\'s name.');
        }
    </script>
}
