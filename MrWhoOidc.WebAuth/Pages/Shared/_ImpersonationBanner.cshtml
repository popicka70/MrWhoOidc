@inject MrWhoOidc.WebAuth.Services.IImpersonationService ImpersonationService
@{
    var impersonationInfo = await ImpersonationService.GetImpersonationInfoAsync(Context);
    if (impersonationInfo != null)
    {
        <div class="alert alert-danger border-start border-5 border-danger mb-3 shadow-sm" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-shield-lock-fill icon-xl me-3 text-danger"></i>
                <div class="flex-grow-1">
                    <h5 class="alert-heading mb-2 d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill icon-sm me-2"></i>
                        <strong>🔒 READ-ONLY IMPERSONATION MODE</strong>
                    </h5>
                    <p class="mb-2">
                        Viewing as <strong>Tenant Admin</strong> for: 
                        <span class="badge bg-danger text-white ms-1">@impersonationInfo.TenantName</span>
                    </p>
                    <div class="small mb-2">
                        <i class="bi bi-tag icon-sm me-1"></i>
                        <code class="bg-white px-1 rounded">@impersonationInfo.TenantSlug</code>
                        <span class="mx-2">|</span>
                        <i class="bi bi-clock icon-sm me-1"></i>
                        Duration: <strong>@impersonationInfo.Duration</strong>
                    </div>
                    <div class="alert alert-light border border-danger mb-0 py-2">
                        <i class="bi bi-info-circle-fill icon-sm me-1 text-danger"></i>
                        <strong>All write operations are disabled.</strong> You can view data but cannot create, edit, or delete anything. Exit impersonation to make changes.
                    </div>
                </div>
                <div class="ms-3">
                    <form method="post" asp-page="/StopImpersonation" class="d-inline">
                        <button type="submit" class="btn btn-danger btn-lg shadow">
                            <i class="bi bi-x-circle icon-sm me-1"></i>
                            Exit Read-Only Mode
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
}
