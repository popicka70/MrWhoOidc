@using MrWhoOidc.WebAuth.Services
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MrWhoOidc.WebAuth</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <!-- Fluent Design System -->
    <link rel="stylesheet" href="~/css/fluent-design-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fluent-base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fluent-components/buttons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fluent-components/forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fluent-components/cards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fluent-components/alerts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fluent-components/tables.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MrWhoOidc.WebAuth.styles.css" asp-append-version="true" />
</head>
<body class="@(StyleSchemes.Resolve((string?)Context.Request.Query["style"]).CssClass) auth-scheme-body">
    <div class="d-flex flex-column min-vh-100">
        <main role="main" class="flex-grow-1 d-flex align-items-center justify-content-center py-4">
            <div class="w-100 px-3 auth-container">
                @RenderBody()
            </div>
        </main>
        <footer class="border-top footer text-muted small py-2">
            <div class="container text-center">
                &copy; 2025 - MrWhoOidc.WebAuth - <a asp-area="" asp-page="/Privacy">Privacy</a>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
