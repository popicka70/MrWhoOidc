@using MrWhoOidc.WebAuth.Services
@{
    var display = (string?)Context.Request.Query["display"];
    var displayCss = string.Equals(display, "popup", StringComparison.OrdinalIgnoreCase)
        ? "auth-display-popup"
        : string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MrWhoOidc.WebAuth</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" integrity="sha384-tViUnnbYAV00FLIhhi3v/dWt3Jxw4gZQcNoSCxCIFNJVCx7/D55/wXsrNIRANwdD" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://unpkg.com/@@phosphor-icons/web@@2.1.1/src/regular/style.css" integrity="sha384-6p9AefaqUhEVheRlj1mpAkbngHXy9mbYMrIdcIt4Jlc9lOLIablJq3bBsLOjGwZ7" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://unpkg.com/@@phosphor-icons/web@@2.1.1/src/thin/style.css" integrity="sha384-ZrguSahlNzFt9jT0cuIhTCpssPYg2cCEoWz7Bpd96tKHthb+kBAIugSMdw0DUcEy" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://unpkg.com/@@phosphor-icons/web@@2.1.1/src/light/style.css" integrity="sha384-GzhNOdwUkh38xzoNEY1vRdLr+w8q+bXEJsd/km6Ef61w1Kfk+lself6cn14ilrpO" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://unpkg.com/@@phosphor-icons/web@@2.1.1/src/bold/style.css" integrity="sha384-nblAP2mo2pVPyMQZDw9Xy9Cwgs9lowushAYep4w5+Q9kF4Ibf3n0B/gCMVdR+Vqy" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://unpkg.com/@@phosphor-icons/web@@2.1.1/src/fill/style.css" integrity="sha384-pPVoXE8ft+zxKtxIDDI7SfTK6y95NHm4qa+hKEg/hs8VkjW5IP+9/dGOPCbDpUPl" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://unpkg.com/@@phosphor-icons/web@@2.1.1/src/duotone/style.css" integrity="sha384-UVFvhZP7fWAENUPOoq61rJg5ef6QZW0k5vpAn71041/QS4STvUcJQCGNhStZLGx9" crossorigin="anonymous" />

    <!-- Fluent Design System -->
    <link rel="stylesheet" href="~/css/fluent-design-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fluent-base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fluent-components/buttons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fluent-components/forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fluent-components/cards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fluent-components/alerts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fluent-components/tables.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MrWhoOidc.WebAuth.styles.css" asp-append-version="true" />
</head>
<body class="@(StyleSchemes.Resolve((string?)Context.Request.Query["style"]).CssClass) @displayCss auth-scheme-body auth-shell" data-auth-display="@display">
    <div class="d-flex flex-column min-vh-100">
        <main role="main" class="flex-grow-1 d-flex align-items-center justify-content-center py-4 auth-main">
            <div class="w-100 px-3 auth-container">
                @RenderBody()
            </div>
        </main>
        <footer class="border-top footer text-muted small py-2 auth-footer">
            <div class="container text-center">
                &copy; 2025 - MrWhoOidc.WebAuth - <a asp-area="" asp-page="/Privacy">Privacy</a>
            </div>
        </footer>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
