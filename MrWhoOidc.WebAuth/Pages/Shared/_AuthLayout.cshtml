@using MrWhoOidc.WebAuth.Services
@using MrWhoOidc.Auth.Services
@inject MrWhoOidc.Auth.Services.ITenantBrandingService BrandingService
@{
    var display = (string?)Context.Request.Query["display"];
    var displayCss = string.Equals(display, "popup", StringComparison.OrdinalIgnoreCase)
        ? "auth-display-popup"
        : string.Empty;
    var uiPreset = UiPresets.Resolve(Context);
    // Tenant branding is loaded before the head so the title, favicon and custom CSS can use it.
    var tenantBranding = await BrandingService.GetCurrentTenantBrandingAsync();
    var cspNonce = ViewContext.HttpContext.Items["csp-nonce"] as string ?? string.Empty;
}
<!DOCTYPE html>
<html lang="en" data-ui-preset="@uiPreset.Key">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @tenantBranding.TitleSuffix</title>
    @if (!string.IsNullOrEmpty(tenantBranding.FaviconUrl))
    {
        <link rel="icon" href="@tenantBranding.FaviconUrl" />
    }
    @if (tenantBranding.SafeCustomCss is { } tenantCss)
    {
        // Raw render is required: CSS combinators ('>') must not be HTML-encoded. The SafeCustomCss
        // getter strips '</style' and HTML comment sequences, so the tenant CSS cannot escape the tag.
        <style nonce="@cspNonce">@Html.Raw(tenantCss)</style>
    }
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* Phosphor icon styles are vendored (wwwroot/lib) instead of served from unpkg: the CDN
       burst-throttles (HTTP 429) under load, which left pages without icons/fonts mid-session.
       The old bootstrap-icons link is gone too — no `bi-` classes are used anywhere. *@
    <link rel="stylesheet" href="~/lib/phosphor-icons/web/2.1.1/src/regular/style.css" />
    <link rel="stylesheet" href="~/lib/phosphor-icons/web/2.1.1/src/thin/style.css" />
    <link rel="stylesheet" href="~/lib/phosphor-icons/web/2.1.1/src/light/style.css" />
    <link rel="stylesheet" href="~/lib/phosphor-icons/web/2.1.1/src/bold/style.css" />
    <link rel="stylesheet" href="~/lib/phosphor-icons/web/2.1.1/src/fill/style.css" />
    <link rel="stylesheet" href="~/lib/phosphor-icons/web/2.1.1/src/duotone/style.css" />

    <!-- Fluent Design System -->
    <link rel="stylesheet" href="~/css/fluent-design-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fluent-base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fluent-components/buttons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fluent-components/forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fluent-components/cards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fluent-components/alerts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fluent-components/tables.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui-presets.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MrWhoOidc.WebAuth.styles.css" asp-append-version="true" />
</head>
<body class="@(StyleSchemes.Resolve((string?)Context.Request.Query["style"]).CssClass) @displayCss auth-scheme-body auth-shell" data-auth-display="@display">
    <div class="d-flex flex-column min-vh-100">
        <main role="main" class="flex-grow-1 d-flex align-items-center justify-content-center py-4 auth-main">
            <div class="w-100 px-3 auth-container">
                @RenderBody()
            </div>
        </main>
        <footer class="border-top footer text-muted small py-2 auth-footer">
            <div class="container d-flex flex-wrap align-items-center justify-content-center gap-3">
                <span>&copy; @DateTime.Now.Year - @tenantBranding.TitleSuffix</span>
                @if (!string.IsNullOrEmpty(tenantBranding.TermsOfServiceUrl))
                {
                    <a href="@tenantBranding.TermsOfServiceUrl" target="_blank" rel="noopener noreferrer">Terms of Service</a>
                }
                @if (!string.IsNullOrEmpty(tenantBranding.PrivacyPolicyUrl))
                {
                    <a href="@tenantBranding.PrivacyPolicyUrl" target="_blank" rel="noopener noreferrer">Privacy</a>
                }
                else
                {
                    <a asp-area="" asp-page="/Privacy">Privacy</a>
                }
                <partial name="_UiPresetSwitcher" />
            </div>
        </footer>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
