@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService

@{
    var tenant = TenantAccessor.CurrentTenant;
    var isPlatformAdmin = User?.Identity?.IsAuthenticated ?? false 
        ? (await AuthorizationService.AuthorizeAsync(User, null, "platform-admin")).Succeeded 
        : false;
}

@if (MultiTenancyOptions.Enabled && tenant != null)
{
    <div class="alert alert-info alert-dismissible fade show border-start border-5 border-info mb-4" role="alert">
        <div class="d-flex align-items-center flex-wrap gap-2">
            <i class="ph ph-buildings-gear icon-md text-info"></i>
            <div class="flex-grow-1">
                <h6 class="alert-heading mb-1">
                    <strong>@tenant.Name</strong>
                    @if (isPlatformAdmin)
                    {
                        <span class="badge bg-primary ms-2"><i class="ph ph-shield-check icon-xs me-1"></i>Platform Admin</span>
                    }
                </h6>
                <small class="text-muted d-block">
                    <i class="ph ph-tag icon-xs me-1"></i><strong>Slug:</strong> @tenant.Slug
                    <span class="mx-2 d-none d-sm-inline">|</span>
                    <span class="d-block d-sm-inline">
                        <i class="ph ph-link icon-xs me-1"></i><strong>Issuer:</strong> 
                        <code class="text-muted">@tenant.IssuerUri</code>
                    </span>
                </small>
            </div>
            @if (isPlatformAdmin)
            {
                <a class="btn btn-sm btn-outline-secondary" asp-page="/PlatformAdmin/Tenants/Index" title="View all tenants">
                    <i class="ph ph-arrow-left me-1"></i><span class="d-none d-sm-inline">All Tenants</span>
                </a>
            }
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
else if (MultiTenancyOptions.Enabled && tenant == null)
{
    <div class="alert alert-warning border-start border-5 border-warning mb-4" role="alert">
        <div class="d-flex align-items-center">
            <i class="ph ph-warning fs-4 text-warning me-3"></i>
            <div>
                <strong>No Tenant Context</strong>
                <p class="mb-0 small">Unable to resolve tenant context. Please navigate from a valid tenant path.</p>
            </div>
        </div>
    </div>
}
