<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MrWhoOidc.WebAuth</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MrWhoOidc.WebAuth.styles.css" asp-append-version="true" />
</head>
<body>
    @{ var hideNavbar = (ViewData["HideNavbar"] as bool?) ?? false; }
    @if (!hideNavbar)
    {
        <header>
            <nav class="navbar navbar-light bg-white border-bottom box-shadow mb-0">
                <div class="container-fluid">
                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        <button class="navbar-toggler d-md-none border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarNav" aria-controls="sidebarNav" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                    }
                    <a class="navbar-brand" asp-area="" asp-page="/Index">MrWhoOidc.WebAuth</a>
                    
                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        <!-- Desktop Navigation -->
                        <div class="d-none d-md-flex align-items-center gap-3">
                            <a class="nav-link" asp-page="/Registrations/Index">Register</a>
                            <a class="nav-link" asp-page="/Password/Index">Change password</a>
                            <a class="nav-link" asp-page="/Mfa/Index">Two-factor (TOTP)</a>
                            <span class="navbar-text">Hello, @User.Identity!.Name</span>
                            <a class="nav-link" href="/logout?returnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)">Log out</a>
                        </div>
                        <!-- Mobile Navigation Dropdown -->
                        <div class="dropdown d-md-none">
                            <button class="btn btn-link nav-link dropdown-toggle p-2" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenuDropdown">
                                <li><h6 class="dropdown-header">@User.Identity!.Name</h6></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-page="/Registrations/Index"><i class="bi bi-person-plus me-2"></i>Register</a></li>
                                <li><a class="dropdown-item" asp-page="/Password/Index"><i class="bi bi-key me-2"></i>Change password</a></li>
                                <li><a class="dropdown-item" asp-page="/Mfa/Index"><i class="bi bi-shield-lock me-2"></i>Two-factor (TOTP)</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="/logout?returnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)"><i class="bi bi-box-arrow-right me-2"></i>Log out</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-3">
                            <a class="nav-link" asp-page="/Registrations/Index">Register</a>
                            <a class="nav-link" asp-page="/Login">Log in</a>
                        </div>
                    }
                </div>
            </nav>
        </header>
    }

    @if (User?.Identity?.IsAuthenticated ?? false && !hideNavbar)
    {
        <div class="container-fluid">
            <div class="row">
                <!-- Sidebar: Offcanvas on mobile, always visible on desktop -->
                <aside class="offcanvas-md offcanvas-start col-md-3 col-lg-2 border-end p-0" id="sidebarNav" tabindex="-1" aria-labelledby="sidebarNavLabel">
                    <div class="offcanvas-header d-md-none">
                        <h5 class="offcanvas-title" id="sidebarNavLabel">Navigation</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#sidebarNav" aria-label="Close"></button>
                    </div>
                    <div class="offcanvas-body p-0">
                        <div class="list-group list-group-flush rounded-0">
                            <a class="list-group-item list-group-item-action" asp-page="/Index"><i class="bi bi-house-door me-2"></i>Home</a>
                            <a class="list-group-item list-group-item-action" href="/.well-known/openid-configuration" target="_blank" rel="noopener"><i class="bi bi-file-earmark-code me-2"></i>OIDC Discovery</a>
                            <a class="list-group-item list-group-item-action" href="/jwks" target="_blank" rel="noopener"><i class="bi bi-key me-2"></i>JWKS</a>
                            <div class="list-group-item fw-semibold text-uppercase small">Admin</div>
                            <a class="list-group-item list-group-item-action" asp-page="/Admin/Realms/Index"><i class="bi bi-diagram-3 me-2"></i>Realms</a>
                            <a class="list-group-item list-group-item-action" asp-page="/Admin/Clients/Index"><i class="bi bi-people me-2"></i>Clients</a>
                            <a class="list-group-item list-group-item-action" asp-page="/Admin/Providers/Index"><i class="bi bi-shield-lock me-2"></i>Providers</a>
                            <a class="list-group-item list-group-item-action" asp-page="/Admin/ProviderMappings/Index"><i class="bi bi-diagram-2 me-2"></i>Provider mappings</a>
                            <a class="list-group-item list-group-item-action" asp-page="/Admin/Scopes/Index"><i class="bi bi-tags me-2"></i>Scopes</a>
                            <a class="list-group-item list-group-item-action" asp-page="/Admin/Roles/Index"><i class="bi bi-person-badge me-2"></i>Roles</a>
                            <a class="list-group-item list-group-item-action" asp-page="/Admin/Users/Index"><i class="bi bi-people-fill me-2"></i>Users</a>
                            <a class="list-group-item list-group-item-action" asp-page="/Admin/Registrations/Index"><i class="bi bi-clipboard2-check me-2"></i>Registrations</a>
                            <a class="list-group-item list-group-item-action" asp-page="/Admin/Backchannel/Index"><i class="bi bi-plug me-2"></i>BCL outbox</a>
                        </div>
                    </div>
                </aside>
                <main role="main" class="col-md-9 col-lg-10 ms-sm-auto px-md-4">
                    <div class="py-3">
                        @if (TempData.ContainsKey("Error"))
                        {
                            <div class="alert alert-danger">@TempData["Error"]</div>
                        }
                        @RenderBody()
                    </div>
                </main>
            </div>
        </div>
    }
    else
    {
        <!-- Tight centered landing layout (unauthenticated) -->
        <div class="d-flex flex-column align-items-center justify-content-start py-4" style="min-height:70vh;">
            <div class="w-100" style="max-width:750px;">
                @if (TempData.ContainsKey("Error"))
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }
                @RenderBody()
            </div>
        </div>
    }

    <footer class="border-top footer text-muted mt-auto">
        <div class="container py-2">
            &copy; 2025 - MrWhoOidc.WebAuth - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
