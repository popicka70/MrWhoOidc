@inject Microsoft.Extensions.Options.IOptions<MrWhoOidc.Auth.MultiTenancy.MultiTenancyOptions> MultiTenancyOptions
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.WebAuth.Services.ITenantSwitchingService TenantSwitchingService
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@inject MrWhoOidc.Auth.Services.ITenantBrandingService BrandingService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MrWhoOidc.WebAuth</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MrWhoOidc.WebAuth.styles.css" asp-append-version="true" />
    
    @* Inject tenant branding CSS variables *@
    @await Component.InvokeAsync("TenantBranding")
</head>
<body class="d-flex flex-column min-vh-100">
    @{
        var hideNavbar = (ViewData["HideNavbar"] as bool?) ?? false;
        // Get tenant context from middleware (set by TenantResolutionMiddleware)
        var currentTenant = TenantAccessor.CurrentTenant;
        var tenantPrefix = currentTenant != null && MultiTenancyOptions.Value.Enabled 
            ? $"/t/{currentTenant.Slug}" 
            : "";
        
        // Load user's accessible tenants for tenant switcher
        var userTenants = new List<MrWhoOidc.WebAuth.Services.TenantAccessInfo>();
        if (User?.Identity?.IsAuthenticated ?? false)
        {
            userTenants = await TenantSwitchingService.GetUserTenantsAsync(User);
        }
        
        // Determine user role for badge display
        string userRole = "User";
        string roleBadgeClass = "bg-secondary";
        if (User?.Identity?.IsAuthenticated ?? false)
        {
            var isPlatformAdmin = (await AuthorizationService.AuthorizeAsync(User, null, "platform-admin")).Succeeded;
            var isTenantAdmin = (await AuthorizationService.AuthorizeAsync(User, null, "tenant-admin")).Succeeded;
            
            if (isPlatformAdmin)
            {
                userRole = "Platform Admin";
                roleBadgeClass = "bg-primary";
            }
            else if (isTenantAdmin)
            {
                userRole = "Tenant Admin";
                roleBadgeClass = "bg-success";
            }
        }
        
        // Get user email
        var userEmail = User?.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value 
                        ?? User?.Identity?.Name 
                        ?? "Unknown";
        
        // Get tenant branding for logo display
        var tenantBranding = await BrandingService.GetCurrentTenantBrandingAsync();
    }
    @if (!hideNavbar)
    {
        <header>
            <nav class="navbar navbar-light bg-white border-bottom box-shadow mb-0">
                <div class="container-fluid">
                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        <button class="navbar-toggler d-md-none border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarNav" aria-controls="sidebarNav" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                    }
                    <a class="navbar-brand d-flex align-items-center gap-2" href="@(tenantPrefix)/">
                        @if (!string.IsNullOrEmpty(tenantBranding.LogoUrl))
                        {
                            <img src="@tenantBranding.LogoUrl" alt="@tenantBranding.TenantName Logo" style="max-height: 40px; max-width: 150px;" />
                        }
                        else
                        {
                            <i class="bi bi-shield-lock-fill text-primary fs-4"></i>
                            @if (currentTenant != null)
                            {
                                <span class="text-muted small">@currentTenant.Name</span>
                            }
                        }
                    </a>
                    
                    @* Tenant Switcher Dropdown *@
                    @if ((User?.Identity?.IsAuthenticated ?? false) && userTenants.Count > 1)
                    {
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="tenantSwitcherDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-building me-1"></i>
                                @if (currentTenant != null)
                                {
                                    <span>@currentTenant.Name</span>
                                }
                                else
                                {
                                    <span>Select Tenant</span>
                                }
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="tenantSwitcherDropdown">
                                <li><h6 class="dropdown-header">Switch Tenant</h6></li>
                                <li><hr class="dropdown-divider"></li>
                                @foreach (var tenant in userTenants)
                                {
                                    var isCurrent = currentTenant?.TenantId == tenant.TenantId;
                                    <li>
                                        <form method="post" asp-page="/SwitchTenant" class="m-0">
                                            <input type="hidden" name="tenantId" value="@tenant.TenantId" />
                                            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                            <button type="submit" class="dropdown-item @(isCurrent ? "active" : "")" @(isCurrent ? "disabled" : "")>
                                                <i class="bi @(tenant.HasAdminAccess ? "bi-shield-check" : "bi-building") me-2"></i>
                                                @tenant.TenantName
                                                @if (isCurrent)
                                                {
                                                    <i class="bi bi-check-circle-fill ms-2 text-success"></i>
                                                }
                                            </button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                    
                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        <!-- Desktop Navigation -->
                        <div class="d-none d-md-flex align-items-center gap-3">
                            <a class="nav-link" href="@(tenantPrefix)/Registrations">Register</a>
                            <a class="nav-link" href="@(tenantPrefix)/Password">Change password</a>
                            <a class="nav-link" href="@(tenantPrefix)/Mfa">Two-factor (TOTP)</a>
                            <div class="d-flex align-items-center gap-2">
                                <span class="navbar-text small">@userEmail</span>
                                <span class="badge @roleBadgeClass">@userRole</span>
                            </div>
                            <a class="nav-link" href="@(tenantPrefix)/logout?returnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)">Log out</a>
                        </div>
                        <!-- Mobile Navigation Dropdown -->
                        <div class="dropdown d-md-none">
                            <button class="btn btn-link nav-link dropdown-toggle p-2" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenuDropdown">
                                <li><h6 class="dropdown-header">@userEmail</h6></li>
                                <li><div class="px-3 pb-2"><span class="badge @roleBadgeClass">@userRole</span></div></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="@(tenantPrefix)/Registrations"><i class="bi bi-person-plus me-2"></i>Register</a></li>
                                <li><a class="dropdown-item" href="@(tenantPrefix)/Password"><i class="bi bi-key me-2"></i>Change password</a></li>
                                <li><a class="dropdown-item" href="@(tenantPrefix)/Mfa"><i class="bi bi-shield-lock me-2"></i>Two-factor (TOTP)</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="@(tenantPrefix)/logout?returnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)"><i class="bi bi-box-arrow-right me-2"></i>Log out</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-3">
                            <a class="nav-link" href="@(tenantPrefix)/Registrations">Register</a>
                            <a class="nav-link" asp-page="/DiscoverTenant">Log in</a>
                        </div>
                    }
                </div>
            </nav>
        </header>
    }

    <div class="flex-grow-1 d-flex flex-column">
        @if (User?.Identity?.IsAuthenticated ?? false && !hideNavbar)
        {
            <div class="container-fluid flex-grow-1">
                <div class="row h-100">
                    <!-- Sidebar: Offcanvas on mobile, always visible on desktop -->
                    <aside class="offcanvas-md offcanvas-start col-md-3 col-lg-2 border-end p-0 d-flex flex-column" id="sidebarNav" tabindex="-1" aria-labelledby="sidebarNavLabel">
                    <div class="offcanvas-header d-md-none">
                        <h5 class="offcanvas-title" id="sidebarNavLabel">Navigation</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#sidebarNav" aria-label="Close"></button>
                    </div>
                        <div class="offcanvas-body p-0 d-flex flex-column flex-grow-1">
                            <div class="list-group list-group-flush rounded-0 d-flex flex-column flex-grow-1 overflow-auto">
                            <a class="list-group-item list-group-item-action" asp-page="/Index"><i class="bi bi-house-door me-2"></i>Home</a>
                            <a class="list-group-item list-group-item-action" href="@(tenantPrefix)/.well-known/openid-configuration" target="_blank" rel="noopener"><i class="bi bi-file-earmark-code me-2"></i>OIDC Discovery</a>
                            <a class="list-group-item list-group-item-action" href="@(tenantPrefix)/jwks" target="_blank" rel="noopener"><i class="bi bi-key me-2"></i>JWKS</a>
                            
                            @* My Account Section - All authenticated users *@
                            @if (User?.Identity?.IsAuthenticated ?? false)
                            {
                                <div class="list-group-item fw-semibold text-uppercase small bg-info text-white">My Account</div>
                                <a class="list-group-item list-group-item-action" href="@(tenantPrefix)/account"><i class="bi bi-person-circle me-2"></i>Dashboard</a>
                                <a class="list-group-item list-group-item-action" href="@(tenantPrefix)/account/profile"><i class="bi bi-person me-2"></i>Profile</a>
                                <a class="list-group-item list-group-item-action" href="@(tenantPrefix)/password"><i class="bi bi-key me-2"></i>Password</a>
                                <a class="list-group-item list-group-item-action" href="@(tenantPrefix)/mfa"><i class="bi bi-shield-lock me-2"></i>Security</a>
                                <a class="list-group-item list-group-item-action" href="@(tenantPrefix)/account/sessions"><i class="bi bi-phone me-2"></i>Sessions</a>
                            }
                            
                            @* Platform Admin Section - Only visible to platform admins *@
                            @if (User?.Identity?.IsAuthenticated ?? false)
                            {
                                var platformAdminResult = await AuthorizationService.AuthorizeAsync(User, null, "platform-admin");
                                if (platformAdminResult.Succeeded)
                                {
                                    <div class="list-group-item fw-semibold text-uppercase small bg-primary text-white">Platform Admin</div>
                                    <a class="list-group-item list-group-item-action" asp-page="/platform-admin"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
                                    @if (MultiTenancyOptions.Value.Enabled)
                                    {
                                        <a class="list-group-item list-group-item-action" asp-page="/platform-admin/tenants"><i class="bi bi-building me-2"></i>Tenants</a>
                                    }
                                    <a class="list-group-item list-group-item-action" asp-page="/platform-admin/impersonation"><i class="bi bi-incognito me-2"></i>Impersonation</a>
                                    <a class="list-group-item list-group-item-action" asp-page="/platform-admin/impersonation-history"><i class="bi bi-clock-history me-2"></i>Impersonation History</a>
                                }
                            }
                            
                            @* Admin Section - Only visible to tenant admins or platform admins *@
                            @if (User?.Identity?.IsAuthenticated ?? false)
                            {
                                var tenantAdminResult = await AuthorizationService.AuthorizeAsync(User, null, "tenant-admin");
                                var platformAdminCheck = await AuthorizationService.AuthorizeAsync(User, null, "platform-admin");
                                if (tenantAdminResult.Succeeded || platformAdminCheck.Succeeded)
                                {
                                    <div class="list-group-item fw-semibold text-uppercase small bg-success text-white">Admin</div>
                                    <a class="list-group-item list-group-item-action" href="@(tenantPrefix)/admin/realms"><i class="bi bi-diagram-3 me-2"></i>Realms</a>
                                    <a class="list-group-item list-group-item-action" href="@(tenantPrefix)/admin/clients"><i class="bi bi-people me-2"></i>Clients</a>
                                    <a class="list-group-item list-group-item-action" href="@(tenantPrefix)/admin/providers"><i class="bi bi-shield-lock me-2"></i>Providers</a>
                                    <a class="list-group-item list-group-item-action" href="@(tenantPrefix)/admin/provider-mappings"><i class="bi bi-diagram-2 me-2"></i>Provider mappings</a>
                                    <a class="list-group-item list-group-item-action" href="@(tenantPrefix)/admin/scopes"><i class="bi bi-tags me-2"></i>Scopes</a>
                                    <a class="list-group-item list-group-item-action" href="@(tenantPrefix)/admin/roles"><i class="bi bi-person-badge me-2"></i>Roles</a>
                                    <a class="list-group-item list-group-item-action" href="@(tenantPrefix)/admin/users"><i class="bi bi-people-fill me-2"></i>Users</a>
                                    <a class="list-group-item list-group-item-action" href="@(tenantPrefix)/admin/registrations"><i class="bi bi-clipboard2-check me-2"></i>Registrations</a>
                                    <a class="list-group-item list-group-item-action" href="@(tenantPrefix)/admin/backchannel"><i class="bi bi-plug me-2"></i>BCL outbox</a>
                                    <a class="list-group-item list-group-item-action" href="@(tenantPrefix)/admin/license"><i class="bi bi-award me-2"></i>License</a>
                                    <a class="list-group-item list-group-item-action ps-4 small" href="@(tenantPrefix)/admin/license/install"><i class="bi bi-cloud-upload me-2"></i>Install or update</a>
                                    <a class="list-group-item list-group-item-action ps-4 small" href="@(tenantPrefix)/admin/license/history"><i class="bi bi-clock-history me-2"></i>History</a>
                                    
                                    @* Branding - Only show in multi-tenant mode *@
                                    @if (MultiTenancyOptions.Value.Enabled)
                                    {
                                        <a class="list-group-item list-group-item-action" asp-page="/admin/branding" asp-route-tenantSlug="@currentTenant?.Slug"><i class="bi bi-palette-fill me-2"></i>Branding</a>
                                        <a class="list-group-item list-group-item-action" asp-page="/admin/settings" asp-route-tenantSlug="@currentTenant?.Slug"><i class="bi bi-gear-fill me-2"></i>Settings</a>
                                    }
                                }
                            }
                            
                            <div class="mt-auto border-top flex-shrink-0">
                                <div class="list-group-item fw-semibold text-uppercase small bg-secondary text-white">Account</div>
                                <a class="list-group-item list-group-item-action" href="@(tenantPrefix)/logout?returnUrl=@Uri.EscapeDataString("/")"><i class="bi bi-box-arrow-right me-2"></i>Log out</a>
                            </div>
                        </div>
                    </div>
                    </aside>
                    <main role="main" class="col-md-9 col-lg-10 ms-sm-auto px-md-4 pb-5 d-flex flex-column">
                    <div class="py-3 flex-grow-1">
                        @* Impersonation Banner - Shows when platform admin is impersonating *@
                        <partial name="_ImpersonationBanner" />
                        
                        @* Tenant Context Banner for Admin Pages *@
                        @if (Context.Request.Path.StartsWithSegments("/Admin") || Context.Request.Path.StartsWithSegments("/PlatformAdmin"))
                        {
                            <partial name="_TenantContextBanner" />
                        }
                        
                        @if (TempData.ContainsKey("Error"))
                        {
                            <div class="alert alert-danger">@TempData["Error"]</div>
                        }
                        @RenderBody()
                    </div>
                    </main>
                </div>
            </div>
        }
        else
        {
            <!-- Tight centered landing layout (unauthenticated) -->
            <div class="d-flex flex-column align-items-center justify-content-start py-4 flex-grow-1" style="min-height:70vh;">
                <div class="w-100" style="max-width:750px;">
                    @if (TempData.ContainsKey("Error"))
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }
                    @RenderBody()
                </div>
            </div>
        }
    </div>

    <footer class="border-top footer text-muted mt-auto">
        <div class="container py-2">
            &copy; 2025 - MrWhoOidc.WebAuth - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
