@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.WebAuth.Services.ITenantSwitchingService TenantSwitchingService
@inject MrWhoOidc.WebAuth.Services.IDefaultTenantContextResolver DefaultTenantContextResolver
@inject MrWhoOidc.WebAuth.Services.ILayoutTenantContextService LayoutTenantContextService
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@inject MrWhoOidc.Auth.Services.ITenantBrandingService BrandingService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MrWhoOidc.WebAuth</title>
    <script type="importmap"></script>
    
    <!-- Bootstrap Foundation -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    
    <!-- Fluent Design System -->
    <link rel="stylesheet" href="~/css/fluent-design-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fluent-base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fluent-components/buttons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fluent-components/forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fluent-components/cards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fluent-components/alerts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fluent-components/tables.css" asp-append-version="true" />
    
    <!-- Application Styles (override/extend Fluent) -->
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MrWhoOidc.WebAuth.styles.css" asp-append-version="true" />
    
    @* Inject tenant branding CSS variables *@
    @await Component.InvokeAsync("TenantBranding")
</head>
<body class="page-shell">
    @{
        var hideNavbar = (ViewData["HideNavbar"] as bool?) ?? false;
        
        // UNIFIED TENANT CONTEXT RESOLUTION
        // Uses priority: URL path > session > default tenant
        // This ensures consistent menu rendering even on /platform-admin/* pages
        var layoutTenantContext = await LayoutTenantContextService.GetLayoutTenantContextAsync(Context!);
        var tenantPrefix = layoutTenantContext.UrlPrefix;
        
        // Keep currentTenant for backwards compatibility (some components might use it)
        // but prefer layoutTenantContext for menu/link generation
        var currentTenant = TenantAccessor.CurrentTenant;

        // Sidebar highlighting helpers
        static string NormalizePath(string? value)
        {
            if (string.IsNullOrWhiteSpace(value)) return "/";
            var cleaned = value;
            var qIndex = cleaned.IndexOf('?');
            if (qIndex >= 0) cleaned = cleaned[..qIndex];
            var hashIndex = cleaned.IndexOf('#');
            if (hashIndex >= 0) cleaned = cleaned[..hashIndex];
            cleaned = cleaned.Trim();
            if (cleaned.Length > 1) cleaned = cleaned.TrimEnd('/');
            return cleaned.Length == 0 ? "/" : cleaned;
        }

        var currentPath = NormalizePath(Context?.Request?.Path.Value);
        bool IsActiveHref(string? href, bool matchPrefix = false)
        {
            var expected = NormalizePath(href);
            if (matchPrefix)
            {
                return currentPath.Equals(expected, StringComparison.OrdinalIgnoreCase)
                    || currentPath.StartsWith(expected + "/", StringComparison.OrdinalIgnoreCase);
            }
            return currentPath.Equals(expected, StringComparison.OrdinalIgnoreCase);
        }

        string LinkClass(string baseClass, string? href, bool matchPrefix = false)
            => IsActiveHref(href, matchPrefix) ? $"{baseClass} active" : baseClass;

        // Use unified resolver for consistent default tenant context determination
        // This matches the logic in RequireDefaultTenantContextAttribute
        var isDefaultTenantContext = DefaultTenantContextResolver.IsDefaultTenantContext(Context!);

        var isMyAccountArea = currentPath.StartsWith(NormalizePath($"{tenantPrefix}/account"), StringComparison.OrdinalIgnoreCase)
            || currentPath.StartsWith(NormalizePath($"{tenantPrefix}/password"), StringComparison.OrdinalIgnoreCase)
            || currentPath.StartsWith(NormalizePath($"{tenantPrefix}/mfa"), StringComparison.OrdinalIgnoreCase);
        
        // Load user's accessible tenants for tenant switcher
        var userTenants = new List<MrWhoOidc.WebAuth.Services.TenantAccessInfo>();
        if (User?.Identity?.IsAuthenticated ?? false)
        {
            userTenants = await TenantSwitchingService.GetUserTenantsAsync(User);
        }
        
        // Determine user role for badge display
        string userRole = "User";
        string roleBadgeClass = "bg-secondary";
        if (User?.Identity?.IsAuthenticated ?? false)
        {
            var isPlatformAdmin = (await AuthorizationService.AuthorizeAsync(User, null, "platform-admin")).Succeeded;
            var isTenantAdmin = (await AuthorizationService.AuthorizeAsync(User, null, "tenant-admin")).Succeeded;
            
            if (isPlatformAdmin)
            {
                userRole = "Platform Admin";
                roleBadgeClass = "bg-primary";
            }
            else if (isTenantAdmin)
            {
                userRole = "Tenant Admin";
                roleBadgeClass = "bg-success";
            }
        }
        
        // Get user email
        var userEmail = User?.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value 
                        ?? User?.Identity?.Name 
                        ?? "Unknown";
        
        // Get tenant branding for logo display
        var tenantBranding = await BrandingService.GetCurrentTenantBrandingAsync();
    }
    @if (!hideNavbar)
    {
        <header>
            <nav class="navbar navbar-light bg-white border-bottom box-shadow mb-0">
                <div class="container-fluid">
                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        <button class="navbar-toggler d-md-none border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarNav" aria-controls="sidebarNav" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                    }
                    <a class="navbar-brand d-flex align-items-center gap-2" href="@(tenantPrefix)/">
                        @if (!string.IsNullOrEmpty(tenantBranding.LogoUrl))
                        {
                            <img src="@tenantBranding.LogoUrl" alt="@tenantBranding.TenantName Logo" class="navbar-logo" />
                        }
                        else
                        {
                            <i class="bi bi-shield-lock-fill icon-md text-primary"></i>
                            @if (!string.IsNullOrEmpty(layoutTenantContext.Name))
                            {
                                <span class="text-muted small">@layoutTenantContext.Name</span>
                            }
                        }
                    </a>
                    
                    @* Tenant Switcher Dropdown *@
                    @if ((User?.Identity?.IsAuthenticated ?? false) && userTenants.Count > 1)
                    {
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="tenantSwitcherDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-building me-1"></i>
                                @if (!string.IsNullOrEmpty(layoutTenantContext.Name))
                                {
                                    <span>@layoutTenantContext.Name</span>
                                }
                                else
                                {
                                    <span>Select Tenant</span>
                                }
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="tenantSwitcherDropdown">
                                <li><h6 class="dropdown-header">Switch Tenant</h6></li>
                                <li><hr class="dropdown-divider"></li>
                                @foreach (var tenant in userTenants)
                                {
                                    var isCurrent = layoutTenantContext.TenantId == tenant.TenantId;
                                    <li>
                                        <form method="post" asp-page="/SwitchTenant" class="m-0">
                                            <input type="hidden" name="tenantId" value="@tenant.TenantId" />
                                            <input type="hidden" name="returnUrl" value="@(Context!.Request.Path + Context!.Request.QueryString)" />
                                            <button type="submit" class="dropdown-item @(isCurrent ? "active" : "")" @(isCurrent ? "disabled" : "")>
                                                <i class="bi @(tenant.HasAdminAccess ? "bi-shield-check" : "bi-building") me-2"></i>
                                                @tenant.TenantName
                                                @if (isCurrent)
                                                {
                                                    <i class="bi bi-check-circle-fill ms-2 text-success"></i>
                                                }
                                            </button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                    
                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        <!-- Desktop Navigation -->
                        <div class="d-none d-md-flex align-items-center gap-3">
                            <a class="nav-link" href="@(tenantPrefix)/Registrations">Register</a>
                            <a class="nav-link" href="@(tenantPrefix)/Password">Change password</a>
                            <a class="nav-link" href="@(tenantPrefix)/Mfa">Two-factor (TOTP)</a>
                            <div class="d-flex align-items-center gap-2">
                                <span class="navbar-text small">@userEmail</span>
                                <span class="badge @roleBadgeClass">@userRole</span>
                            </div>
                            <a class="nav-link" href="@(tenantPrefix)/logout?returnUrl=%2F">Log out</a>
                        </div>
                        <!-- Mobile Navigation Dropdown -->
                        <div class="dropdown d-md-none">
                            <button class="btn btn-link nav-link dropdown-toggle p-2" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenuDropdown">
                                <li><h6 class="dropdown-header">@userEmail</h6></li>
                                <li><div class="px-3 pb-2"><span class="badge @roleBadgeClass">@userRole</span></div></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="@(tenantPrefix)/Registrations"><i class="bi bi-person-plus me-2"></i>Register</a></li>
                                <li><a class="dropdown-item" href="@(tenantPrefix)/Password"><i class="bi bi-key me-2"></i>Change password</a></li>
                                <li><a class="dropdown-item" href="@(tenantPrefix)/Mfa"><i class="bi bi-shield-lock me-2"></i>Two-factor (TOTP)</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="@(tenantPrefix)/logout?returnUrl=%2F"><i class="bi bi-box-arrow-right me-2"></i>Log out</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-3">
                            <a class="nav-link" href="@(tenantPrefix)/Registrations">Register</a>
                            <a class="nav-link" asp-page="/DiscoverTenant">Log in</a>
                        </div>
                    }
                </div>
            </nav>
        </header>
    }

    <div class="scroll-container d-flex flex-column">
        @if (User?.Identity?.IsAuthenticated ?? false && !hideNavbar)
        {
            <div class="container-fluid flex-grow-1">
                <div class="row h-100">
                    <!-- Sidebar: Offcanvas on mobile, always visible on desktop -->
                    <aside class="offcanvas-md offcanvas-start col-md-3 col-lg-2 border-end p-0 d-flex flex-column" id="sidebarNav" tabindex="-1" aria-labelledby="sidebarNavLabel">
                    <div class="offcanvas-header d-md-none">
                        <h5 class="offcanvas-title" id="sidebarNavLabel">Navigation</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#sidebarNav" aria-label="Close"></button>
                    </div>
                        <div class="offcanvas-body p-0 d-flex flex-column flex-grow-1">
                            <div class="list-group d-flex flex-column flex-grow-1 overflow-auto p-2">
                            <a class="@LinkClass("list-group-item list-group-item-action", $"{tenantPrefix}/")" href="@(tenantPrefix)/"><i class="bi bi-house-door me-2"></i>Home</a>
                            <a class="list-group-item list-group-item-action" href="@(tenantPrefix)/.well-known/openid-configuration" target="_blank" rel="noopener"><i class="bi bi-file-earmark-code me-2"></i>OIDC Discovery</a>
                            <a class="list-group-item list-group-item-action" href="@(tenantPrefix)/jwks" target="_blank" rel="noopener"><i class="bi bi-key me-2"></i>JWKS</a>
                            
                            @* My Account Section - All authenticated users *@
                            @if (User?.Identity?.IsAuthenticated ?? false)
                            {
                                <div class="list-group-item fw-semibold text-uppercase small bg-body-tertiary text-body">My Account</div>
                                <a class="list-group-item list-group-item-action @(isMyAccountArea ? "active" : "")" href="@(tenantPrefix)/account"><i class="bi bi-person-circle me-2"></i>Dashboard</a>
                            }
                            
                            @* Platform Admin Section - Only visible to platform admins *@
                            @if (User?.Identity?.IsAuthenticated ?? false)
                            {
                                var platformAdminResult = await AuthorizationService.AuthorizeAsync(User, null, "platform-admin");
                                if (platformAdminResult.Succeeded && isDefaultTenantContext)
                                {
                                    <div class="list-group-item fw-semibold text-uppercase small bg-body-tertiary text-body">Platform Admin</div>
                                    <a class="@LinkClass("list-group-item list-group-item-action", Url.Page("/PlatformAdmin/Index"))" asp-page="/PlatformAdmin/Index"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
                                    @if (MultiTenancyOptions.Enabled)
                                    {
                                        <a class="@LinkClass("list-group-item list-group-item-action", Url.Page("/PlatformAdmin/Tenants/Index"), matchPrefix: true)" asp-page="/PlatformAdmin/Tenants/Index"><i class="bi bi-building me-2"></i>Tenants</a>
                                    }
                                    <a class="@LinkClass("list-group-item list-group-item-action", Url.Page("/PlatformAdmin/Impersonation"))" asp-page="/PlatformAdmin/Impersonation"><i class="bi bi-incognito me-2"></i>Impersonation</a>
                                    <a class="@LinkClass("list-group-item list-group-item-action", Url.Page("/PlatformAdmin/ImpersonationHistory/Index"))" asp-page="/PlatformAdmin/ImpersonationHistory/Index"><i class="bi bi-clock-history me-2"></i>Impersonation History</a>
                                    <a class="@LinkClass("list-group-item list-group-item-action", $"{tenantPrefix}/admin/license/platform", matchPrefix: true)" href="@(tenantPrefix)/admin/license/platform"><i class="bi bi-award me-2"></i>Platform License</a>
                                    <a class="@LinkClass("list-group-item list-group-item-action", Url.Page("/PlatformAdmin/Settings"))" asp-page="/PlatformAdmin/Settings"><i class="bi bi-sliders me-2"></i>Platform Settings</a>
                                }
                            }
                            
                            @* Admin Section - Only visible to tenant admins (platform admins must use impersonation) *@
                            @if (User?.Identity?.IsAuthenticated ?? false)
                            {
                                var tenantAdminResult = await AuthorizationService.AuthorizeAsync(User, null, "tenant-admin");
                                if (tenantAdminResult.Succeeded)
                                {
                                    <div class="list-group-item fw-semibold text-uppercase small bg-body-tertiary text-body">Admin</div>
                                    <a class="@LinkClass("list-group-item list-group-item-action", $"{tenantPrefix}/admin/realms", matchPrefix: true)" href="@(tenantPrefix)/admin/realms"><i class="bi bi-diagram-3 me-2"></i>Realms</a>
                                    <a class="@LinkClass("list-group-item list-group-item-action", $"{tenantPrefix}/admin/clients", matchPrefix: true)" href="@(tenantPrefix)/admin/clients"><i class="bi bi-people me-2"></i>Clients</a>
                                    <a class="@LinkClass("list-group-item list-group-item-action", $"{tenantPrefix}/admin/providers", matchPrefix: true)" href="@(tenantPrefix)/admin/providers"><i class="bi bi-shield-lock me-2"></i>Providers</a>
                                    <a class="@LinkClass("list-group-item list-group-item-action", $"{tenantPrefix}/admin/provider-mappings", matchPrefix: true)" href="@(tenantPrefix)/admin/provider-mappings"><i class="bi bi-diagram-2 me-2"></i>Provider mappings</a>
                                    <a class="@LinkClass("list-group-item list-group-item-action", $"{tenantPrefix}/admin/scopes", matchPrefix: true)" href="@(tenantPrefix)/admin/scopes"><i class="bi bi-tags me-2"></i>Scopes</a>
                                    <a class="@LinkClass("list-group-item list-group-item-action", $"{tenantPrefix}/admin/roles", matchPrefix: true)" href="@(tenantPrefix)/admin/roles"><i class="bi bi-person-badge me-2"></i>Roles</a>
                                    <a class="@LinkClass("list-group-item list-group-item-action", $"{tenantPrefix}/admin/users", matchPrefix: true)" href="@(tenantPrefix)/admin/users"><i class="bi bi-people-fill me-2"></i>Users</a>
                                    <a class="@LinkClass("list-group-item list-group-item-action", $"{tenantPrefix}/admin/registrations", matchPrefix: true)" href="@(tenantPrefix)/admin/registrations"><i class="bi bi-clipboard2-check me-2"></i>Registrations</a>
                                    <a class="@LinkClass("list-group-item list-group-item-action", $"{tenantPrefix}/admin/backchannel", matchPrefix: true)" href="@(tenantPrefix)/admin/backchannel"><i class="bi bi-plug me-2"></i>BCL outbox</a>
                                    <a class="@LinkClass("list-group-item list-group-item-action", $"{tenantPrefix}/admin/license/tenant", matchPrefix: true)" href="@(tenantPrefix)/admin/license/tenant"><i class="bi bi-award me-2"></i>Tenant License</a>
                                    <a class="@LinkClass("list-group-item list-group-item-action ps-4 small", $"{tenantPrefix}/admin/license/history", matchPrefix: true)" href="@(tenantPrefix)/admin/license/history"><i class="bi bi-clock-history me-2"></i>History</a>
                                    
                                    @* Branding and Settings - Only show in multi-tenant mode *@
                                    @if (MultiTenancyOptions.Enabled)
                                    {
                                        <a class="@LinkClass("list-group-item list-group-item-action", $"{tenantPrefix}/admin/branding", matchPrefix: true)" asp-page="/admin/branding" asp-route-tenantSlug="@layoutTenantContext.Slug"><i class="bi bi-palette-fill me-2"></i>Branding</a>
                                        <a class="@LinkClass("list-group-item list-group-item-action", $"{tenantPrefix}/admin/settings", matchPrefix: true)" asp-page="/admin/settings" asp-route-tenantSlug="@layoutTenantContext.Slug"><i class="bi bi-gear-fill me-2"></i>Settings</a>
                                    }
                                }
                            }
                            
                            <div class="mt-auto border-top flex-shrink-0">
                                <div class="list-group-item fw-semibold text-uppercase small bg-body-tertiary text-body">Account</div>
                                <a class="list-group-item list-group-item-action" href="@(tenantPrefix)/logout?returnUrl=@Uri.EscapeDataString("/")"><i class="bi bi-box-arrow-right me-2"></i>Log out</a>
                            </div>
                        </div>
                    </div>
                    </aside>
                    <main role="main" class="col-md-9 col-lg-10 ms-sm-auto px-md-4 d-flex flex-column">
                    <div class="py-3 flex-grow-1">
                        @* Impersonation Banner - Shows when platform admin is impersonating *@
                        <partial name="_ImpersonationBanner" />
                        
                        @* Tenant Context Banner for Admin Pages *@
                        @if (Context!.Request.Path.StartsWithSegments("/Admin") || Context!.Request.Path.StartsWithSegments("/PlatformAdmin"))
                        {
                            <partial name="_TenantContextBanner" />
                        }
                        
                        @if (TempData.ContainsKey("Error"))
                        {
                            <div class="alert alert-danger">@TempData["Error"]</div>
                        }
                        @RenderBody()
                    </div>
                    </main>
                </div>
            </div>
        }
        else
        {
            <!-- Tight centered landing layout (unauthenticated) -->
            <div class="d-flex flex-column align-items-center justify-content-start py-4 flex-grow-1" style="min-height:70vh;">
                <div class="w-100 content-container">
                    @if (TempData.ContainsKey("Error"))
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }
                    @RenderBody()
                </div>
            </div>
        }
    </div>

    <footer class="border-top footer text-muted">
        <div class="container py-2">
            &copy; 2025 - MrWhoOidc.WebAuth - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
