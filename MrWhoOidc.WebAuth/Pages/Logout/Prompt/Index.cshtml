@page "/logout/prompt"
@model MrWhoOidc.WebAuth.Pages.Logout.Prompt.IndexModel
@{
    Layout = "~/Pages/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Sign out";
}
@{
  var dark = (Model.Style ?? string.Empty).Contains("dark", StringComparison.OrdinalIgnoreCase);
  var alertClass = dark ? "alert-secondary" : "alert-info";
}
<div class="card shadow-sm mt-4 @(dark ? "bg-dark text-light" : string.Empty)">
  <div class="card-body">
  <h2 class="h4 mb-3"><i class="bi @Model.ProviderIconClass me-1"></i>Sign out</h2>
  <div class="alert @alertClass py-2 small mb-3 @(dark ? "text-light" : string.Empty)">
    If you choose <strong>Sign out here and at @Model.ProviderDisplay</strong>, it will also end the session at the external provider and any other apps using it may require you to sign in again.
  </div>
  <p class="mb-3">You signed in using external provider <strong>@Model.ProviderDisplay</strong>. Choose how you want to sign out by selecting one of the options below:</p>
  <form method="post" class="mb-0">
  @Html.AntiForgeryToken()
  <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
  @if (!string.IsNullOrEmpty(Model.Style))
  {
    <input type="hidden" name="style" value="@Model.Style" />
  }
  @if (!string.IsNullOrEmpty(Model.ClientId))
  {
    <input type="hidden" name="client_id" value="@Model.ClientId" />
  }
  @if (!string.IsNullOrEmpty(Model.PostLogoutRedirectUri))
  {
    <input type="hidden" name="post_logout_redirect_uri" value="@Model.PostLogoutRedirectUri" />
  }
  <div class="d-flex flex-column gap-3 mb-2">
    <button type="submit" name="mode" value="local" class="btn btn-outline-secondary text-start p-3" style="white-space: normal;">
      <div class="fw-semibold mb-1">Sign out only from this application</div>
      <div class="small text-muted">Keeps you signed in at the external provider; other apps may stay signed in.</div>
    </button>
    <button type="submit" name="mode" value="federated" class="btn btn-danger text-start p-3" style="white-space: normal;">
      <div class="fw-semibold mb-1">Sign out here and at @Model.ProviderDisplay</div>
      <div class="small opacity-75">Ends the session at the external provider too; other apps may require you to sign in again.</div>
    </button>
  </div>
  </form>
  </div>
</div>
