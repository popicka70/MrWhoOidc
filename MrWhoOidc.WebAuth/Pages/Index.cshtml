@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to MrWho OIDC</h1>
    <img src="~/images/shape.jpeg" asp-append-version="true" class="img-fluid mt-3" alt="Decorative shape" style="max-width: 50%;"/>

    @if (User?.Identity?.IsAuthenticated ?? false)
    {
        <div class="alert alert-success mt-4" role="alert">
            You are signed in as <strong>@User.Identity!.Name</strong>.
        </div>
    }
    else
    {
        <div class="mt-4">
            <a class="btn btn-primary" asp-page="/Login">Log in</a>
        </div>
    }
</div>
