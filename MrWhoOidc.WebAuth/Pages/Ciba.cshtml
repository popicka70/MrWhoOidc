@page "/ciba"
@model MrWhoOidc.WebAuth.Pages.CibaModel
@{
    ViewData["Title"] = "Backchannel Authentication";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="card-body p-4">
        @if (Model.ShowAuthReqIdInput)
        {
            <div class="auth-card__header">
                <i class="ph ph-broadcast icon-xl icon-primary"></i>
                <h2 class="auth-card__title">Authentication Request</h2>
                <p class="auth-card__subtitle">
                    Enter the authentication request ID to continue.
                </p>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    <i class="ph ph-warning me-2"></i>@Model.ErrorMessage
                </div>
            }

            <form method="get" asp-antiforgery="true">
                <div class="mb-4">
                    <label for="auth_req_id" class="form-label">Request ID</label>
                    <input type="text" class="form-control form-control-lg"
                           id="auth_req_id" name="AuthReqId" placeholder="Enter request ID"
                           value="@Model.AuthReqId" autocomplete="off" required />
                    <div class="form-text">Enter the authentication request ID from the notification you received.</div>
                </div>
                <button type="submit" class="btn btn-primary w-100">
                    <i class="ph ph-arrow-right me-2"></i>Continue
                </button>
            </form>
        }
        else if (Model.ShowConfirmation)
        {
            <div class="auth-card__header">
                <i class="ph ph-shield-check icon-xl icon-primary"></i>
                <h2 class="auth-card__title">Confirm Authentication</h2>
                <p class="auth-card__subtitle">
                    An application is requesting to authenticate as you.
                </p>
            </div>

            <div class="mb-4">
                <div class="card bg-light">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-2">
                            <i class="ph ph-app-window me-2"></i>
                            <strong>Application:</strong>
                            <span class="ms-2">@Model.ClientName</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.BindingMessage))
                        {
                            <div class="mt-3">
                                <strong>Message:</strong>
                                <div class="alert alert-info mt-2 mb-0">
                                    <i class="ph ph-info me-2"></i>@Model.BindingMessage
                                </div>
                            </div>
                        }
                        @if (Model.RequestedScopes.Any())
                        {
                            <div class="mt-3">
                                <strong>Requested Permissions:</strong>
                                <ul class="list-unstyled mt-2 mb-0">
                                    @foreach (var scope in Model.RequestedScopes)
                                    {
                                        <li class="d-flex align-items-center py-1">
                                            <i class="ph ph-check text-success me-2"></i>
                                            @scope
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="alert alert-warning" role="alert">
                <i class="ph ph-warning me-2"></i>
                <strong>Security Notice:</strong> Only approve this request if you initiated the authentication.
                If you did not request this, click Deny.
            </div>

            <form method="post" asp-antiforgery="true">
                <input type="hidden" name="AuthReqId" value="@Model.AuthReqId" />
                <div class="action-buttons">
                    <button type="submit" name="action" value="approve" class="btn btn-success flex-fill">
                        <i class="ph ph-check me-2"></i>Approve
                    </button>
                    <button type="submit" name="action" value="deny" class="btn btn-outline-danger flex-fill">
                        <i class="ph ph-x me-2"></i>Deny
                    </button>
                </div>
            </form>
        }
        else if (Model.ShowSuccess)
        {
            <div class="auth-card__header">
                <i class="ph ph-check-circle icon-xl icon-success"></i>
                <h2 class="auth-card__title">Authentication Approved</h2>
                <p class="auth-card__subtitle">
                    The authentication request has been approved. You can close this window.
                    The requesting application will now be signed in.
                </p>
            </div>
        }
        else if (Model.ShowDenied)
        {
            <div class="auth-card__header">
                <i class="ph ph-x-circle icon-xl icon-danger"></i>
                <h2 class="auth-card__title">Authentication Denied</h2>
                <p class="auth-card__subtitle">
                    The authentication request has been denied. You can close this window.
                </p>
            </div>
        }
    </div>
</div>

<style nonce="@(ViewContext.HttpContext.Items["csp-nonce"] as string ?? string.Empty)">
    .icon-xl {
        font-size: 3rem;
        margin-bottom: 1rem;
    }
    .icon-primary {
        color: var(--bs-primary);
    }
    .icon-success {
        color: var(--bs-success);
    }
    .icon-danger {
        color: var(--bs-danger);
    }
    .action-buttons {
        display: flex;
        gap: 1rem;
    }
</style>
