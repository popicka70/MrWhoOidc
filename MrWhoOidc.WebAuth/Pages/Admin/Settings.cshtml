@page "/t/{tenantSlug}/admin/settings"
@model MrWhoOidc.WebAuth.Pages.Admin.SettingsModel
@{
    ViewData["Title"] = "Tenant Settings";
}

<div class="mt-2">
    <div class="page-header">
        <div class="page-header__content">
            <h1 class="page-header__title">
                <i class="ph ph-gear icon-md icon-primary"></i>
                Tenant Settings
            </h1>
            <p class="page-header__subtitle">Override platform defaults with tenant-specific configuration</p>
        </div>
    </div>
    
    @if (Model.SuccessMessage != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="ph-fill ph-check-circle me-2"></i>@Model.SuccessMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            
            @if (!Model.IsMultiTenantMode)
            {
                <div class="alert alert-info">
                    <i class="ph ph-info-fill me-2"></i>
                    <strong>Single-Tenant Mode:</strong> Settings overrides are available in multi-tenant mode only.
                </div>
            }
            
            <form method="post" class="needs-validation" novalidate>
                
                @* Authentication Settings *@
                <div class="card mb-3">
                    <div class="card-header">
                        <i class="ph ph-shield-check me-2"></i>Authentication
                    </div>
                    <div class="card-body">
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" asp-for="Input.AllowRefreshTokenIntrospection" id="allowRefreshIntrospection">
                            <label class="form-check-label" for="allowRefreshIntrospection">
                                Allow Refresh Token Introspection
                            </label>
                            <small class="form-text text-muted d-block w-100 mt-1">
                                Platform default: <strong>@(Model.PlatformDefaults?.Auth?.AllowRefreshTokenIntrospection?.ToString() ?? "Not set")</strong>
                            </small>
                        </div>
                        
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" asp-for="Input.RequireMfa" id="requireMfa">
                            <label class="form-check-label" for="requireMfa">
                                Require MFA for All Users
                            </label>
                            <small class="form-text text-muted d-block w-100 mt-1">
                                Platform default: <strong>@(Model.PlatformDefaults?.Auth?.RequireMfa?.ToString() ?? "Not set")</strong>
                            </small>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" asp-for="Input.CliAccessEnabled" id="cliAccessEnabled">
                            <label class="form-check-label" for="cliAccessEnabled">
                                Enable CLI Access
                            </label>
                            <small class="form-text text-muted d-block w-100 mt-1">
                                Creates or enables the tenant's dedicated MrWho CLI device-flow client. The CLI then only needs this tenant URL.
                            </small>
                            @if (!string.IsNullOrWhiteSpace(Model.CurrentCliClientId))
                            {
                                <small class="form-text text-muted d-block w-100 mt-1">
                                    Dedicated client ID: <strong>@Model.CurrentCliClientId</strong>
                                </small>
                                @if (!string.IsNullOrWhiteSpace(Model.CurrentCliServerUrl))
                                {
                                    <div class="mt-3">
                                        <label for="cli-server-url" class="form-label">CLI Server URL</label>
                                        <div class="input-group">
                                            <input id="cli-server-url" type="text" class="form-control" value="@Model.CurrentCliServerUrl" readonly>
                                            <button id="btn-copy-cli-url" type="button" class="btn btn-outline-secondary">
                                                <i class="ph ph-copy me-1"></i>Copy
                                            </button>
                                        </div>
                                        <small class="form-text text-muted d-block mt-1">
                                            Use this tenant URL when connecting MrWho CLI.
                                        </small>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                @* Dynamic Client Registration *@
                <div class="card mb-3">
                    <div class="card-header">
                        <i class="ph ph-tree-structure me-2"></i>Dynamic Client Registration
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.DynamicClientRegistrationRealmId" class="form-label">Realm</label>
                                <select asp-for="Input.DynamicClientRegistrationRealmId" class="form-select" asp-items="Model.DynamicClientRegistrationRealmOptions"></select>
                                <span asp-validation-for="Input.DynamicClientRegistrationRealmId" class="text-danger small"></span>
                                <div class="form-text">
                                    Select which realm newly registered clients belong to. Choose “Disabled (no realm)” to turn off <strong>/register</strong> for this tenant.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* User Registration *@
                <div class="card mb-3">
                    <div class="card-header">
                        <i class="ph ph-user-plus me-2"></i>User Registration
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Input.RegistrationMode" class="form-label">Registration path</label>
                                <select asp-for="Input.RegistrationMode" class="form-select" asp-items="Model.RegistrationModeOptions"></select>
                                <span asp-validation-for="Input.RegistrationMode" class="text-danger small"></span>
                                <small class="form-text text-muted d-block mt-1">
                                    Platform default: <strong>@(Model.PlatformDefaults?.Registration?.Mode?.ToString() ?? "PlatformOnly")</strong>
                                </small>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Input.RegistrationHeadline" class="form-label">Tenant registration heading</label>
                                <input asp-for="Input.RegistrationHeadline" class="form-control" maxlength="120" placeholder="Register with your organization" />
                                <span asp-validation-for="Input.RegistrationHeadline" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.RegistrationHeroImageUrl" class="form-label">Registration image URL</label>
                                <input asp-for="Input.RegistrationHeroImageUrl" type="url" class="form-control" maxlength="500" placeholder="https://example.com/registration.jpg" />
                                <span asp-validation-for="Input.RegistrationHeroImageUrl" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Input.RegistrationIntroText" class="form-label">Tenant registration intro</label>
                                <textarea asp-for="Input.RegistrationIntroText" class="form-control" rows="3" maxlength="500" placeholder="Short copy shown above the tenant registration form"></textarea>
                                <span asp-validation-for="Input.RegistrationIntroText" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
                
                @* Password Policy *@
                <div class="card mb-3">
                    <div class="card-header">
                        <i class="ph ph-key-fill me-2"></i>Password Policy
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Input.PasswordMinLength" class="form-label">Minimum Length</label>
                                <input asp-for="Input.PasswordMinLength" type="number" class="form-control" min="6" max="128" placeholder="Leave empty for platform default">
                                <small class="form-text text-muted">
                                    Platform default: <strong>@(Model.PlatformDefaults?.Auth?.PasswordPolicy?.MinLength?.ToString() ?? "8")</strong>
                                </small>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Input.PasswordRequireUppercase" id="reqUpper">
                                    <label class="form-check-label" for="reqUpper">Require Uppercase</label>
                                </div>
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Input.PasswordRequireLowercase" id="reqLower">
                                    <label class="form-check-label" for="reqLower">Require Lowercase</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Input.PasswordRequireDigit" id="reqDigit">
                                    <label class="form-check-label" for="reqDigit">Require Digit</label>
                                </div>
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Input.PasswordRequireSpecialChar" id="reqSpecial">
                                    <label class="form-check-label" for="reqSpecial">Require Special Character</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* QR Login Settings *@
                <div class="card mb-3">
                    <div class="card-header">
                        <i class="ph ph-qr-code me-2"></i>QR Login
                    </div>
                    <div class="card-body">
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" asp-for="Input.QrLoginEnabled" id="qrEnabled">
                            <label class="form-check-label" for="qrEnabled">
                                Enable QR Login
                            </label>
                            <small class="form-text text-muted d-block w-100 mt-1">
                                Platform default: <strong>@(Model.PlatformDefaults?.QrLogin?.Enabled?.ToString() ?? "Not set")</strong>
                            </small>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <label asp-for="Input.QrSessionLifetimeSeconds" class="form-label">Session Lifetime (seconds)</label>
                                <input asp-for="Input.QrSessionLifetimeSeconds" type="number" class="form-control" min="30" max="600" placeholder="Leave empty for platform default">
                                <small class="form-text text-muted">
                                    Platform default: <strong>@(Model.PlatformDefaults?.QrLogin?.SessionLifetimeSeconds?.ToString() ?? "300")</strong>
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
                
                @* Token Lifetimes *@
                <div class="card mb-3">
                    <div class="card-header">
                        <i class="ph ph-clock-counter-clockwise me-2"></i>Token Lifetimes
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Input.AccessTokenLifetimeSeconds" class="form-label">Access Token (seconds)</label>
                                <input asp-for="Input.AccessTokenLifetimeSeconds" type="number" class="form-control" min="60" max="86400" placeholder="Leave empty for platform default">
                                <small class="form-text text-muted">
                                    Platform default: <strong>@(Model.PlatformDefaults?.Tokens?.AccessTokenLifetimeSeconds?.ToString() ?? "3600")</strong>
                                </small>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.RefreshTokenLifetimeSeconds" class="form-label">Refresh Token (seconds)</label>
                                <input asp-for="Input.RefreshTokenLifetimeSeconds" type="number" class="form-control" min="3600" max="2592000" placeholder="Leave empty for platform default">
                                <small class="form-text text-muted">
                                    Platform default: <strong>@(Model.PlatformDefaults?.Tokens?.RefreshTokenLifetimeSeconds?.ToString() ?? "1296000")</strong>
                                </small>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <label asp-for="Input.AuthorizationCodeLifetimeSeconds" class="form-label">Authorization Code (seconds)</label>
                                <input asp-for="Input.AuthorizationCodeLifetimeSeconds" type="number" class="form-control" min="30" max="600" placeholder="Leave empty for platform default">
                                <small class="form-text text-muted">
                                    Platform default: <strong>@(Model.PlatformDefaults?.Tokens?.AuthorizationCodeLifetimeSeconds?.ToString() ?? "300")</strong>
                                </small>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.IdTokenLifetimeSeconds" class="form-label">ID Token (seconds)</label>
                                <input asp-for="Input.IdTokenLifetimeSeconds" type="number" class="form-control" min="60" max="86400" placeholder="Leave empty for platform default">
                                <small class="form-text text-muted">
                                    Platform default: <strong>@(Model.PlatformDefaults?.Tokens?.IdTokenLifetimeSeconds?.ToString() ?? "3600")</strong>
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
                
                @* Consent-based user assistance *@
                <div class="card mb-3">
                    <div class="card-header">
                        <i class="ph ph-hand-heart me-2"></i>User Assistance
                    </div>
                    <div class="card-body">
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" asp-for="Input.AssistanceEnabled" id="assistanceEnabled">
                            <label class="form-check-label" for="assistanceEnabled">
                                Enable consent-based assistance for this tenant
                            </label>
                            <small class="form-text text-muted d-block w-100 mt-1">
                                The platform flag <code>Auth:EnableUserAssistance</code> must also be on.
                            </small>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Input.AssistanceRightsMode" class="form-label">Rights mode</label>
                                <select asp-for="Input.AssistanceRightsMode" class="form-select">
                                    <option value="intersection">Intersection of requester and helper roles</option>
                                    <option value="fullTarget">Full requester role set</option>
                                </select>
                                <span asp-validation-for="Input.AssistanceRightsMode" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.AssistanceReadOnlyTokenPolicy" class="form-label">Read-only token policy</label>
                                <select asp-for="Input.AssistanceReadOnlyTokenPolicy" class="form-select">
                                    <option value="markerOnly">markerOnly — issue tokens with assistance_mode=read_only</option>
                                    <option value="deny">deny — block OIDC authorization for read-only sessions</option>
                                </select>
                                <span asp-validation-for="Input.AssistanceReadOnlyTokenPolicy" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Input.AssistanceRequesterRoles" class="form-label">Requester roles</label>
                                <input asp-for="Input.AssistanceRequesterRoles" class="form-control" placeholder="Empty = any tenant user" />
                                <span asp-validation-for="Input.AssistanceRequesterRoles" class="text-danger small"></span>
                                <small class="form-text text-muted">Comma-separated role names in this tenant.</small>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.AssistanceManagerRoles" class="form-label">Manager roles</label>
                                <input asp-for="Input.AssistanceManagerRoles" class="form-control" placeholder="tenant-admin" />
                                <span asp-validation-for="Input.AssistanceManagerRoles" class="text-danger small"></span>
                                <small class="form-text text-muted">Roles that can list and revoke all tenant sessions.</small>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Input.AssistanceReadOnlyHelperRoles" class="form-label">Read-only helper roles</label>
                                <input asp-for="Input.AssistanceReadOnlyHelperRoles" class="form-control" placeholder="tenant-admin" />
                                <span asp-validation-for="Input.AssistanceReadOnlyHelperRoles" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.AssistanceReadWriteHelperRoles" class="form-label">Read-write helper roles</label>
                                <input asp-for="Input.AssistanceReadWriteHelperRoles" class="form-control" placeholder="Empty = no read-write helpers" />
                                <span asp-validation-for="Input.AssistanceReadWriteHelperRoles" class="text-danger small"></span>
                                <small class="form-text text-muted">Read-write roles also imply read-only capability.</small>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <label asp-for="Input.AssistanceDefaultDurationMinutes" class="form-label">Default duration (minutes)</label>
                                <input asp-for="Input.AssistanceDefaultDurationMinutes" type="number" class="form-control" min="1" max="1440" placeholder="15" />
                                <span asp-validation-for="Input.AssistanceDefaultDurationMinutes" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Input.AssistanceMaxDurationMinutes" class="form-label">Maximum duration (minutes)</label>
                                <input asp-for="Input.AssistanceMaxDurationMinutes" type="number" class="form-control" min="1" max="1440" placeholder="60" />
                                <span asp-validation-for="Input.AssistanceMaxDurationMinutes" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Input.AssistanceRequestLifetimeMinutes" class="form-label">Request lifetime (minutes)</label>
                                <input asp-for="Input.AssistanceRequestLifetimeMinutes" type="number" class="form-control" min="1" max="1440" placeholder="10" />
                                <span asp-validation-for="Input.AssistanceRequestLifetimeMinutes" class="text-danger small"></span>
                                <small class="form-text text-muted">How long an unanswered request stays pending.</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <a asp-page="/admin/clients" asp-route-tenantSlug="@Model.TenantSlug" class="btn btn-secondary">
                            <i class="ph ph-arrow-left me-1"></i>Back
                        </a>
                        <button id="btn-reset-defaults" type="button" class="btn btn-outline-danger">
                            <i class="ph ph-arrow-counterclockwise me-1"></i>Reset to Platform Defaults
                        </button>
                        <div class="form-text text-danger mt-1" id="reset-warning">
                            <i class="ph ph-warning me-1"></i>
                            <strong>Destructive:</strong> clears every tenant-specific override in this form
                            (feature flags, token lifetimes, registration mode) back to the platform defaults.
                            Confirmed with a dialog before applying — save afterwards to persist.
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary" disabled="@(!Model.IsMultiTenantMode)">
                        <i class="ph ph-save me-1"></i>Save Settings
                    </button>
                </div>
            </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script nonce="@(HttpContext.Items["csp-nonce"] as string ?? string.Empty)">
        document.addEventListener('DOMContentLoaded', function () {
            var resetBtn = document.getElementById('btn-reset-defaults');
            if (resetBtn) {
                resetBtn.addEventListener('click', function () {
                    if (confirm('Are you sure you want to reset all settings to platform defaults? This will clear all tenant-specific overrides.')) {
                        document.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
                        document.querySelectorAll('input[type="number"]').forEach(num => num.value = '');
                        document.querySelectorAll('input[type="text"], input[type="url"], textarea').forEach(input => input.value = '');
                        document.querySelectorAll('select').forEach(sel => sel.value = '');
                        var registrationMode = document.getElementById('Input_RegistrationMode');
                        if (registrationMode) registrationMode.value = 'PlatformOnly';
                    }
                });
            }

            var copyBtn = document.getElementById('btn-copy-cli-url');
            if (copyBtn) {
                copyBtn.addEventListener('click', async function () {
                    var input = document.getElementById('cli-server-url');
                    if (!input) return;

                    var value = input.value;
                    try {
                        if (navigator.clipboard && navigator.clipboard.writeText) {
                            await navigator.clipboard.writeText(value);
                        } else {
                            input.focus();
                            input.select();
                            document.execCommand('copy');
                        }

                        var original = copyBtn.innerHTML;
                        copyBtn.innerHTML = '<i class="ph ph-check me-1"></i>Copied';
                        setTimeout(function () { copyBtn.innerHTML = original; }, 1500);
                    } catch {
                        input.focus();
                        input.select();
                    }
                });
            }
        });
    </script>
}
