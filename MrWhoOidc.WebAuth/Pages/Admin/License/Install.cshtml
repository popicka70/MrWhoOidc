@page "/admin/license/install"
@model MrWhoOidc.WebAuth.Pages.Admin.License.InstallModel
@{
    ViewData["Title"] = "Install License";
}

<h1 class="mb-3">Install or update license</h1>

<form method="post" class="mb-4">
    <div class="card">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @if (Model.IsPlatformAdmin)
            {
                <div class="row g-3 mb-4">
                    <div class="col-md-4 col-lg-3">
                        <label class="form-label" asp-for="Scope">Scope</label>
                        <select class="form-select" asp-for="Scope" asp-items="Model.ScopeOptions"></select>
                    </div>
                    @if (string.Equals(Model.Scope, Model.TenantScopeTenant, StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="col-md-5 col-lg-4">
                            <label class="form-label" asp-for="TenantId">Tenant</label>
                            <select class="form-select" asp-for="TenantId" asp-items="Model.TenantOptions"></select>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" asp-for="TenantId" />
                    }
                </div>
            }
            else
            {
                <input type="hidden" asp-for="Scope" />
                <input type="hidden" asp-for="TenantId" />
                <div class="alert alert-secondary" role="alert">
                    Managing license for tenant: <strong>@(Model.TenantName ?? "Current tenant")</strong>
                </div>
            }

            <div class="mb-3">
                <label class="form-label" asp-for="Input.LicenseKey"></label>
                <div class="row g-2 align-items-end mb-2">
                    <div class="col-md-7 col-lg-6">
                        <label class="form-label small text-muted" for="licenseFile">Load from local file</label>
                        <input id="licenseFile" class="form-control" type="file" accept=".jws,.jwt,.license,.txt,text/plain,application/jwt" data-license-file-input data-license-file-target="#Input_LicenseKey" data-license-file-status="#licenseFileStatus" />
                    </div>
                    <div class="col-md-5 col-lg-6">
                        <div id="licenseFileStatus" class="form-text">Select a downloaded license file to fill the JWS field.</div>
                    </div>
                </div>
                <textarea class="form-control" asp-for="Input.LicenseKey" rows="10" spellcheck="false" aria-describedby="licenseKeyHelp"></textarea>
                <div id="licenseKeyHelp" class="form-text">Paste the signed JWS license key exactly as provided, or load it from a downloaded license file. Validation runs before installation.</div>
                <span class="text-danger" asp-validation-for="Input.LicenseKey"></span>
            </div>

            <div class="mb-0">
                <label class="form-label" asp-for="Input.Notes"></label>
                <textarea class="form-control" asp-for="Input.Notes" rows="3" aria-describedby="licenseNotesHelp"></textarea>
                <div id="licenseNotesHelp" class="form-text">Optional notes appear in the license history (e.g., purchase order, contact).</div>
                <span class="text-danger" asp-validation-for="Input.Notes"></span>
            </div>
        </div>
        <div class="card-footer d-flex flex-wrap gap-2">
            <button class="btn btn-outline-secondary" type="submit" asp-page-handler="Validate">
                <i class="ph ph-search me-1"></i>Validate only
            </button>
            <button class="btn btn-primary" type="submit" asp-page-handler="Install">
                <i class="ph ph-cloud-upload me-1"></i>Install license
            </button>
            <a class="btn btn-link ms-auto" asp-page="Index" asp-route-scope="@Model.Scope" asp-route-tenantId="@(string.Equals(Model.Scope, Model.TenantScopeTenant, StringComparison.OrdinalIgnoreCase) ? Model.TenantId : null)">
                Back to summary
            </a>
        </div>
    </div>
</form>

@if (Model.ValidationPreview is not null)
{
    var validationStateClass = Model.ValidationPreview.IsValid ? "border-success" : "border-danger";
    <div class="card @validationStateClass mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <strong>Validation result:</strong>
                <span class="@(Model.ValidationPreview.IsValid ? "text-success" : "text-danger")">
                    @(Model.ValidationPreview.IsValid ? "License is valid" : "License validation failed")
                </span>
            </div>
            <span class="badge @(Model.ValidationPreview.IsValid ? "text-bg-success" : "text-bg-danger")">
                @(Model.ValidationPreview.IsValid ? "Valid" : "Invalid")
            </span>
        </div>
        <div class="card-body">
            @if (Model.ValidationError is not null)
            {
                <div class="alert alert-danger" role="alert">
                    <div class="fw-semibold">@Model.ValidationError.Error</div>
                    <div>@Model.ValidationError.ErrorDescription</div>
                </div>
            }

            @if (Model.ValidationSummary is not null)
            {
                <div class="row g-4">
                    <div class="col-lg-6">
                        <h5 class="mb-3">Proposed license</h5>
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Tier</dt>
                            <dd class="col-sm-8">@Model.ValidationSummary.TierDisplay</dd>
                            <dt class="col-sm-4">Scope</dt>
                            <dd class="col-sm-8">@Model.ValidationSummary.ScopeDisplay</dd>
                            <dt class="col-sm-4">Issued to</dt>
                            <dd class="col-sm-8">@Model.ValidationSummary.IssuedToDisplay</dd>
                            <dt class="col-sm-4">Organization</dt>
                            <dd class="col-sm-8">@(!string.IsNullOrWhiteSpace(Model.ValidationSummary.Info.OrganizationName) ? Model.ValidationSummary.Info.OrganizationName : "—")</dd>
                            <dt class="col-sm-4">Valid from</dt>
                            <dd class="col-sm-8">@Model.FormatDate(Model.ValidationSummary.Info.ValidFrom)</dd>
                            <dt class="col-sm-4">Valid until</dt>
                            <dd class="col-sm-8">@Model.ValidationSummary.ExpiryText</dd>
                        </dl>
                    </div>
                    <div class="col-lg-6">
                        <h5 class="mb-3">Enabled features</h5>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @foreach (var feature in Model.ValidationSummary.Features)
                            {
                                <span class="badge text-bg-light border">@feature.DisplayName</span>
                            }
                        </div>

                        @if (Model.ValidationSummary.Info.AllowedIssuers.Count > 0)
                        {
                            <h5 class="mb-3">Allowed Issuers</h5>
                            <ul class="list-unstyled small text-muted mb-0">
                                @foreach (var issuer in Model.ValidationSummary.Info.AllowedIssuers)
                                {
                                    <li><i class="ph ph-check me-1 text-success"></i>@issuer</li>
                                }
                            </ul>
                        }
                    </div>
                </div>
                <div class="table-responsive mt-4">
                    <table class="table table-sm mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Limit</th>
                                <th scope="col">Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var limit in Model.ValidationSummary.Limits)
                            {
                                <tr>
                                    <th scope="row">@limit.DisplayName</th>
                                    <td>
                                        @if (limit.IsUnlimited)
                                        {
                                            <span class="badge text-bg-success">Unlimited</span>
                                        }
                                        else if (limit.IsDisabled)
                                        {
                                            <span class="badge text-bg-secondary">Disabled</span>
                                        }
                                        else
                                        {
                                            @limit.ValueDisplay
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
