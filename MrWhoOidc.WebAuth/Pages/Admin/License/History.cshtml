@page "/admin/license/history"
@model MrWhoOidc.WebAuth.Pages.Admin.License.HistoryModel
@{
    ViewData["Title"] = "License History";
    var history = Model.History;
}

<h1 class="mb-3">License history</h1>

@if (ModelState.ErrorCount > 0)
{
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
}

<form method="get" class="card mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            @if (Model.IsPlatformAdmin)
            {
                <div class="col-md-4 col-lg-3">
                    <label class="form-label" asp-for="Scope">Scope</label>
                    <select class="form-select" asp-for="Scope" asp-items="Model.ScopeOptions"></select>
                </div>
                @if (string.Equals(Model.Scope, Model.TenantScopeTenant, StringComparison.OrdinalIgnoreCase))
                {
                    <div class="col-md-5 col-lg-4">
                        <label class="form-label" asp-for="TenantId">Tenant</label>
                        <select class="form-select" asp-for="TenantId" asp-items="Model.TenantOptions"></select>
                    </div>
                }
                else
                {
                    <input type="hidden" asp-for="TenantId" />
                }
            }
            else
            {
                <input type="hidden" asp-for="Scope" />
                <input type="hidden" asp-for="TenantId" />
                <div class="col-12">
                    <div class="alert alert-secondary" role="alert">
                        Viewing history for tenant: <strong>@(Model.TenantName ?? "Current tenant")</strong>
                    </div>
                </div>
            }

            <div class="col-md-4 col-lg-3">
                <label class="form-label" asp-for="ActionFilter">Action</label>
                <select class="form-select" asp-for="ActionFilter" asp-items="Model.ActionOptions"></select>
            </div>
            <div class="col-md-3 col-lg-2">
                <label class="form-label" asp-for="PageSize">Page size</label>
                <select class="form-select" asp-for="PageSize">
                    <option value="10" selected="@(Model.PageSize == 10)">10</option>
                    <option value="20" selected="@(Model.PageSize == 20)">20</option>
                    <option value="50" selected="@(Model.PageSize == 50)">50</option>
                    <option value="100" selected="@(Model.PageSize == 100)">100</option>
                </select>
            </div>
            <input type="hidden" name="pageNumber" value="1" />
            <div class="col-md-3 col-lg-2">
                <button class="btn btn-primary w-100" type="submit">
                    <i class="bi bi-arrow-repeat me-1"></i>Apply
                </button>
            </div>
        </div>
    </div>
</form>

@if (history is not null && Model.HasEntries)
{
    <div class="table-responsive mb-3">
        <table class="data-table align-middle">
            <thead class="table-light">
                <tr>
                    <th scope="col">Timestamp</th>
                    <th scope="col">Action</th>
                    <th scope="col">Tier change</th>
                    <th scope="col">Notes &amp; reason</th>
                    <th scope="col">User</th>
                    <th scope="col">IP / Agent</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in history.Entries)
                {
                    <tr>
                        <td>
                            <div>@Model.FormatDate(entry.CreatedAt)</div>
                            <div class="small text-muted">@Model.FormatRelativeTime(entry.CreatedAt)</div>
                        </td>
                        <td>
                            <span class="badge text-bg-light border">@Model.DescribeAction(entry.Action)</span>
                        </td>
                        <td>
                            @Model.DescribeTier(entry.OldTier)
                            <span class="mx-1">→</span>
                            @Model.DescribeTier(entry.NewTier)
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(entry.Notes))
                            {
                                <div>@entry.Notes</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(entry.Reason))
                            {
                                <div class="small text-muted">Reason: @entry.Reason</div>
                            }
                            @if (string.IsNullOrWhiteSpace(entry.Notes) && string.IsNullOrWhiteSpace(entry.Reason))
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>@(entry.CreatedBy?.ToString() ?? "—")</td>
                        <td>
                            <div>@(entry.IpAddress ?? "—")</div>
                            @if (!string.IsNullOrWhiteSpace(entry.UserAgent))
                            {
                                <div class="small text-muted text-truncate" style="max-width: 260px;" title="@entry.UserAgent">@entry.UserAgent</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    var start = ((history.Page - 1) * history.PageSize) + 1;
    var end = Math.Min(start + history.Entries.Count - 1, history.TotalCount);

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div class="text-muted">Showing @start - @end of @history.TotalCount entries</div>
        <nav aria-label="License history pagination">
            <ul class="pagination mb-0">
                <li class="page-item @(history.Page == 1 ? "disabled" : string.Empty)">
                    <a class="page-link" asp-page="History"
                       asp-route-scope="@Model.Scope"
                       asp-route-tenantId="@(string.Equals(Model.Scope, Model.TenantScopeTenant, StringComparison.OrdinalIgnoreCase) ? Model.TenantId : null)"
                       asp-route-pageNumber="@(history.Page - 1)"
                       asp-route-pageSize="@history.PageSize"
                       asp-route-actionFilter="@Model.ActionFilter"
                       aria-label="Previous">&laquo;</a>
                </li>
                <li class="page-item disabled"><span class="page-link">Page @history.Page of @history.TotalPages</span></li>
                <li class="page-item @(history.Page >= history.TotalPages ? "disabled" : string.Empty)">
                    <a class="page-link" asp-page="History"
                       asp-route-scope="@Model.Scope"
                       asp-route-tenantId="@(string.Equals(Model.Scope, Model.TenantScopeTenant, StringComparison.OrdinalIgnoreCase) ? Model.TenantId : null)"
                       asp-route-pageNumber="@(history.Page + 1)"
                       asp-route-pageSize="@history.PageSize"
                       asp-route-actionFilter="@Model.ActionFilter"
                       aria-label="Next">&raquo;</a>
                </li>
            </ul>
        </nav>
    </div>
}
else if (history is not null)
{
    <div class="alert alert-secondary" role="alert">
        No history entries found for the selected filters.
    </div>
}

<div class="mt-4">
    <a class="btn btn-outline-secondary" asp-page="Index" asp-route-scope="@Model.Scope" asp-route-tenantId="@(string.Equals(Model.Scope, Model.TenantScopeTenant, StringComparison.OrdinalIgnoreCase) ? Model.TenantId : null)">
        <i class="bi bi-arrow-left me-1"></i>Back to summary
    </a>
</div>
