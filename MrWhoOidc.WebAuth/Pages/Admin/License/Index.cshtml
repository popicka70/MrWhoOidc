@page "/admin/license"
@model MrWhoOidc.WebAuth.Pages.Admin.License.IndexModel
@{
    ViewData["Title"] = "License Management";
}

<h1 class="mb-3">
    <i class="bi bi-award me-2"></i>License Management
</h1>
<p class="text-muted mb-4">
    Manage platform and tenant licenses. Platform licenses define deployment-wide capabilities; tenant licenses customize features per tenant.
</p>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.InfoMessage))
{
    <div class="alert alert-info" role="alert">
        <i class="bi bi-info-circle-fill me-2"></i>@Model.InfoMessage
    </div>
}

<div class="row g-4 mb-4">
    @if (Model.IsPlatformAdmin)
    {
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-globe me-2"></i>Platform License</h5>
                </div>
                <div class="card-body">
                    <p class="card-text">
                        The platform license governs the entire deployment. It defines:
                    </p>
                    <ul class="mb-3">
                        <li><strong>Deployment mode</strong> (single-tenant or multi-tenant)</li>
                        <li><strong>Maximum tenants</strong> allowed</li>
                        <li><strong>Enterprise features</strong> available to all tenants</li>
                        <li><strong>Default limits</strong> inherited by tenants</li>
                    </ul>
                    <p class="small text-muted">
                        Tenant licenses cannot exceed the capabilities defined in the platform license.
                    </p>
                </div>
                <div class="card-footer d-flex gap-2">
                    <a class="btn btn-primary" asp-page="Platform/Index">
                        <i class="bi bi-eye me-1"></i>View platform license
                    </a>
                    <a class="btn btn-outline-primary" asp-page="Platform/Install">
                        <i class="bi bi-cloud-upload me-1"></i>Install
                    </a>
                </div>
            </div>
        </div>
    }
    
    <div class="@(Model.IsPlatformAdmin ? "col-md-6" : "col-12")">
        <div class="card h-100">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="bi bi-building me-2"></i>Tenant License</h5>
            </div>
            <div class="card-body">
                <p class="card-text">
                    Tenant licenses customize features for specific tenants:
                </p>
                <ul class="mb-3">
                    <li><strong>Tenant-specific features</strong> enabled or disabled</li>
                    <li><strong>User limits</strong> for the tenant</li>
                    <li><strong>Client limits</strong> and API quotas</li>
                    <li><strong>Sublicense support</strong> (derived from platform license)</li>
                </ul>
                <p class="small text-muted">
                    Tenant features are constrained by what the platform license allows.
                </p>
            </div>
            <div class="card-footer d-flex gap-2">
                <a class="btn btn-info text-white" asp-page="Tenant/Index">
                    <i class="bi bi-eye me-1"></i>View tenant license
                </a>
                <a class="btn btn-outline-info" asp-page="Tenant/Install">
                    <i class="bi bi-cloud-upload me-1"></i>Install
                </a>
            </div>
        </div>
    </div>
</div>

@* Quick summary if there's license data *@
@if (Model.Summary is not null)
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0">Current License Summary</h5>
                <div class="small text-muted">@Model.Summary.ScopeDisplay</div>
            </div>
            <span class="badge @Model.Summary.StatusCssClass fs-6">@Model.Summary.StatusText</span>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Tier</dt>
                        <dd class="col-sm-8">@Model.Summary.TierDisplay</dd>
                        <dt class="col-sm-4">Valid until</dt>
                        <dd class="col-sm-8">@Model.Summary.ExpiryText</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <div class="mb-2 fw-semibold">Enabled features</div>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var feature in Model.Summary.Features.Take(6))
                        {
                            <span class="badge text-bg-light border small">@feature.DisplayName</span>
                        }
                        @if (Model.Summary.Features.Count > 6)
                        {
                            <span class="badge text-bg-secondary small">+@(Model.Summary.Features.Count - 6) more</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">License tier reference</h5>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(Model.TierMessage))
        {
            <div class="text-muted">@Model.TierMessage</div>
        }
        else if (Model.TierCatalog.Count > 0)
        {
            <div class="accordion" id="tierCatalog">
                @for (var i = 0; i < Model.TierCatalog.Count; i++)
                {
                    var tier = Model.TierCatalog[i];
                    var collapseId = $"tier-{i}";
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="heading-@collapseId">
                            <button class="accordion-button @(i == 0 ? string.Empty : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(i == 0 ? "true" : "false")" aria-controls="@collapseId">
                                <span class="fw-semibold me-2">@tier.DisplayName</span>
                                <span class="text-muted small">@tier.Description</span>
                            </button>
                        </h2>
                        <div id="@collapseId" class="accordion-collapse collapse @(i == 0 ? "show" : string.Empty)" aria-labelledby="heading-@collapseId" data-bs-parent="#tierCatalog">
                            <div class="accordion-body">
                                <div class="mb-2 fw-semibold">Included features</div>
                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    @foreach (var feature in tier.Features)
                                    {
                                        <span class="badge text-bg-light border">@feature</span>
                                    }
                                </div>
                                <div class="mb-2 fw-semibold">Default limits</div>
                                <div class="table-responsive">
                                    <table class="table table-sm mb-0">
                                        <tbody>
                                            @foreach (var limit in tier.DefaultLimits)
                                            {
                                                <tr>
                                                    <th scope="row">@limit.DisplayName</th>
                                                    <td>@limit.ValueDisplay</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-muted">Tier reference data is not available.</div>
        }
    </div>
</div>

<div class="d-flex flex-wrap gap-2">
    <a class="btn btn-outline-secondary" asp-page="History">
        <i class="bi bi-clock-history me-1"></i>View all history
    </a>
</div>
