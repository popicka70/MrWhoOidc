@page "/admin/configuration-audit"
@model MrWhoOidc.WebAuth.Pages.Admin.ConfigurationAudit.IndexModel
@{
    ViewData["Title"] = "Configuration Audit Log";
    ViewData["AdminSection"] = "configuration-audit";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="h3 mb-0">
                <i class="ph ph-clipboard-data me-2"></i>Configuration Audit Log
            </h1>
            <p class="text-muted">View export and import operation history</p>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label for="operationFilter" class="form-label">Operation</label>
                    <select id="operationFilter" name="OperationFilter" class="form-select" asp-for="OperationFilter">
                        <option value="">All Operations</option>
                        <option value="Export">Export</option>
                        <option value="Import">Import</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="entityTypeFilter" class="form-label">Entity Type</label>
                    <select id="entityTypeFilter" name="EntityTypeFilter" class="form-select" asp-for="EntityTypeFilter">
                        <option value="">All Types</option>
                        <option value="Tenant">Tenant</option>
                        <option value="Realm">Realm</option>
                        <option value="Client">Client</option>
                        <option value="IdentityProvider">Identity Provider</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="actorFilter" class="form-label">Actor</label>
                    <input id="actorFilter" name="ActorFilter" class="form-control" asp-for="ActorFilter"
                           type="text" placeholder="Who performed the operation" autocomplete="off" />
                </div>
                <div class="col-md-3">
                    <label class="form-label d-block" for="fromDate">Date Range</label>
                    <div class="input-group">
                        <input id="fromDate" name="FromDate" class="form-control" asp-for="FromDate"
                               type="date" aria-label="From date" />
                        <span class="input-group-text">–</span>
                        <input id="toDate" name="ToDate" class="form-control" asp-for="ToDate"
                               type="date" aria-label="To date" />
                    </div>
                </div>
                <div class="col-md-3">
                    <label for="pageSize" class="form-label">Page Size</label>
                    <select id="pageSize" name="PageSize" class="form-select" asp-for="PageSize">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
                <div class="col-md-9 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="ph ph-funnel me-1"></i>Filter
                    </button>
                    <a asp-page="Index" class="btn btn-outline-secondary">
                        <i class="ph ph-x-circle me-1"></i>Clear
                    </a>
                    <button type="submit" name="Export" value="csv" class="btn btn-outline-primary">
                        <i class="ph ph-download-simple me-1"></i>Export CSV
                    </button>
                    <span class="text-muted small ms-auto">
                        <i class="ph ph-clock-counter-clockwise me-1"></i>
                        @Model.TotalCount total entries
                    </span>
                </div>
            </form>
        </div>
    </div>

    <div class="row">
        <!-- Audit Log List -->
        <div class="@(Model.SelectedAuditLog != null ? "col-lg-7" : "col-12")">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Audit Entries</span>
                    <span class="badge bg-secondary">@Model.TotalCount total</span>
                </div>
                <div class="card-body p-0">
                    @if (Model.AuditLogs.Count == 0)
                    {
                        <div class="p-5 text-center text-muted">
                            <i class="ph ph-clock-counter-clockwise icon-xl mb-2 d-block"></i>
                            <p class="mb-1">No audit log entries found.</p>
                            <p class="small mb-0">
                                This is expected on a fresh instance: the log records configuration
                                <strong>import and export</strong> operations only — nothing else writes to it.
                                Perform an import or export and it will appear here.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Timestamp</th>
                                        <th>Operation</th>
                                        <th>Entity</th>
                                        <th>Result</th>
                                        <th>Performed By</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model.AuditLogs)
                                    {
                                        var isSelected = Model.DetailId == log.Id;
                                        <tr class="@(isSelected ? "table-active" : "")">
                                            <td>
                                                <small>@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</small>
                                            </td>
                                            <td>
                                                @if (log.Operation == "Export")
                                                {
                                                    <span class="badge bg-info">
                                                        <i class="ph ph-box-arrow-up me-1"></i>Export
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="ph ph-box-arrow-in-down me-1"></i>Import
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <span class="text-muted small">@log.EntityType</span><br />
                                                <code class="small">@log.EntityIdentifier</code>
                                            </td>
                                            <td>
                                                @if (log.Result == "Success")
                                                {
                                                    <span class="badge bg-success">Success</span>
                                                }
                                                else if (log.Result == "Failed")
                                                {
                                                    <span class="badge bg-danger">Failed</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">@log.Result</span>
                                                }
                                            </td>
                                            <td>
                                                <small>@log.PerformedBy</small>
                                            </td>
                                            <td>
                                                <a asp-page="Index"
                                                   asp-route-DetailId="@log.Id"
                                                   asp-route-Page="@Model.CurrentPage"
                                                   asp-route-PageSize="@Model.PageSize"
                                                   asp-route-OperationFilter="@Model.OperationFilter"
                                                   asp-route-EntityTypeFilter="@Model.EntityTypeFilter"
                                                   asp-route-ActorFilter="@Model.ActorFilter"
                                                   asp-route-FromDate="@Model.FromDate"
                                                   asp-route-ToDate="@Model.ToDate"
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="ph ph-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer">
                        <nav aria-label="Audit log pagination">
                            <ul class="pagination justify-content-center mb-0">
                                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link" asp-page="Index"
                                       asp-route-Page="@(Model.CurrentPage - 1)"
                                       asp-route-PageSize="@Model.PageSize"
                                       asp-route-OperationFilter="@Model.OperationFilter"
                                       asp-route-EntityTypeFilter="@Model.EntityTypeFilter"
                                       asp-route-ActorFilter="@Model.ActorFilter"
                                       asp-route-FromDate="@Model.FromDate"
                                       asp-route-ToDate="@Model.ToDate">
                                        Previous
                                    </a>
                                </li>
                                @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" asp-page="Index"
                                           asp-route-Page="@i"
                                           asp-route-PageSize="@Model.PageSize"
                                           asp-route-OperationFilter="@Model.OperationFilter"
                                           asp-route-EntityTypeFilter="@Model.EntityTypeFilter"
                                           asp-route-ActorFilter="@Model.ActorFilter"
                                           asp-route-FromDate="@Model.FromDate"
                                           asp-route-ToDate="@Model.ToDate">
                                            @i
                                        </a>
                                    </li>
                                }
                                <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link" asp-page="Index"
                                       asp-route-Page="@(Model.CurrentPage + 1)"
                                       asp-route-PageSize="@Model.PageSize"
                                       asp-route-OperationFilter="@Model.OperationFilter"
                                       asp-route-EntityTypeFilter="@Model.EntityTypeFilter"
                                       asp-route-ActorFilter="@Model.ActorFilter"
                                       asp-route-FromDate="@Model.FromDate"
                                       asp-route-ToDate="@Model.ToDate">
                                        Next
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>

        <!-- Detail Panel -->
        @if (Model.SelectedAuditLog != null)
        {
            var log = Model.SelectedAuditLog;
            <div class="col-lg-5">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>Audit Log Details</span>
                        <a asp-page="Index"
                           asp-route-Page="@Model.CurrentPage"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-OperationFilter="@Model.OperationFilter"
                           asp-route-EntityTypeFilter="@Model.EntityTypeFilter"
                           asp-route-ActorFilter="@Model.ActorFilter"
                           asp-route-FromDate="@Model.FromDate"
                           asp-route-ToDate="@Model.ToDate"
                           class="btn btn-sm btn-outline-secondary">
                            <i class="ph ph-x"></i>
                        </a>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">ID</dt>
                            <dd class="col-sm-8"><code class="small">@log.Id</code></dd>

                            <dt class="col-sm-4">Timestamp</dt>
                            <dd class="col-sm-8">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss.fff zzz")</dd>

                            <dt class="col-sm-4">Operation</dt>
                            <dd class="col-sm-8">
                                @if (log.Operation == "Export")
                                {
                                    <span class="badge bg-info">Export</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Import</span>
                                }
                            </dd>

                            <dt class="col-sm-4">Entity Type</dt>
                            <dd class="col-sm-8">@log.EntityType</dd>

                            <dt class="col-sm-4">Entity ID</dt>
                            <dd class="col-sm-8"><code>@log.EntityIdentifier</code></dd>

                            <dt class="col-sm-4">Export Mode</dt>
                            <dd class="col-sm-8">@log.ExportMode</dd>

                            <dt class="col-sm-4">Result</dt>
                            <dd class="col-sm-8">
                                @if (log.Result == "Success")
                                {
                                    <span class="badge bg-success">Success</span>
                                }
                                else if (log.Result == "Failed")
                                {
                                    <span class="badge bg-danger">Failed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@log.Result</span>
                                }
                            </dd>

                            @if (log.Operation == "Import")
                            {
                                <dt class="col-sm-4">Created</dt>
                                <dd class="col-sm-8">@(log.EntitiesCreated ?? 0)</dd>

                                <dt class="col-sm-4">Updated</dt>
                                <dd class="col-sm-8">@(log.EntitiesUpdated ?? 0)</dd>

                                <dt class="col-sm-4">Skipped</dt>
                                <dd class="col-sm-8">@(log.EntitiesSkipped ?? 0)</dd>
                            }

                            @if (!string.IsNullOrEmpty(log.ErrorDetails))
                            {
                                <dt class="col-sm-4">Error</dt>
                                <dd class="col-sm-8">
                                    <div class="alert alert-danger mb-0 py-1 px-2 small">
                                        @log.ErrorDetails
                                    </div>
                                </dd>
                            }

                            @if (!string.IsNullOrEmpty(log.ManifestChecksum))
                            {
                                <dt class="col-sm-4">Checksum</dt>
                                <dd class="col-sm-8"><code class="small text-break">@log.ManifestChecksum</code></dd>
                            }

                            <dt class="col-sm-4">Performed By</dt>
                            <dd class="col-sm-8">@log.PerformedBy</dd>

                            @if (!string.IsNullOrEmpty(log.IpAddress))
                            {
                                <dt class="col-sm-4">IP Address</dt>
                                <dd class="col-sm-8"><code>@log.IpAddress</code></dd>
                            }

                            @if (!string.IsNullOrEmpty(log.UserAgent))
                            {
                                <dt class="col-sm-4">User Agent</dt>
                                <dd class="col-sm-8"><small class="text-break">@log.UserAgent</small></dd>
                            }
                        </dl>
                    </div>
                </div>
            </div>
        }
    </div>
</div>


