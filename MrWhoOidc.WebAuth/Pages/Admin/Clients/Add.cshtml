@page "/admin/clients/add"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Admin.Clients.AddModel
@{
    ViewData["Title"] = "Add client";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Enabled
        ? $"/t/{currentTenant.Slug}"
        : string.Empty;
    var clientsIndexPath = string.IsNullOrEmpty(tenantPrefix)
        ? "/admin/clients"
        : $"{tenantPrefix}/admin/clients";
}

<h1>Add client</h1>

<form method="post" autocomplete="off">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Input.ClientId" class="form-label"></label>
            <div class="input-group">
                <input asp-for="Input.ClientId" class="form-control" autocomplete="off" />
                <button type="submit" asp-page-handler="Generate" class="btn btn-outline-secondary" title="Generate client ID" formnovalidate>Generate</button>
            </div>
            <span asp-validation-for="Input.ClientId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.ClientName" class="form-label"></label>
            <input asp-for="Input.ClientName" class="form-control" autocomplete="off" />
            <span asp-validation-for="Input.ClientName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.RealmId" class="form-label"></label>
            <select asp-for="Input.RealmId" asp-items="Model.RealmOptions" class="form-select"></select>
            <span asp-validation-for="Input.RealmId" class="text-danger"></span>
        </div>
        <div class="col-md-3 form-check mt-4">
            <input asp-for="Input.RequirePkce" class="form-check-input" />
            <label asp-for="Input.RequirePkce" class="form-check-label"></label>
        </div>
        <div class="col-md-3 form-check mt-4">
            <input asp-for="Input.RequireConsent" class="form-check-input" />
            <label asp-for="Input.RequireConsent" class="form-check-label"></label>
        </div>
        <div class="col-md-6 form-check mt-4">
            <input asp-for="Input.AutoAssignNewUsersToClient" class="form-check-input" />
            <label asp-for="Input.AutoAssignNewUsersToClient" class="form-check-label"></label>
        </div>
        <div class="col-12">
            <label asp-for="Input.ClientSecret" class="form-label"></label>
            <div class="input-group">
                <input asp-for="Input.ClientSecret" type="password" class="form-control" autocomplete="new-password" />
                <button type="button" id="btn-generate-secret" class="btn btn-outline-secondary" title="Generate client secret">Generate</button>
                <button type="button" id="btn-reveal-secret" class="btn btn-outline-secondary" title="Show secret" disabled>
                    <i class="ph ph-eye"></i>
                </button>
                <button type="button" id="btn-copy-secret" class="btn btn-outline-secondary" title="Copy to clipboard" disabled>Copy</button>
            </div>
            <small class="form-text text-muted">Leave empty for public client</small>
            <span asp-validation-for="Input.ClientSecret" class="text-danger"></span>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <i class="ph ph-lock me-2"></i>OIDC JWT response crypto (optional)
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12 small text-muted">
                            Tenant active signing alg: <code>@Model.ActiveSigningAlg</code>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.IdTokenSignedResponseAlg" class="form-label"></label>
                            <select asp-for="Input.IdTokenSignedResponseAlg" class="form-select">
                                <option value="">Default (tenant active signing alg)</option>
                                <option value="@Model.ActiveSigningAlg">@Model.ActiveSigningAlg</option>
                            </select>
                            <small class="form-text text-muted">When set, client expresses preferred ID token signing alg. Must match tenant active signing alg.</small>
                            <span asp-validation-for="Input.IdTokenSignedResponseAlg" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.PublicJwksUri" class="form-label"></label>
                            <input asp-for="Input.PublicJwksUri" class="form-control" placeholder="https://client.example.com/jwks.json" />
                            <small class="form-text text-muted">Used for encrypted ID tokens and encrypted UserInfo JWT responses.</small>
                            <span asp-validation-for="Input.PublicJwksUri" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.UserInfoSignedResponseAlg" class="form-label"></label>
                            <select asp-for="Input.UserInfoSignedResponseAlg" class="form-select">
                                <option value="">Default (JSON)</option>
                                <option value="@Model.ActiveSigningAlg">@Model.ActiveSigningAlg</option>
                            </select>
                            <small class="form-text text-muted">When set, the server returns a signed UserInfo JWT (application/jwt).</small>
                            <span asp-validation-for="Input.UserInfoSignedResponseAlg" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.IdTokenSignedResponseAlg" class="form-label"></label>
                            <select asp-for="Input.IdTokenSignedResponseAlg" class="form-select">
                                <option value="">Default (tenant active signing alg)</option>
                                <option value="@Model.ActiveSigningAlg">@Model.ActiveSigningAlg</option>
                            </select>
                            <small class="form-text text-muted">When set, the server enforces this alg for ID tokens. Must match tenant active signing alg.</small>
                            <span asp-validation-for="Input.IdTokenSignedResponseAlg" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.AuthorizationSignedResponseAlg" class="form-label"></label>
                            <select asp-for="Input.AuthorizationSignedResponseAlg" class="form-select">
                                <option value="">Default (JARM signing enabled by response_mode)</option>
                                <option value="@Model.ActiveSigningAlg">@Model.ActiveSigningAlg</option>
                            </select>
                            <small class="form-text text-muted">When set, the server uses this alg for signed JARM responses. Must match tenant active signing alg.</small>
                            <span asp-validation-for="Input.AuthorizationSignedResponseAlg" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Input.PublicJwksJson" class="form-label"></label>
                            <textarea asp-for="Input.PublicJwksJson" class="form-control" rows="6" placeholder='{"keys":[{...}]}'></textarea>
                            <small class="form-text text-muted">Optional alternative to JWKS URI.</small>
                            <span asp-validation-for="Input.PublicJwksJson" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">ID token encryption (JWE)</div>
                                <div class="card-body">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label asp-for="Input.IdTokenEncryptedResponseAlg" class="form-label"></label>
                                            <select asp-for="Input.IdTokenEncryptedResponseAlg" class="form-select">
                                                <option value="">Not encrypted</option>
                                                <option value="RSA-OAEP">RSA-OAEP</option>
                                            </select>
                                            <span asp-validation-for="Input.IdTokenEncryptedResponseAlg" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="Input.IdTokenEncryptedResponseEnc" class="form-label"></label>
                                            <select asp-for="Input.IdTokenEncryptedResponseEnc" class="form-select">
                                                <option value="">(none)</option>
                                                <option value="A256CBC-HS512">A256CBC-HS512</option>
                                            </select>
                                            <span asp-validation-for="Input.IdTokenEncryptedResponseEnc" class="text-danger"></span>
                                        </div>
                                        <div class="col-12 form-text">
                                            Requires a client public JWKS (JSON or URI).
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">UserInfo encryption (nested JWT)</div>
                                <div class="card-body">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label asp-for="Input.UserInfoEncryptedResponseAlg" class="form-label"></label>
                                            <select asp-for="Input.UserInfoEncryptedResponseAlg" class="form-select">
                                                <option value="">Not encrypted</option>
                                                <option value="RSA-OAEP">RSA-OAEP</option>
                                            </select>
                                            <span asp-validation-for="Input.UserInfoEncryptedResponseAlg" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="Input.UserInfoEncryptedResponseEnc" class="form-label"></label>
                                            <select asp-for="Input.UserInfoEncryptedResponseEnc" class="form-select">
                                                <option value="">(none)</option>
                                                <option value="A256CBC-HS512">A256CBC-HS512</option>
                                            </select>
                                            <span asp-validation-for="Input.UserInfoEncryptedResponseEnc" class="text-danger"></span>
                                        </div>
                                        <div class="col-12 form-text">
                                            If set, the server returns a signed+encrypted UserInfo JWT and requires a client public JWKS.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">Authorization response encryption (JARM JWE)</div>
                                <div class="card-body">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label asp-for="Input.AuthorizationEncryptedResponseAlg" class="form-label"></label>
                                            <select asp-for="Input.AuthorizationEncryptedResponseAlg" class="form-select">
                                                <option value="">Not encrypted</option>
                                                <option value="RSA-OAEP">RSA-OAEP</option>
                                            </select>
                                            <span asp-validation-for="Input.AuthorizationEncryptedResponseAlg" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="Input.AuthorizationEncryptedResponseEnc" class="form-label"></label>
                                            <select asp-for="Input.AuthorizationEncryptedResponseEnc" class="form-select">
                                                <option value="">(none)</option>
                                                <option value="A256CBC-HS512">A256CBC-HS512</option>
                                            </select>
                                            <span asp-validation-for="Input.AuthorizationEncryptedResponseEnc" class="text-danger"></span>
                                        </div>
                                        <div class="col-12 form-text">
                                            If set, the server returns an encrypted JARM response (JWE) and requires a client public JWKS.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary" asp-page-handler="Create">Create</button>
        <a href="@clientsIndexPath" class="btn btn-secondary">Back</a>
    </div>
</form>

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
    <script nonce="@(HttpContext.Items["csp-nonce"] as string ?? string.Empty)">
        (function(){
            function toBase64Url(bytes) {
                let binary = '';
                const len = bytes.byteLength;
                for (let i = 0; i < len; i++) {
                    binary += String.fromCharCode(bytes[i]);
                }
                let base64 = btoa(binary);
                base64 = base64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
                return base64;
            }
            function updateSecretButtons(input, copyBtn, revealBtn){
                const hasValue = !!(input && input.value);
                if(copyBtn) copyBtn.disabled = !hasValue;
                if(revealBtn) revealBtn.disabled = !hasValue;
            }
            document.addEventListener('DOMContentLoaded', function(){
                const input = document.getElementById('Input_ClientSecret');
                const genBtn = document.getElementById('btn-generate-secret');
                const copyBtn = document.getElementById('btn-copy-secret');
                const revealBtn = document.getElementById('btn-reveal-secret');

                if (genBtn){
                    genBtn.addEventListener('click', function(e){
                        e.preventDefault();
                        if(!input) return;
                        const bytes = new Uint8Array(48); // strong secret
                        window.crypto.getRandomValues(bytes);
                        const secret = toBase64Url(bytes);
                        input.value = secret;
                        const span = document.querySelector('span[data-valmsg-for="Input.ClientSecret"]');
                        if (span) { span.textContent = ''; }
                        // ensure hidden by default
                        input.setAttribute('type', 'password');
                        if (revealBtn){
                            revealBtn.title = 'Show secret';
                            const icon = revealBtn.querySelector('i');
                            if (icon){ icon.className = 'ph ph-eye'; }
                        }
                        updateSecretButtons(input, copyBtn, revealBtn);
                    });
                }

                if (revealBtn && input){
                    revealBtn.addEventListener('click', function(e){
                        e.preventDefault();
                        const currentType = input.getAttribute('type') || 'text';
                        if (currentType.toLowerCase() === 'password'){
                            input.setAttribute('type', 'text');
                            revealBtn.title = 'Hide secret';
                            const icon = revealBtn.querySelector('i');
                            if (icon){ icon.className = 'ph ph-eye-slash'; }
                        } else {
                            input.setAttribute('type', 'password');
                            revealBtn.title = 'Show secret';
                            const icon = revealBtn.querySelector('i');
                            if (icon){ icon.className = 'ph ph-eye'; }
                        }
                    });
                }

                if (copyBtn && input){
                    copyBtn.addEventListener('click', async function(e){
                        e.preventDefault();
                        if(!input.value) return;
                        try{
                            if (navigator.clipboard && navigator.clipboard.writeText){
                                await navigator.clipboard.writeText(input.value);
                            } else {
                                input.select();
                                document.execCommand('copy');
                                input.setSelectionRange(input.value.length, input.value.length); // move caret to end
                            }
                            const original = copyBtn.textContent;
                            copyBtn.textContent = 'Copied!';
                            copyBtn.classList.add('btn-success');
                            setTimeout(()=>{
                                copyBtn.textContent = original;
                                copyBtn.classList.remove('btn-success');
                            }, 1000);
                        }catch{
                            const original = copyBtn.textContent;
                            copyBtn.textContent = 'Failed';
                            copyBtn.classList.add('btn-danger');
                            setTimeout(()=>{
                                copyBtn.textContent = original;
                                copyBtn.classList.remove('btn-danger');
                            }, 1200);
                        }
                    });
                }

                if (input){
                    input.addEventListener('input', function(){
                        updateSecretButtons(input, copyBtn, revealBtn);
                    });
                    updateSecretButtons(input, copyBtn, revealBtn);
                }
            });
        })();
    </script>
}
