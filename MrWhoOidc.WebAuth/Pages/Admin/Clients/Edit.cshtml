@page "{id:guid}"
@model MrWhoOidc.WebAuth.Pages.Admin.Clients.EditModel
@{
    ViewData["Title"] = "Edit client";
}

<h1>Edit client</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Input.ClientId" class="form-label"></label>
            <input asp-for="Input.ClientId" class="form-control" />
            <span asp-validation-for="Input.ClientId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.ClientName" class="form-label"></label>
            <input asp-for="Input.ClientName" class="form-control" />
            <span asp-validation-for="Input.ClientName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.RealmId" class="form-label"></label>
            <select asp-for="Input.RealmId" asp-items="Model.RealmOptions" class="form-select"></select>
            <span asp-validation-for="Input.RealmId" class="text-danger"></span>
        </div>
        <div class="col-md-3 form-check mt-4">
            <input asp-for="Input.RequirePkce" class="form-check-input" />
            <label asp-for="Input.RequirePkce" class="form-check-label"></label>
        </div>
        <div class="col-md-3 form-check mt-4">
            <input asp-for="Input.RequireConsent" class="form-check-input" />
            <label asp-for="Input.RequireConsent" class="form-check-label"></label>
        </div>
        <div class="col-12">
            <label asp-for="Input.ClientSecret" class="form-label"></label>
            <div class="input-group">
                <input asp-for="Input.ClientSecret" class="form-control" />
                <button type="button" id="btn-generate-secret" class="btn btn-outline-secondary" title="Generate client secret">Generate</button>
            </div>
            <small class="form-text text-muted">Set to rotate/change secret; leave blank to keep current</small>
            <span asp-validation-for="Input.ClientSecret" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Input.PublicJwksUri" class="form-label"></label>
            <div class="input-group">
                <input asp-for="Input.PublicJwksUri" class="form-control" placeholder="https://client.example.com/jwks.json" />
                <button type="submit" class="btn btn-outline-secondary" asp-page-handler="FetchJwks">Fetch</button>
            </div>
            <small class="form-text text-muted">Optional URI for client's JWKS. Click Fetch to load into JSON field.</small>
            <span asp-validation-for="Input.PublicJwksUri" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Input.PublicJwksJson" class="form-label"></label>
            <textarea asp-for="Input.PublicJwksJson" class="form-control" rows="8" placeholder='{"keys":[{...}]}'></textarea>
            <small class="form-text text-muted">Paste a public JWK (single) or JWKS (keys array) used for private_key_jwt and JAR.</small>
            <span asp-validation-for="Input.PublicJwksJson" class="text-danger"></span>
        </div>
        @if (Model.KeyPreviews?.Count > 0)
        {
            <div class="col-12">
                <div class="card mb-3">
                    <div class="card-header">JWKS preview</div>
                    <div class="card-body">
                        <ul class="list-unstyled">
                            @foreach (var k in Model.KeyPreviews)
                            {
                                <li>
                                    <code>@k.Kid</code> — @k.Kty @k.Alg @(" ") @k.Details
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }
        <div class="col-12">
            <label asp-for="Input.IntrospectionAudiences" class="form-label"></label>
            <input asp-for="Input.IntrospectionAudiences" class="form-control" placeholder="api1, https://api.example.com" />
            <small class="form-text text-muted">Comma-separated audience allow-list for this client's introspection calls. Leave empty to use global config.</small>
            <span asp-validation-for="Input.IntrospectionAudiences" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Input.TestJwt" class="form-label"></label>
            <textarea asp-for="Input.TestJwt" class="form-control" rows="4" placeholder="Paste a signed JWT to validate its signature against the JWKS"></textarea>
            <div class="mt-2">
                <button type="submit" class="btn btn-outline-primary" asp-page-handler="ValidateJwt">Validate JWT Signature</button>
            </div>
            @if (Model.JwtTest is not null)
            {
                <div class="alert @(Model.JwtTest.Ok ? "alert-success" : "alert-danger") mt-2">
                    <strong>@Model.JwtTest.Message</strong>
                    <div class="small text-muted">
                        alg: @Model.JwtTest.HeaderAlg; kid: @Model.JwtTest.HeaderKid; iss: @Model.JwtTest.Iss; sub: @Model.JwtTest.Sub
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-page="Index" class="btn btn-secondary">Back</a>
    </div>
</form>

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
    <script>
        (function(){
            function toBase64Url(bytes) {
                let binary = '';
                const len = bytes.byteLength;
                for (let i = 0; i < len; i++) {
                    binary += String.fromCharCode(bytes[i]);
                }
                let base64 = btoa(binary);
                base64 = base64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
                return base64;
            }
            const btnSecret = document.getElementById('btn-generate-secret');
            if(btnSecret){
                btnSecret.addEventListener('click', function(){
                    const input = document.getElementById('Input_ClientSecret');
                    if(!input) return;
                    const bytes = new Uint8Array(48); // strong secret
                    window.crypto.getRandomValues(bytes);
                    const secret = toBase64Url(bytes);
                    input.value = secret;
                    const span = document.querySelector('span[data-valmsg-for="Input.ClientSecret"]');
                    if (span) { span.textContent = ''; }
                });
            }
        })();
    </script>
}
