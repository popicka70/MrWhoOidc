@page "{id:guid}"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@using MrWhoOidc.Auth.Persistence
@model MrWhoOidc.WebAuth.Pages.Admin.Clients.EditModel
@{
    ViewData["Title"] = "Edit client";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Enabled 
        ? $"/t/{currentTenant.Slug}" 
        : "";
    var clientsIndexPath = string.IsNullOrEmpty(tenantPrefix)
        ? "/admin/clients"
        : $"{tenantPrefix}/admin/clients";
}

<h1>Edit client</h1>

<form method="post" autocomplete="off">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <ul class="nav nav-tabs" id="clientTab" role="tablist" data-active-tab="@Model.ActiveTab">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#tab-general" type="button" role="tab" aria-controls="tab-general" aria-selected="true">
                <i class="ph ph-gear me-1"></i> General
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="redirect-uris-tab" data-bs-toggle="tab" data-bs-target="#tab-redirect-uris" type="button" role="tab" aria-controls="tab-redirect-uris" aria-selected="false">
                <i class="ph ph-arrows-left-right me-1"></i> Redirect URIs
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="providers-tab" data-bs-toggle="tab" data-bs-target="#tab-providers" type="button" role="tab" aria-controls="tab-providers" aria-selected="false">
                <i class="ph ph-users me-1"></i> Providers
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="scopes-tab" data-bs-toggle="tab" data-bs-target="#tab-scopes" type="button" role="tab" aria-controls="tab-scopes" aria-selected="false">
                <i class="ph ph-tag me-1"></i> Scopes
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="keys-tab" data-bs-toggle="tab" data-bs-target="#tab-keys" type="button" role="tab" aria-controls="tab-keys" aria-selected="false">
                <i class="ph ph-key me-1"></i> Keys
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="secrets-tab" data-bs-toggle="tab" data-bs-target="#tab-secrets" type="button" role="tab" aria-controls="tab-secrets" aria-selected="false">
                <i class="ph ph-shield me-1"></i> Secrets
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="introspection-tab" data-bs-toggle="tab" data-bs-target="#tab-introspection" type="button" role="tab" aria-controls="tab-introspection" aria-selected="false">
                <i class="ph ph-search me-1"></i> Introspection
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="m2m-tab" data-bs-toggle="tab" data-bs-target="#tab-m2m" type="button" role="tab" aria-controls="tab-m2m" aria-selected="false">
                <i class="ph ph-cpu me-1"></i> M2M
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="obo-tab" data-bs-toggle="tab" data-bs-target="#tab-obo" type="button" role="tab" aria-controls="tab-obo" aria-selected="false">
                <i class="ph ph-user-gear me-1"></i> OBO
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="users-tab" data-bs-toggle="tab" data-bs-target="#tab-users" type="button" role="tab" aria-controls="tab-users" aria-selected="false">
                <i class="ph-fill ph-users me-1"></i> Users
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tools-tab" data-bs-toggle="tab" data-bs-target="#tab-tools" type="button" role="tab" aria-controls="tab-tools" aria-selected="false">
                <i class="ph ph-tools me-1"></i> Tools
            </button>
        </li>
    </ul>

    <div class="tab-content border-start border-end border-bottom p-3" id="clientTabContent">
        <div class="tab-pane fade show active" id="tab-general" role="tabpanel" aria-labelledby="general-tab" tabindex="0">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.ClientId" class="form-label"></label>
                    <input asp-for="Input.ClientId" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Input.ClientId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.ClientName" class="form-label"></label>
                    <input asp-for="Input.ClientName" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Input.ClientName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.RealmId" class="form-label"></label>
                    <select asp-for="Input.RealmId" asp-items="Model.RealmOptions" class="form-select"></select>
                    <span asp-validation-for="Input.RealmId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="Input_LoginStyleKey">Login style scheme</label>
                    <select class="form-select" id="Input_LoginStyleKey" name="Input.LoginStyleKey">
                        <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Input.LoginStyleKey) ? "selected" : null)">Default</option>
                        <option value="classic" selected="@((Model.Input.LoginStyleKey?.Equals("classic", StringComparison.OrdinalIgnoreCase) ?? false) ? "selected" : null)">Classic</option>
                        <option value="ocean" selected="@((Model.Input.LoginStyleKey?.Equals("ocean", StringComparison.OrdinalIgnoreCase) ?? false) ? "selected" : null)">Ocean (info)</option>
                        <option value="forest" selected="@((Model.Input.LoginStyleKey?.Equals("forest", StringComparison.OrdinalIgnoreCase) ?? false) ? "selected" : null)">Forest (success)</option>
                        <option value="plum" selected="@((Model.Input.LoginStyleKey?.Equals("plum", StringComparison.OrdinalIgnoreCase) ?? false) ? "selected" : null)">Plum</option>
                        <option value="contrast" selected="@((Model.Input.LoginStyleKey?.Equals("contrast", StringComparison.OrdinalIgnoreCase) ?? false) ? "selected" : null)">High contrast</option>
                    </select>
                    <small class="form-text text-muted">Overrides page style for login/provider selection screens.</small>
                </div>
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <i class="ph-fill ph-gear me-2"></i>Client Settings
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-4 form-check">
                                    <input asp-for="Input.RequirePkce" class="form-check-input" />
                                    <label asp-for="Input.RequirePkce" class="form-check-label"></label>
                                </div>
                                <div class="col-md-4 form-check">
                                    <input asp-for="Input.RequireConsent" class="form-check-input" />
                                    <label asp-for="Input.RequireConsent" class="form-check-label"></label>
                                </div>
                                <div class="col-md-4 form-check">
                                    <input asp-for="Input.RequirePar" class="form-check-input" />
                                    <label asp-for="Input.RequirePar" class="form-check-label">Require PAR for this client</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <i class="ph ph-fingerprint me-2"></i>OIDC Subject Identifiers
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label asp-for="Input.SubjectType" class="form-label"></label>
                                    <select asp-for="Input.SubjectType" class="form-select">
                                        <option value="public">Public</option>
                                        <option value="pairwise">Pairwise</option>
                                    </select>
                                    <span asp-validation-for="Input.SubjectType" class="text-danger"></span>
                                    <div class="form-text">Controls whether the OIDC <code>sub</code> is public or pairwise for this client.</div>
                                </div>
                                <div class="col-md-8">
                                    <label asp-for="Input.SectorIdentifierUri" class="form-label"></label>
                                    <input asp-for="Input.SectorIdentifierUri" class="form-control" autocomplete="off" />
                                    <span asp-validation-for="Input.SectorIdentifierUri" class="text-danger"></span>
                                    <div class="form-text">Optional. Used for pairwise sector resolution when configured.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <i class="ph ph-door-open me-2"></i>Login methods
                        </div>
                        <div class="card-body row g-3">
                            <div class="col-md-4 form-check">
                                <input asp-for="Input.AllowLocalLogin" class="form-check-input" />
                                <label asp-for="Input.AllowLocalLogin" class="form-check-label"></label>
                            </div>
                            <div class="col-md-4 form-check">
                                <input asp-for="Input.AllowExternalIdp" class="form-check-input" />
                                <label asp-for="Input.AllowExternalIdp" class="form-check-label"></label>
                            </div>
                            <div class="col-md-4 form-check">
                                <input asp-for="Input.AllowQrLogin" class="form-check-input" />
                                <label asp-for="Input.AllowQrLogin" class="form-check-label"></label>
                            </div>
                            <div class="col-12 small text-muted">
                                Use these toggles to control which login options are shown/enforced for this client.
                            </div>
                            <div class="col-12">
                                <div class="alert alert-info small mb-0" role="alert">
                                    <i class="ph ph-info me-1"></i>
                                    <strong>IdP Chaining:</strong> If this client represents an upstream IdP in a chaining scenario, enable the login methods you want available when users are redirected here from that upstream IdP. 
                                    See <a href="/docs/idp-chaining-client-configuration.md" target="_blank" class="alert-link">IdP Chaining Configuration Guide</a> for details.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <i class="ph ph-person-check me-2"></i>User Registration Auto-Approval
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label asp-for="Input.AutoApprovalMode" class="form-label"></label>
                                <select asp-for="Input.AutoApprovalMode" class="form-select" asp-items="Html.GetEnumSelectList<AutoApprovalMode>()"></select>
                                <div class="form-text">
                                    <strong>No:</strong> All new registrations require manual admin approval (default).<br />
                                    <strong>OnlyExternalIdp:</strong> Auto-approve registrations from external identity providers only.<br />
                                    <strong>All:</strong> Auto-approve all new registrations regardless of source.<br />
                                    Federation clients that this tenant uses as an upstream external OIDC provider should typically use <strong>All</strong>,
                                    otherwise first-time locally authenticated upstream users can hit <strong>access_denied</strong> before the external callback returns.
                                </div>
                                <span asp-validation-for="Input.AutoApprovalMode" class="text-danger"></span>
                            </div>

                            <div class="form-check">
                                <input asp-for="Input.AutoAssignNewUsersToClient" class="form-check-input" />
                                <label asp-for="Input.AutoAssignNewUsersToClient" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <label asp-for="Input.ClientSecret" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="Input.ClientSecret" type="password" class="form-control" autocomplete="new-password" />
                        <button type="button" id="btn-generate-secret" class="btn btn-outline-secondary" title="Generate client secret">Generate</button>
                        <button type="button" id="btn-reveal-secret" class="btn btn-outline-secondary" title="Show secret" disabled>
                            <i class="ph ph-eye"></i>
                        </button>
                        <button type="button" id="btn-copy-secret" class="btn btn-outline-secondary" title="Copy to clipboard" disabled>Copy</button>
                    </div>
                    <small class="form-text text-muted">Set to rotate/change secret; leave blank to keep current</small>
                    <span asp-validation-for="Input.ClientSecret" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-redirect-uris" role="tabpanel" aria-labelledby="redirect-uris-tab" tabindex="0">
            <div class="row g-4">
                <div class="col-12">
                    <div class="alert alert-info">
                        <i class="ph ph-info me-2"></i>
                        <strong>Note:</strong> Enter one URL per line. These URLs must match exactly during the OAuth2/OIDC flow.
                    </div>
                </div>
                <div class="col-12">
                    <label asp-for="Input.AllowedLoginRedirectUris" class="form-label">
                        <i class="ph ph-arrow-right-circle me-1"></i>
                        Allowed Login Redirect URIs
                    </label>
                    <textarea asp-for="Input.AllowedLoginRedirectUris" class="form-control" rows="6" 
                              placeholder="https://app.example.com/signin-oidc&#10;https://app2.example.com/callback&#10;https://localhost:5001/signin-oidc"
                              style="font-family: 'Courier New', monospace; font-size: 0.9rem;"></textarea>
                    <small class="form-text text-muted">
                        <strong>One URL per line.</strong> These absolute URLs are accepted as <code>redirect_uri</code> during login/authorization flow.
                    </small>
                    <span asp-validation-for="Input.AllowedLoginRedirectUris" class="text-danger d-block mt-1"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.AllowedLogoutRedirectUris" class="form-label">
                        <i class="ph ph-arrow-left-circle me-1"></i>
                        Allowed Logout Redirect URIs
                    </label>
                    <textarea asp-for="Input.AllowedLogoutRedirectUris" class="form-control" rows="6" 
                              placeholder="https://app.example.com/signout-callback-oidc&#10;https://app2.example.com/logout-callback&#10;https://localhost:5001/signout-callback-oidc"
                              style="font-family: 'Courier New', monospace; font-size: 0.9rem;"></textarea>
                    <small class="form-text text-muted">
                        <strong>One URL per line.</strong> These absolute URLs are accepted as <code>post_logout_redirect_uri</code> during logout flow.
                    </small>
                    <span asp-validation-for="Input.AllowedLogoutRedirectUris" class="text-danger d-block mt-1"></span>
                </div>
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <i class="ph ph-lightbulb me-2"></i>Tips
                        </div>
                        <div class="card-body">
                            <ul class="mb-0">
                                <li>URLs must be <strong>absolute</strong> and use <code>https://</code> (or <code>http://localhost</code> for development)</li>
                                <li>Wildcards are <strong>not supported</strong> - each URL must be listed explicitly</li>
                                <li>The redirect URIs are case-sensitive</li>
                                <li>Query parameters in URIs are typically not recommended</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-providers" role="tabpanel" aria-labelledby="providers-tab" tabindex="0">
            <div class="row g-3">
                <div class="col-12">
                    <div class="card mb-3">
                        <div class="card-header bg-info text-white">
                            <i class="ph ph-link me-2"></i>IdP Chaining
                        </div>
                        <div class="card-body">
                            <p class="mb-3">
                                <i class="ph ph-info me-1"></i>
                                When configuring an upstream IdP to chain into this instance, use the issuer URL below as the <strong>issuer</strong> (or authority) of this identity provider.
                                The upstream IdP will discover all endpoints automatically via the <a href="@Model.IdpChainingIssuerUrl/.well-known/openid-configuration" target="_blank" rel="noopener">OpenID Connect discovery document</a>.
                            </p>
                            <div class="col-12">
                                <label class="form-label fw-bold">
                                    <i class="ph ph-globe me-1"></i>Issuer URL
                                </label>
                                <div class="input-group">
                                    <input type="text" class="form-control font-monospace" readonly value="@Model.IdpChainingIssuerUrl" id="idp-issuer-url" />
                                    <button type="button" id="idp-copy-btn" class="btn btn-outline-secondary" data-copy-text="@Model.IdpChainingIssuerUrl" title="Copy to clipboard">
                                        <i class="ph ph-clipboard"></i> Copy
                                    </button>
                                </div>
                                <small class="form-text text-muted">Use this as the <code>issuer</code> / authority in your upstream IdP configuration.</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <h5>Add or update mapping</h5>
                    <div class="row g-2 align-items-end">
                        <div class="col-md-4">
                            <label asp-for="ProviderInput.IdentityProviderId" class="form-label">Provider</label>
                            <select asp-for="ProviderInput.IdentityProviderId" class="form-select" asp-items="Model.ProviderOptions"></select>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="ProviderInput.Order" class="form-label">Order</label>
                            <input asp-for="ProviderInput.Order" class="form-control" />
                        </div>
                        <div class="col-md-2 form-check">
                            <input asp-for="ProviderInput.Enabled" class="form-check-input" />
                            <label asp-for="ProviderInput.Enabled" class="form-check-label">Enabled</label>
                        </div>
                        <div class="col-md-2 form-check">
                            <input asp-for="ProviderInput.IsDefaultForClient" class="form-check-input" />
                            <label asp-for="ProviderInput.IsDefaultForClient" class="form-check-label">Default</label>
                        </div>
                        <div class="col-md-2 form-check">
                            <input asp-for="ProviderInput.AutoRedirectIfSingle" class="form-check-input" />
                            <label asp-for="ProviderInput.AutoRedirectIfSingle" class="form-check-label">Auto</label>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ProviderInput.RequiredAcr" class="form-label">Required ACR</label>
                            <input asp-for="ProviderInput.RequiredAcr" class="form-control" />
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-outline-primary" asp-page-handler="AddProvider" formnovalidate>Add / Update</button>
                            <a href="@(tenantPrefix)/admin/provider-mappings" class="btn btn-link">Open full mapping page</a>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <h5 class="mt-3">Current mappings</h5>
                    @if (Model.ProviderMappings.Count == 0)
                    {
                        <p>No mappings.</p>
                    }
                    else
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Provider</th>
                                    <th>Enabled</th>
                                    <th>Default</th>
                                    <th>Auto</th>
                                    <th>ACR</th>
                                    <th>Order</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var r in Model.ProviderMappings)
                            {
                                <tr>
                                    <td>@r.ProviderDisplay (@r.ProviderName)</td>
                                    <td>@(r.Enabled ? "Yes" : "No")</td>
                                    <td>@(r.IsDefaultForClient ? "Yes" : "No")</td>
                                    <td>@(r.AutoRedirectIfSingle ? "Yes" : "No")</td>
                                    <td>@r.RequiredAcr</td>
                                    <td>@r.Order</td>
                                    <td class="text-end">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" asp-page-handler="DeleteProvider" name="providerId" value="@r.IdentityProviderId" formnovalidate>Delete</button>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-scopes" role="tabpanel" aria-labelledby="scopes-tab" tabindex="0">
            <div class="row g-3">
                <div class="col-md-6">
                    <h5>Assigned scopes</h5>
                    
                    @if (Model.GlobalAssignedScopes.Any())
                    {
                        <h6 class="text-muted mt-3">
                            <i class="ph ph-globe me-1"></i> Global Scopes
                        </h6>
                        <table class="table table-sm align-middle">
                            <tbody>
                            @foreach (var s in Model.GlobalAssignedScopes)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary-emphasis me-1">Global</span>
                                        @s
                                    </td>
                                    <td class="text-end">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" asp-page-handler="RemoveScope" name="scopeName" value="@s" formnovalidate>Remove</button>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                    
                    @if (Model.TenantAssignedScopes.Any())
                    {
                        <h6 class="text-muted mt-3">
                            <i class="ph ph-buildings me-1"></i> Tenant Scopes
                        </h6>
                        <table class="table table-sm align-middle">
                            <tbody>
                            @foreach (var s in Model.TenantAssignedScopes)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-info-subtle text-info-emphasis me-1">Tenant</span>
                                        @s
                                    </td>
                                    <td class="text-end">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" asp-page-handler="RemoveScope" name="scopeName" value="@s" formnovalidate>Remove</button>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                    
                    @if (!Model.AssignedScopes.Any())
                    {
                        <p class="text-muted fst-italic">No scopes assigned yet.</p>
                    }
                </div>
                <div class="col-md-6">
                    <h5>Add scope</h5>
                    <div class="input-group mb-2">
                        <select asp-for="NewScope" class="form-select">
                            <option value="">-- select scope --</option>
                            @if (Model.GlobalAvailableScopes.Any())
                            {
                                <optgroup label="🌐 Global Scopes">
                                    @foreach (var s in Model.GlobalAvailableScopes)
                                    {
                                        <option value="@s.Name">@s.Name</option>
                                    }
                                </optgroup>
                            }
                            @if (Model.TenantAvailableScopes.Any())
                            {
                                <optgroup label="🏢 Tenant Scopes">
                                    @foreach (var s in Model.TenantAvailableScopes)
                                    {
                                        <option value="@s.Name">@s.Name</option>
                                    }
                                </optgroup>
                            }
                        </select>
                        <button type="submit" class="btn btn-outline-primary" asp-page-handler="AddScope" formnovalidate>Add</button>
                    </div>
                    <small class="form-text text-muted">
                        <strong>Global scopes</strong> are available to all tenants (e.g., openid, profile, email).<br />
                        <strong>Tenant scopes</strong> are specific to your tenant (e.g., @(Model.CurrentTenantSlug).reports.read).
                    </small>
                    <span asp-validation-for="NewScope" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-keys" role="tabpanel" aria-labelledby="keys-tab" tabindex="0">
            <div class="d-flex justify-content-between align-items-center">
                <div></div>
                <div>
                    <a href="@(tenantPrefix)/admin/client-keys/@Model.Id" class="btn btn-sm btn-outline-secondary">Open dedicated keys page</a>
                </div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-12">
                    <label asp-for="Input.PublicJwksUri" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="Input.PublicJwksUri" class="form-control" placeholder="https://client.example.com/jwks.json" />
                        <button type="submit" class="btn btn-outline-secondary" asp-page-handler="FetchJwks" formnovalidate>Fetch</button>
                        <select asp-for="GenerateAlg" class="form-select" style="max-width: 180px;">
                            <option value="RS256">RS256</option>
                            <option value="ES256">ES256</option>
                            <option value="ES384">ES384</option>
                            <option value="ES512">ES512</option>
                        </select>
                        <button type="submit" class="btn btn-outline-success" asp-page-handler="GenerateJwks" formnovalidate>Generate JWKS</button>
                        <button type="submit" class="btn btn-outline-success" asp-page-handler="AddKey" formnovalidate>Add Key</button>
                    </div>
                    @if (Model.JwksStatus is not null)
                    {
                        <div class="mt-1 small">
                            <span class="badge @(Model.JwksStatus.Ok ? "bg-success" : "bg-danger")">@Model.JwksStatus.Message</span>
                            @if (Model.JwksStatus.Ok)
                            {
                                <span class="text-muted ms-2">keys: @Model.JwksStatus.KeyCount; unique kid: @Model.JwksStatus.UniqueKidCount</span>
                            }
                            @if (Model.JwksStatus.DuplicateKids?.Count > 0)
                            {
                                <span class="text-danger ms-2">duplicates: @string.Join(", ", Model.JwksStatus.DuplicateKids)</span>
                            }
                        </div>
                    }
                    <small class="form-text text-muted">Fetch from URI or manage JWKS below. Use Add Key to append another key.</small>
                    <span asp-validation-for="Input.PublicJwksUri" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.PublicJwksJson" class="form-label">
                        Public JWKS JSON
                        @if (Model.JwksStatus is not null)
                        {
                            <span class="badge @(Model.JwksStatus.Ok ? "bg-success" : "bg-danger") ms-2">@Model.JwksStatus.Summary</span>
                        }
                    </label>
                    <textarea asp-for="Input.PublicJwksJson" class="form-control" rows="8" placeholder='{"keys":[{...}]}'></textarea>
                    <small class="form-text text-muted">Public JWKS used for private_key_jwt and JAR.</small>
                    <span asp-validation-for="Input.PublicJwksJson" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <i class="ph ph-lock me-2"></i>OIDC JWT response crypto
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-12 small text-muted">
                                    Optional per-client settings for encrypted ID tokens and signed/encrypted UserInfo JWT responses.
                                    Tenant active signing alg: <code>@Model.ActiveSigningAlg</code>
                                </div>

                                <div class="col-md-6">
                                    <div class="card">
                                        <div class="card-header">ID token signing</div>
                                        <div class="card-body">
                                            <label asp-for="Input.IdTokenSignedResponseAlg" class="form-label"></label>
                                            <select asp-for="Input.IdTokenSignedResponseAlg" class="form-select">
                                                <option value="">Default (tenant active signing alg)</option>
                                                <option value="@Model.ActiveSigningAlg">@Model.ActiveSigningAlg</option>
                                            </select>
                                            <span asp-validation-for="Input.IdTokenSignedResponseAlg" class="text-danger"></span>
                                            <div class="form-text">When set, client expresses preferred ID token signing alg. Must match tenant active signing alg.</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="card">
                                        <div class="card-header">ID token encryption (JWE)</div>
                                        <div class="card-body">
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label asp-for="Input.IdTokenEncryptedResponseAlg" class="form-label"></label>
                                                    <select asp-for="Input.IdTokenEncryptedResponseAlg" class="form-select">
                                                        <option value="">Not encrypted</option>
                                                        <option value="RSA-OAEP">RSA-OAEP</option>
                                                    </select>
                                                    <span asp-validation-for="Input.IdTokenEncryptedResponseAlg" class="text-danger"></span>
                                                </div>
                                                <div class="col-md-6">
                                                    <label asp-for="Input.IdTokenEncryptedResponseEnc" class="form-label"></label>
                                                    <select asp-for="Input.IdTokenEncryptedResponseEnc" class="form-select">
                                                        <option value="">(none)</option>
                                                        <option value="A256CBC-HS512">A256CBC-HS512</option>
                                                    </select>
                                                    <span asp-validation-for="Input.IdTokenEncryptedResponseEnc" class="text-danger"></span>
                                                </div>
                                                <div class="col-12 form-text">
                                                    Requires a client public JWKS (JSON or URI).
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="card">
                                        <div class="card-header">UserInfo as JWT (application/jwt)</div>
                                        <div class="card-body">
                                            <div class="row g-3">
                                                <div class="col-12">
                                                    <label asp-for="Input.UserInfoSignedResponseAlg" class="form-label"></label>
                                                    <select asp-for="Input.UserInfoSignedResponseAlg" class="form-select">
                                                        <option value="">Default (JSON)</option>
                                                        <option value="@Model.ActiveSigningAlg">@Model.ActiveSigningAlg</option>
                                                    </select>
                                                    <span asp-validation-for="Input.UserInfoSignedResponseAlg" class="text-danger"></span>
                                                    <div class="form-text">When set, the server returns a signed UserInfo JWT (JWS). Must match tenant active signing alg.</div>
                                                </div>
                                                <div class="col-md-6">
                                                    <label asp-for="Input.UserInfoEncryptedResponseAlg" class="form-label"></label>
                                                    <select asp-for="Input.UserInfoEncryptedResponseAlg" class="form-select">
                                                        <option value="">Not encrypted</option>
                                                        <option value="RSA-OAEP">RSA-OAEP</option>
                                                    </select>
                                                    <span asp-validation-for="Input.UserInfoEncryptedResponseAlg" class="text-danger"></span>
                                                </div>
                                                <div class="col-md-6">
                                                    <label asp-for="Input.UserInfoEncryptedResponseEnc" class="form-label"></label>
                                                    <select asp-for="Input.UserInfoEncryptedResponseEnc" class="form-select">
                                                        <option value="">(none)</option>
                                                        <option value="A256CBC-HS512">A256CBC-HS512</option>
                                                    </select>
                                                    <span asp-validation-for="Input.UserInfoEncryptedResponseEnc" class="text-danger"></span>
                                                </div>
                                                <div class="col-12 form-text">
                                                    If encryption is set, the server returns a signed+encrypted UserInfo JWT (nested JWS inside JWE) and requires a client public JWKS.
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="card">
                                        <div class="card-header">Authorization response (JARM)</div>
                                        <div class="card-body">
                                            <div class="row g-3">
                                                <div class="col-12">
                                                    <label asp-for="Input.AuthorizationSignedResponseAlg" class="form-label"></label>
                                                    <select asp-for="Input.AuthorizationSignedResponseAlg" class="form-select">
                                                        <option value="">Default (tenant active signing alg)</option>
                                                        <option value="@Model.ActiveSigningAlg">@Model.ActiveSigningAlg</option>
                                                    </select>
                                                    <span asp-validation-for="Input.AuthorizationSignedResponseAlg" class="text-danger"></span>
                                                    <div class="form-text">When set, JARM responses are signed with this alg. Must match tenant active signing alg.</div>
                                                </div>
                                                <div class="col-md-6">
                                                    <label asp-for="Input.AuthorizationEncryptedResponseAlg" class="form-label"></label>
                                                    <select asp-for="Input.AuthorizationEncryptedResponseAlg" class="form-select">
                                                        <option value="">Not encrypted</option>
                                                        <option value="RSA-OAEP">RSA-OAEP</option>
                                                    </select>
                                                    <span asp-validation-for="Input.AuthorizationEncryptedResponseAlg" class="text-danger"></span>
                                                </div>
                                                <div class="col-md-6">
                                                    <label asp-for="Input.AuthorizationEncryptedResponseEnc" class="form-label"></label>
                                                    <select asp-for="Input.AuthorizationEncryptedResponseEnc" class="form-select">
                                                        <option value="">(none)</option>
                                                        <option value="A256CBC-HS512">A256CBC-HS512</option>
                                                    </select>
                                                    <span asp-validation-for="Input.AuthorizationEncryptedResponseEnc" class="text-danger"></span>
                                                </div>
                                                <div class="col-12 form-text">
                                                    If encryption is set, the server returns an encrypted JARM response (JWE) and requires a client public JWKS.
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <label asp-for="Input.PrivateJwk" class="form-label"></label>
                    <textarea asp-for="Input.PrivateJwk" class="form-control" rows="6" placeholder='Paste private JWK or JWKS; only public parts will be extracted'></textarea>
                    <div class="mt-2">
                        <button type="submit" class="btn btn-outline-secondary" asp-page-handler="ExtractPublicJwk" formnovalidate>Extract public JWKS</button>
                        <small class="form-text text-muted ms-2">The private key is not saved; we only derive public fields and populate the JWKS field above.</small>
                    </div>
                    <span asp-validation-for="Input.PrivateJwk" class="text-danger"></span>
                </div>
                @if (Model.KeyPreviews?.Count > 0)
                {

                    <div class="mb-3">
                        <label asp-for="Input.IdTokenSignedResponseAlg" class="form-label"></label>
                        <select asp-for="Input.IdTokenSignedResponseAlg" class="form-select">
                            <option value="">(default)</option>
                            <option value="@Model.ActiveSigningAlg">@Model.ActiveSigningAlg</option>
                        </select>
                        <div class="form-text">Must match tenant active signing alg or be empty.</div>
                        <span asp-validation-for="Input.IdTokenSignedResponseAlg" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <div class="card mb-2">
                            <div class="card-header">JWKS preview</div>
                            <div class="card-body">
                                <ul class="list-unstyled">
                                    @foreach (var k in Model.KeyPreviews)
                                    {
                                        <li>
                                            <code>@k.Kid</code> ? @k.Kty @k.Alg @(" ") @k.Details
                                        </li>
                                    }
                                </ul>
                                <div class="input-group mt-2">
                                    <input asp-for="RemoveKid" class="form-control" placeholder="kid to remove" />
                                    <button type="submit" class="btn btn-outline-danger" asp-page-handler="RemoveKey" formnovalidate>Remove Key</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.GeneratedPrivateJwk))
                {
                    <div class="col-12">
                        <div class="alert alert-warning">
                            <strong>Private JWK generated.</strong> Copy and store it securely. It will not be persisted on the server.
                        </div>
                        <textarea class="form-control" rows="6" readonly>@Model.GeneratedPrivateJwk</textarea>
                    </div>
                }
            </div>
        </div>

        <div class="tab-pane fade" id="tab-introspection" role="tabpanel" aria-labelledby="introspection-tab" tabindex="0">
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Input.IntrospectionAudiences" class="form-label"></label>
                    <input asp-for="Input.IntrospectionAudiences" class="form-control" placeholder="api1, https://api.example.com" />
                    <small class="form-text text-muted">Comma-separated audience allow-list for this client's introspection calls. Leave empty to use global config.</small>
                    <span asp-validation-for="Input.IntrospectionAudiences" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.IntrospectionResponseFields" class="form-label"></label>
                    <input asp-for="Input.IntrospectionResponseFields" class="form-control" placeholder="active, token_type, scope, sub, aud, iss, exp" />
                    <small class="form-text text-muted">Overrides server default allow-list for this client; leave blank to use defaults.</small>
                    <span asp-validation-for="Input.IntrospectionResponseFields" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.IntrospectionMtlsThumbprints" class="form-label"></label>
                    <input asp-for="Input.IntrospectionMtlsThumbprints" class="form-control" placeholder="ABCD..., 1234..." />
                    <small class="form-text text-muted">When set, /introspect will require a matching client certificate. Values are case-insensitive.</small>
                    <span asp-validation-for="Input.IntrospectionMtlsThumbprints" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-m2m" role="tabpanel" aria-labelledby="m2m-tab" tabindex="0">
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Input.M2MAllowedAudiences" class="form-label"></label>
                    <input asp-for="Input.M2MAllowedAudiences" class="form-control" placeholder="api, https://api.example.com" />
                    <small class="form-text text-muted">Comma-separated list of allowed audiences for client_credentials tokens. Empty to use server global allow-list.</small>
                    <span asp-validation-for="Input.M2MAllowedAudiences" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.M2MAccessTokenLifetimeSeconds" class="form-label"></label>
                    <input asp-for="Input.M2MAccessTokenLifetimeSeconds" class="form-control" />
                    <small class="form-text text-muted">Override access token lifetime in seconds for M2M. Leave empty or 0 for default (900s).</small>
                    <span asp-validation-for="Input.M2MAccessTokenLifetimeSeconds" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">Token endpoint auth methods</div>
                        <div class="card-body row g-3">
                            <div class="col-md-4 form-check">
                                <input asp-for="Input.AllowClientSecretBasic" class="form-check-input" />
                                <label asp-for="Input.AllowClientSecretBasic" class="form-check-label"></label>
                            </div>
                            <div class="col-md-4 form-check">
                                <input asp-for="Input.AllowClientSecretPost" class="form-check-input" />
                                <label asp-for="Input.AllowClientSecretPost" class="form-check-label"></label>
                            </div>
                            <div class="col-md-4 form-check">
                                <input asp-for="Input.AllowPrivateKeyJwt" class="form-check-input" />
                                <label asp-for="Input.AllowPrivateKeyJwt" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <label asp-for="Input.M2MMtlsThumbprints" class="form-label"></label>
                    <input asp-for="Input.M2MMtlsThumbprints" class="form-control" placeholder="ABCD..., 1234..." />
                    <small class="form-text text-muted">When set, client_credentials will require a matching client certificate. Values are case-insensitive.</small>
                    <span asp-validation-for="Input.M2MMtlsThumbprints" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-obo" role="tabpanel" aria-labelledby="obo-tab" tabindex="0">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h6>On-Behalf-Of (Token Exchange)</h6>
                    <p class="text-muted">Configure RFC 8693 token exchange policy for this client</p>
                </div>
                <a href="@(tenantPrefix)/admin/obo-setup?step=shape" class="btn btn-sm btn-outline-primary">
                    <i class="ph ph-user-gear"></i> Setup Wizard
                </a>
            </div>
            <div class="row g-3">
                <div class="col-12 form-check">
                    <input asp-for="Input.OboEnabled" class="form-check-input" />
                    <label asp-for="Input.OboEnabled" class="form-check-label"></label>
                </div>
                <div class="col-12">
                    <label asp-for="Input.OboAllowedCallers" class="form-label"></label>
                    <input asp-for="Input.OboAllowedCallers" class="form-control" placeholder="caller-app, api-gateway" />
                    <small class="form-text text-muted">Only these clients may call token exchange for this client when acting as the caller (actor).</small>
                    <span asp-validation-for="Input.OboAllowedCallers" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.OboAllowedSourceAudiences" class="form-label"></label>

                    <input asp-for="Input.OboAllowedSourceAudiences" class="form-control" placeholder="api-a, https://api-a.example.com" />
                    <small class="form-text text-muted">Subject token must target one of these audiences.</small>
                    <span asp-validation-for="Input.OboAllowedSourceAudiences" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.OboAllowedTargetAudiences" class="form-label"></label>
                    <input asp-for="Input.OboAllowedTargetAudiences" class="form-control" placeholder="api-b, https://api-b.example.com" />
                    <small class="form-text text-muted">Outgoing token audience must be one of these. Leave empty to fall back to server API audiences.</small>
                    <span asp-validation-for="Input.OboAllowedTargetAudiences" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.OboAllowedScopes" class="form-label"></label>
                    <input asp-for="Input.OboAllowedScopes" class="form-control" placeholder="read, write, email" />
                    <small class="form-text text-muted">Scopes are narrowed to intersection of requested, subject token, and this allow-list.</small>
                    <span asp-validation-for="Input.OboAllowedScopes" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.OboMaxDelegationDepth" class="form-label"></label>
                    <input asp-for="Input.OboMaxDelegationDepth" class="form-control" />
                    <small class="form-text text-muted">For opaque subject tokens, max number of exchanges allowed. 1 allows single-hop only.</small>
                    <span asp-validation-for="Input.OboMaxDelegationDepth" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.OboMaxLifetimeMinutes" class="form-label"></label>
                    <input asp-for="Input.OboMaxLifetimeMinutes" class="form-control" />
                    <small class="form-text text-muted">Cap on outgoing token lifetime in minutes. Final lifetime is the min of subject remaining, this cap, and defaults.</small>
                    <span asp-validation-for="Input.OboMaxLifetimeMinutes" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.OboDpopMode" class="form-label"></label>
                    <select asp-for="Input.OboDpopMode" class="form-select">
                        <option value="Deny">Deny</option>
                        <option value="RequireSameJkt">RequireSameJkt</option>
                        <option value="AllowSameJktOnly">AllowSameJktOnly</option>
                    </select>
                    <small class="form-text text-muted">Controls DPoP bridging behavior for Token Exchange. See docs for details.</small>
                </div>
            </div>
        </div>

            <div class="tab-pane fade" id="tab-secrets" role="tabpanel" aria-labelledby="secrets-tab" tabindex="0">
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                        <div>
                            <h5 class="mb-1">Client secrets</h5>
                            <p class="text-muted mb-0">
                                Manage secrets for <strong>@Model.ClientDisplayName</strong>
                                <span class="font-monospace">(@Model.ClientPublicId)</span>
                            </p>
                        </div>
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createSecretModal">
                            <i class="ph ph-plus-circle me-1"></i> Generate New Secret
                        </button>
                    </div>

                    @if (Model.HasLegacyClientSecretHash)
                    {
                        <div class="alert alert-warning alert-dismissible fade show" role="alert">
                            <h5 class="alert-heading">
                                <i class="ph ph-warning-fill me-2"></i>
                                <span class="badge bg-warning text-dark me-2">DEPRECATED</span>
                                Legacy Single Secret Detected
                            </h5>
                            <p class="mb-2">
                                This client is using the deprecated single <code>ClientSecretHash</code> field.
                                While it will continue to work for backward compatibility, we recommend migrating to the new multi-secret system for:
                            </p>
                            <ul class="mb-2">
                                <li><strong>Zero-downtime rotation</strong> — overlap old and new secrets during rotation</li>
                                <li><strong>Expiry enforcement</strong> — automatically reject expired secrets</li>
                                <li><strong>Better audit trail</strong> — track secret creation, activation, usage, and revocation</li>
                                <li><strong>Enhanced security</strong> — up to 3 active secrets with individual lifecycle management</li>
                            </ul>
                            <p class="mb-0">
                                <strong>Action:</strong> Generate a new secret below, test it with your client application, then the legacy secret will be automatically ignored once you have active secrets in the new system.
                            </p>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.SecretErrorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="ph ph-warning-fill me-2"></i>
                            @Model.SecretErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.SecretSuccessMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="ph-fill ph-check-circle me-2"></i>
                            @Model.SecretSuccessMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.SecretNewSecretValue))
                    {
                        <div class="alert alert-warning" role="alert">
                            <h5 class="alert-heading"><i class="ph ph-warning-fill me-2"></i>Save This Secret Now!</h5>
                            <p><strong>You won't be able to see this secret again.</strong> Copy it to a secure location.</p>
                            <div class="input-group mb-3">
                                <input type="text" class="form-control font-monospace" id="newSecret" value="@Model.SecretNewSecretValue" readonly>
                                <button class="btn btn-outline-secondary" type="button" id="copySecretBtn">
                                    <i class="ph ph-clipboard"></i> Copy
                                </button>
                            </div>
                            <small class="text-muted">Secret ID: @Model.SecretNewSecretIdentifier</small>
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Status</th>
                                    <th>Description</th>
                                    <th>Created</th>
                                    <th>Activated</th>
                                    <th>Expires</th>
                                    <th>Last Used</th>
                                    <th>Usage</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            @if (Model.ClientSecrets is null || !Model.ClientSecrets.Any())
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted">
                                        <i class="ph ph-info me-2"></i>No secrets configured for this client.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var secret in Model.ClientSecrets)
                                {
                                    <tr>
                                        <td>
                                            @switch (secret.Status)
                                            {
                                                case "primary":
                                                    <span class="badge bg-success"><i class="ph ph-star-fill me-1"></i>Primary</span>;
                                                    break;
                                                case "active":
                                                    <span class="badge bg-info">Active</span>;
                                                    break;
                                                case "inactive":
                                                    <span class="badge bg-secondary">Inactive</span>;
                                                    break;
                                                case "expired":
                                                    <span class="badge bg-warning text-dark">Expired</span>;
                                                    break;
                                                case "revoked":
                                                    <span class="badge bg-danger">Revoked</span>;
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            @(string.IsNullOrEmpty(secret.Description) ? "<em>No description</em>" : secret.Description)
                                        </td>
                                        <td>
                                            <small>@secret.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</small><br />
                                            <small class="text-muted">by @secret.CreatedBy</small>
                                        </td>
                                        <td>
                                            @if (secret.ActivatedAtUtc.HasValue)
                                            {
                                                <small>@secret.ActivatedAtUtc.Value.ToString("yyyy-MM-dd HH:mm")</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            @if (secret.ExpiresAtUtc.HasValue)
                                            {
                                                var daysUntilExpiry = (secret.ExpiresAtUtc.Value - DateTime.UtcNow).Days;
                                                <small>@secret.ExpiresAtUtc.Value.ToString("yyyy-MM-dd")</small>
                                                if (daysUntilExpiry < 7 && daysUntilExpiry > 0)
                                                {
                                                    <br /><span class="badge bg-warning text-dark">Expires in @daysUntilExpiry days</span>
                                                }
                                                else if (daysUntilExpiry <= 0)
                                                {
                                                    <br /><span class="badge bg-danger">Expired</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">Never</span>
                                            }
                                        </td>
                                        <td>
                                            @if (secret.LastUsedAtUtc.HasValue)
                                            {
                                                <small>@secret.LastUsedAtUtc.Value.ToString("yyyy-MM-dd HH:mm")</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Never</span>
                                            }
                                        </td>
                                        <td>@secret.UsageCount</td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm" role="group">
                                                @if (secret.Status == "inactive")
                                                {
                                                    <button type="submit" class="btn btn-outline-success" title="Activate"
                                                            asp-page-handler="ActivateSecret" asp-route-id="@Model.Id" asp-route-secretId="@secret.Id">
                                                        <i class="ph ph-check-circle"></i>
                                                    </button>
                                                }
                                                @if (secret.Status == "active" || secret.Status == "primary")
                                                {
                                                    <button type="submit" class="btn btn-outline-warning" title="Set as Primary"
                                                            asp-page-handler="SetPrimarySecret" asp-route-id="@Model.Id" asp-route-secretId="@secret.Id"
                                                            disabled="@(secret.Status == "primary")">
                                                        <i class="ph ph-star"></i>
                                                    </button>
                                                }
                                                @if (secret.Status != "revoked")
                                                {
                                                    <button type="button" class="btn btn-outline-danger" title="Revoke"
                                                            data-bs-toggle="modal" data-bs-target="#revokeModal"
                                                            data-secret-id="@secret.Id"
                                                            data-secret-desc="@(string.IsNullOrEmpty(secret.Description) ? "this secret" : secret.Description)">
                                                        <i class="ph ph-x-circle"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        <div class="tab-pane fade" id="tab-users" role="tabpanel" aria-labelledby="users-tab" tabindex="0">
            <div class="row g-3">
                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="mb-1">User Assignments</h5>
                            <p class="text-muted mb-0">Manage which users are assigned to this client</p>
                        </div>
                    </div>
                    @if (MultiTenancyOptions.Enabled)
                    {
                        <div class="alert alert-info mb-3">
                            <i class="ph ph-buildings me-1"></i>
                            <strong>Multi-tenant mode:</strong> Only users from the current tenant can be assigned to this client.
                        </div>
                    }
                </div>
                <div class="col-md-5">
                    <div class="card h-100">
                        <div class="card-header bg-secondary text-white">
                            <i class="ph ph-users me-1"></i> Available Users
                            <span class="badge bg-light text-dark ms-2">@Model.AvailableUsers.Count</span>
                        </div>
                        <div class="card-body p-0">
                            <div class="list-group list-group-flush user-list-scroll" id="availableUsersList">
                                @if (!Model.AvailableUsers.Any())
                                {
                                    <div class="list-group-item text-center text-muted py-4">
                                        <i class="ph ph-person-x fs-4 d-block mb-2"></i>
                                        No available users
                                    </div>
                                }
                                else
                                {
                                    @foreach (var user in Model.AvailableUsers.OrderBy(u => u.Username))
                                    {
                                        <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center user-item" data-user-id="@user.Id">
                                            <div>
                                                <div class="fw-medium">@user.Username</div>
                                                <small class="text-muted">@(user.Name ?? user.Email ?? "—")</small>
                                            </div>
                                            <button type="submit" class="btn btn-sm btn-outline-success" 
                                                    asp-page-handler="AssignUser" 
                                                    name="userId" value="@user.Id" 
                                                    formnovalidate
                                                    title="Assign user">
                                                <i class="ph ph-arrow-right"></i>
                                            </button>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-2 d-flex flex-column justify-content-center align-items-center gap-2">
                    <div class="text-muted small text-center">
                        <i class="ph ph-arrows-left-right fs-3"></i>
                        <div class="mt-2">Click buttons to<br/>assign or remove</div>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="card h-100">
                        <div class="card-header bg-success text-white">
                            <i class="ph ph-person-check me-1"></i> Assigned Users
                            <span class="badge bg-light text-dark ms-2">@Model.AssignedUsers.Count</span>
                        </div>
                        <div class="card-body p-0">
                            <div class="list-group list-group-flush user-list-scroll" id="assignedUsersList">
                                @if (!Model.AssignedUsers.Any())
                                {
                                    <div class="list-group-item text-center text-muted py-4">
                                        <i class="ph ph-person-check fs-4 d-block mb-2"></i>
                                        No users assigned
                                    </div>
                                }
                                else
                                {
                                    @foreach (var user in Model.AssignedUsers.OrderBy(u => u.Username))
                                    {
                                        <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center user-item @(!user.IsActive ? "list-group-item-secondary" : "")" data-user-id="@user.Id">
                                            <div>
                                                <div class="fw-medium">
                                                    @user.Username
                                                    @if (!user.IsActive)
                                                    {
                                                        <span class="badge bg-secondary ms-1">Inactive</span>
                                                    }
                                                </div>
                                                <small class="text-muted">@(user.Name ?? user.Email ?? "—")</small>
                                            </div>
                                            <button type="submit" class="btn btn-sm btn-outline-danger" 
                                                    asp-page-handler="UnassignUser" 
                                                    name="userId" value="@user.Id" 
                                                    formnovalidate
                                                    title="Remove assignment">
                                                <i class="ph ph-arrow-left"></i>
                                            </button>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-tools" role="tabpanel" aria-labelledby="tools-tab" tabindex="0">
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Input.TestJwt" class="form-label"></label>
                    <textarea asp-for="Input.TestJwt" class="form-control" rows="4" placeholder="Paste a signed JWT to validate its signature against the JWKS"></textarea>
                    <div class="mt-2 d-flex gap-2">
                        <button type="submit" class="btn btn-outline-primary" asp-page-handler="ValidateJwt" formnovalidate>Validate JWT Signature</button>
                        <button type="submit" class="btn btn-outline-secondary" asp-page-handler="SignTestJwt" formnovalidate>Sign Test JWT from private JWK</button>
                    </div>
                    @if (Model.JwtTest is not null)
                    {
                        <div class="alert @(Model.JwtTest.Ok ? "alert-success" : "alert-danger") mt-2">
                            <strong>@Model.JwtTest.Message</strong>
                            <div class="small text-muted">
                                alg: @Model.JwtTest.HeaderAlg; kid: @Model.JwtTest.HeaderKid; iss: @Model.JwtTest.Iss; sub: @Model.JwtTest.Sub
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3 mb-5 d-flex gap-2">
        <button type="submit" class="btn btn-primary" asp-page-handler="Save">Save</button>
        <a href="@clientsIndexPath" class="btn btn-secondary">Back</a>
    </div>
</form>

<!-- Create Secret Modal -->
<div class="modal fade" id="createSecretModal" tabindex="-1" aria-labelledby="createSecretModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateSecret" asp-route-id="@Model.Id">
                <div class="modal-header">
                    <h5 class="modal-title" id="createSecretModalLabel">Generate New Secret</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="SecretInput.Description" class="form-label">Description (optional)</label>
                        <input asp-for="SecretInput.Description" class="form-control" placeholder="Production secret Q4 2025">
                        <small class="form-text text-muted">Give this secret a friendly label to help operators identify it later.</small>
                    </div>
                    <div class="mb-3">
                        <label asp-for="SecretInput.ExpiresInDays" class="form-label">Expires in (days, optional)</label>
                        <input asp-for="SecretInput.ExpiresInDays" class="form-control" type="number" min="1" max="730" placeholder="90">
                        <small class="form-text text-muted">Leave empty for no expiry. Range: 1-730 days (2 years).</small>
                    </div>
                    <div class="form-check">
                        <input asp-for="SecretInput.ActivateImmediately" class="form-check-input" type="checkbox">
                        <label asp-for="SecretInput.ActivateImmediately" class="form-check-label">Activate immediately</label>
                        <small class="form-text text-muted d-block">Uncheck to keep the secret inactive until you are ready to switch.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Generate Secret</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Revoke Confirmation Modal -->
<div class="modal fade" id="revokeModal" tabindex="-1" aria-labelledby="revokeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="revokeModalLabel">Confirm Revocation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-danger"><strong>Warning:</strong> This action cannot be undone.</p>
                <p>Are you sure you want to revoke <strong id="revokeSecretDesc"></strong>?</p>
                <p class="text-muted">After revocation, the secret instantly stops authenticating this client.</p>
            </div>
            <div class="modal-footer">
                <form id="revokeForm" method="post" asp-page-handler="RevokeSecret" asp-route-id="@Model.Id">
                    <input type="hidden" id="revokeSecretId" name="secretId" value="" />
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Revoke Secret</button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .user-list-scroll {
        max-height: 400px;
        overflow-y: auto;
    }
    .user-item:hover {
        background-color: rgba(0,0,0,.04);
    }
</style>

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
    <script nonce="@(HttpContext.Items["csp-nonce"] as string ?? string.Empty)">
        (function(){
            // Tab persistence: activate tab from URL parameter or restore from previous selection
            const urlParams = new URLSearchParams(window.location.search);
            const tabParam = urlParams.get('tab');
            const tabList = document.getElementById('clientTab');
            
            if (tabParam) {
                // Activate tab from URL parameter
                const tabButton = document.getElementById(tabParam + '-tab');
                if (tabButton) {
                    const tab = new bootstrap.Tab(tabButton);
                    tab.show();
                }
            } else if (tabList && tabList.dataset && tabList.dataset.activeTab) {
                const serverTab = tabList.dataset.activeTab;
                if (serverTab) {
                    const tabButton = document.getElementById(serverTab + '-tab');
                    if (tabButton) {
                        const tab = new bootstrap.Tab(tabButton);
                        tab.show();
                    }
                }
            }
            
            // Store active tab selection in URL when user clicks tabs
            const tabButtons = document.querySelectorAll('button[data-bs-toggle="tab"]');
            tabButtons.forEach(button => {
                button.addEventListener('shown.bs.tab', function(event) {
                    const targetId = event.target.id;
                    const tabName = targetId.replace('-tab', '');
                    
                    // Update URL with tab parameter without page reload
                    const newUrl = new URL(window.location);
                    newUrl.searchParams.set('tab', tabName);
                    window.history.replaceState({}, '', newUrl);
                });
            });
            
            function toBase64Url(bytes) {
                let binary = '';
                const len = bytes.byteLength;
                for (let i = 0; i < len; i++) {
                    binary += String.fromCharCode(bytes[i]);
                }
                let base64 = btoa(binary);
                base64 = base64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
                return base64;
            }
            function updateSecretButtons(input, copyBtn, revealBtn){
                const hasValue = !!(input && input.value);
                if(copyBtn) copyBtn.disabled = !hasValue;
                if(revealBtn) revealBtn.disabled = !hasValue;
            }
            const input = document.getElementById('Input_ClientSecret');
            const genBtn = document.getElementById('btn-generate-secret');
            const copyBtn = document.getElementById('btn-copy-secret');
            const revealBtn = document.getElementById('btn-reveal-secret');

            if (genBtn){
                genBtn.addEventListener('click', function(){
                    if(!input) return;
                    const bytes = new Uint8Array(48); // strong secret
                    window.crypto.getRandomValues(bytes);
                    const secret = toBase64Url(bytes);
                    input.value = secret;
                    const span = document.querySelector('span[data-valmsg-for="Input.ClientSecret"]');
                    if (span) { span.textContent = ''; }
                    input.setAttribute('type', 'password');
                    if (revealBtn){
                        revealBtn.title = 'Show secret';
                        const icon = revealBtn.querySelector('i');
                        if (icon){ icon.className = 'ph ph-eye'; }
                    }
                    updateSecretButtons(input, copyBtn, revealBtn);
                });
            }

            if (revealBtn && input){
                revealBtn.addEventListener('click', function(e){
                    e.preventDefault();
                    const currentType = input.getAttribute('type') || 'text';
                    if (currentType.toLowerCase() === 'password'){
                        input.setAttribute('type', 'text');
                        revealBtn.title = 'Hide secret';
                        const icon = revealBtn.querySelector('i');
                        if (icon){ icon.className = 'ph ph-eye-slash'; }
                    } else {
                        input.setAttribute('type', 'password');
                        revealBtn.title = 'Show secret';
                        const icon = revealBtn.querySelector('i');
                        if (icon){ icon.className = 'ph ph-eye'; }
                    }
                });
            }

            if (copyBtn && input){
                copyBtn.addEventListener('click', async function(e){
                    e.preventDefault();
                    if(!input.value) return;
                    try{
                        if (navigator.clipboard && navigator.clipboard.writeText){
                            await navigator.clipboard.writeText(input.value);
                        } else {
                            input.select();
                            document.execCommand('copy');
                            input.setSelectionRange(input.value.length, input.value.length);
                        }
                        const original = copyBtn.textContent;
                        copyBtn.textContent = 'Copied!';
                        copyBtn.classList.add('btn-success');
                        setTimeout(()=>{
                            copyBtn.textContent = original;
                            copyBtn.classList.remove('btn-success');
                        }, 1000);
                    }catch{
                        const original = copyBtn.textContent;
                        copyBtn.textContent = 'Failed';
                        copyBtn.classList.add('btn-danger');
                        setTimeout(()=>{
                            copyBtn.textContent = original;
                            copyBtn.classList.remove('btn-danger');
                        }, 1200);
                    }
                });
            }

            if (input){
                input.addEventListener('input', function(){
                    updateSecretButtons(input, copyBtn, revealBtn);
                });
                updateSecretButtons(input, copyBtn, revealBtn);
            }

            const newSecretField = document.getElementById('newSecret');
            const newSecretCopyBtn = document.getElementById('copySecretBtn');
            if (newSecretField && newSecretCopyBtn){
                newSecretCopyBtn.addEventListener('click', async function(){
                    try {
                        const value = newSecretField.value;
                        if (!value) { return; }

                        if (navigator.clipboard && navigator.clipboard.writeText){
                            await navigator.clipboard.writeText(value);
                        } else {
                            newSecretField.select();
                            document.execCommand('copy');
                            window.getSelection().removeAllRanges();
                        }

                        const original = newSecretCopyBtn.innerHTML;
                        newSecretCopyBtn.innerHTML = '<i class="ph ph-check"></i> Copied!';
                        newSecretCopyBtn.classList.remove('btn-outline-secondary');
                        newSecretCopyBtn.classList.add('btn-success');
                        setTimeout(() => {
                            newSecretCopyBtn.innerHTML = original;
                            newSecretCopyBtn.classList.add('btn-outline-secondary');
                            newSecretCopyBtn.classList.remove('btn-success');
                        }, 1500);
                    } catch (err) {
                        console.error('Failed to copy secret', err);
                    }
                });
            }

            const revokeModal = document.getElementById('revokeModal');
            revokeModal?.addEventListener('show.bs.modal', function(event){
                const trigger = event.relatedTarget;
                if (!trigger) { return; }
                const secretId = trigger.getAttribute('data-secret-id');
                const secretDesc = trigger.getAttribute('data-secret-desc');
                const hiddenField = document.getElementById('revokeSecretId');
                const descField = document.getElementById('revokeSecretDesc');
                if (hiddenField){ hiddenField.value = secretId || ''; }
                if (descField){ descField.textContent = secretDesc || 'this secret'; }
            });
        })();

        // IdP Chaining copy button — wired here (not via onclick) to satisfy CSP nonce requirement
        const idpCopyBtn = document.getElementById('idp-copy-btn');
        if (idpCopyBtn) {
            idpCopyBtn.addEventListener('click', function() {
                const text = idpCopyBtn.getAttribute('data-copy-text');
                if (!text) return;

                const ta = document.createElement('textarea');
                ta.value = text;
                ta.style.cssText = 'position:fixed;top:-9999px;left:-9999px;opacity:0';
                document.body.appendChild(ta);
                ta.focus();
                ta.select();
                try { document.execCommand('copy'); } catch (e) {}
                document.body.removeChild(ta);

                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(text).catch(() => {});
                }

                const originalHtml = idpCopyBtn.innerHTML;
                idpCopyBtn.innerHTML = '<i class="ph ph-check"></i> Copied!';
                idpCopyBtn.classList.replace('btn-outline-secondary', 'btn-success');
                setTimeout(() => {
                    idpCopyBtn.innerHTML = originalHtml;
                    idpCopyBtn.classList.replace('btn-success', 'btn-outline-secondary');
                }, 1500);
            });
        }
    </script>
}
