@page "{id:guid}"
@model MrWhoOidc.WebAuth.Pages.Admin.Clients.EditModel
@{
    ViewData["Title"] = "Edit client";
}

<h1>Edit client</h1>

<form method="post" autocomplete="off">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <ul class="nav nav-tabs" id="clientTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#tab-general" type="button" role="tab" aria-controls="tab-general" aria-selected="true">
                <i class="bi bi-gear me-1"></i> General
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="providers-tab" data-bs-toggle="tab" data-bs-target="#tab-providers" type="button" role="tab" aria-controls="tab-providers" aria-selected="false">
                <i class="bi bi-people me-1"></i> Providers
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="scopes-tab" data-bs-toggle="tab" data-bs-target="#tab-scopes" type="button" role="tab" aria-controls="tab-scopes" aria-selected="false">
                <i class="bi bi-tag me-1"></i> Scopes
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="keys-tab" data-bs-toggle="tab" data-bs-target="#tab-keys" type="button" role="tab" aria-controls="tab-keys" aria-selected="false">
                <i class="bi bi-key me-1"></i> Keys
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="introspection-tab" data-bs-toggle="tab" data-bs-target="#tab-introspection" type="button" role="tab" aria-controls="tab-introspection" aria-selected="false">
                <i class="bi bi-search me-1"></i> Introspection
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="m2m-tab" data-bs-toggle="tab" data-bs-target="#tab-m2m" type="button" role="tab" aria-controls="tab-m2m" aria-selected="false">
                <i class="bi bi-cpu me-1"></i> M2M
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tools-tab" data-bs-toggle="tab" data-bs-target="#tab-tools" type="button" role="tab" aria-controls="tab-tools" aria-selected="false">
                <i class="bi bi-tools me-1"></i> Tools
            </button>
        </li>
    </ul>

    <div class="tab-content border-start border-end border-bottom p-3" id="clientTabContent">
        <div class="tab-pane fade show active" id="tab-general" role="tabpanel" aria-labelledby="general-tab" tabindex="0">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.ClientId" class="form-label"></label>
                    <input asp-for="Input.ClientId" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Input.ClientId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.ClientName" class="form-label"></label>
                    <input asp-for="Input.ClientName" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Input.ClientName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.RealmId" class="form-label"></label>
                    <select asp-for="Input.RealmId" asp-items="Model.RealmOptions" class="form-select"></select>
                    <span asp-validation-for="Input.RealmId" class="text-danger"></span>
                </div>
                <div class="col-md-3 form-check mt-4">
                    <input asp-for="Input.RequirePkce" class="form-check-input" />
                    <label asp-for="Input.RequirePkce" class="form-check-label"></label>
                </div>
                <div class="col-md-3 form-check mt-4">
                    <input asp-for="Input.RequireConsent" class="form-check-input" />
                    <label asp-for="Input.RequireConsent" class="form-check-label"></label>
                </div>
                <div class="col-md-3 form-check mt-2">
                    <input asp-for="Input.RequirePar" class="form-check-input" />
                    <label asp-for="Input.RequirePar" class="form-check-label">Require PAR for this client</label>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="Input_LoginStyleKey">Login style scheme</label>
                    <select class="form-select" id="Input_LoginStyleKey" name="Input.LoginStyleKey">
                        <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Input.LoginStyleKey) ? "selected" : null)">Default</option>
                        <option value="classic" selected="@((Model.Input.LoginStyleKey?.Equals("classic", StringComparison.OrdinalIgnoreCase) ?? false) ? "selected" : null)">Classic</option>
                        <option value="ocean" selected="@((Model.Input.LoginStyleKey?.Equals("ocean", StringComparison.OrdinalIgnoreCase) ?? false) ? "selected" : null)">Ocean (info)</option>
                        <option value="forest" selected="@((Model.Input.LoginStyleKey?.Equals("forest", StringComparison.OrdinalIgnoreCase) ?? false) ? "selected" : null)">Forest (success)</option>
                        <option value="plum" selected="@((Model.Input.LoginStyleKey?.Equals("plum", StringComparison.OrdinalIgnoreCase) ?? false) ? "selected" : null)">Plum</option>
                        <option value="contrast" selected="@((Model.Input.LoginStyleKey?.Equals("contrast", StringComparison.OrdinalIgnoreCase) ?? false) ? "selected" : null)">High contrast</option>
                    </select>
                    <small class="form-text text-muted">Overrides page style for login/provider selection screens.</small>
                </div>
                <div class="col-12">
                    <label asp-for="Input.AllowedLoginRedirectUris" class="form-label"></label>
                    <input asp-for="Input.AllowedLoginRedirectUris" class="form-control" placeholder="https://app.example.com/signin-oidc, https://app2.example.com/callback" />
                    <small class="form-text text-muted">Comma-separated absolute URLs accepted as redirect_uri during login.</small>
                    <span asp-validation-for="Input.AllowedLoginRedirectUris" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.AllowedLogoutRedirectUris" class="form-label"></label>
                    <input asp-for="Input.AllowedLogoutRedirectUris" class="form-control" placeholder="https://app.example.com/signout-callback-oidc" />
                    <small class="form-text text-muted">Comma-separated absolute URLs accepted as post_logout_redirect_uri during logout.</small>
                    <span asp-validation-for="Input.AllowedLogoutRedirectUris" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">Login methods</div>
                        <div class="card-body row g-3">
                            <div class="col-md-4 form-check">
                                <input asp-for="Input.AllowLocalLogin" class="form-check-input" />
                                <label asp-for="Input.AllowLocalLogin" class="form-check-label"></label>
                            </div>
                            <div class="col-md-4 form-check">
                                <input asp-for="Input.AllowExternalIdp" class="form-check-input" />
                                <label asp-for="Input.AllowExternalIdp" class="form-check-label"></label>
                            </div>
                            <div class="col-md-4 form-check">
                                <input asp-for="Input.AllowQrLogin" class="form-check-input" />
                                <label asp-for="Input.AllowQrLogin" class="form-check-label"></label>
                            </div>
                            <div class="col-12 small text-muted">Use these toggles to control which login options are shown/enforced for this client.</div>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <label asp-for="Input.ClientSecret" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="Input.ClientSecret" class="form-control" autocomplete="new-password" />
                        <button type="button" id="btn-generate-secret" class="btn btn-outline-secondary" title="Generate client secret">Generate</button>
                    </div>
                    <small class="form-text text-muted">Set to rotate/change secret; leave blank to keep current</small>
                    <span asp-validation-for="Input.ClientSecret" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-providers" role="tabpanel" aria-labelledby="providers-tab" tabindex="0">
            <div class="row g-3">
                <div class="col-12">
                    <h5>Add or update mapping</h5>
                    <div class="row g-2 align-items-end">
                        <div class="col-md-4">
                            <label asp-for="ProviderInput.IdentityProviderId" class="form-label">Provider</label>
                            <select asp-for="ProviderInput.IdentityProviderId" class="form-select" asp-items="Model.ProviderOptions"></select>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="ProviderInput.Order" class="form-label">Order</label>
                            <input asp-for="ProviderInput.Order" class="form-control" />
                        </div>
                        <div class="col-md-2 form-check">
                            <input asp-for="ProviderInput.Enabled" class="form-check-input" />
                            <label asp-for="ProviderInput.Enabled" class="form-check-label">Enabled</label>
                        </div>
                        <div class="col-md-2 form-check">
                            <input asp-for="ProviderInput.IsDefaultForClient" class="form-check-input" />
                            <label asp-for="ProviderInput.IsDefaultForClient" class="form-check-label">Default</label>
                        </div>
                        <div class="col-md-2 form-check">
                            <input asp-for="ProviderInput.AutoRedirectIfSingle" class="form-check-input" />
                            <label asp-for="ProviderInput.AutoRedirectIfSingle" class="form-check-label">Auto</label>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ProviderInput.RequiredAcr" class="form-label">Required ACR</label>
                            <input asp-for="ProviderInput.RequiredAcr" class="form-control" />
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-outline-primary" asp-page-handler="AddProvider" formnovalidate>Add / Update</button>
                            <a asp-page="/Admin/ProviderMappings/Index" class="btn btn-link">Open full mapping page</a>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <h5 class="mt-3">Current mappings</h5>
                    @if (Model.ProviderMappings.Count == 0)
                    {
                        <p>No mappings.</p>
                    }
                    else
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Provider</th>
                                    <th>Enabled</th>
                                    <th>Default</th>
                                    <th>Auto</th>
                                    <th>ACR</th>
                                    <th>Order</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var r in Model.ProviderMappings)
                            {
                                <tr>
                                    <td>@r.ProviderDisplay (@r.ProviderName)</td>
                                    <td>@(r.Enabled ? "Yes" : "No")</td>
                                    <td>@(r.IsDefaultForClient ? "Yes" : "No")</td>
                                    <td>@(r.AutoRedirectIfSingle ? "Yes" : "No")</td>
                                    <td>@r.RequiredAcr</td>
                                    <td>@r.Order</td>
                                    <td class="text-end">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" asp-page-handler="DeleteProvider" name="providerId" value="@r.IdentityProviderId" formnovalidate>Delete</button>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-scopes" role="tabpanel" aria-labelledby="scopes-tab" tabindex="0">
            <div class="row g-3">
                <div class="col-md-6">
                    <h5>Assigned scopes</h5>
                    <table class="table table-sm align-middle">
                        <tbody>
                        @foreach (var s in Model.AssignedScopes)
                        {
                            <tr>
                                <td>@s</td>
                                <td class="text-end">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" asp-page-handler="RemoveScope" name="scopeName" value="@s" formnovalidate>Remove</button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <div class="col-md-6">
                    <h5>Add scope</h5>
                    <div class="input-group">
                        <select asp-for="NewScope" class="form-select">
                            <option value="">-- select scope --</option>
                            @foreach (var s in Model.AvailableScopes)
                            {
                                <option value="@s.Name">@s.Name</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-outline-primary" asp-page-handler="AddScope" formnovalidate>Add</button>
                    </div>
                    <small class="form-text text-muted">Only scopes from the catalog can be assigned.</small>
                    <span asp-validation-for="NewScope" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-keys" role="tabpanel" aria-labelledby="keys-tab" tabindex="0">
            <div class="d-flex justify-content-between align-items-center">
                <div></div>
                <div>
                    <a asp-page="/Admin/ClientKeys/Index" asp-route-clientId="@Model.Id" class="btn btn-sm btn-outline-secondary">Open dedicated keys page</a>
                </div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-12">
                    <label asp-for="Input.PublicJwksUri" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="Input.PublicJwksUri" class="form-control" placeholder="https://client.example.com/jwks.json" />
                        <button type="submit" class="btn btn-outline-secondary" asp-page-handler="FetchJwks" formnovalidate>Fetch</button>
                        <select asp-for="GenerateAlg" class="form-select" style="max-width: 180px;">
                            <option value="RS256">RS256</option>
                            <option value="ES256">ES256</option>
                            <option value="ES384">ES384</option>
                            <option value="ES512">ES512</option>
                        </select>
                        <button type="submit" class="btn btn-outline-success" asp-page-handler="GenerateJwks" formnovalidate>Generate JWKS</button>
                        <button type="submit" class="btn btn-outline-success" asp-page-handler="AddKey" formnovalidate>Add Key</button>
                    </div>
                    @if (Model.JwksStatus is not null)
                    {
                        <div class="mt-1 small">
                            <span class="badge @(Model.JwksStatus.Ok ? "bg-success" : "bg-danger")">@Model.JwksStatus.Message</span>
                            @if (Model.JwksStatus.Ok)
                            {
                                <span class="text-muted ms-2">keys: @Model.JwksStatus.KeyCount; unique kid: @Model.JwksStatus.UniqueKidCount</span>
                            }
                            @if (Model.JwksStatus.DuplicateKids?.Count > 0)
                            {
                                <span class="text-danger ms-2">duplicates: @string.Join(", ", Model.JwksStatus.DuplicateKids)</span>
                            }
                        </div>
                    }
                    <small class="form-text text-muted">Fetch from URI or manage JWKS below. Use Add Key to append another key.</small>
                    <span asp-validation-for="Input.PublicJwksUri" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.PublicJwksJson" class="form-label">
                        Public JWKS JSON
                        @if (Model.JwksStatus is not null)
                        {
                            <span class="badge @(Model.JwksStatus.Ok ? "bg-success" : "bg-danger") ms-2">@Model.JwksStatus.Summary</span>
                        }
                    </label>
                    <textarea asp-for="Input.PublicJwksJson" class="form-control" rows="8" placeholder='{"keys":[{...}]}'></textarea>
                    <small class="form-text text-muted">Public JWKS used for private_key_jwt and JAR.</small>
                    <span asp-validation-for="Input.PublicJwksJson" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.PrivateJwk" class="form-label"></label>
                    <textarea asp-for="Input.PrivateJwk" class="form-control" rows="6" placeholder='Paste private JWK or JWKS; only public parts will be extracted'></textarea>
                    <div class="mt-2">
                        <button type="submit" class="btn btn-outline-secondary" asp-page-handler="ExtractPublicJwk" formnovalidate>Extract public JWKS</button>
                        <small class="form-text text-muted ms-2">The private key is not saved; we only derive public fields and populate the JWKS field above.</small>
                    </div>
                    <span asp-validation-for="Input.PrivateJwk" class="text-danger"></span>
                </div>
                @if (Model.KeyPreviews?.Count > 0)
                {
                    <div class="col-12">
                        <div class="card mb-2">
                            <div class="card-header">JWKS preview</div>
                            <div class="card-body">
                                <ul class="list-unstyled">
                                    @foreach (var k in Model.KeyPreviews)
                                    {
                                        <li>
                                            <code>@k.Kid</code> ? @k.Kty @k.Alg @(" ") @k.Details
                                        </li>
                                    }
                                </ul>
                                <div class="input-group mt-2">
                                    <input asp-for="RemoveKid" class="form-control" placeholder="kid to remove" />
                                    <button type="submit" class="btn btn-outline-danger" asp-page-handler="RemoveKey" formnovalidate>Remove Key</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.GeneratedPrivateJwk))
                {
                    <div class="col-12">
                        <div class="alert alert-warning">
                            <strong>Private JWK generated.</strong> Copy and store it securely. It will not be persisted on the server.
                        </div>
                        <textarea class="form-control" rows="6" readonly>@Model.GeneratedPrivateJwk</textarea>
                    </div>
                }
            </div>
        </div>

        <div class="tab-pane fade" id="tab-introspection" role="tabpanel" aria-labelledby="introspection-tab" tabindex="0">
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Input.IntrospectionAudiences" class="form-label"></label>
                    <input asp-for="Input.IntrospectionAudiences" class="form-control" placeholder="api1, https://api.example.com" />
                    <small class="form-text text-muted">Comma-separated audience allow-list for this client's introspection calls. Leave empty to use global config.</small>
                    <span asp-validation-for="Input.IntrospectionAudiences" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.IntrospectionResponseFields" class="form-label"></label>
                    <input asp-for="Input.IntrospectionResponseFields" class="form-control" placeholder="active, token_type, scope, sub, aud, iss, exp" />
                    <small class="form-text text-muted">Overrides server default allow-list for this client; leave blank to use defaults.</small>
                    <span asp-validation-for="Input.IntrospectionResponseFields" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.IntrospectionMtlsThumbprints" class="form-label"></label>
                    <input asp-for="Input.IntrospectionMtlsThumbprints" class="form-control" placeholder="ABCD..., 1234..." />
                    <small class="form-text text-muted">When set, /introspect will require a matching client certificate. Values are case-insensitive.</small>
                    <span asp-validation-for="Input.IntrospectionMtlsThumbprints" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-m2m" role="tabpanel" aria-labelledby="m2m-tab" tabindex="0">
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Input.M2MAllowedAudiences" class="form-label"></label>
                    <input asp-for="Input.M2MAllowedAudiences" class="form-control" placeholder="api, https://api.example.com" />
                    <small class="form-text text-muted">Comma-separated list of allowed audiences for client_credentials tokens. Empty to use server global allow-list.</small>
                    <span asp-validation-for="Input.M2MAllowedAudiences" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.M2MAccessTokenLifetimeSeconds" class="form-label"></label>
                    <input asp-for="Input.M2MAccessTokenLifetimeSeconds" class="form-control" />
                    <small class="form-text text-muted">Override access token lifetime in seconds for M2M. Leave empty or 0 for default (900s).</small>
                    <span asp-validation-for="Input.M2MAccessTokenLifetimeSeconds" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">Token endpoint auth methods</div>
                        <div class="card-body row g-3">
                            <div class="col-md-4 form-check">
                                <input asp-for="Input.AllowClientSecretBasic" class="form-check-input" />
                                <label asp-for="Input.AllowClientSecretBasic" class="form-check-label"></label>
                            </div>
                            <div class="col-md-4 form-check">
                                <input asp-for="Input.AllowClientSecretPost" class="form-check-input" />
                                <label asp-for="Input.AllowClientSecretPost" class="form-check-label"></label>
                            </div>
                            <div class="col-md-4 form-check">
                                <input asp-for="Input.AllowPrivateKeyJwt" class="form-check-input" />
                                <label asp-for="Input.AllowPrivateKeyJwt" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <label asp-for="Input.M2MMtlsThumbprints" class="form-label"></label>
                    <input asp-for="Input.M2MMtlsThumbprints" class="form-control" placeholder="ABCD..., 1234..." />
                    <small class="form-text text-muted">When set, client_credentials will require a matching client certificate. Values are case-insensitive.</small>
                    <span asp-validation-for="Input.M2MMtlsThumbprints" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-tools" role="tabpanel" aria-labelledby="tools-tab" tabindex="0">
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Input.TestJwt" class="form-label"></label>
                    <textarea asp-for="Input.TestJwt" class="form-control" rows="4" placeholder="Paste a signed JWT to validate its signature against the JWKS"></textarea>
                    <div class="mt-2 d-flex gap-2">
                        <button type="submit" class="btn btn-outline-primary" asp-page-handler="ValidateJwt" formnovalidate>Validate JWT Signature</button>
                        <button type="submit" class="btn btn-outline-secondary" asp-page-handler="SignTestJwt" formnovalidate>Sign Test JWT from private JWK</button>
                    </div>
                    @if (Model.JwtTest is not null)
                    {
                        <div class="alert @(Model.JwtTest.Ok ? "alert-success" : "alert-danger") mt-2">
                            <strong>@Model.JwtTest.Message</strong>
                            <div class="small text-muted">
                                alg: @Model.JwtTest.HeaderAlg; kid: @Model.JwtTest.HeaderKid; iss: @Model.JwtTest.Iss; sub: @Model.JwtTest.Sub
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary" asp-page-handler="Save">Save</button>
        <a asp-page="Index" class="btn btn-secondary">Back</a>
    </div>
</form>

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
    <script>
        (function(){
            function toBase64Url(bytes) {
                let binary = '';
                const len = bytes.byteLength;
                for (let i = 0; i < len; i++) {
                    binary += String.fromCharCode(bytes[i]);
                }
                let base64 = btoa(binary);
                base64 = base64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
                return base64;
            }
            const btnSecret = document.getElementById('btn-generate-secret');
            if(btnSecret){
                btnSecret.addEventListener('click', function(){
                    const input = document.getElementById('Input_ClientSecret');
                    if(!input) return;
                    const bytes = new Uint8Array(48); // strong secret
                    window.crypto.getRandomValues(bytes);
                    const secret = toBase64Url(bytes);
                    input.value = secret;
                    const span = document.querySelector('span[data-valmsg-for="Input.ClientSecret"]');
                    if (span) { span.textContent = ''; }
                });
            }
        })();
    </script>
}
