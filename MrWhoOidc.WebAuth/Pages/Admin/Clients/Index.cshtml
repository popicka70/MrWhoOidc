@page
@model MrWhoOidc.WebAuth.Pages.Admin.Clients.IndexModel
@{
    ViewData["Title"] = "Clients";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="m-0">
            <i class="bi bi-people text-primary me-2"></i>
            Clients
        </h1>
        <p class="text-muted mb-0">Manage OAuth2/OIDC client applications</p>
    </div>
    <a class="btn btn-success" asp-page="Add">
        <i class="bi bi-plus-lg"></i> Add Client
    </a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>
                        <i class="bi bi-key me-1"></i>Client ID
                    </th>
                    <th>
                        <i class="bi bi-tag me-1"></i>Name
                    </th>
                    <th>
                        <i class="bi bi-diagram-3 me-1"></i>Realm
                    </th>
                    <th>PKCE</th>
                    <th>Consent</th>
                    <th>
                        <i class="bi bi-gear me-1"></i>Status
                    </th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var c in Model.Clients)
            {
                <tr>
                    <td><code>@c.ClientId</code></td>
                    <td><strong>@c.ClientName</strong></td>
                    <td>
                        <span class="badge text-bg-secondary">@c.RealmName</span>
                    </td>
                    <td>
                        @if (c.RequirePkce)
                        {
                            <span class="badge text-bg-success">
                                <i class="bi bi-check"></i> Yes
                            </span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">No</span>
                        }
                    </td>
                    <td>
                        @if (c.RequireConsent)
                        {
                            <span class="badge text-bg-success">
                                <i class="bi bi-check"></i> Yes
                            </span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">No</span>
                        }
                    </td>
                    <td>
                        @if (c.HasJwks)
                        {
                            <span class="badge text-bg-success">
                                <i class="bi bi-shield-check"></i> JWKS
                            </span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">no JWKS</span>
                        }
                        @if (c.RequirePar)
                        {
                            <span class="badge text-bg-primary ms-1">
                                <i class="bi bi-lock"></i> PAR
                            </span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-page="Edit" asp-route-id="@c.Id">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <form method="post" class="d-inline" asp-page-handler="Delete" asp-route-id="@c.Id" onsubmit="return confirm('Are you sure you want to delete this client?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
