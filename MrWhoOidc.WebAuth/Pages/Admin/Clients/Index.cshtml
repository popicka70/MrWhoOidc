@page "/admin/clients"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject Microsoft.Extensions.Options.IOptions<MrWhoOidc.Auth.MultiTenancy.MultiTenancyOptions> MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Admin.Clients.IndexModel
@{
    ViewData["Title"] = "Clients";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Value.Enabled 
        ? $"/t/{currentTenant.Slug}" 
        : "";
}

<div class="page-header">
    <div class="page-header__content">
        <h1 class="page-header__title">
            <i class="bi bi-people icon-md icon-primary"></i>
            Clients
        </h1>
        <p class="page-header__subtitle">Manage OAuth2/OIDC client applications</p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn-success" href="@(tenantPrefix)/admin/clients/add">
            <i class="bi bi-plus-lg"></i> Add Client
        </a>
    </div>
</div>

@if (Model.IsPlatformAdmin)
{
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label">
                        <i class="bi bi-building me-1"></i>Tenant Filter
                    </label>
                    <select class="form-select" name="tenantId" onchange="this.form.submit()">
                        @foreach (var opt in Model.TenantOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == Model.TenantId?.ToString())">@opt.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <button class="btn btn-primary w-100 mt-4" type="submit">
                        <i class="bi bi-funnel"></i> Filter
                    </button>
                </div>
            </form>
        </div>
    </div>
}

<div class="card">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>
                        <i class="bi bi-key icon-sm"></i> Client ID
                    </th>
                    <th>
                        <i class="bi bi-tag icon-sm"></i> Name
                    </th>
                    <th class="d-none d-md-table-cell">
                        <i class="bi bi-diagram-3 icon-sm"></i> Realm
                    </th>
                    <th class="d-none d-lg-table-cell">
                        <i class="bi bi-building icon-sm"></i> Tenant
                    </th>
                    <th class="d-none d-md-table-cell">PKCE</th>
                    <th class="d-none d-md-table-cell">Consent</th>
                    <th class="d-none d-md-table-cell">
                        <i class="bi bi-gear icon-sm"></i> Status
                    </th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var c in Model.Clients)
            {
                <tr class="data-table__row">
                    <td data-label="Client ID"><code>@c.ClientId</code></td>
                    <td data-label="Name"><strong>@c.ClientName</strong></td>
                    <td data-label="Realm" class="d-none d-md-table-cell">
                        <span class="badge text-bg-secondary">@c.RealmName</span>
                    </td>
                    <td data-label="Tenant" class="d-none d-lg-table-cell">
                        <span class="badge text-bg-info">@c.TenantName</span>
                    </td>
                    <td data-label="PKCE" class="d-none d-md-table-cell">
                        @if (c.RequirePkce)
                        {
                            <span class="badge text-bg-success">
                                <i class="bi bi-check"></i> Yes
                            </span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">No</span>
                        }
                    </td>
                    <td data-label="Consent" class="d-none d-md-table-cell">
                        @if (c.RequireConsent)
                        {
                            <span class="badge text-bg-success">
                                <i class="bi bi-check"></i> Yes
                            </span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">No</span>
                        }
                    </td>
                    <td data-label="Status" class="d-none d-md-table-cell">
                        @if (c.HasJwks)
                        {
                            <span class="badge text-bg-success">
                                <i class="bi bi-shield-check"></i> JWKS
                            </span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">no JWKS</span>
                        }
                        @if (c.RequirePar)
                        {
                            <span class="badge text-bg-primary ms-1">
                                <i class="bi bi-lock"></i> PAR
                            </span>
                        }
                    </td>
                    <td data-label="Actions" class="text-end">
                        <div class="btn-group btn-group-sm" role="group">
                            <a href="@(tenantPrefix)/admin/clients/edit/@c.Id" class="btn btn-outline-secondary" title="Edit">Edit</a>
                            <a asp-page="Delete" asp-route-id="@c.Id" class="btn btn-outline-danger" title="Delete">Del</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
