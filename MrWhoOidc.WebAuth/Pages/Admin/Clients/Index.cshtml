@page
@model MrWhoOidc.WebAuth.Pages.Admin.Clients.IndexModel
@{
    ViewData["Title"] = "Clients";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="m-0">Clients</h1>
    <a class="btn btn-primary" asp-page="Add">Add client</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>ClientId</th>
            <th>Name</th>
            <th>Realm</th>
            <th>PKCE</th>
            <th>Consent</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var c in Model.Clients)
    {
        <tr>
            <td>@c.ClientId</td>
            <td>@c.ClientName</td>
            <td>@c.RealmName</td>
            <td>@(c.RequirePkce ? "Yes" : "No")</td>
            <td>@(c.RequireConsent ? "Yes" : "No")</td>
            <td>
                @if (c.HasJwks)
                {
                    <span class="badge text-bg-success">JWKS</span>
                }
                else
                {
                    <span class="badge text-bg-secondary">no JWKS</span>
                }
                @if (c.RequirePar)
                {
                    <span class="badge text-bg-primary ms-1">PAR</span>
                }
            </td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-page="Edit" asp-route-id="@c.Id">Edit</a>
                <form method="post" class="d-inline" asp-page-handler="Delete" asp-route-id="@c.Id" onsubmit="return confirm('Delete this client?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
