@page "/admin/clients"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Admin.Clients.IndexModel
@{
    ViewData["Title"] = "Clients";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Enabled 
        ? $"/t/{currentTenant.Slug}" 
        : "";
}

<div class="page-header">
    <div class="page-header__content">
        <h1 class="page-header__title">
            <i class="ph ph-users icon-md icon-primary"></i>
            Clients
        </h1>
        <p class="page-header__subtitle">Manage OAuth2/OIDC client applications</p>
    </div>
    <div class="page-header__actions">
        <div class="btn-group">
            <a class="btn btn-outline-primary" href="@(tenantPrefix)/admin/clients/import">
                <i class="ph ph-upload"></i> Import Client
            </a>
            <a class="btn btn-success" href="@(tenantPrefix)/admin/clients/add">
                <i class="ph ph-plus"></i> Add Client
            </a>
        </div>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>
                        <i class="ph ph-key icon-sm"></i> Client ID
                    </th>
                    <th>
                        <i class="ph ph-tag icon-sm"></i> Name
                    </th>
                    <th class="d-none d-md-table-cell">
                        <i class="ph ph-tree-structure icon-sm"></i> Realm
                    </th>
                    <th class="d-none d-lg-table-cell">
                        <i class="ph ph-buildings icon-sm"></i> Tenant
                    </th>
                    <th class="d-none d-md-table-cell">PKCE</th>
                    <th class="d-none d-md-table-cell">Consent</th>
                    <th class="d-none d-md-table-cell">
                        <i class="ph ph-gear icon-sm"></i> Status
                    </th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var c in Model.Clients)
            {
                <tr class="data-table__row">
                    <td data-label="Client ID"><code>@c.ClientId</code></td>
                    <td data-label="Name"><strong>@c.ClientName</strong></td>
                    <td data-label="Realm" class="d-none d-md-table-cell">
                        <span class="badge text-bg-secondary">@c.RealmName</span>
                    </td>
                    <td data-label="Tenant" class="d-none d-lg-table-cell">
                        <span class="badge text-bg-info">@c.TenantName</span>
                    </td>
                    <td data-label="PKCE" class="d-none d-md-table-cell">
                        @if (c.RequirePkce)
                        {
                            <span class="badge text-bg-success">
                                <i class="ph ph-check"></i> Yes
                            </span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">No</span>
                        }
                    </td>
                    <td data-label="Consent" class="d-none d-md-table-cell">
                        @if (c.RequireConsent)
                        {
                            <span class="badge text-bg-success">
                                <i class="ph ph-check"></i> Yes
                            </span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">No</span>
                        }
                    </td>
                    <td data-label="Status" class="d-none d-md-table-cell">
                        @if (c.HasJwks)
                        {
                            <span class="badge text-bg-success">
                                <i class="ph ph-shield-check"></i> JWKS
                            </span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">no JWKS</span>
                        }
                        @if (c.RequirePar)
                        {
                            <span class="badge text-bg-primary ms-1">
                                <i class="ph ph-lock"></i> PAR
                            </span>
                        }
                    </td>
                    <td data-label="Actions" class="text-end">
                        <div class="btn-group btn-group-sm" role="group">
                            <a href="@(tenantPrefix)/admin/clients/edit/@c.Id" class="btn btn-outline-secondary" title="Edit">Edit</a>
                            <a href="@(tenantPrefix)/admin/clients/export/@c.Id" class="btn btn-outline-secondary" title="Export Configuration">Export</a>
                            <a asp-page="Delete" asp-route-id="@c.Id" class="btn btn-outline-danger" title="Delete">Del</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
