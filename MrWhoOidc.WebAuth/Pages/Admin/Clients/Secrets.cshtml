@page "{id:guid}"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject Microsoft.Extensions.Options.IOptions<MrWhoOidc.Auth.MultiTenancy.MultiTenancyOptions> MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Admin.Clients.SecretsModel
@{
    ViewData["Title"] = "Client Secrets";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Value.Enabled 
        ? $"/t/{currentTenant.Slug}" 
        : "";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="@tenantPrefix/Admin/Clients">Clients</a></li>
        <li class="breadcrumb-item"><a href="@tenantPrefix/Admin/Clients/Edit/@Model.ClientId">@Model.ClientName</a></li>
        <li class="breadcrumb-item active" aria-current="page">Secrets</li>
    </ol>
</nav>

<h1>Client Secrets</h1>
<p class="text-muted">Manage secrets for client <strong>@Model.ClientName</strong> (@Model.ClientClientId)</p>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- New Secret Display (shown after creation) -->
@if (!string.IsNullOrEmpty(Model.NewSecretValue))
{
    <div class="alert alert-warning" role="alert">
        <h5 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i>Save This Secret Now!</h5>
        <p><strong>You won't be able to see this secret again.</strong> Copy it to a secure location.</p>
        <div class="input-group mb-3">
            <input type="text" class="form-control font-monospace" id="newSecret" value="@Model.NewSecretValue" readonly>
            <button class="btn btn-outline-secondary" type="button" id="copySecretBtn">
                <i class="bi bi-clipboard"></i> Copy
            </button>
        </div>
        <small class="text-muted">Secret ID: @Model.NewSecretId</small>
    </div>
}

<div class="mb-3">
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createSecretModal">
        <i class="bi bi-plus-circle me-1"></i> Generate New Secret
    </button>
</div>

<!-- Secrets Table -->
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Status</th>
                <th>Description</th>
                <th>Created</th>
                <th>Activated</th>
                <th>Expires</th>
                <th>Last Used</th>
                <th>Usage</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Secrets == null || !Model.Secrets.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted">
                        <i class="bi bi-info-circle me-2"></i>No secrets configured for this client.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var secret in Model.Secrets)
                {
                    <tr>
                        <td>
                            @if (secret.Status == "primary")
                            {
                                <span class="badge bg-success"><i class="bi bi-star-fill me-1"></i>Primary</span>
                            }
                            else if (secret.Status == "active")
                            {
                                <span class="badge bg-info">Active</span>
                            }
                            else if (secret.Status == "inactive")
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                            else if (secret.Status == "expired")
                            {
                                <span class="badge bg-warning text-dark">Expired</span>
                            }
                            else if (secret.Status == "revoked")
                            {
                                <span class="badge bg-danger">Revoked</span>
                            }
                        </td>
                        <td>
                            @(string.IsNullOrEmpty(secret.Description) ? "<em>No description</em>" : secret.Description)
                        </td>
                        <td>
                            <small>@secret.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</small><br />
                            <small class="text-muted">by @secret.CreatedBy</small>
                        </td>
                        <td>
                            @if (secret.ActivatedAtUtc.HasValue)
                            {
                                <small>@secret.ActivatedAtUtc.Value.ToString("yyyy-MM-dd HH:mm")</small>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (secret.ExpiresAtUtc.HasValue)
                            {
                                var daysUntilExpiry = (secret.ExpiresAtUtc.Value - DateTime.UtcNow).Days;
                                <small>@secret.ExpiresAtUtc.Value.ToString("yyyy-MM-dd")</small>
                                @if (daysUntilExpiry < 7 && daysUntilExpiry > 0)
                                {
                                    <br /><span class="badge bg-warning text-dark">Expires in @daysUntilExpiry days</span>
                                }
                                else if (daysUntilExpiry <= 0)
                                {
                                    <br /><span class="badge bg-danger">Expired</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Never</span>
                            }
                        </td>
                        <td>
                            @if (secret.LastUsedAtUtc.HasValue)
                            {
                                <small>@secret.LastUsedAtUtc.Value.ToString("yyyy-MM-dd HH:mm")</small>
                            }
                            else
                            {
                                <span class="text-muted">Never</span>
                            }
                        </td>
                        <td>@secret.UsageCount</td>
                        <td>
                            <div class="btn-group btn-group-sm" role="group">
                                @if (secret.Status == "inactive")
                                {
                                    <form method="post" asp-page-handler="Activate" asp-route-secretId="@secret.Id" class="d-inline">
                                        <button type="submit" class="btn btn-outline-success" title="Activate">
                                            <i class="bi bi-check-circle"></i>
                                        </button>
                                    </form>
                                }
                                @if (secret.Status == "active" || secret.Status == "primary")
                                {
                                    <form method="post" asp-page-handler="SetPrimary" asp-route-secretId="@secret.Id" class="d-inline">
                                        <button type="submit" class="btn btn-outline-warning" title="Set as Primary" @(secret.Status == "primary" ? "disabled" : "")>
                                            <i class="bi bi-star"></i>
                                        </button>
                                    </form>
                                }
                                @if (secret.Status != "revoked")
                                {
                                    <button type="button" class="btn btn-outline-danger" title="Revoke" 
                                            data-bs-toggle="modal" data-bs-target="#revokeModal" 
                                            data-secret-id="@secret.Id" 
                                            data-secret-desc="@(string.IsNullOrEmpty(secret.Description) ? "this secret" : secret.Description)">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Create Secret Modal -->
<div class="modal fade" id="createSecretModal" tabindex="-1" aria-labelledby="createSecretModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h5 class="modal-title" id="createSecretModalLabel">Generate New Secret</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="description" class="form-label">Description (optional)</label>
                        <input type="text" class="form-control" id="description" name="Input.Description" placeholder="Production secret Q4 2025">
                        <small class="form-text text-muted">A friendly label to identify this secret.</small>
                    </div>
                    <div class="mb-3">
                        <label for="expiresInDays" class="form-label">Expires in (days, optional)</label>
                        <input type="number" class="form-control" id="expiresInDays" name="Input.ExpiresInDays" min="1" max="730" placeholder="90">
                        <small class="form-text text-muted">Leave empty for no expiry. Range: 1-730 days (2 years).</small>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="activateImmediately" name="Input.ActivateImmediately" checked>
                        <label class="form-check-label" for="activateImmediately">
                            Activate immediately
                        </label>
                        <small class="form-text text-muted d-block">If unchecked, you'll need to activate the secret manually.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Generate Secret</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Revoke Confirmation Modal -->
<div class="modal fade" id="revokeModal" tabindex="-1" aria-labelledby="revokeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="revokeModalLabel">Confirm Revocation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-danger"><strong>Warning:</strong> This action cannot be undone.</p>
                <p>Are you sure you want to revoke <strong id="revokeSecretDesc"></strong>?</p>
                <p class="text-muted">After revocation, this secret will no longer authenticate the client.</p>
            </div>
            <div class="modal-footer">
                <form id="revokeForm" method="post" asp-page-handler="Revoke">
                    <input type="hidden" id="revokeSecretId" name="secretId" value="" />
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Revoke Secret</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Copy to clipboard
        document.getElementById('copySecretBtn')?.addEventListener('click', function() {
            var secretInput = document.getElementById('newSecret');
            secretInput.select();
            document.execCommand('copy');
            
            var btn = this;
            var originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="bi bi-check"></i> Copied!';
            btn.classList.add('btn-success');
            btn.classList.remove('btn-outline-secondary');
            
            setTimeout(function() {
                btn.innerHTML = originalHtml;
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-secondary');
            }, 2000);
        });

        // Revoke modal - populate with secret info
        var revokeModal = document.getElementById('revokeModal');
        revokeModal?.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var secretId = button.getAttribute('data-secret-id');
            var secretDesc = button.getAttribute('data-secret-desc');
            
            document.getElementById('revokeSecretId').value = secretId;
            document.getElementById('revokeSecretDesc').textContent = secretDesc;
        });
    </script>
}
