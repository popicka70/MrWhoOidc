@page "{name}"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Admin.Scopes.EditModel
@{
    ViewData["Title"] = "Edit scope";
    var tenantPrefix = TenantAccessor.CurrentTenant != null && MultiTenancyOptions.Enabled
        ? $"/t/{TenantAccessor.CurrentTenant.Slug}"
        : string.Empty;
    var scopesIndexPath = string.IsNullOrEmpty(tenantPrefix)
        ? "/admin/scopes"
        : $"{tenantPrefix}/admin/scopes";
}

<div class="page-header">
    <div class="page-header__content">
        <h1 class="page-header__title">
            <i class="ph ph-target icon-md icon-primary"></i>
            Edit scope
        </h1>
        <p class="page-header__subtitle">Update the description and discovery exposure of a global scope</p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn-outline-secondary" href="@scopesIndexPath">
            <i class="ph ph-arrow-left me-1"></i>Back to scopes
        </a>
    </div>
</div>

<div class="alert alert-info d-flex align-items-start gap-2" role="note">
    <i class="ph ph-lock-key mt-1"></i>
    <div>
        <strong>This is a global scope.</strong> Its identifier is immutable: clients already reference it
        by name, so renaming would silently break their configuration. Only the description and
        exposure can change.
    </div>
</div>

<form method="post" class="mt-3" style="max-width: 640px;">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label class="form-label" asp-for="Input.Name">Name</label>
        <input class="form-control font-monospace" value="@Model.Input.Name" disabled aria-readonly="true" />
        <input asp-for="Input.Name" type="hidden" />
        <div class="form-text">The scope identifier — fixed after creation.</div>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Input.Description">Description</label>
        <input asp-for="Input.Description" class="form-control" placeholder="What this scope grants, shown on consent screens" />
        <div class="form-text">Shown to users on consent screens and in the discovery document.</div>
        <span asp-validation-for="Input.Description" class="text-danger"></span>
    </div>
    <div class="form-check form-switch mb-4">
        <input asp-for="Input.IsExposed" class="form-check-input" type="checkbox" role="switch" id="exposedToggle" />
        <label class="form-check-label" asp-for="Input.IsExposed">Exposed</label>
        <div class="form-text mt-1">Advertise this scope in the discovery document. Unexposed scopes stay usable by clients but are not listed publicly.</div>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit">
            <i class="ph ph-check me-1"></i>Save
        </button>
        <a class="btn btn-secondary" href="@scopesIndexPath">Cancel</a>
    </div>
</form>

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
