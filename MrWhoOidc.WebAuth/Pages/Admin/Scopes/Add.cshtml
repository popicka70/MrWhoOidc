@page "/admin/scopes/add"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Admin.Scopes.AddModel
@{
    ViewData["Title"] = "Add scope";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Enabled
        ? $"/t/{currentTenant.Slug}"
        : string.Empty;
    var scopesIndexPath = string.IsNullOrEmpty(tenantPrefix)
        ? "/admin/scopes"
        : $"{tenantPrefix}/admin/scopes";
}

<h1>Add scope</h1>

@if (currentTenant is not null)
{
    <div class="alert alert-info d-flex align-items-center gap-2" role="status">
        <i class="ph ph-tag"></i>
        <div>
            The scope is created for <strong>@currentTenant.Name</strong> (@currentTenant.Slug).
        </div>
    </div>
}

<form method="post" class="mt-3" autocomplete="off">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Input.Name" class="form-label"></label>
        <input asp-for="Input.Name" class="form-control" autocomplete="off" placeholder="e.g. api.read" />
        <div class="form-text">
            The identifier clients request at the token endpoint, using dot-separated segments, e.g.
            <code>api.read</code>. Spaces and uppercase letters are not allowed.
        </div>
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Description" class="form-label"></label>
        <input asp-for="Input.Description" class="form-control" autocomplete="off"
               placeholder="What access this scope grants" />
        <div class="form-text">
            Human-readable description shown in the scope list, so administrators and client owners
            understand what the scope grants.
        </div>
    </div>
    <div class="mb-3">
        <div class="form-check form-switch">
            <input asp-for="Input.IsExposed" class="form-check-input" type="checkbox" role="switch" />
            <label asp-for="Input.IsExposed" class="form-check-label"></label>
        </div>
        <div class="form-text">
            Advertises the scope in the tenant's OpenID Connect discovery document. Keep internal or
            administrative scopes unexposed so they are not offered to external clients.
        </div>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit">Save</button>
        <a class="btn btn-secondary" href="@scopesIndexPath">Cancel</a>
    </div>
</form>

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
