@page "/admin/scopes"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Admin.Scopes.IndexModel
@{
    ViewData["Title"] = "Scopes";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Enabled 
        ? $"/t/{currentTenant.Slug}" 
        : "";
    var scopesAddPath = string.IsNullOrEmpty(tenantPrefix)
        ? "/admin/scopes/add"
        : $"{tenantPrefix}/admin/scopes/add";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="m-0">
            <i class="ph ph-tag text-primary me-2"></i>
            Scopes
        </h1>
        <p class="text-muted mb-0">Manage OAuth2/OIDC scopes and permissions</p>
    </div>
    @if (Model.IsPlatformAdmin)
    {
        <a class="btn btn-success" href="@scopesAddPath">
            <i class="ph ph-plus"></i> Add Scope
        </a>
    }
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-10">
                <label class="form-label">
                    <i class="ph ph-search me-1"></i>Search
                </label>
                <input class="form-control" type="text" name="search" value="@Model.Search" placeholder="Search scopes by name or description..." />
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" type="submit">
                    <i class="ph ph-funnel"></i> Filter
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive table-responsive-cards">
        <table class="data-table align-middle mb-0">
            <thead>
                <tr>
                    <th>
                        <i class="ph ph-tag me-1"></i>Name
                    </th>
                    <th class="d-none d-md-table-cell">
                        <i class="ph ph-info me-1"></i>Description
                    </th>
                    <th class="d-none d-md-table-cell">
                        <i class="ph ph-eye me-1"></i>Exposed
                    </th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var s in Model.Scopes)
            {
                <tr>
                    <td data-label="Name"><code>@s.Name</code></td>
                    <td data-label="Description" class="d-none d-md-table-cell">@s.Description</td>
                    <td data-label="Exposed" class="d-none d-md-table-cell">
                        @if (s.IsExposed)
                        {
                            <span class="badge text-bg-success">
                                <i class="ph ph-check"></i> Yes
                            </span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">No</span>
                        }
                    </td>
                    <td data-label="Actions" class="text-end">
                        @if (Model.IsPlatformAdmin)
                        {
                            <div class="btn-group btn-group-sm" role="group">
                                <a href="@(tenantPrefix)/admin/scopes/edit/@s.Name" class="btn btn-outline-secondary" title="Edit">Edit</a>
                                <a asp-page="Delete" asp-route-name="@s.Name" class="btn btn-outline-danger" title="Delete">Del</a>
                            </div>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">
                                <i class="ph ph-eye me-1"></i>View Only
                            </span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
