@page "{id:guid}"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Admin.Providers.DetailsModel
@{
    ViewData["Title"] = "Provider Details";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Enabled 
        ? $"/t/{currentTenant.Slug}" 
        : "";
}

<h2>Provider Details</h2>

@if (Model.Provider is null)
{
    <p>Provider not found.</p>
}
else
{
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Provider.Name</dd>
        <dt class="col-sm-2">Display Name</dt>
        <dd class="col-sm-10">@Model.Provider.DisplayName</dd>
        <dt class="col-sm-2">Type</dt>
        <dd class="col-sm-10">@Model.Provider.Type</dd>
        <dt class="col-sm-2">Enabled</dt>
        <dd class="col-sm-10">@(Model.Provider.Enabled ? "Yes" : "No")</dd>
        <dt class="col-sm-2">Default</dt>
        <dd class="col-sm-10">@(Model.Provider.IsDefault ? "Yes" : "No")</dd>
        <dt class="col-sm-2">Logo</dt>
        <dd class="col-sm-10">
            @if (Model.Provider.LogoData != null)
            {
                <img src="/api/providers/@Model.Provider.Id/logo" alt="Logo" style="max-height:64px" />
            }
            else if (!string.IsNullOrEmpty(Model.Provider.LogoUrl))
            {
                <img src="@Model.Provider.LogoUrl" alt="Logo" style="max-height:64px" />
            }
            else
            {
                <span class="text-muted">None</span>
            }
        </dd>
        <dt class="col-sm-2">Order</dt>
        <dd class="col-sm-10">@Model.Provider.SortOrder</dd>
        <dt class="col-sm-2">Created</dt>
        <dd class="col-sm-10">@Model.Provider.CreatedAt.ToString("u")</dd>
        <dt class="col-sm-2">Updated</dt>
        <dd class="col-sm-10">@Model.Provider.UpdatedAt.ToString("u")</dd>
        <dt class="col-sm-2">Config</dt>
        <dd class="col-sm-10"><pre><code>@Model.ConfigPretty</code></pre></dd>
    </dl>

    <p>
        <a href="@(tenantPrefix)/Admin/Providers/ClaimMappings/@Model.Provider.Id" class="btn btn-outline-primary">Manage claim mappings</a>
        <a href="@(tenantPrefix)/Admin/Providers/Edit/@Model.Provider.Id" class="btn btn-primary">Edit</a>
        <a href="@(tenantPrefix)/Admin/ProviderKeys/Index?providerId=@Model.Provider.Id" class="btn btn-outline-secondary">Manage keys</a>
    </p>
}
