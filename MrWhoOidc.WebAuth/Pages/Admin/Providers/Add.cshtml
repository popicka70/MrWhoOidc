@page "/admin/providers/add"
@using MrWhoOidc.Auth.Persistence
@using MrWhoOidc.Auth.IdentityProviders
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Admin.Providers.AddModel
@{
    ViewData["Title"] = "Add Identity Provider";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Enabled 
        ? $"/t/{currentTenant.Slug}" 
        : "";
}

<h2>Add Identity Provider</h2>

<form method="post" id="addProviderForm" enctype="multipart/form-data">
    <div class="mb-3">
        <div asp-validation-summary="All" class="text-danger"></div>
    </div>

    @* Step 1: Provider Template Selection *@
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Step 1: Select Provider Template</h5>
        </div>
        <div class="card-body">
            @await Html.PartialAsync("_ProviderSelector")
        </div>
    </div>

    @* Step 2: Basic Information *@
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Step 2: Basic Information</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Input.Name" class="form-label"></label>
                        <input asp-for="Input.Name" class="form-control" id="ProviderName" />
                        <span asp-validation-for="Input.Name" class="text-danger"></span>
                        <div class="form-text">A unique identifier for this provider (e.g., "google", "entra-tenant1").</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.DisplayName" class="form-label"></label>
                        <input asp-for="Input.DisplayName" class="form-control" id="ProviderDisplayName" />
                        <div class="form-text">Shown to users on the login page.</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Input.Type" class="form-label"></label>
                        <select asp-for="Input.Type" class="form-select" asp-items="Model.TypeOptions" id="ProviderType"></select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.SortOrder" class="form-label"></label>
                        <input asp-for="Input.SortOrder" class="form-control" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-check mb-3">
                        <input asp-for="Input.Enabled" class="form-check-input" />
                        <label asp-for="Input.Enabled" class="form-check-label"></label>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="Input.IsDefault" class="form-check-input" />
                        <label asp-for="Input.IsDefault" class="form-check-label"></label>
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            <input asp-for="Input.AllowRegistration" class="form-check-input" />
                            <label asp-for="Input.AllowRegistration" class="form-check-label">Allow Registration</label>
                        </div>
                        <div class="form-text">
                            When enabled, this provider will appear on the public registration page,
                            allowing new users to register by authenticating with this IdP.
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Input.LogoUrl" class="form-label"></label>
                        <input asp-for="Input.LogoUrl" class="form-control" />
                        <div class="form-text">Optional. External URL for the logo.</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Logo" class="form-label">Upload Logo</label>
                        <div class="d-flex align-items-start gap-3">
                            <div id="iconPreview" class="border rounded p-2 bg-light d-flex align-items-center justify-content-center" style="width: 64px; height: 64px; flex-shrink: 0;">
                                <i class="ph ph-image text-muted" style="font-size: 2rem;"></i>
                            </div>
                            <div class="flex-grow-1">
                                <input asp-for="Logo" type="file" class="form-control" accept=".png,.jpg,.jpeg,.svg,.webp" id="LogoUpload" />
                                <div class="form-text">Optional. Upload an image to store in the database (max 512KB).</div>
                                <div id="presetIconInfo" class="form-text text-success" style="display:none;">
                                    <i class="ph-fill ph-check-circle"></i> Standard icon will be used if no file is uploaded.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Input.ButtonBackgroundColor" class="form-label">Button Background Color</label>
                        <div class="d-flex gap-2">
                            <input type="color" asp-for="Input.ButtonBackgroundColor" class="form-control form-control-color" id="BtnBgColorPicker" value="#ffffff" title="Choose background color" />
                            <input type="text" asp-for="Input.ButtonBackgroundColor" class="form-control" id="BtnBgColorText" placeholder="#RRGGBB" />
                        </div>
                        <div class="form-text">Optional. Background color for the login button.</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Input.ButtonTextColor" class="form-label">Button Text Color</label>
                        <div class="d-flex gap-2">
                            <input type="color" asp-for="Input.ButtonTextColor" class="form-control form-control-color" id="BtnTextColorPicker" value="#000000" title="Choose text color" />
                            <input type="text" asp-for="Input.ButtonTextColor" class="form-control" id="BtnTextColorText" placeholder="#RRGGBB" />
                        </div>
                        <div class="form-text">Optional. Text color for the login button.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Step 3: Provider Configuration (dynamic based on template) *@
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Step 3: Provider Configuration</h5>
        </div>
        <div class="card-body" id="providerConfigContainer">
            @* Custom / Generic OIDC (default) *@
            <div id="config-0" class="provider-config-section">
                @if (Model.Input.Type == IdentityProviderType.Oidc)
                {
                    <div class="alert alert-info">
                        <strong>Custom OIDC Provider</strong> - Configure any OpenID Connect compatible identity provider.
                    </div>

                    @if (Model.OidcConfig is not null)
                    {
                        <partial name="_OidcStandardConfig" for="OidcConfig" />
                        <partial name="_OidcAdvancedConfig" for="OidcConfig" view-data='@new ViewDataDictionary(ViewData) { ["Compact"] = true }' />
                    }
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label">Config JSON</label>
                        <textarea asp-for="Input.ConfigJson" class="form-control font-monospace" rows="10"></textarea>
                        <span asp-validation-for="Input.ConfigJson" class="text-danger"></span>
                    </div>
                }
            </div>

            @* Microsoft Entra ID *@
            <div id="config-1" class="provider-config-section" style="display:none;">
                @if (Model.OidcConfig is not null)
                {
                    <partial name="_EntraIdConfig" for="OidcConfig" />
                }
            </div>

            @* Google *@
            <div id="config-2" class="provider-config-section" style="display:none;">
                @if (Model.OidcConfig is not null)
                {
                    <partial name="_GoogleConfig" for="OidcConfig" />
                }
            </div>

            @* Facebook *@
            <div id="config-3" class="provider-config-section" style="display:none;">
                @if (Model.OidcConfig is not null)
                {
                    <partial name="_FacebookConfig" for="OidcConfig" />
                }
            </div>

            @* Apple *@
            <div id="config-4" class="provider-config-section" style="display:none;">
                @if (Model.OidcConfig is not null)
                {
                    <partial name="_AppleConfig" for="OidcConfig" />
                }
            </div>

            @* GitHub *@
            <div id="config-5" class="provider-config-section" style="display:none;">
                @if (Model.OidcConfig is not null)
                {
                    <partial name="_GitHubConfig" for="OidcConfig" />
                }
            </div>

            @* LinkedIn (Tier 1) - uses generic config *@
            <div id="config-6" class="provider-config-section" style="display:none;">
                @if (Model.OidcConfig is not null)
                {
                    <partial name="_GenericProviderConfig" model='(Model.OidcConfig, WellKnownProviderTemplate.LinkedIn)' />
                }
            </div>

            @* Tier 2 providers - use generic config *@
            @foreach (var template in new[] { 
                WellKnownProviderTemplate.Okta, 
                WellKnownProviderTemplate.Auth0, 
                WellKnownProviderTemplate.Keycloak, 
                WellKnownProviderTemplate.AwsCognito,
                WellKnownProviderTemplate.PingIdentity,
                WellKnownProviderTemplate.OneLogin })
            {
                <div id="config-@((int)template)" class="provider-config-section" style="display:none;">
                    @if (Model.OidcConfig is not null)
                    {
                        <partial name="_GenericProviderConfig" model='(Model.OidcConfig, template)' />
                    }
                </div>
            }
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="ph ph-check me-1"></i>Create Provider
        </button>
        <a href="@(tenantPrefix)/Admin/Providers" class="btn btn-secondary">Cancel</a>
    </div>
</form>

<script>
    document.addEventListener('providerTemplateChanged', function(e) {
        const templateId = e.detail.templateId;
        
        // Hide all config sections and DISABLE their inputs
        document.querySelectorAll('.provider-config-section').forEach(section => {
            section.style.display = 'none';
            // Disable all inputs/selects/textareas in this section so they aren't validated or submitted
            section.querySelectorAll('input, select, textarea').forEach(input => {
                input.disabled = true;
            });
        });
        
        // Show the selected config section and ENABLE its inputs
        const selectedSection = document.getElementById('config-' + templateId);
        if (selectedSection) {
            selectedSection.style.display = 'block';
            selectedSection.querySelectorAll('input, select, textarea').forEach(input => {
                input.disabled = false;
            });
        }
        
        // Auto-populate name and display name suggestions
        const templates = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            WellKnownProviderCatalog.GetAllTemplates()
                .ToDictionary(t => (int)t.Template, t => new { 
                    name = t.Template.ToString().ToLowerInvariant().Replace("_", "-"), 
                    displayName = t.DisplayName,
                    iconSvg = t.IconSvg,
                    brandColor = t.BrandColor
                })));
        
        const nameInput = document.getElementById('ProviderName');
        const displayNameInput = document.getElementById('ProviderDisplayName');
        const iconPreview = document.getElementById('iconPreview');
        const presetIconInfo = document.getElementById('presetIconInfo');
        const btnBgColorPicker = document.getElementById('BtnBgColorPicker');
        const btnBgColorText = document.getElementById('BtnBgColorText');
        const btnTextColorPicker = document.getElementById('BtnTextColorPicker');
        const btnTextColorText = document.getElementById('BtnTextColorText');
        
        if (templates[templateId]) {
            const template = templates[templateId];
            
            if (!nameInput.value) {
                nameInput.value = template.name;
            }
            if (!displayNameInput.value) {
                displayNameInput.value = template.displayName;
            }
            
            // Update icon preview
            if (template.iconSvg) {
                iconPreview.innerHTML = template.iconSvg;
                presetIconInfo.style.display = 'block';
            } else {
                iconPreview.innerHTML = '<i class="ph ph-image text-muted" style="font-size: 2rem;"></i>';
                presetIconInfo.style.display = 'none';
            }
            
            // Update brand colors
            if (template.brandColor) {
                btnBgColorPicker.value = template.brandColor;
                btnBgColorText.value = template.brandColor;
                
                // Auto-set text color based on background brightness
                const isDark = isColorDark(template.brandColor);
                const textColor = isDark ? '#ffffff' : '#000000';
                btnTextColorPicker.value = textColor;
                btnTextColorText.value = textColor;
            }
        } else {
            iconPreview.innerHTML = '<i class="ph ph-image text-muted" style="font-size: 2rem;"></i>';
            presetIconInfo.style.display = 'none';
        }
        
        // Set provider type to OIDC for all well-known templates
        if (templateId > 0) {
            document.getElementById('ProviderType').value = '0'; // OIDC
        }
    });

    // Helper to determine if a color is dark
    function isColorDark(hex) {
        if (!hex || hex.length < 6) return false;
        const r = parseInt(hex.slice(1, 3), 16);
        const g = parseInt(hex.slice(3, 5), 16);
        const b = parseInt(hex.slice(5, 7), 16);
        const brightness = (r * 299 + g * 587 + b * 114) / 1000;
        return brightness < 128;
    }

    // Sync color pickers and text inputs
    document.addEventListener('DOMContentLoaded', function() {
        const syncColor = (pickerId, textId) => {
            const picker = document.getElementById(pickerId);
            const text = document.getElementById(textId);
            picker.addEventListener('input', () => text.value = picker.value);
            text.addEventListener('input', () => {
                if (/^#[0-9A-F]{6}$/i.test(text.value)) {
                    picker.value = text.value;
                }
            });
        };
        
        syncColor('BtnBgColorPicker', 'BtnBgColorText');
        syncColor('BtnTextColorPicker', 'BtnTextColorText');

        // Preview uploaded logo
        const logoUpload = document.getElementById('LogoUpload');
        logoUpload.addEventListener('change', function() {
            if (this.files && this.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const iconPreview = document.getElementById('iconPreview');
                    const presetIconInfo = document.getElementById('presetIconInfo');
                    
                    if (logoUpload.files[0].type === 'image/svg+xml') {
                        // For SVG, we can try to inject it or just use img
                        iconPreview.innerHTML = `<img src="${e.target.result}" style="max-width: 100%; max-height: 100%;" />`;
                    } else {
                        iconPreview.innerHTML = `<img src="${e.target.result}" style="max-width: 100%; max-height: 100%;" />`;
                    }
                    presetIconInfo.style.display = 'none';
                };
                reader.readAsDataURL(this.files[0]);
            }
        });

        const initialTemplateId = document.getElementById('ProviderTemplate').value || '0';
        const event = new CustomEvent('providerTemplateChanged', {
            detail: { templateId: initialTemplateId }
        });
        document.dispatchEvent(event);
    });
</script>
