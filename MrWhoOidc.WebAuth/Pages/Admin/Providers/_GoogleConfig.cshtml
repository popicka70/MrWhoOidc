@model MrWhoOidc.WebAuth.Pages.Admin.Providers.OidcConfigForm
@using MrWhoOidc.Auth.IdentityProviders
@{
    var template = WellKnownProviderCatalog.GetTemplate(WellKnownProviderTemplate.Google);
}

<div class="provider-config-google">
    <div class="alert alert-info mb-4">
        <h5 class="alert-heading"><i class="bi bi-info-circle me-2"></i>Google Sign-In</h5>
        <p class="mb-1">Configure your Google OAuth 2.0 / OpenID Connect identity provider.</p>
        <a href="@template?.DocumentationUrl" target="_blank" rel="noopener" class="alert-link">
            <i class="bi bi-box-arrow-up-right me-1"></i>View Google Developer Documentation
        </a>
    </div>

    <div class="row">
        <div class="col-md-6">
            <h5 class="mb-3"><i class="bi bi-key me-1"></i>OAuth Credentials</h5>

            <div class="mb-3">
                <label asp-for="Authority" class="form-label">Authority</label>
                <input asp-for="Authority" class="form-control" value="https://accounts.google.com" readonly />
                <span asp-validation-for="Authority" class="text-danger"></span>
                <div class="form-text">Google's OIDC authority (fixed).</div>
            </div>

            <div class="mb-3">
                <label asp-for="ClientId" class="form-label">Client ID</label>
                <input asp-for="ClientId" class="form-control" 
                       placeholder="xxxx.apps.googleusercontent.com" />
                <span asp-validation-for="ClientId" class="text-danger"></span>
                <div class="form-text">From Google Cloud Console → APIs & Services → Credentials.</div>
            </div>

            <div class="mb-3">
                <label asp-for="ClientSecret" class="form-label">Client Secret</label>
                <input asp-for="ClientSecret" type="password" class="form-control" />
                <span asp-validation-for="ClientSecret" class="text-danger"></span>
            </div>
        </div>

        <div class="col-md-6">
            <h5 class="mb-3"><i class="bi bi-sliders me-1"></i>Protocol Settings</h5>

            <div class="mb-3">
                <label asp-for="ResponseType" class="form-label">Response Type</label>
                <select asp-for="ResponseType" class="form-select">
                    <option value="code" selected>code (recommended)</option>
                    <option value="id_token">id_token</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="ScopesString" class="form-label">Scopes</label>
                <input asp-for="ScopesString" class="form-control" value="openid profile email" />
                <div class="form-text">Space-separated. "openid" is required.</div>
            </div>

            <div class="form-check mb-2">
                <input asp-for="UsePKCE" class="form-check-input" checked />
                <label asp-for="UsePKCE" class="form-check-label">Use PKCE</label>
            </div>
        </div>
    </div>

    <hr class="my-4" />

    <div class="row">
        <div class="col-md-6">
            <h5 class="mb-3"><i class="bi bi-gear me-1"></i>Google-Specific Options</h5>

            <div class="mb-3">
                <label for="GoogleHostedDomain" class="form-label">Hosted Domain (hd)</label>
                <input type="text" id="GoogleHostedDomain" name="GoogleConfig.HostedDomain" class="form-control" 
                       placeholder="example.com" />
                <div class="form-text">Limit sign-in to a Google Workspace domain. Leave empty to allow any.</div>
            </div>

            <div class="mb-3">
                <label for="GoogleLoginHint" class="form-label">Login Hint</label>
                <input type="text" id="GoogleLoginHint" name="GoogleConfig.LoginHint" class="form-control" 
                       placeholder="user@example.com" />
                <div class="form-text">Pre-fill the email address at login.</div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="mb-3">
                <label for="GooglePrompt" class="form-label">Prompt Behavior</label>
                <select id="GooglePrompt" name="GoogleConfig.Prompt" class="form-select">
                    <option value="">Default</option>
                    <option value="none">none (silent)</option>
                    <option value="consent">consent</option>
                    <option value="select_account" selected>select_account</option>
                </select>
            </div>

            <div class="mb-3">
                <label for="GoogleAccessType" class="form-label">Access Type</label>
                <select id="GoogleAccessType" name="GoogleConfig.AccessType" class="form-select">
                    <option value="online" selected>online</option>
                    <option value="offline">offline (for refresh tokens)</option>
                </select>
                <div class="form-text">Use "offline" if you need long-lived access via refresh tokens.</div>
            </div>
        </div>
    </div>
</div>
