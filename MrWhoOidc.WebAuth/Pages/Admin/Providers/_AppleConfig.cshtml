@model MrWhoOidc.WebAuth.Pages.Admin.Providers.OidcConfigForm
@using MrWhoOidc.Auth.IdentityProviders
@{
    var template = WellKnownProviderCatalog.GetTemplate(WellKnownProviderTemplate.Apple);
}

<div class="provider-config-apple">
    <div class="alert alert-warning mb-4">
        <h5 class="alert-heading"><i class="bi bi-exclamation-triangle me-2"></i>Sign in with Apple</h5>
        <p class="mb-1">Apple requires a special client authentication method using a private key. User profile information is only sent on the user's first authorization.</p>
        <a href="@template?.DocumentationUrl" target="_blank" rel="noopener" class="alert-link">
            <i class="bi bi-box-arrow-up-right me-1"></i>View Apple Developer Documentation
        </a>
    </div>

    <div class="row">
        <div class="col-md-6">
            <h5 class="mb-3"><i class="bi bi-key me-1"></i>App Configuration</h5>

            <div class="mb-3">
                <label asp-for="Authority" class="form-label">Authority</label>
                <input asp-for="Authority" class="form-control" value="https://appleid.apple.com" />
                <span asp-validation-for="Authority" class="text-danger"></span>
                <div class="form-text">Apple's OIDC authority. Default is <code>https://appleid.apple.com</code>.</div>
            </div>

            <div class="mb-3">
                <label asp-for="ClientId" class="form-label">Service ID (Client ID)</label>
                <input asp-for="ClientId" class="form-control" 
                       placeholder="com.example.myapp" />
                <span asp-validation-for="ClientId" class="text-danger"></span>
                <div class="form-text">Your Services ID from Apple Developer Portal.</div>
            </div>

            <div class="mb-3">
                <label for="AppleTeamId" class="form-label">Team ID</label>
                <input type="text" id="AppleTeamId" name="AppleConfig.TeamId" class="form-control" 
                       placeholder="XXXXXXXXXX" required />
                <div class="form-text">Your 10-character Apple Developer Team ID.</div>
            </div>
        </div>

        <div class="col-md-6">
            <h5 class="mb-3"><i class="bi bi-file-earmark-lock me-1"></i>Key Configuration</h5>

            <div class="mb-3">
                <label for="AppleKeyId" class="form-label">Key ID</label>
                <input type="text" id="AppleKeyId" name="AppleConfig.KeyId" class="form-control" 
                       placeholder="XXXXXXXXXX" required />
                <div class="form-text">The Key ID for your Sign in with Apple private key.</div>
            </div>

            <div class="mb-3">
                <label for="ApplePrivateKey" class="form-label">Private Key (ES256)</label>
                <textarea id="ApplePrivateKey" name="AppleConfig.PrivateKey" class="form-control font-monospace" 
                          rows="6" placeholder="-----BEGIN PRIVATE KEY-----&#10;...&#10;-----END PRIVATE KEY-----" required></textarea>
                <div class="form-text">
                    <i class="bi bi-shield-lock me-1"></i>
                    Your .p8 private key content. This will be securely stored.
                </div>
            </div>

            <div class="alert alert-secondary small">
                <i class="bi bi-info-circle me-1"></i>
                Apple uses <code>private_key_jwt</code> for client authentication. A client secret JWT will be generated automatically using this key.
            </div>
        </div>
    </div>

    <hr class="my-4" />

    <div class="row">
        <div class="col-md-6">
            <h5 class="mb-3"><i class="bi bi-sliders me-1"></i>Protocol Settings</h5>

            <div class="mb-3">
                <label asp-for="ResponseType" class="form-label">Response Type</label>
                <select asp-for="ResponseType" class="form-select">
                    <option value="code" selected>code (required)</option>
                </select>
                <div class="form-text">Apple only supports the authorization code flow.</div>
            </div>

            <div class="mb-3">
                <label asp-for="ScopesString" class="form-label">Scopes</label>
                <input asp-for="ScopesString" class="form-control" value="openid name email" />
                <div class="form-text">Apple supports: openid, name, email. User info is only available on first auth.</div>
            </div>

            <div class="mb-3">
                <label asp-for="ResponseMode" class="form-label">Response Mode</label>
                <select asp-for="ResponseMode" class="form-select">
                    <option value="form_post" selected>form_post (required)</option>
                </select>
                <div class="form-text">Apple requires form_post response mode.</div>
            </div>
        </div>

        <div class="col-md-6">
            <h5 class="mb-3"><i class="bi bi-exclamation-diamond me-1"></i>Important Notes</h5>
            
            <div class="card bg-light">
                <div class="card-body small">
                    <ul class="mb-0">
                        <li class="mb-2">
                            <strong>User info limitation:</strong> Apple only sends name and email on the user's first authorization. Store this data immediately.
                        </li>
                        <li class="mb-2">
                            <strong>Hide My Email:</strong> Users can choose to hide their email. You'll receive a relay email address.
                        </li>
                        <li class="mb-2">
                            <strong>Key rotation:</strong> The private key generates a client secret JWT valid for up to 6 months. Plan for periodic regeneration.
                        </li>
                        <li>
                            <strong>Redirect URI:</strong> Must be registered in Apple Developer Portal under your Services ID.
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
