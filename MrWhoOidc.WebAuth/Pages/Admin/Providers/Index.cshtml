@page
@model MrWhoOidc.WebAuth.Pages.Admin.Providers.IndexModel
@{
    ViewData["Title"] = "Identity Providers";
}
<h2>Identity Providers</h2>

<p>
    <a asp-page="Add" class="btn btn-primary">Add Provider</a>
</p>

@if (Model.Providers.Count == 0)
{
    <p>No identity providers found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Display Name</th>
                <th>Type</th>
                <th>Enabled</th>
                <th>Default</th>
                <th>Order</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var p in Model.Providers)
        {
            <tr>
                <td>@p.Name</td>
                <td>@p.DisplayName</td>
                <td>@p.Type</td>
                <td>@(p.Enabled ? "Yes" : "No")</td>
                <td>@(p.IsDefault ? "Yes" : "No")</td>
                <td>@p.SortOrder</td>
                <td>
                    <a asp-page="Details" asp-route-id="@p.Id">View</a> |
                    <a asp-page="Edit" asp-route-id="@p.Id">Edit</a> |
                    <a asp-page="ClaimMappings" asp-route-id="@p.Id">Claim mappings</a> |
                    <a asp-page="Delete" asp-route-id="@p.Id">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
