@page "{id:guid}"
@using MrWhoOidc.Auth.IdentityProviders
@using MrWhoOidc.Auth.Persistence
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject Microsoft.Extensions.Options.IOptions<MrWhoOidc.Auth.MultiTenancy.MultiTenancyOptions> MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Admin.Providers.EditModel
@{
    ViewData["Title"] = "Edit Identity Provider";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Value.Enabled 
        ? $"/t/{currentTenant.Slug}" 
        : "";
}

<h2>Edit Identity Provider</h2>

@if (!string.IsNullOrEmpty(Model.DiscoverySummary))
{
    <div class="alert @(Model.DiscoveryOk ? "alert-success" : "alert-danger")">
        <strong>@Model.DiscoverySummary</strong>
    </div>
}

@if (!string.IsNullOrEmpty(Model.DiscoveryJson))
{
    <div class="card mb-3">
        <div class="card-header">Discovery excerpt</div>
        <pre class="m-0 p-3"><code>@Model.DiscoveryJson</code></pre>
    </div>
}

@if (Model.Input is null)
{
    <p>Provider not found.</p>
}
else
{
<form method="post" asp-page="" enctype="multipart/form-data">
    @* Preserve both the route id and the bound model id so model binding hydrates Input.Id *@
    <input type="hidden" name="id" value="@Model.Input.Id" />
    <input asp-for="Input.Id" type="hidden" />

    <div class="mb-3">
        <div asp-validation-summary="All" class="text-danger"></div>
    </div>

    @* Bootstrap Tabs *@
    <ul class="nav nav-tabs" id="providerTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab" aria-controls="general" aria-selected="true">
                <i class="bi bi-info-circle me-1"></i>General
            </button>
        </li>
        @if (Model.Input?.Type == IdentityProviderType.Oidc)
        {
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="form-tab" data-bs-toggle="tab" data-bs-target="#form" type="button" role="tab" aria-controls="form" aria-selected="false">
                    <i class="bi bi-ui-checks me-1"></i>Form Editor
                </button>
            </li>
        }
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="config-tab" data-bs-toggle="tab" data-bs-target="#config" type="button" role="tab" aria-controls="config" aria-selected="false">
                <i class="bi bi-code-square me-1"></i>JSON Configuration
            </button>
        </li>
    </ul>

    <div class="tab-content border-start border-end border-bottom p-3" id="providerTabsContent">
        @* General Tab *@
        <div class="tab-pane fade show active" id="general" role="tabpanel" aria-labelledby="general-tab">
            @* Redirect URI Configuration Card *@
            @if ((Model.RedirectUris != null && Model.RedirectUris.Count > 0) || (Model.LogoutCallbackUris != null && Model.LogoutCallbackUris.Count > 0))
            {
                <div class="card mb-4 border-primary">
                    <div class="card-header bg-primary text-white">
                        <i class="bi bi-link-45deg me-1"></i>
                        <strong>Configuration for External Identity Provider</strong>
                    </div>
                    <div class="card-body">
                        <p class="mb-3">
                            <i class="bi bi-info-circle text-primary me-1"></i>
                            Configure the following callback URI(s) in your external identity provider:
                        </p>
                        
                        @if (Model.RedirectUris != null && Model.RedirectUris.Count > 0)
                        {
                            <h6 class="fw-bold mb-2">
                                <i class="bi bi-box-arrow-in-right me-1"></i>
                                Authentication Redirect URI
                            </h6>
                            @foreach (var uri in Model.RedirectUris)
                            {
                                <div class="input-group mb-3">
                                    <input type="text" 
                                           class="form-control font-monospace" 
                                           value="@uri" 
                                           readonly 
                                           id="redirect-uri-@Model.RedirectUris.IndexOf(uri)" />
                                    <button class="btn btn-outline-secondary" 
                                            type="button" 
                                            onclick="copyToClipboard('redirect-uri-@Model.RedirectUris.IndexOf(uri)', this)"
                                            title="Copy to clipboard">
                                        <i class="bi bi-clipboard"></i>
                                    </button>
                                </div>
                            }
                        }
                        
                        @if (Model.LogoutCallbackUris != null && Model.LogoutCallbackUris.Count > 0)
                        {
                            <h6 class="fw-bold mb-2 mt-3">
                                <i class="bi bi-box-arrow-left me-1"></i>
                                Logout Callback URI (Post-Logout Redirect URI)
                            </h6>
                            @foreach (var uri in Model.LogoutCallbackUris)
                            {
                                <div class="input-group mb-2">
                                    <input type="text" 
                                           class="form-control font-monospace" 
                                           value="@uri" 
                                           readonly 
                                           id="logout-uri-@Model.LogoutCallbackUris.IndexOf(uri)" />
                                    <button class="btn btn-outline-secondary" 
                                            type="button" 
                                            onclick="copyToClipboard('logout-uri-@Model.LogoutCallbackUris.IndexOf(uri)', this)"
                                            title="Copy to clipboard">
                                        <i class="bi bi-clipboard"></i>
                                    </button>
                                </div>
                            }
                        }
                        
                        <small class="text-muted mt-2 d-block">
                            <i class="bi bi-shield-check me-1"></i>
                            These URIs are tenant-aware and match your current configuration.
                        </small>
                    </div>
                </div>
            }

            <div class="mb-3">
                <label asp-for="Input.Name" class="form-label"></label>
                <input asp-for="Input.Name" class="form-control" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.DisplayName" class="form-label"></label>
                <input asp-for="Input.DisplayName" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.Type" class="form-label"></label>
                <select asp-for="Input.Type" class="form-select" asp-items="Model.TypeOptions"></select>
            </div>
            <div class="form-check mb-3">
                <input asp-for="Input.Enabled" class="form-check-input" />
                <label asp-for="Input.Enabled" class="form-check-label"></label>
            </div>
            <div class="form-check mb-3">
                <input asp-for="Input.IsDefault" class="form-check-input" />
                <label asp-for="Input.IsDefault" class="form-check-label"></label>
            </div>
            <div class="mb-3">
                <label asp-for="Input.SortOrder" class="form-label"></label>
                <input asp-for="Input.SortOrder" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Logo</label>
                @if (Model.Input is not null && !string.IsNullOrWhiteSpace(Model.Input.LogoUrl))
                {
                    <div class="mb-2">
                        <img src="@Model.Input.LogoUrl" alt="Logo" style="max-height:64px" />
                    </div>
                }
                <div class="d-flex gap-2 align-items-center">
                    <input type="file" asp-for="Logo" class="form-control" accept="image/png,image/jpeg,image/svg+xml,image/webp" />
                    <button type="submit" class="btn btn-outline-secondary" asp-page-handler="UploadLogo">Upload</button>
                    <button type="submit" class="btn btn-outline-danger" asp-page-handler="ClearLogo">Clear</button>
                </div>
                <div class="form-text">PNG/JPG/SVG/WEBP, up to 512 KB.</div>
            </div>

            <div class="mb-3">
                <label asp-for="Input.LogoUrl" class="form-label"></label>
                <input asp-for="Input.LogoUrl" class="form-control" />
                <span class="form-text">Optional direct URL; uploading overrides this.</span>
            </div>
        </div>

        @* Form Editor Tab (OIDC only) *@
        @if (Model.Input?.Type == IdentityProviderType.Oidc)
        {
            <div class="tab-pane fade" id="form" role="tabpanel" aria-labelledby="form-tab">
                @if (Model.OidcConfig != null)
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-1"></i>
                        <strong>Form Editor:</strong> Edit OIDC configuration using structured fields. Changes are synchronized with the JSON tab.
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="mb-3"><i class="bi bi-link-45deg me-1"></i>Connection Settings</h5>
                            
                            <div class="mb-3">
                                <label asp-for="OidcConfig.Authority" class="form-label"></label>
                                <input asp-for="OidcConfig.Authority" class="form-control" placeholder="https://login.example.com" />
                                <span asp-validation-for="OidcConfig.Authority" class="text-danger"></span>
                                <div class="form-text">The base URL of the OIDC provider.</div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="OidcConfig.DiscoveryUrl" class="form-label"></label>
                                <input asp-for="OidcConfig.DiscoveryUrl" class="form-control" placeholder="Leave empty to use Authority/.well-known/openid-configuration" />
                                <span asp-validation-for="OidcConfig.DiscoveryUrl" class="text-danger"></span>
                                <div class="form-text">Override the discovery endpoint if needed.</div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="OidcConfig.ClientId" class="form-label"></label>
                                <input asp-for="OidcConfig.ClientId" class="form-control" />
                                <span asp-validation-for="OidcConfig.ClientId" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="OidcConfig.ClientSecret" class="form-label"></label>
                                <input asp-for="OidcConfig.ClientSecret" type="password" class="form-control" />
                                <span asp-validation-for="OidcConfig.ClientSecret" class="text-danger"></span>
                                <div class="form-text">Leave empty for public clients or when using client assertions.</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <h5 class="mb-3"><i class="bi bi-sliders me-1"></i>Protocol Settings</h5>

                            <div class="mb-3">
                                <label asp-for="OidcConfig.ResponseType" class="form-label"></label>
                                <select asp-for="OidcConfig.ResponseType" class="form-select">
                                    <option value="code">code</option>
                                    <option value="id_token">id_token</option>
                                    <option value="code id_token">code id_token</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label asp-for="OidcConfig.ScopesString" class="form-label"></label>
                                <input asp-for="OidcConfig.ScopesString" class="form-control" placeholder="openid profile email" />
                                <div class="form-text">Space-separated list of scopes.</div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="OidcConfig.ResponseMode" class="form-label"></label>
                                <input asp-for="OidcConfig.ResponseMode" class="form-control" placeholder="query, fragment, or form_post" />
                            </div>

                            <div class="mb-3">
                                <label asp-for="OidcConfig.Prompt" class="form-label"></label>
                                <input asp-for="OidcConfig.Prompt" class="form-control" placeholder="login, consent, none" />
                            </div>

                            <div class="mb-3">
                                <label asp-for="OidcConfig.RequestedAcrValues" class="form-label"></label>
                                <input asp-for="OidcConfig.RequestedAcrValues" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="mb-3"><i class="bi bi-shield-check me-1"></i>Security Features</h5>

                            <div class="card mb-3">
                                <div class="card-body">
                                    <div class="form-check mb-2">
                                        <input asp-for="OidcConfig.UsePKCE" class="form-check-input" />
                                        <label asp-for="OidcConfig.UsePKCE" class="form-check-label"></label>
                                    </div>
                                    <div class="form-check mb-2">
                                        <input asp-for="OidcConfig.UseJAR" class="form-check-input" />
                                        <label asp-for="OidcConfig.UseJAR" class="form-check-label"></label>
                                    </div>
                                    <div class="form-check mb-2">
                                        <input asp-for="OidcConfig.UsePAR" class="form-check-input" />
                                        <label asp-for="OidcConfig.UsePAR" class="form-check-label"></label>
                                    </div>
                                    <div class="form-check">
                                        <input asp-for="OidcConfig.BackChannelLogout" class="form-check-input" />
                                        <label asp-for="OidcConfig.BackChannelLogout" class="form-check-label"></label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <h5 class="mb-3"><i class="bi bi-check-circle me-1"></i>Token Validation</h5>

                            <div class="card mb-3">
                                <div class="card-body">
                                    <div class="form-check mb-2">
                                        <input asp-for="OidcConfig.ValidateIssuer" class="form-check-input" />
                                        <label asp-for="OidcConfig.ValidateIssuer" class="form-check-label"></label>
                                    </div>
                                    <div class="form-check mb-2">
                                        <input asp-for="OidcConfig.ValidateAudience" class="form-check-input" />
                                        <label asp-for="OidcConfig.ValidateAudience" class="form-check-label"></label>
                                    </div>
                                    <div class="form-check mb-3">
                                        <input asp-for="OidcConfig.ValidateLifetime" class="form-check-input" />
                                        <label asp-for="OidcConfig.ValidateLifetime" class="form-check-label"></label>
                                    </div>

                                    <div class="mb-0">
                                        <label asp-for="OidcConfig.ClockSkewSeconds" class="form-label"></label>
                                        <input asp-for="OidcConfig.ClockSkewSeconds" type="number" class="form-control" />
                                        <div class="form-text">Tolerance for token expiration checks.</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="OidcConfig.ExtraAuthParamsJson" class="form-label"></label>
                        <textarea asp-for="OidcConfig.ExtraAuthParamsJson" class="form-control font-monospace" rows="3" placeholder='{"param1": "value1", "param2": "value2"}'></textarea>
                        <span asp-validation-for="OidcConfig.ExtraAuthParamsJson" class="text-danger"></span>
                        <div class="form-text">Additional parameters to send during authorization (JSON format).</div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Could not parse existing configuration. Please use the JSON tab to fix any syntax errors.
                    </div>
                }
            </div>
        }

        @* Configuration Tab *@
        <div class="tab-pane fade" id="config" role="tabpanel" aria-labelledby="config-tab">
            @if (Model.Input?.Type == IdentityProviderType.Oidc)
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-1"></i>
                    <strong>JSON Configuration:</strong> This tab shows the raw JSON configuration. 
                    For OIDC providers, you can use the <strong>Form Editor</strong> tab for a structured editing experience, 
                    or edit the JSON directly here for advanced scenarios.
                </div>
            }
            <div class="mb-3">
                <label class="form-label">Config JSON (OIDC)</label>
                <textarea asp-for="Input.ConfigJson" class="form-control font-monospace" id="configJsonTextarea" style="height: calc(100vh - 350px); min-height: 400px;"></textarea>
                <span asp-validation-for="Input.ConfigJson" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2 align-items-center">
                <button type="button" class="btn btn-outline-secondary" id="formatJsonBtn">
                    <i class="bi bi-code-slash me-1"></i>Format JSON
                </button>
                <button type="submit" class="btn btn-outline-primary" asp-page-handler="Test" formnovalidate>
                    <i class="bi bi-cloud-check me-1"></i>Test connection
                </button>
                <span class="form-text">Tests discovery endpoint reachability and shows a brief summary.</span>
            </div>
        </div>
    </div>

    <hr class="my-4" />
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save me-1"></i>Save
        </button>
        <a href="@(tenantPrefix)/Admin/Providers" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to list
        </a>
    </div>
</form>

@* JSON Formatting & Tab Coordination Script *@
<script>
    function copyToClipboard(inputId, button) {
        const input = document.getElementById(inputId);
        if (input) {
            input.select();
            input.setSelectionRange(0, 99999); // For mobile devices
            
            navigator.clipboard.writeText(input.value).then(function() {
                // Visual feedback
                const originalHTML = button.innerHTML;
                button.innerHTML = '<i class="bi bi-check-lg"></i>';
                button.classList.remove('btn-outline-secondary');
                button.classList.add('btn-success');
                
                setTimeout(function() {
                    button.innerHTML = originalHTML;
                    button.classList.remove('btn-success');
                    button.classList.add('btn-outline-secondary');
                }, 1500);
            }).catch(function(err) {
                console.error('Failed to copy text: ', err);
                alert('Failed to copy to clipboard');
            });
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        const formatBtn = document.getElementById('formatJsonBtn');
        const textarea = document.getElementById('configJsonTextarea');
        
        if (formatBtn && textarea) {
            formatBtn.addEventListener('click', function() {
                try {
                    const json = JSON.parse(textarea.value);
                    textarea.value = JSON.stringify(json, null, 2);
                    formatBtn.classList.remove('btn-outline-secondary');
                    formatBtn.classList.add('btn-success');
                    setTimeout(() => {
                        formatBtn.classList.remove('btn-success');
                        formatBtn.classList.add('btn-outline-secondary');
                    }, 1000);
                } catch (e) {
                    alert('Invalid JSON: ' + e.message);
                }
            });
        }

        // Show info alert when switching between Form and JSON tabs
        const formTab = document.getElementById('form-tab');
        const configTab = document.getElementById('config-tab');
        
        if (formTab) {
            formTab.addEventListener('shown.bs.tab', function () {
                console.log('Form editor active - changes will be synced to JSON on save');
            });
        }
        
        if (configTab) {
            configTab.addEventListener('shown.bs.tab', function () {
                console.log('JSON editor active - manual edits will override form values on save');
            });
        }
    });
</script>
}
