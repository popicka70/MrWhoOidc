@page "{id:guid}"
@model MrWhoOidc.WebAuth.Pages.Admin.Providers.EditModel
@{
    ViewData["Title"] = "Edit Identity Provider";
}

<h2>Edit Identity Provider</h2>

@if (!string.IsNullOrEmpty(Model.DiscoverySummary))
{
    <div class="alert @(Model.DiscoveryOk ? "alert-success" : "alert-danger")">
        <strong>@Model.DiscoverySummary</strong>
    </div>
}

@if (!string.IsNullOrEmpty(Model.DiscoveryJson))
{
    <div class="card mb-3">
        <div class="card-header">Discovery excerpt</div>
        <pre class="m-0 p-3"><code>@Model.DiscoveryJson</code></pre>
    </div>
}

@if (Model.Input is null)
{
    <p>Provider not found.</p>
}
else
{
<form method="post" asp-page="" enctype="multipart/form-data">
    @* Preserve both the route id and the bound model id so model binding hydrates Input.Id *@
    <input type="hidden" name="id" value="@Model.Input.Id" />
    <input asp-for="Input.Id" type="hidden" />

    <div class="mb-3">
        <div asp-validation-summary="All" class="text-danger"></div>
    </div>

    @* Bootstrap Tabs *@
    <ul class="nav nav-tabs mb-3" id="providerTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab" aria-controls="general" aria-selected="true">
                <i class="bi bi-info-circle me-1"></i>General
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="config-tab" data-bs-toggle="tab" data-bs-target="#config" type="button" role="tab" aria-controls="config" aria-selected="false">
                <i class="bi bi-code-square me-1"></i>Configuration
            </button>
        </li>
    </ul>

    <div class="tab-content" id="providerTabsContent">
        @* General Tab *@
        <div class="tab-pane fade show active" id="general" role="tabpanel" aria-labelledby="general-tab">
            <div class="mb-3">
                <label asp-for="Input.Name" class="form-label"></label>
                <input asp-for="Input.Name" class="form-control" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.DisplayName" class="form-label"></label>
                <input asp-for="Input.DisplayName" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.Type" class="form-label"></label>
                <select asp-for="Input.Type" class="form-select" asp-items="Model.TypeOptions"></select>
            </div>
            <div class="form-check mb-3">
                <input asp-for="Input.Enabled" class="form-check-input" />
                <label asp-for="Input.Enabled" class="form-check-label"></label>
            </div>
            <div class="form-check mb-3">
                <input asp-for="Input.IsDefault" class="form-check-input" />
                <label asp-for="Input.IsDefault" class="form-check-label"></label>
            </div>
            <div class="mb-3">
                <label asp-for="Input.SortOrder" class="form-label"></label>
                <input asp-for="Input.SortOrder" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Logo</label>
                @if (!string.IsNullOrWhiteSpace(Model.Input.LogoUrl))
                {
                    <div class="mb-2">
                        <img src="@Model.Input.LogoUrl" alt="Logo" style="max-height:64px" />
                    </div>
                }
                <div class="d-flex gap-2 align-items-center">
                    <input type="file" asp-for="Logo" class="form-control" accept="image/png,image/jpeg,image/svg+xml,image/webp" />
                    <button type="submit" class="btn btn-outline-secondary" asp-page-handler="UploadLogo">Upload</button>
                    <button type="submit" class="btn btn-outline-danger" asp-page-handler="ClearLogo">Clear</button>
                </div>
                <div class="form-text">PNG/JPG/SVG/WEBP, up to 512 KB.</div>
            </div>

            <div class="mb-3">
                <label asp-for="Input.LogoUrl" class="form-label"></label>
                <input asp-for="Input.LogoUrl" class="form-control" />
                <span class="form-text">Optional direct URL; uploading overrides this.</span>
            </div>
        </div>

        @* Configuration Tab *@
        <div class="tab-pane fade" id="config" role="tabpanel" aria-labelledby="config-tab">
            <div class="mb-3">
                <label class="form-label">Config JSON (OIDC)</label>
                <textarea asp-for="Input.ConfigJson" class="form-control font-monospace" id="configJsonTextarea" style="height: calc(100vh - 350px); min-height: 400px;"></textarea>
                <span asp-validation-for="Input.ConfigJson" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2 align-items-center">
                <button type="button" class="btn btn-outline-secondary" id="formatJsonBtn">
                    <i class="bi bi-code-slash me-1"></i>Format JSON
                </button>
                <button type="submit" class="btn btn-outline-primary" asp-page-handler="Test" formnovalidate>
                    <i class="bi bi-cloud-check me-1"></i>Test connection
                </button>
                <span class="form-text">Tests discovery endpoint reachability and shows a brief summary.</span>
            </div>
        </div>
    </div>

    <hr class="my-4" />
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save me-1"></i>Save
        </button>
        <a asp-page="Index" class="btn btn-secondary">
            <i class="bi bi-x-circle me-1"></i>Cancel
        </a>
    </div>
</form>

@* JSON Formatting Script *@
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const formatBtn = document.getElementById('formatJsonBtn');
        const textarea = document.getElementById('configJsonTextarea');
        
        if (formatBtn && textarea) {
            formatBtn.addEventListener('click', function() {
                try {
                    const json = JSON.parse(textarea.value);
                    textarea.value = JSON.stringify(json, null, 2);
                    formatBtn.classList.remove('btn-outline-secondary');
                    formatBtn.classList.add('btn-success');
                    setTimeout(() => {
                        formatBtn.classList.remove('btn-success');
                        formatBtn.classList.add('btn-outline-secondary');
                    }, 1000);
                } catch (e) {
                    alert('Invalid JSON: ' + e.message);
                }
            });
        }
    });
</script>
}
