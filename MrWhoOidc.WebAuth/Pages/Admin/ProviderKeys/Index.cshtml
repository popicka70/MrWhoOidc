@page "{providerId:guid}"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Admin.ProviderKeys.IndexModel
@{
    ViewData["Title"] = "Provider Keys";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Enabled 
        ? $"/t/{currentTenant.Slug}" 
        : "";
}

<h2>Keys for @Model.ProviderDisplay</h2>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}
@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

<form method="post" class="mb-4">
    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="Input.Purpose" class="form-label">Purpose</label>
            <select asp-for="Input.Purpose" class="form-select">
                <option value="Signing">Signing</option>
                <option value="Encryption">Encryption</option>
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="Input.Alg" class="form-label">Alg</label>
            <input asp-for="Input.Alg" class="form-control" placeholder="RS256, PS256, ES256, RSA-OAEP, ECDH-ES..." />
        </div>
        <div class="col-md-3">
            <label asp-for="Input.Kid" class="form-label">Key ID (kid)</label>
            <input asp-for="Input.Kid" class="form-control" placeholder="auto if blank" />
        </div>
        <div class="col-md-2 form-check mt-4">
            <input asp-for="Input.Active" class="form-check-input" />
            <label asp-for="Input.Active" class="form-check-label">Set active</label>
        </div>
        <div class="col-md-2 form-check mt-4">
            <input asp-for="Input.Publishable" class="form-check-input" />
            <label asp-for="Input.Publishable" class="form-check-label">Publishable</label>
        </div>
        <div class="col-md-3">
            <label asp-for="Input.ExpiresAt" class="form-label">Expires at (optional)</label>
            <input asp-for="Input.ExpiresAt" class="form-control" type="datetime-local" />
        </div>
        <div class="col-12">
            <label asp-for="Input.JwkJson" class="form-label">Private JWK JSON or PEM</label>
            <textarea asp-for="Input.JwkJson" class="form-control" rows="6" placeholder='{"kty":"RSA",...} or -----BEGIN PRIVATE KEY-----'></textarea>
            <span class="form-text">Paste a private JWK (JSON) or a PEM (RSA/EC private key). We'll convert PEM to JWK.</span>
        </div>
        <div class="col-12 d-flex gap-2">
            <button type="submit" asp-page-handler="Add" class="btn btn-primary">Import key</button>
            <button type="submit" asp-page-handler="Pretty" class="btn btn-outline-secondary">Pretty</button>
            <button type="submit" asp-page-handler="Compact" class="btn btn-outline-secondary">Compact</button>
            <a href="@(tenantPrefix)/Admin/Providers/Index" class="btn btn-secondary ms-auto">Back</a>
        </div>
    </div>
</form>

@if (Model.Preview is not null)
{
    <div class="card mb-3">
        <div class="card-header">JWK preview</div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3"><strong>kid</strong><br />@Model.Preview.Kid</div>
                <div class="col-md-2"><strong>alg</strong><br />@Model.Preview.Alg</div>
                <div class="col-md-2"><strong>kty</strong><br />@Model.Preview.Kty</div>
                <div class="col-md-2"><strong>use</strong><br />@Model.Preview.Use</div>
                <div class="col-md-3"><strong>thumbprint (b64url)</strong><br /><code>@Model.Preview.ThumbprintB64Url</code></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Preview.Curve))
            {
                <div class="mt-2"><strong>curve</strong>: @Model.Preview.Curve</div>
            }
        </div>
    </div>
}

@if (Model.Rows.Count == 0)
{
    <p>No keys.</p>
}
else
{
    <table class="table table-sm align-middle jwks-preview-table">
        <thead>
            <tr>
                <th>Status</th>
                <th>Purpose</th>
                <th>Alg</th>
                <th>KTY</th>
                <th>use</th>
                <th>KID</th>
                <th>Active</th>
                <th>Publishable</th>
                <th>Created</th>
                <th>Expires</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            var rowClass = r.Active ? (r.Publishable ? "table-success" : "table-warning") : "table-secondary";
            <tr class="@rowClass">
                <td>
                    @if (r.Active)
                    {
                        <span class="badge bg-success" title="Active: currently selected for its purpose" aria-label="active key">active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary" title="Inactive: staged or retired" aria-label="inactive key">inactive</span>
                    }
                    @if (r.Publishable)
                    {
                        <span class="badge bg-primary ms-1" title="Publishable: will be exposed via provider JWKS if enabled" aria-label="publishable">pub</span>
                    }
                    else
                    {
                        <span class="badge bg-dark ms-1" title="Private only: will NOT appear in provider JWKS" aria-label="private only">priv</span>
                    }
                </td>
                <td>@r.Purpose</td>
                <td><code>@r.Alg</code></td>
                <td>@r.Kty</td>
                <td>@r.Use</td>
                <td><code>@r.Kid</code></td>
                <td>@(r.Active ? "Yes" : "No")</td>
                <td>@(r.Publishable ? "Yes" : "No")</td>
                <td class="text-nowrap" title="@r.CreatedAt.ToString("O")">@r.CreatedAt.ToString("u")</td>
                <td class="text-nowrap" title="@r.ExpiresAt?.ToString("O")">@(r.ExpiresAt?.ToString("u"))</td>
                <td class="text-end text-nowrap">
                    @if (!r.Active)
                    {
                        <form method="post" asp-page-handler="Activate" class="d-inline">
                            <input type="hidden" name="id" value="@r.Id" />
                            <button class="btn btn-sm btn-success">Activate</button>
                        </form>
                    }
                    @if (!r.Publishable)
                    {
                        <form method="post" asp-page-handler="Publish" class="d-inline">
                            <input type="hidden" name="id" value="@r.Id" />
                            <button class="btn btn-sm btn-outline-primary">Publish</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Unpublish" class="d-inline">
                            <input type="hidden" name="id" value="@r.Id" />
                            <button class="btn btn-sm btn-outline-warning">Unpublish</button>
                        </form>
                    }
                    <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('Delete this key?');">
                        <input type="hidden" name="id" value="@r.Id" />
                        <button class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
<div class="mt-3 small" aria-describedby="jwks-legend-heading">
    <strong id="jwks-legend-heading">Legend:</strong>
    <ul class="list-inline mb-0">
        <li class="list-inline-item"><span class="badge bg-success">active</span> = currently selected key for its purpose</li>
        <li class="list-inline-item"><span class="badge bg-secondary">inactive</span> = staged / retired (not used)</li>
        <li class="list-inline-item"><span class="badge bg-primary">pub</span> = publishable (in provider JWKS)</li>
        <li class="list-inline-item"><span class="badge bg-dark">priv</span> = private only (excluded from provider JWKS)</li>
    </ul>
</div>

<style nonce="@(ViewContext.HttpContext.Items["csp-nonce"] as string ?? string.Empty)">
    /* Advanced JWKS visual preview styling */
    .jwks-preview-table code { font-size: .85rem; }
    .jwks-preview-table td, .jwks-preview-table th { vertical-align: middle; }
    .jwks-preview-table tr.table-secondary { opacity: 0.75; }
    .jwks-preview-table tr.table-warning { /* active but not publishable scenario shouldn't happen often */ }
    @@media (max-width: 992px) {
        .jwks-preview-table { font-size: .8rem; }
        .jwks-preview-table .badge { font-size: .55rem; }
    }
</style>
