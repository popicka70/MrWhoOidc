@page
@model MrWhoOidc.WebAuth.Pages.Admin.Roles.AddModel
@{
    ViewData["Title"] = "Add role";
}

<h1>Add role</h1>

<form method="post" class="mt-3">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="Input.TenantId" class="form-label">Tenant</label>
        <select asp-for="Input.TenantId" asp-items="Model.TenantOptions" class="form-select" 
                onchange="this.form.submit()">
            <option value="">-- Select tenant --</option>
        </select>
        <span asp-validation-for="Input.TenantId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Realm</label>
        <select asp-for="Input.RealmId" class="form-select">
            @if (!Model.Realms.Any())
            {
                <option value="">-- No realms available (select tenant first) --</option>
            }
            else
            {
                <option value="">-- Select realm --</option>
                @foreach (var r in Model.Realms)
                {
                    <option value="@r.Id">@r.Name</option>
                }
            }
        </select>
        <span asp-validation-for="Input.RealmId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input asp-for="Input.Name" class="form-control" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="Input.IsActive" class="form-check-input" />
        <label class="form-check-label" asp-for="Input.IsActive">Active</label>
    </div>
    <button class="btn btn-primary" type="submit">Save</button>
    <a class="btn btn-secondary" asp-page="Index">Cancel</a>
</form>

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
