@page "/admin/roles/add"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject Microsoft.Extensions.Options.IOptions<MrWhoOidc.Auth.MultiTenancy.MultiTenancyOptions> MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Admin.Roles.AddModel
@{
    ViewData["Title"] = "Add role";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant is not null && MultiTenancyOptions.Value.Enabled
        ? $"/t/{currentTenant.Slug}"
        : string.Empty;
    var rolesIndexPath = string.IsNullOrEmpty(tenantPrefix)
        ? "/admin/roles"
        : $"{tenantPrefix}/admin/roles";
}

<h1>Add role</h1>

<form method="post" class="mt-3">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    @if (currentTenant is not null)
    {
        <div class="alert alert-info d-flex align-items-center gap-2" role="status">
            <i class="bi bi-building"></i>
            <div>
                Roles created here automatically belong to <strong>@currentTenant.Name</strong> (@currentTenant.Slug).
            </div>
        </div>
    }
    <div class="mb-3">
        <label class="form-label">Realm</label>
        <select asp-for="Input.RealmId" class="form-select">
            @if (!Model.Realms.Any())
            {
                <option value="">-- No realms available for this tenant --</option>
            }
            else
            {
                <option value="">-- Select realm --</option>
                @foreach (var r in Model.Realms)
                {
                    <option value="@r.Id">@r.Name</option>
                }
            }
        </select>
        <span asp-validation-for="Input.RealmId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input asp-for="Input.Name" class="form-control" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="Input.IsActive" class="form-check-input" />
        <label class="form-check-label" asp-for="Input.IsActive">Active</label>
    </div>
    <button class="btn btn-primary" type="submit">Save</button>
    <a class="btn btn-secondary" href="@rolesIndexPath">Cancel</a>
</form>

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
