@page
@model MrWhoOidc.WebAuth.Pages.Admin.Roles.IndexModel
@{
    ViewData["Title"] = "Roles";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="m-0">
            <i class="bi bi-person-badge text-primary me-2"></i>
            Roles
        </h1>
        <p class="text-muted mb-0">Manage user roles and permissions</p>
    </div>
    <a class="btn btn-success" asp-page="Add">
        <i class="bi bi-plus-lg"></i> Add Role
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">
                    <i class="bi bi-building me-1"></i>Tenant
                </label>
                <select class="form-select" name="tenantId" onchange="this.form.submit()">
                    @foreach (var opt in Model.TenantOptions)
                    {
                        <option value="@opt.Value" selected="@(opt.Value == Model.TenantId?.ToString())">@opt.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">
                    <i class="bi bi-diagram-3 me-1"></i>Realm
                </label>
                <select class="form-select" name="realmId" onchange="this.form.submit()">
                    <option value="">All realms</option>
                    @foreach (var r in Model.Realms)
                    {
                        <option value="@r.Id" selected="@(Model.SelectedRealmId == r.Id)">@r.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label">
                    <i class="bi bi-search me-1"></i>Search
                </label>
                <input class="form-control" type="text" name="search" value="@Model.Search" placeholder="Search roles..." />
            </div>
            <div class="col-md-1">
                <button class="btn btn-primary w-100" type="submit">
                    <i class="bi bi-funnel"></i> Filter
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive table-responsive-cards">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>
                        <i class="bi bi-tag me-1"></i>Name
                    </th>
                    <th class="d-none d-md-table-cell">
                        <i class="bi bi-diagram-3 me-1"></i>Realm
                    </th>
                    <th class="d-none d-lg-table-cell">
                        <i class="bi bi-building me-1"></i>Tenant
                    </th>
                    <th class="d-none d-md-table-cell">
                        <i class="bi bi-toggle-on me-1"></i>Active
                    </th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var r in Model.Roles)
            {
                <tr>
                    <td data-label="Name"><strong>@r.Name</strong></td>
                    <td data-label="Realm" class="d-none d-md-table-cell">
                        <span class="badge text-bg-secondary">@r.RealmName</span>
                    </td>
                    <td data-label="Tenant" class="d-none d-lg-table-cell">
                        <span class="badge text-bg-info">@r.TenantName</span>
                    </td>
                    <td data-label="Active" class="d-none d-md-table-cell">
                        @if (r.IsActive)
                        {
                            <span class="badge text-bg-success">
                                <i class="bi bi-check"></i> Yes
                            </span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">No</span>
                        }
                    </td>
                    <td data-label="Actions" class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-page="Edit" asp-route-id="@r.Id">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <form method="post" class="d-inline" asp-page-handler="Delete" asp-route-id="@r.Id" onsubmit="return confirm('Are you sure you want to delete this role?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
