@page "/admin/roles"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject Microsoft.Extensions.Options.IOptions<MrWhoOidc.Auth.MultiTenancy.MultiTenancyOptions> MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Admin.Roles.IndexModel
@{
    ViewData["Title"] = "Roles";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Value.Enabled 
        ? $"/t/{currentTenant.Slug}" 
        : "";
}

<div class="page-header">
    <div class="page-header__content">
        <h1 class="page-header__title">
            <i class="bi bi-person-badge icon-md icon-primary"></i>
            Roles
        </h1>
        <p class="page-header__subtitle">Manage user roles and permissions</p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn-success" href="@tenantPrefix/admin/roles/add">
            <i class="bi bi-plus-lg"></i> Add Role
        </a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            @if (Model.IsPlatformAdmin)
            {
                <div class="col-md-3">
                    <label class="form-label">
                        <i class="bi bi-building me-1"></i>Tenant Filter
                    </label>
                    <select class="form-select" name="tenantId" onchange="this.form.submit()">
                        @foreach (var opt in Model.TenantOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == Model.TenantId?.ToString())">@opt.Text</option>
                        }
                    </select>
                </div>
            }
            <div class="@(Model.IsPlatformAdmin ? "col-md-3" : "col-md-4")">
                <label class="form-label">
                    <i class="bi bi-diagram-3 me-1"></i>Realm
                </label>
                <select class="form-select" name="realmId" onchange="this.form.submit()">
                    <option value="">All realms</option>
                    @foreach (var r in Model.Realms)
                    {
                        <option value="@r.Id" selected="@(Model.SelectedRealmId == r.Id)">@r.Name</option>
                    }
                </select>
            </div>
            <div class="@(Model.IsPlatformAdmin ? "col-md-5" : "col-md-7")">
                <label class="form-label">
                    <i class="bi bi-search me-1"></i>Search
                </label>
                <input class="form-control" type="text" name="search" value="@Model.Search" placeholder="Search roles..." />
            </div>
            <div class="col-md-1">
                <button class="btn btn-primary w-100" type="submit">
                    <i class="bi bi-funnel"></i> Filter
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive table-responsive-cards">
        <table class="data-table align-middle mb-0">
            <thead>
                <tr>
                    <th>
                        <i class="bi bi-tag me-1"></i>Name
                    </th>
                    <th class="d-none d-md-table-cell">
                        <i class="bi bi-diagram-3 me-1"></i>Realm
                    </th>
                    <th class="d-none d-lg-table-cell">
                        <i class="bi bi-building me-1"></i>Tenant
                    </th>
                    <th class="d-none d-md-table-cell">
                        <i class="bi bi-toggle-on me-1"></i>Active
                    </th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var r in Model.Roles)
            {
                <tr>
                    <td data-label="Name"><strong>@r.Name</strong></td>
                    <td data-label="Realm" class="d-none d-md-table-cell">
                        <span class="badge text-bg-secondary">@r.RealmName</span>
                    </td>
                    <td data-label="Tenant" class="d-none d-lg-table-cell">
                        <span class="badge text-bg-info">@r.TenantName</span>
                    </td>
                    <td data-label="Active" class="d-none d-md-table-cell">
                        @if (r.IsActive)
                        {
                            <span class="badge text-bg-success">
                                <i class="bi bi-check"></i> Yes
                            </span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">No</span>
                        }
                    </td>
                    <td data-label="Actions" class="text-end">
                        <div class="btn-group btn-group-sm" role="group">
                            <a href="@(tenantPrefix)/admin/roles/edit/@r.Id" class="btn btn-outline-secondary" title="Edit">Edit</a>
                            <a asp-page="Delete" asp-route-id="@r.Id" class="btn btn-outline-danger" title="Delete">Del</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
