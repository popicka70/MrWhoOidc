@page "{id:guid}"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Admin.Roles.EditModel
@{
    ViewData["Title"] = "Edit role";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant is not null && MultiTenancyOptions.Enabled
        ? $"/t/{currentTenant.Slug}"
        : string.Empty;
    var rolesIndexPath = string.IsNullOrEmpty(tenantPrefix)
        ? "/admin/roles"
        : $"{tenantPrefix}/admin/roles";
}

<h1>Edit role</h1>

@if (!string.IsNullOrEmpty(Model.TenantName))
{
    <div class="alert alert-secondary mb-3">
        <i class="ph ph-buildings"></i> <strong>Tenant:</strong> <span class="badge text-bg-info">@Model.TenantName</span>
        | <strong>Realm:</strong> <span class="badge text-bg-secondary">@Model.RealmName</span>
    </div>
}

@if (Model.IsSystemRole)
{
    <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
        <i class="ph ph-shield-warning"></i>
        <div>
            <strong>@Model.Input.Name</strong> is a seeded system role. Authorization policies match on this
            role name, so it cannot be renamed or moved to another realm — only its active state can change.
        </div>
    </div>
}

<form method="post" class="mt-3">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    @if (Model.IsSystemRole)
    {
        // Disabled controls do not post their values; hidden inputs carry the original ones so
        // the server-side guard can compare against what the user actually submitted.
        <input type="hidden" asp-for="Input.RealmId" />
        <input type="hidden" asp-for="Input.Name" />
    }
    <div class="mb-3">
        <label class="form-label">Realm</label>
        <select asp-for="Input.RealmId" class="form-select" disabled="@(Model.IsSystemRole)">
            @foreach (var r in Model.Realms)
            {
                <option value="@r.Id" selected="@(Model.Input.RealmId == r.Id)">@r.Name</option>
            }
        </select>
        <div class="form-text">
            The realm the role lives in. Built-in authorization roles are bound to their seeded realm.
        </div>
        <span asp-validation-for="Input.RealmId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input asp-for="Input.Name" class="form-control" readonly="@(Model.IsSystemRole)" />
        <div class="form-text">
            The identifier assigned to users. Authorization policies match on this exact name.
        </div>
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Display name (optional)</label>
        <input asp-for="Input.DisplayName" class="form-control" maxlength="200" placeholder="e.g. Support Engineer" />
        <div class="form-text">
            A human-friendly label shown in the admin UI. Changing it never affects authorization.
        </div>
        <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="Input.IsActive" class="form-check-input" />
        <label class="form-check-label" asp-for="Input.IsActive">Active</label>
    </div>
    <button class="btn btn-primary" type="submit">Save</button>
    <a class="btn btn-secondary" href="@rolesIndexPath">Cancel</a>
</form>

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
