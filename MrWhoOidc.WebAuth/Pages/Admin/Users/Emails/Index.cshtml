@page "{userId:guid}"
@model MrWhoOidc.WebAuth.Pages.Admin.Users.Emails.IndexModel
@{
    ViewData["Title"] = "Alternative emails";
}

@{ ViewData["ActiveUserTab"] = "emails"; }
<h1 class="mb-3">Alternative emails</h1>
<partial name="~/Pages/Admin/Users/_UserTabs.cshtml" />

<form method="post" class="row g-2 mb-3" asp-page-handler="Add">
    <div class="col-auto">
        <input class="form-control" type="email" name="email" placeholder="name@example.com" required />
    </div>
    <div class="col-auto">
        <button class="btn btn-primary" type="submit">Add email</button>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Email</th>
            <th>Verified</th>
            <th>Verified at</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var e in Model.Items)
    {
        <tr>
            <td>@e.Email</td>
            <td>@(e.IsVerified ? "Yes" : "No")</td>
            <td>@(e.VerifiedAt?.ToLocalTime().ToString("g"))</td>
            <td class="text-end">
                <form method="post" class="d-inline" asp-page-handler="Toggle" asp-route-emailId="@e.Id">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">@(e.IsVerified ? "Mark unverified" : "Mark verified")</button>
                </form>
                <form method="post" class="d-inline" asp-page-handler="Delete" asp-route-emailId="@e.Id" onsubmit="return confirm('Delete this email?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
