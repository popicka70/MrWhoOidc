@page "/admin/users/add"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Admin.Users.AddModel
@{
    ViewData["Title"] = "Add user";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Enabled
        ? $"/t/{currentTenant.Slug}"
        : string.Empty;
    var usersIndexPath = string.IsNullOrEmpty(tenantPrefix)
        ? "/admin/users"
        : $"{tenantPrefix}/admin/users";
}

<div class="page-header">
    <div class="page-header__content">
        <h1 class="page-header__title">
            <i class="ph ph-user-plus icon-md icon-primary"></i>
            Add user
        </h1>
    </div>
</div>

@if (currentTenant is not null)
{
    <div class="alert alert-info d-flex align-items-center gap-2" role="status">
        <i class="ph ph-buildings"></i>
        <div>User will be created in <strong>@currentTenant.Name</strong> (@currentTenant.Slug).</div>
    </div>
}

<div class="alert alert-secondary d-flex align-items-start gap-2" role="note">
    <i class="ph ph-info mt-1"></i>
    <div>
        <strong>Passwordless by design.</strong> Users are created without a password. The person sets
        their first password themselves via <em>Forgot password</em> on the sign-in page — the reset
        link doubles as first-time account setup. Users who already have a global account should be
        <a href="@(usersIndexPath)">invited</a> instead of re-created.
    </div>
</div>

<form method="post" class="mt-3">
    <div class="form-group">
        <label class="form-label">Username <span class="text-danger">*</span></label>
        <input asp-for="Input.Username" class="form-control" />
        <span asp-validation-for="Input.Username" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label class="form-label">Email (optional)</label>
        <input asp-for="Input.Email" class="form-control" />
        <div class="form-text">Needed for the password-reset / first-login flow — strongly recommended.</div>
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label class="form-label">Name (display)</label>
        <input asp-for="Input.Name" class="form-control" />
    </div>
    <div class="action-buttons">
        <button class="btn btn-primary" type="submit">
            <i class="ph ph-check"></i> Save
        </button>
        <a class="btn btn-secondary" href="@usersIndexPath">Cancel</a>
    </div>
</form>

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
