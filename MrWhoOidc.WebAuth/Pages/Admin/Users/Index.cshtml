@page
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject Microsoft.Extensions.Options.IOptions<MrWhoOidc.Auth.MultiTenancy.MultiTenancyOptions> MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Users";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Value.Enabled 
        ? $"/t/{currentTenant.Slug}" 
        : "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="m-0">
            <i class="bi bi-people-fill text-primary me-2"></i>
            Users
        </h1>
        <p class="text-muted mb-0">Manage user accounts and permissions</p>
    </div>
    <a class="btn btn-success" asp-page="Add">
        <i class="bi bi-plus-lg"></i> Add User
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            @if (Model.IsPlatformAdmin)
            {
                <div class="col-md-4">
                    <label class="form-label">
                        <i class="bi bi-building me-1"></i>Tenant Filter
                    </label>
                    <select class="form-select" name="tenantId" onchange="this.form.submit()">
                        @foreach (var opt in Model.TenantOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == Model.TenantId?.ToString())">@opt.Text</option>
                        }
                    </select>
                </div>
            }
            <div class="@(Model.IsPlatformAdmin ? "col-md-5" : "col-md-9")">
                <label class="form-label">
                    <i class="bi bi-search me-1"></i>Search
                </label>
                <input class="form-control" type="text" name="search" value="@Model.Search" placeholder="Search by username, email, or name..." />
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary w-100" type="submit">
                    <i class="bi bi-funnel"></i> Filter
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive table-responsive-cards">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>
                        <i class="bi bi-person me-1"></i>Username
                    </th>
                    <th>
                        <i class="bi bi-envelope me-1"></i>Email
                    </th>
                    <th class="d-none d-md-table-cell">
                        <i class="bi bi-card-text me-1"></i>Name
                    </th>
                    <th class="d-none d-lg-table-cell">
                        <i class="bi bi-building me-1"></i>Tenant
                    </th>
                    <th class="d-none d-md-table-cell">
                        <i class="bi bi-calendar me-1"></i>Created
                    </th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var u in Model.Users)
            {
                <tr>
                    <td data-label="Username"><strong>@u.Username</strong></td>
                    <td data-label="Email">@u.Email</td>
                    <td data-label="Name" class="d-none d-md-table-cell">@u.Name</td>
                    <td data-label="Tenant" class="d-none d-lg-table-cell">
                        <span class="badge text-bg-info">@u.TenantName</span>
                    </td>
                    <td data-label="Created" class="d-none d-md-table-cell">@u.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td data-label="Actions" class="text-end">
                        <div class="btn-group btn-group-sm" role="group">
                            <a href="@(tenantPrefix)/Admin/Users/Edit/@u.Id" class="btn btn-outline-secondary" title="Edit">Edit</a>
                            <a asp-page="Delete" asp-route-id="@u.Id" class="btn btn-outline-danger" title="Delete">Del</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
