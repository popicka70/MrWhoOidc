@page "/admin/users"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Users";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Enabled 
        ? $"/t/{currentTenant.Slug}" 
        : "";
}

@if (TempData["ResetPassword_Username"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="ph ph-check-circle icon-sm"></i>
        Password reset for user '<strong>@TempData["ResetPassword_Username"]</strong>'.<br/>
        Temporary password: <code class='user-select-all'>@TempData["ResetPassword_TempPassword"]</code><br/>
        <small class='text-info'><i class='ph ph-info'></i> This password applies to all @TempData["ResetPassword_AffectedTenantCount"] tenant(s) the user belongs to.</small><br/>
        <small class='text-warning'><i class='ph ph-warning'></i> Please save this password and share it securely with the user.</small>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="ph ph-check-circle icon-sm"></i>
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="ph ph-warning icon-sm"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="page-header">
    <div class="page-header__content">
        <h1 class="page-header__title">
            <i class="ph-fill ph-users icon-md icon-primary"></i>
            Users
        </h1>
        <p class="page-header__subtitle">Manage user accounts and permissions</p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn-outline-primary" href="@(tenantPrefix)/admin/invitations">
            <i class="ph ph-envelope-simple-open"></i> Invitations
        </a>
        <a class="btn btn-success" href="@(tenantPrefix)/admin/users/add">
            <i class="ph ph-plus"></i> Add User
        </a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-9">
                <label class="form-label">
                    <i class="ph ph-search icon-sm"></i> Search
                </label>
                <input class="form-control" type="text" name="search" value="@Model.Search" placeholder="Search by username, email, or name..." />
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary w-100" type="submit">
                    <i class="ph ph-funnel"></i> Filter
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>
                        <i class="ph ph-person icon-sm"></i> Username
                    </th>
                    <th>
                        <i class="ph ph-envelope-simple icon-sm"></i> Email
                    </th>
                    <th class="d-none d-md-table-cell">
                        <i class="ph ph-card-text icon-sm"></i> Name
                    </th>
                    <th class="d-none d-lg-table-cell">
                        <i class="ph ph-buildings icon-sm"></i> Tenant
                    </th>
                    <th class="d-none d-md-table-cell">
                        <i class="ph ph-calendar-blank icon-sm"></i> Created
                    </th>
                    <th>
                        <i class="ph ph-circle-half icon-sm"></i> Status
                    </th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var u in Model.Users)
            {
                <tr class="data-table__row">
                    <td data-label="Username"><strong>@u.Username</strong></td>
                    <td data-label="Email">@u.Email</td>
                    <td data-label="Name" class="d-none d-md-table-cell">@u.Name</td>
                    <td data-label="Tenant" class="d-none d-lg-table-cell">
                        <span class="badge text-bg-info">@u.TenantName</span>
                    </td>
                    <td data-label="Created" class="d-none d-md-table-cell">@u.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td data-label="Status">
                        @if (u.Status == MrWhoOidc.Auth.Persistence.UserStatus.Deactivated)
                        {
                            <span class="badge text-bg-secondary"><i class="ph ph-prohibit"></i> Deactivated</span>
                        }
                        else
                        {
                            <span class="badge text-bg-success"><i class="ph ph-check-circle"></i> Active</span>
                        }
                    </td>
                    <td data-label="Actions" class="text-end">
                        <div class="action-buttons">
                            <a href="@(tenantPrefix)/admin/users/edit/@u.Id" class="btn btn-sm btn-outline-secondary" title="Edit">
                                <i class="ph ph-pencil-simple"></i> Edit
                            </a>
                            @if (Model.IsPlatformAdmin)
                            {
                                <button type="button" class="btn btn-sm btn-outline-warning" title="Reset Password" 
                                        data-bs-toggle="modal" data-bs-target="#resetPasswordModal" 
                                        data-user-id="@u.Id" data-username="@u.Username">
                                    <i class="ph ph-key"></i> Reset
                                </button>
                            }
                            <button type="button" class="btn btn-sm btn-outline-danger btn-delete-user" title="Delete" 
                                    data-confirm-msg="Delete user @u.Username? This cannot be undone."
                                    data-delete-form="deleteForm_@u.Id">
                                <i class="ph ph-trash"></i> Del
                            </button>
                            @if (u.Status == MrWhoOidc.Auth.Persistence.UserStatus.Active)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary btn-deactivate-user" title="Deactivate"
                                        data-confirm-msg="Deactivate user @u.Username? They will no longer be able to log in, but their data is preserved."
                                        data-delete-form="deactivateForm_@u.Id">
                                    <i class="ph ph-power"></i> Deact
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-success btn-reactivate-user" title="Reactivate"
                                        data-confirm-msg="Reactivate user @u.Username? They will be able to log in again."
                                        data-delete-form="reactivateForm_@u.Id">
                                    <i class="ph ph-power"></i> React
                                </button>
                            }
                        </div>
                        <form id="deleteForm_@u.Id" method="post" asp-page-handler="Delete" asp-route-id="@u.Id" class="d-none"></form>
                        <form id="deactivateForm_@u.Id" method="post" asp-page-handler="Deactivate" asp-route-id="@u.Id" class="d-none"></form>
                        <form id="reactivateForm_@u.Id" method="post" asp-page-handler="Reactivate" asp-route-id="@u.Id" class="d-none"></form>
                        @if (Model.IsPlatformAdmin)
                        {
                            <form id="resetForm_@u.Id" method="post" asp-page-handler="ResetPassword" asp-route-id="@u.Id" class="d-none"></form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (Model.IsPlatformAdmin)
{
    <!-- Password Reset Confirmation Modal -->
    <div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title" id="resetPasswordModalLabel">
                        <i class="ph ph-warning"></i> Reset Password
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning">
                        <strong><i class="ph ph-globe"></i> Global Password Reset</strong>
                        <p class="mb-0 mt-2">
                            You are about to reset the password for user "<strong id="modalUsername"></strong>".
                        </p>
                    </div>
                    <p>
                        <i class="ph ph-info text-info"></i> 
                        This will reset the user's password <strong>across ALL tenants</strong> they belong to.
                        The user will need to use the new temporary password to log in to any organization.
                    </p>
                    <p class="mb-0">
                        <i class="ph ph-unlock text-success"></i> 
                        If the account is locked out, this will also unlock it.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-warning" id="confirmResetBtn">
                        <i class="ph ph-key"></i> Reset Password
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
    <script nonce="@(HttpContext.Items["csp-nonce"] as string ?? string.Empty)">
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.btn-deactivate-user').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    if (confirm(this.getAttribute('data-confirm-msg'))) {
                        var form = document.getElementById(this.getAttribute('data-delete-form'));
                        if (form) form.submit();
                    }
                });
            });
            document.querySelectorAll('.btn-reactivate-user').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    if (confirm(this.getAttribute('data-confirm-msg'))) {
                        var form = document.getElementById(this.getAttribute('data-delete-form'));
                        if (form) form.submit();
                    }
                });
            });
        });
    </script>
    @if (Model.IsPlatformAdmin)
    {
        <script nonce="@(HttpContext.Items["csp-nonce"] as string ?? string.Empty)">
            document.addEventListener('DOMContentLoaded', function() {
                // Delete user buttons
                document.querySelectorAll('.btn-delete-user').forEach(function(btn) {
                    btn.addEventListener('click', function() {
                        if (confirm(this.getAttribute('data-confirm-msg'))) {
                            var form = document.getElementById(this.getAttribute('data-delete-form'));
                            if (form) form.submit();
                        }
                    });
                });

                var resetModal = document.getElementById('resetPasswordModal');
                var currentUserId = null;
                
                resetModal.addEventListener('show.bs.modal', function(event) {
                    var button = event.relatedTarget;
                    currentUserId = button.getAttribute('data-user-id');
                    var username = button.getAttribute('data-username');
                    document.getElementById('modalUsername').textContent = username;
                });
                
                document.getElementById('confirmResetBtn').addEventListener('click', function() {
                    if (currentUserId) {
                        var form = document.getElementById('resetForm_' + currentUserId);
                        if (form) {
                            form.submit();
                        }
                    }
                });
            });
        </script>
    }
}
