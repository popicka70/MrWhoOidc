@page "{id:guid}"
@model MrWhoOidc.WebAuth.Pages.Admin.Users.EditModel
@{
    ViewData["Title"] = "Edit user";
}

<h1>Edit user</h1>

<form method="post" class="mt-3">
    <div class="mb-3">
        <label class="form-label">Username</label>
        <input asp-for="Input.Username" class="form-control" />
        <span asp-validation-for="Input.Username" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="Input.Email" class="form-control" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input asp-for="Input.Name" class="form-control" />
    </div>
    <button class="btn btn-primary" type="submit">Save</button>
    <a class="btn btn-secondary" asp-page="Index">Cancel</a>
</form>

<hr class="my-4" />
<div class="d-flex gap-2">
    <a class="btn btn-outline-secondary" asp-page="/Admin/Users/Emails/Index" asp-route-userId="@RouteData.Values["id"]">Manage alternative emails</a>
    <a class="btn btn-outline-secondary" asp-page="/Admin/Users/Clients/Index" asp-route-userId="@RouteData.Values["id"]">Manage client assignments</a>
    <a class="btn btn-outline-secondary" asp-page="/Admin/Users/Roles/Index" asp-route-userId="@RouteData.Values["id"]">Manage role assignments</a>
</div>

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
