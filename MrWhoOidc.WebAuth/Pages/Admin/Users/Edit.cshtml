@page "/admin/users/edit/{id:guid}"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Admin.Users.EditModel
@{
    ViewData["Title"] = "Edit user";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant is not null && MultiTenancyOptions.Enabled
        ? $"/t/{currentTenant.Slug}"
        : string.Empty;
    var usersIndexPath = string.IsNullOrEmpty(tenantPrefix)
        ? "/admin/users"
        : $"{tenantPrefix}/admin/users";
}

@{ ViewData["ActiveUserTab"] = "edit"; }

<div class="page-header">
    <div class="page-header__content">
        <h1 class="page-header__title">
            <i class="bi bi-person-gear icon-md icon-primary"></i>
            Edit user
        </h1>
        <p class="page-header__subtitle">@((ViewData["UserHeading"] as string) ?? Model.UserHeading ?? "")</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.TenantName))
{
    <div class="alert alert-secondary mb-3">
        <i class="bi bi-building icon-sm"></i> <strong>Tenant:</strong> <span class="badge text-bg-info">@Model.TenantName</span>
    </div>
}

<partial name="~/Pages/Admin/Users/_UserTabs.cshtml" />

<form method="post" class="mt-3">
    <div class="form-group">
        <label class="form-label">Username</label>
        <input asp-for="Input.Username" class="form-control" />
        <span asp-validation-for="Input.Username" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label class="form-label">Email</label>
        <input asp-for="Input.Email" class="form-control" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label class="form-label">Name</label>
        <input asp-for="Input.Name" class="form-control" />
    </div>
    <div class="action-buttons">
        <button class="btn btn-primary" type="submit">
            <i class="bi bi-check-lg"></i> Save
        </button>
        <a class="btn btn-secondary" href="@usersIndexPath">Cancel</a>
    </div>
</form>

<hr class="my-4" />
<div class="alert alert-info">Use the tabs above to manage emails, client assignments, roles, and linked external accounts.</div>

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
