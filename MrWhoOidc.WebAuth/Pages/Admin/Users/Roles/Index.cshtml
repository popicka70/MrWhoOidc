@page "{userId:guid}"
@model MrWhoOidc.WebAuth.Pages.Admin.Users.Roles.IndexModel
@{
    ViewData["Title"] = "Role assignments";
}

@{ ViewData["ActiveUserTab"] = "roles"; }
<h1 class="mb-3">Role assignments <small class="text-muted">@((ViewData["UserHeading"] as string) ?? Model.UserHeading ?? "")</small></h1>

@if (!string.IsNullOrEmpty(Model.TenantName))
{
    <div class="alert alert-secondary mb-3">
        <i class="ph ph-buildings"></i> <strong>User Tenant:</strong> <span class="badge text-bg-info">@Model.TenantName</span>
        <div class="small mt-1">Only realms, clients, and roles from this tenant can be assigned.</div>
    </div>
}

<partial name="~/Pages/Admin/Users/_UserTabs.cshtml" />

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.SelectedClientId.HasValue ? "" : "active")" id="realm-roles-tab" data-bs-toggle="tab" data-bs-target="#realm-roles" type="button" role="tab" aria-controls="realm-roles" aria-selected="@(!Model.SelectedClientId.HasValue ? "true" : "false")">
            <i class="ph ph-shield-check me-1"></i> Realm Roles
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.SelectedClientId.HasValue ? "active" : "")" id="client-roles-tab" data-bs-toggle="tab" data-bs-target="#client-roles" type="button" role="tab" aria-controls="client-roles" aria-selected="@(Model.SelectedClientId.HasValue ? "true" : "false")">
            <i class="ph ph-app-window-indicator me-1"></i> Client Roles
        </button>
    </li>
</ul>

<div class="tab-content">
    <!-- REALM ROLES TAB -->
    <div class="tab-pane fade @(Model.SelectedClientId.HasValue ? "" : "show active")" id="realm-roles" role="tabpanel" aria-labelledby="realm-roles-tab">
        @if (!Model.Realms.Any())
        {
            <div class="alert alert-warning">
                <i class="ph ph-warning"></i> No realms available in this tenant. Create a realm first.
            </div>
        }
        else
        {
            <!-- Realm Selector -->
            <div class="card mb-3">
                <div class="card-body">
                    <label class="form-label fw-bold">Select Realm</label>
                    <div class="btn-group-vertical d-flex gap-2" role="group" style="max-height: 300px; overflow-y: auto;">
                        @foreach (var realm in Model.Realms)
                        {
                            var isSelected = Model.SelectedRealmId == realm.Id;
                            var assignedCount = Model.RealmAssignments.Count(a => a.RealmId == realm.Id);
                            <a href="?SelectedRealmId=@realm.Id" class="btn btn-outline-primary text-start @(isSelected ? "active" : "")">
                                <i class="ph ph-shield me-2"></i>
                                <strong>@realm.Name</strong>
                                @if (assignedCount > 0)
                                {
                                    <span class="badge bg-secondary float-end">@assignedCount</span>
                                }
                            </a>
                        }
                    </div>
                </div>
            </div>

            @if (Model.SelectedRealmId.HasValue)
            {
                var selectedRealm = Model.Realms.FirstOrDefault(r => r.Id == Model.SelectedRealmId.Value);
                if (selectedRealm != null)
                {
                    var assignedRoleIds = Model.RealmAssignments
                        .Where(a => a.RealmId == Model.SelectedRealmId.Value)
                        .Select(a => a.RoleId)
                        .ToHashSet();

                    var availableRoles = Model.Roles
                        .Where(r => r.RealmId == Model.SelectedRealmId.Value && !assignedRoleIds.Contains(r.Id))
                        .ToList();

                    var assignedRoles = Model.RealmAssignments
                        .Where(a => a.RealmId == Model.SelectedRealmId.Value)
                        .OrderBy(a => a.RoleName)
                        .ToList();

                    <div class="row g-3">
                        <!-- Available Roles -->
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <i class="ph ph-plus-circle me-1"></i> Available Roles for <strong>@selectedRealm.Name</strong>
                                </div>
                                <div class="card-body p-0">
                                    @if (!availableRoles.Any())
                                    {
                                        <div class="p-3 text-muted text-center">
                                            <i class="ph ph-check-circle"></i> All roles assigned
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="list-group list-group-flush" style="max-height: 400px; overflow-y: auto;">
                                            @foreach (var role in availableRoles)
                                            {
                                                <form method="post" asp-page-handler="AddRealm" class="m-0">
                                                    <input type="hidden" name="SelectedRealmId" value="@Model.SelectedRealmId.Value" />
                                                    <input type="hidden" asp-for="RealmAddRoleId" value="@role.Id" />
                                                    <button type="submit" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center border-0">
                                                        <span>
                                                            <i class="ph ph-tag text-muted me-2"></i>
                                                            <strong>@role.Name</strong>
                                                        </span>
                                                        <i class="ph ph-arrow-right-circle text-primary"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Assigned Roles -->
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header bg-success text-white">
                                    <i class="ph ph-check-circle me-1"></i> Assigned Roles
                                </div>
                                <div class="card-body p-0">
                                    @if (!assignedRoles.Any())
                                    {
                                        <div class="p-3 text-muted text-center">
                                            <i class="ph ph-info"></i> No roles assigned yet
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="list-group list-group-flush" style="max-height: 400px; overflow-y: auto;">
                                            @foreach (var assignment in assignedRoles)
                                            {
                                                <div class="list-group-item d-flex justify-content-between align-items-center border-0">
                                                    <span>
                                                        <i class="ph ph-tag text-success me-2"></i>
                                                        <strong>@assignment.RoleName</strong>
                                                        @if (assignment.IsActive)
                                                        {
                                                            <span class="badge bg-success ms-2">Active</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary ms-2">Inactive</span>
                                                        }
                                                    </span>
                                                    <form method="post" asp-page-handler="DeleteRealm" asp-route-roleId="@assignment.RoleId" asp-route-realmId="@assignment.RealmId" class="m-0" onsubmit="return confirm('Remove role @assignment.RoleName?');">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                            <i class="ph ph-x-circle"></i> Remove
                                                        </button>
                                                    </form>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info">
                    <i class="ph ph-arrow-up"></i> Select a realm above to manage role assignments
                </div>
            }
        }
    </div>

    <!-- CLIENT ROLES TAB -->
    <div class="tab-pane fade @(Model.SelectedClientId.HasValue ? "show active" : "")" id="client-roles" role="tabpanel" aria-labelledby="client-roles-tab">
        @if (!Model.Clients.Any())
        {
            <div class="alert alert-warning">
                <i class="ph ph-warning"></i> No clients available in this tenant. Create a client first.
            </div>
        }
        else
        {
            <!-- Client Selector -->
            <div class="card mb-3">
                <div class="card-body">
                    <label class="form-label fw-bold">Select Client</label>
                    <div class="btn-group-vertical d-flex gap-2" role="group" style="max-height: 300px; overflow-y: auto;">
                        @foreach (var client in Model.Clients)
                        {
                            var isSelected = Model.SelectedClientId == client.Id;
                            var assignedCount = Model.ClientAssignments.Count(a => a.ClientGuid == client.Id);
                            <a href="?SelectedClientId=@client.Id" class="btn btn-outline-primary text-start @(isSelected ? "active" : "")">
                                <i class="ph ph-app-window me-2"></i>
                                <strong>@client.ClientId</strong>
                                @if (!string.IsNullOrEmpty(client.ClientName))
                                {
                                    <span class="text-muted ms-1">(@client.ClientName)</span>
                                }
                                @if (assignedCount > 0)
                                {
                                    <span class="badge bg-secondary float-end">@assignedCount</span>
                                }
                            </a>
                        }
                    </div>
                </div>
            </div>

            @if (Model.SelectedClientId.HasValue)
            {
                var selectedClient = Model.Clients.FirstOrDefault(c => c.Id == Model.SelectedClientId.Value);
                if (selectedClient != null)
                {
                    var assignedRoleIds = Model.ClientAssignments
                        .Where(a => a.ClientGuid == Model.SelectedClientId.Value)
                        .Select(a => a.RoleId)
                        .ToHashSet();

                    var availableRoles = Model.Roles
                        .Where(r => !assignedRoleIds.Contains(r.Id))
                        .ToList();

                    var assignedRoles = Model.ClientAssignments
                        .Where(a => a.ClientGuid == Model.SelectedClientId.Value)
                        .OrderBy(a => a.RoleName)
                        .ToList();

                    <div class="row g-3">
                        <!-- Available Roles -->
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <i class="ph ph-plus-circle me-1"></i> Available Roles for <strong>@selectedClient.ClientId</strong>
                                </div>
                                <div class="card-body p-0">
                                    @if (!availableRoles.Any())
                                    {
                                        <div class="p-3 text-muted text-center">
                                            <i class="ph ph-check-circle"></i> All roles assigned
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="list-group list-group-flush" style="max-height: 400px; overflow-y: auto;">
                                            @foreach (var role in availableRoles)
                                            {
                                                <form method="post" asp-page-handler="AddClient" class="m-0">
                                                    <input type="hidden" name="SelectedClientId" value="@Model.SelectedClientId.Value" />
                                                    <input type="hidden" asp-for="ClientAddRoleId" value="@role.Id" />
                                                    <button type="submit" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center border-0">
                                                        <span>
                                                            <i class="ph ph-tag text-muted me-2"></i>
                                                            <strong>@role.Name</strong>
                                                            <small class="text-muted ms-2">(@role.RealmName)</small>
                                                        </span>
                                                        <i class="ph ph-arrow-right-circle text-primary"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Assigned Roles -->
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header bg-success text-white">
                                    <i class="ph ph-check-circle me-1"></i> Assigned Roles
                                </div>
                                <div class="card-body p-0">
                                    @if (!assignedRoles.Any())
                                    {
                                        <div class="p-3 text-muted text-center">
                                            <i class="ph ph-info"></i> No roles assigned yet
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="list-group list-group-flush" style="max-height: 400px; overflow-y: auto;">
                                            @foreach (var assignment in assignedRoles)
                                            {
                                                <div class="list-group-item d-flex justify-content-between align-items-center border-0">
                                                    <span>
                                                        <i class="ph ph-tag text-success me-2"></i>
                                                        <strong>@assignment.RoleName</strong>
                                                        <small class="text-muted ms-2">(@assignment.RealmName)</small>
                                                        @if (assignment.IsActive)
                                                        {
                                                            <span class="badge bg-success ms-2">Active</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary ms-2">Inactive</span>
                                                        }
                                                    </span>
                                                    <form method="post" asp-page-handler="DeleteClient" asp-route-roleId="@assignment.RoleId" asp-route-clientId="@assignment.ClientGuid" class="m-0" onsubmit="return confirm('Remove role @assignment.RoleName?');">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                            <i class="ph ph-x-circle"></i> Remove
                                                        </button>
                                                    </form>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info">
                    <i class="ph ph-arrow-up"></i> Select a client above to manage role assignments
                </div>
            }
        }
    </div>
</div>

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
    <script>
        // Smooth scroll to top when realm/client is selected
        document.querySelectorAll('a[href^="?realm="], a[href^="?client="]').forEach(link => {
            link.addEventListener('click', function() {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        });
    </script>
}
