@page "{userId:guid}"
@model MrWhoOidc.WebAuth.Pages.Admin.Users.Roles.IndexModel
@{
    ViewData["Title"] = "Role assignments";
}

@{ ViewData["ActiveUserTab"] = "roles"; }
<h1 class="mb-3">Role assignments <small class="text-muted">@((ViewData["UserHeading"] as string) ?? Model.UserHeading ?? "")</small></h1>

@if (!string.IsNullOrEmpty(Model.TenantName))
{
    <div class="alert alert-secondary mb-3">
        <i class="bi bi-building"></i> <strong>User Tenant:</strong> <span class="badge text-bg-info">@Model.TenantName</span>
        <div class="small mt-1">Only realms, clients, and roles from this tenant can be assigned.</div>
    </div>
}

<partial name="~/Pages/Admin/Users/_UserTabs.cshtml" />

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">Realm roles</div>
            <div class="card-body">
                <form method="post" class="row g-2 align-items-end mb-3" asp-page-handler="AddRealm">
                    <div class="col-auto">
                        <label class="form-label">Realm</label>
                        <select class="form-select" asp-for="RealmAddRealmId">
                            @if (!Model.Realms.Any())
                            {
                                <option value="">-- No realms available --</option>
                            }
                            else
                            {
                                <option value="">-- Select realm --</option>
                                @foreach (var r in Model.Realms)
                                {
                                    <option value="@r.Id">@r.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <label class="form-label">Role</label>
                        <select class="form-select" asp-for="RealmAddRoleId">
                            @if (!Model.Roles.Any())
                            {
                                <option value="">-- No roles available --</option>
                            }
                            else
                            {
                                <option value="">-- Select role --</option>
                                @foreach (var r in Model.Roles)
                                {
                                    <option value="@r.Id">@r.Name (@r.RealmName)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-auto form-check mb-3">
                        <input class="form-check-input" asp-for="RealmIsActive" />
                        <label class="form-check-label" asp-for="RealmIsActive">Active</label>
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-primary" type="submit" disabled="@(!Model.Realms.Any() || !Model.Roles.Any())">Add</button>
                    </div>
                </form>

                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Realm</th>
                            <th>Role</th>
                            <th>Tenant</th>
                            <th>Active</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (!Model.RealmAssignments.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">No realm role assignments</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var a in Model.RealmAssignments)
                        {
                            <tr>
                                <td>@a.RealmName</td>
                                <td>@a.RoleName</td>
                                <td><span class="badge text-bg-info">@a.TenantName</span></td>
                                <td>@(a.IsActive ? "Yes" : "No")</td>
                                <td class="text-end">
                                    <form method="post" class="d-inline" asp-page-handler="DeleteRealm" asp-route-roleId="@a.RoleId" asp-route-realmId="@a.RealmId" onsubmit="return confirm('Remove this role?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">Client roles</div>
            <div class="card-body">
                <form method="post" class="row g-2 align-items-end mb-3" asp-page-handler="AddClient">
                    <div class="col-auto">
                        <label class="form-label">Client</label>
                        <select class="form-select" asp-for="ClientAddClientId">
                            @if (!Model.Clients.Any())
                            {
                                <option value="">-- No clients available --</option>
                            }
                            else
                            {
                                <option value="">-- Select client --</option>
                                @foreach (var c in Model.Clients)
                                {
                                    <option value="@c.Id">@c.ClientId @(!string.IsNullOrEmpty(c.ClientName) ? $"({c.ClientName})" : "")</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <label class="form-label">Role</label>
                        <select class="form-select" asp-for="ClientAddRoleId">
                            @if (!Model.Roles.Any())
                            {
                                <option value="">-- No roles available --</option>
                            }
                            else
                            {
                                <option value="">-- Select role --</option>
                                @foreach (var r in Model.Roles)
                                {
                                    <option value="@r.Id">@r.Name (@r.RealmName)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-auto form-check mb-3">
                        <input class="form-check-input" asp-for="ClientIsActive" />
                        <label class="form-check-label" asp-for="ClientIsActive">Active</label>
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-primary" type="submit" disabled="@(!Model.Clients.Any() || !Model.Roles.Any())">Add</button>
                    </div>
                </form>

                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Client</th>
                            <th>Realm</th>
                            <th>Role</th>
                            <th>Tenant</th>
                            <th>Active</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (!Model.ClientAssignments.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">No client role assignments</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var a in Model.ClientAssignments)
                        {
                            <tr>
                                <td>@a.ClientId @(!string.IsNullOrEmpty(a.ClientName) ? $"({a.ClientName})" : "")</td>
                                <td>@a.RealmName</td>
                                <td>@a.RoleName</td>
                                <td><span class="badge text-bg-info">@a.TenantName</span></td>
                                <td>@(a.IsActive ? "Yes" : "No")</td>
                                <td class="text-end">
                                    <form method="post" class="d-inline" asp-page-handler="DeleteClient" asp-route-roleId="@a.RoleId" asp-route-clientId="@a.ClientGuid" onsubmit="return confirm('Remove this role?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}

