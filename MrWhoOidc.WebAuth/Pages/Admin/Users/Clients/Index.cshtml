@page "{userId:guid}"
@model MrWhoOidc.WebAuth.Pages.Admin.Users.Clients.IndexModel
@{
    ViewData["Title"] = "Client assignments";
}

@{ ViewData["ActiveUserTab"] = "clients"; }
<h1 class="mb-3">Client assignments <small class="text-muted">@((ViewData["UserHeading"] as string) ?? Model.UserHeading ?? "")</small></h1>

@if (!string.IsNullOrEmpty(Model.TenantName))
{
    <div class="alert alert-secondary mb-3">
        <i class="ph ph-buildings"></i> <strong>User Tenant:</strong> <span class="badge text-bg-info">@Model.TenantName</span>
        <div class="small mt-1">Only clients from this tenant can be assigned.</div>
    </div>
}

<partial name="~/Pages/Admin/Users/_UserTabs.cshtml" />

<style>
    .client-list-scroll {
        max-height: 400px;
        overflow-y: auto;
    }
    .client-item:hover {
        background-color: var(--bs-light);
    }
</style>

<form method="post" autocomplete="off">
    <div class="row g-3">
        <div class="col-md-5">
            <div class="card h-100">
                <div class="card-header bg-secondary text-white">
                    <i class="ph ph-grid me-1"></i> Available Clients
                    <span class="badge bg-light text-dark ms-2">@Model.AvailableClients.Count</span>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush client-list-scroll" id="availableClientsList">
                        @if (!Model.AvailableClients.Any())
                        {
                            <div class="list-group-item text-center text-muted py-4">
                                <i class="ph ph-squares-four fs-4 d-block mb-2"></i>
                                No available clients
                            </div>
                        }
                        else
                        {
                            @foreach (var client in Model.AvailableClients.OrderBy(c => c.RealmName).ThenBy(c => c.ClientId))
                            {
                                <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center client-item">
                                    <div>
                                        <div class="fw-medium">@client.ClientId</div>
                                        <small class="text-muted">
                                            @if (!string.IsNullOrEmpty(client.ClientName))
                                            {
                                                @client.ClientName
                                                <span class="mx-1">·</span>
                                            }
                                            <span class="badge bg-secondary">@client.RealmName</span>
                                        </small>
                                    </div>
                                    <button type="submit" class="btn btn-sm btn-outline-success" 
                                            asp-page-handler="Assign" 
                                            name="clientId" value="@client.Id" 
                                            formnovalidate
                                            title="Assign client">
                                        <i class="ph ph-arrow-right"></i>
                                    </button>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 d-flex flex-column justify-content-center align-items-center gap-2">
            <div class="text-muted small text-center">
                <i class="ph ph-arrows-left-right fs-3"></i>
                <div class="mt-2">Click buttons to<br/>assign or remove</div>
            </div>
        </div>
        <div class="col-md-5">
            <div class="card h-100">
                <div class="card-header bg-success text-white">
                    <i class="ph ph-check-square me-1"></i> Assigned Clients
                    <span class="badge bg-light text-dark ms-2">@Model.AssignedClients.Count</span>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush client-list-scroll" id="assignedClientsList">
                        @if (!Model.AssignedClients.Any())
                        {
                            <div class="list-group-item text-center text-muted py-4">
                                <i class="ph ph-check-square fs-4 d-block mb-2"></i>
                                No clients assigned
                            </div>
                        }
                        else
                        {
                            @foreach (var client in Model.AssignedClients.OrderBy(c => c.RealmName).ThenBy(c => c.ClientId))
                            {
                                <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center client-item @(!client.IsActive ? "list-group-item-secondary" : "")">
                                    <div>
                                        <div class="fw-medium">
                                            @client.ClientId
                                            @if (!client.IsActive)
                                            {
                                                <span class="badge bg-secondary ms-1">Inactive</span>
                                            }
                                        </div>
                                        <small class="text-muted">
                                            @if (!string.IsNullOrEmpty(client.ClientName))
                                            {
                                                @client.ClientName
                                                <span class="mx-1">·</span>
                                            }
                                            <span class="badge bg-secondary">@client.RealmName</span>
                                        </small>
                                    </div>
                                    <button type="submit" class="btn btn-sm btn-outline-danger" 
                                            asp-page-handler="Unassign" 
                                            name="clientId" value="@client.Id" 
                                            formnovalidate
                                            title="Remove assignment">
                                        <i class="ph ph-arrow-left"></i>
                                    </button>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
