@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@* Shared user management tab navigation *@
@{
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Enabled 
        ? $"/t/{currentTenant.Slug}" 
        : "";
    
    var rd = ViewContext?.RouteData?.Values;
    string? idVal = null;
    if (rd is not null)
    {
        if (rd.ContainsKey("id")) idVal = rd["id"]?.ToString();
        else if (rd.ContainsKey("userId")) idVal = rd["userId"]?.ToString();
    }
    Guid.TryParse(idVal, out var userId);
    var active = (string?)ViewData["ActiveUserTab"] ?? string.Empty;
}
<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <a class="nav-link @(active=="edit"?"active":"")" href="@(tenantPrefix)/admin/users/edit/@userId">Profile</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(active=="emails"?"active":"")" href="@(tenantPrefix)/admin/users/emails/@userId">Emails</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(active=="clients"?"active":"")" href="@(tenantPrefix)/admin/users/clients/@userId">Clients</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(active=="roles"?"active":"")" href="@(tenantPrefix)/admin/users/roles/@userId">Roles</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(active=="linked"?"active":"")" href="@(tenantPrefix)/admin/users/linked/@userId">Linked accounts</a>
    </li>
</ul>
