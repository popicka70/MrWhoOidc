@page "{clientId:guid}"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Admin.ClientKeys.IndexModel
@{
    ViewData["Title"] = "Client Keys";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Enabled 
        ? $"/t/{currentTenant.Slug}" 
        : "";
}

<h2>Client Keys for @Model.ClientDisplay</h2>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}
@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

<div class="mb-3">
    <form method="post" class="row g-2" asp-page-handler="Fetch">
        <div class="col-md-6">
            <input asp-for="Input.PublicJwksUri" class="form-control" placeholder="https://client.example.com/jwks.json" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-secondary w-100">Fetch JWKS</button>
        </div>
        <div class="col-md-4 text-end">
            <a href="@(tenantPrefix)/admin/clients/edit/@Model.ClientId" class="btn btn-secondary">Back to client</a>
        </div>
    </form>
</div>

<form method="post" class="mb-3" asp-page-handler="Save">
    <div class="mb-2">
        <label class="form-label">Public JWKS JSON</label>
        <textarea asp-for="Input.PublicJwksJson" class="form-control" rows="10"></textarea>
        <div class="form-text">Paste or edit JWKS; on save, a snapshot will be stored in history.</div>
    </div>
    <div class="mb-2">
        @if (Model.JwksStatus is not null)
        {
            <span class="badge @(Model.JwksStatus.Ok ? "bg-success" : "bg-danger")">@Model.JwksStatus.Summary</span>
            <span class="ms-2 small">@Model.JwksStatus.Message</span>
        }
    </div>
    <button type="submit" class="btn btn-primary">Save JWKS</button>
</form>

<h3>History</h3>
@if (Model.History.Count == 0)
{
    <p>No history entries.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>When</th>
                <th>Source</th>
                <th>Hash</th>
                <th>Summary</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var h in Model.History)
        {
            <tr>
                <td>@h.CreatedAt.ToString("u")</td>
                <td>@h.Source</td>
                <td><code>@h.Hash</code></td>
                <td>@h.Summary</td>
                <td class="text-end">
                    <form method="post" asp-page-handler="Restore">
                        <input type="hidden" name="historyId" value="@h.Id" />
                        <button class="btn btn-sm btn-outline-primary">Restore</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
