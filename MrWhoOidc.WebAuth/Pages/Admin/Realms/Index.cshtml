@page "/admin/realms"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject Microsoft.Extensions.Options.IOptions<MrWhoOidc.Auth.MultiTenancy.MultiTenancyOptions> MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Admin.Realms.IndexModel
@{
    ViewData["Title"] = "Realms";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Value.Enabled 
        ? $"/t/{currentTenant.Slug}" 
        : "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="m-0">
            <i class="bi bi-diagram-3 text-primary me-2"></i>
            Realms
        </h1>
        <p class="text-muted mb-0">Manage authentication realms and namespaces</p>
    </div>
    <a class="btn btn-success" asp-page="Add">
        <i class="bi bi-plus-lg"></i> Add Realm
    </a>
</div>

@if (Model.IsPlatformAdmin)
{
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label">
                        <i class="bi bi-building me-1"></i>Tenant Filter
                    </label>
                    <select class="form-select" name="tenantId" onchange="this.form.submit()">
                        @foreach (var opt in Model.TenantOptions)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == Model.TenantId?.ToString())">@opt.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <button class="btn btn-primary w-100 mt-4" type="submit">
                        <i class="bi bi-funnel"></i> Filter
                    </button>
                </div>
            </form>
        </div>
    </div>
}

<div class="card">
    <div class="table-responsive table-responsive-cards">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>
                        <i class="bi bi-tag me-1"></i>Name
                    </th>
                    <th>
                        <i class="bi bi-card-heading me-1"></i>Display Name
                    </th>
                    <th class="d-none d-lg-table-cell">
                        <i class="bi bi-building me-1"></i>Tenant
                    </th>
                    <th class="d-none d-md-table-cell">
                        <i class="bi bi-calendar me-1"></i>Created
                    </th>
                    <th class="d-none d-lg-table-cell">
                        <i class="bi bi-envelope-check me-1"></i>Unconfirmed Login
                    </th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var r in Model.Realms)
            {
                <tr>
                    <td data-label="Name"><code>@r.Name</code></td>
                    <td data-label="Display Name"><strong>@r.DisplayName</strong></td>
                    <td data-label="Tenant" class="d-none d-lg-table-cell">
                        <span class="badge text-bg-info">@r.TenantName</span>
                    </td>
                    <td data-label="Created" class="d-none d-md-table-cell">@r.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td data-label="Unconfirmed Login" class="d-none d-lg-table-cell">
                        @if (r.AllowUnconfirmedLogin)
                        {
                            <span class="badge text-bg-success">Allowed</span>
                        }
                        else
                        {
                            <span class="badge text-bg-warning">Blocked</span>
                        }
                    </td>
                    <td data-label="Actions" class="text-end">
                        <div class="btn-group btn-group-sm" role="group">
                            <a href="@(tenantPrefix)/Admin/Realms/Edit/@r.Id" class="btn btn-outline-secondary" title="Edit">Edit</a>
                            <a asp-page="Delete" asp-route-id="@r.Id" class="btn btn-outline-danger" title="Delete">Del</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
