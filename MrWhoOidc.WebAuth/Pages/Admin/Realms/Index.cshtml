@page
@model MrWhoOidc.WebAuth.Pages.Admin.Realms.IndexModel
@{
    ViewData["Title"] = "Realms";
}

<h1>Realms</h1>

<div class="row">
    <div class="col-md-6">
        <h4>Create realm</h4>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Input.Name" class="form-label"></label>
                <input asp-for="Input.Name" class="form-control" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.DisplayName" class="form-label"></label>
                <input asp-for="Input.DisplayName" class="form-control" />
                <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Create</button>
        </form>
    </div>
</div>

<hr />

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Display name</th>
            <th>Created</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var r in Model.Realms)
    {
        <tr>
            <td>@r.Name</td>
            <td>@r.DisplayName</td>
            <td>@r.CreatedAt.ToLocalTime().ToString("g")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-page="Edit" asp-route-id="@r.Id">Edit</a>
                <form method="post" class="d-inline" asp-page-handler="Delete" asp-route-id="@r.Id" onsubmit="return confirm('Delete this realm?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
