@page "/admin/realms/add"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Admin.Realms.AddModel
@{
    ViewData["Title"] = "Add realm";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Enabled 
        ? $"/t/{currentTenant.Slug}" 
        : string.Empty;
    var realmsIndexPath = string.IsNullOrEmpty(tenantPrefix) 
        ? "/admin/realms" 
        : $"{tenantPrefix}/admin/realms";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="m-0">
            <i class="ph ph-shield-star text-primary me-2"></i>
            Add realm
        </h1>
        <p class="text-muted mb-0">
            Create an isolated space for users, clients, and roles within the tenant.
        </p>
    </div>
    <div>
        <a class="btn btn-outline-secondary" href="@realmsIndexPath">
            <i class="ph ph-arrow-left"></i> Back to realms
        </a>
    </div>
</div>

@if (currentTenant is not null)
{
    <div class="alert alert-info d-flex align-items-center gap-2" role="status">
        <i class="ph ph-buildings"></i>
        <div>
            Realm belongs to <strong>@currentTenant.Name</strong> (@currentTenant.Slug).
        </div>
    </div>
}

<form method="post" autocomplete="off" style="max-width: 640px;">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>
    <div class="mb-3">
        <label class="form-label" for="Input_Name">Name <span class="text-danger">*</span></label>
        <input asp-for="Input.Name" class="form-control" autocomplete="off" aria-required="true"
               placeholder="e.g. internal" />
        <div class="form-text">The realm identifier — 2-100 characters, unique within the tenant. Used in configuration and token issuance.</div>
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.DisplayName" class="form-label"></label>
        <input asp-for="Input.DisplayName" class="form-control" autocomplete="off"
               placeholder="e.g. Internal Services" />
        <div class="form-text">Optional human-friendly name shown in admin screens. Defaults to the identifier when empty.</div>
        <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
    </div>
    <div class="mb-4">
        <div class="form-check form-switch">
            <input asp-for="Input.AllowUnconfirmedLogin" class="form-check-input" type="checkbox" role="switch" />
            <label asp-for="Input.AllowUnconfirmedLogin" class="form-check-label"></label>
        </div>
        <div class="form-text">
            Controls whether users with unconfirmed primary emails may complete client sign-in flows.
        </div>
        <span asp-validation-for="Input.AllowUnconfirmedLogin" class="text-danger"></span>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary" asp-page-handler="Create">
            <i class="ph ph-plus me-1"></i>Create
        </button>
        <a href="@realmsIndexPath" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
