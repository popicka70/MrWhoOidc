@page "/admin/realms/add"
@model MrWhoOidc.WebAuth.Pages.Admin.Realms.AddModel
@{
    ViewData["Title"] = "Add realm";
}

<h1>Add realm</h1>

<form method="post" autocomplete="off">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Input.TenantId" class="form-label">Tenant</label>
        <select asp-for="Input.TenantId" asp-items="Model.TenantOptions" class="form-select">
            <option value="">-- Select tenant --</option>
        </select>
        <span asp-validation-for="Input.TenantId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Name" class="form-label"></label>
        <input asp-for="Input.Name" class="form-control" autocomplete="off" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.DisplayName" class="form-label"></label>
        <input asp-for="Input.DisplayName" class="form-control" autocomplete="off" />
        <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
    </div>
    <div class="form-check form-switch mb-3">
        <input asp-for="Input.AllowUnconfirmedLogin" class="form-check-input" type="checkbox" role="switch" />
        <label asp-for="Input.AllowUnconfirmedLogin" class="form-check-label"></label>
        <span asp-validation-for="Input.AllowUnconfirmedLogin" class="text-danger"></span>
        <div class="form-text">
            Controls whether users with unconfirmed primary emails may complete client sign-in flows.
        </div>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary" asp-page-handler="Create">Create</button>
        <a asp-page="Index" class="btn btn-secondary">Back</a>
    </div>
</form>

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
