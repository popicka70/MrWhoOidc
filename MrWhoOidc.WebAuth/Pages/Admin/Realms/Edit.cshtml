@page "{id:guid}"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject Microsoft.Extensions.Options.IOptions<MrWhoOidc.Auth.MultiTenancy.MultiTenancyOptions> MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Admin.Realms.EditModel
@{
    ViewData["Title"] = "Edit realm";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Value.Enabled
        ? $"/t/{currentTenant.Slug}"
        : string.Empty;
    var realmsIndexPath = string.IsNullOrEmpty(tenantPrefix)
        ? "/admin/realms"
        : $"{tenantPrefix}/admin/realms";
}

<h1>Edit realm</h1>

@if (!string.IsNullOrEmpty(Model.TenantName))
{
    <div class="alert alert-secondary mb-3">
        <i class="bi bi-building"></i> <strong>Tenant:</strong> <span class="badge text-bg-info">@Model.TenantName</span>
    </div>
}

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Input.Name" class="form-label"></label>
        <input asp-for="Input.Name" class="form-control" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.DisplayName" class="form-label"></label>
        <input asp-for="Input.DisplayName" class="form-control" />
        <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <div class="form-check form-switch">
            <input asp-for="Input.AllowUnconfirmedLogin" class="form-check-input" type="checkbox" role="switch" />
            <label asp-for="Input.AllowUnconfirmedLogin" class="form-check-label"></label>
        </div>
        <div class="form-text">
            When disabled, users must confirm their primary email before completing OIDC logins.
        </div>
        <span asp-validation-for="Input.AllowUnconfirmedLogin" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a href="@realmsIndexPath" class="btn btn-secondary">Back</a>
</form>

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
