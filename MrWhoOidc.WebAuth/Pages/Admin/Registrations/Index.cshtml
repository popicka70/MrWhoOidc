@page "/admin/registrations"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@model MrWhoOidc.WebAuth.Pages.Admin.Registrations.IndexModel
@{
    ViewData["Title"] = "Registrations";
    var currentTenant = TenantAccessor.CurrentTenant;
}

<div class="page-header">
    <div class="page-header__content">
        <h1 class="page-header__title">
            <i class="ph ph-clipboard-text icon-md icon-primary"></i>
            Registrations
        </h1>
        <p class="page-header__subtitle">Manage self-service user registration requests</p>
    </div>
    <div class="page-header__actions">
        <form method="get" class="d-flex gap-2 align-items-center">
            <label class="form-label mb-0 small text-muted" for="statusFilter">Status</label>
            <select class="form-select" id="statusFilter" name="Status" style="width: auto;" onchange="this.form.submit()">
                <option value="" selected="@(string.IsNullOrEmpty(Model.Status))">All</option>
                <option value="pending" selected="@(Model.Status == "pending")">Pending</option>
                <option value="approved" selected="@(Model.Status == "approved")">Approved</option>
                <option value="rejected" selected="@(Model.Status == "rejected")">Rejected</option>
            </select>
        </form>
    </div>
</div>

@if (currentTenant is not null)
{
    <div class="alert alert-info d-flex align-items-center gap-2" role="status">
        <i class="ph ph-buildings"></i>
        <div>
            Tenant registration requests belong to <strong>@currentTenant.Name</strong> (@currentTenant.Slug). Platform account requests are reviewed under Platform Admin.
        </div>
    </div>
}

<div class="card">
    <div class="table-responsive table-responsive-cards">
        <table class="table table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Name</th>
                    <th class="d-none d-md-table-cell">Client</th>
                    <th class="d-none d-md-table-cell">State</th>
                    <th class="d-none d-md-table-cell">Created</th>
                    <th class="d-none d-md-table-cell">Approved/Rejected</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Items.Any())
            {
                <tr>
                    <td colspan="7" class="text-center py-5 text-muted">
                        <i class="ph ph-clipboard-text icon-2xl d-block mb-2 mx-auto"></i>
                        @(string.IsNullOrEmpty(Model.Status)
                            ? "No registrations found."
                            : $"No {Model.Status} registrations found.")
                    </td>
                </tr>
            }
            @foreach (var r in Model.Items)
            {
                <tr>
                    <td data-label="Email">@r.Email</td>
                    <td data-label="Name">@(string.Join(' ', new[]{r.FirstName, r.LastName}.Where(s => !string.IsNullOrWhiteSpace(s))))</td>
                    <td data-label="Client" class="d-none d-md-table-cell">@r.ClientDisplay</td>
                    <td data-label="State" class="d-none d-md-table-cell">
                        @if (string.Equals(r.State, "pending", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge text-bg-warning">Pending</span>
                        }
                        else if (string.Equals(r.State, "approved", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge text-bg-success">Approved</span>
                        }
                        else if (string.Equals(r.State, "rejected", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge text-bg-danger">Rejected</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">@r.State</span>
                        }
                    </td>
                    <td data-label="Created" class="d-none d-md-table-cell">@r.CreatedAtLocal</td>
                    <td data-label="Decision" class="d-none d-md-table-cell">@r.Decision</td>
                    <td data-label="Actions" class="text-end">
                        @if (string.Equals(r.State, "pending", StringComparison.OrdinalIgnoreCase))
                        {
                            <form method="post" class="d-inline" asp-page-handler="Approve" asp-route-id="@r.Id">
                                <button type="submit" class="btn btn-sm btn-success">Approve</button>
                            </form>
                            <form method="post" class="d-inline" asp-page-handler="Reject" asp-route-id="@r.Id">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
