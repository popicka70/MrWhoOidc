@page "{id:guid}"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Admin.ProviderClaimMappings.EditModel
@{
    ViewData["Title"] = "Edit Claim Mapping";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Enabled
        ? $"/t/{currentTenant.Slug}"
        : string.Empty;
    var mappingsIndexPath = string.IsNullOrEmpty(tenantPrefix)
        ? $"/admin/providerclaimmappings/{Model.ProviderId}"
        : $"{tenantPrefix}/admin/providerclaimmappings/{Model.ProviderId}";
}

<h2>Edit Claim Mapping</h2>

@if (Model.Input is null)
{
    <p>Mapping not found.</p>
}

@if (Model.Input != null)
{
    <div>
        <form method="post">
            <div class="mb-3">
                <label asp-for="Input.ExternalClaim" class="form-label"></label>
                <input asp-for="Input.ExternalClaim" class="form-control" />
                <span asp-validation-for="Input.ExternalClaim" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.LocalClaim" class="form-label"></label>
                <input asp-for="Input.LocalClaim" class="form-control" />
                <span asp-validation-for="Input.LocalClaim" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Transform" class="form-label"></label>
                <input asp-for="Input.Transform" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.Order" class="form-label"></label>
                <input asp-for="Input.Order" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a href="@mappingsIndexPath" class="btn btn-secondary">Back</a>
        </form>
    </div>
}
