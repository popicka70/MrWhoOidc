@page "/account/delegated-access/granted-by-me"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Account.DelegatedAccess.GrantedByMeModel
@{
    ViewData["Title"] = "Grants Created by Me";
    ViewData["ActiveAccountTab"] = "delegated-access";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Enabled ? $"/t/{currentTenant.Slug}" : "";
}

<h1 class="mb-3">Grants Created by Me</h1>
@if (Model.Message != null) { <div class="alert alert-info">@Model.Message</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }

@if (!Model.Grants.Any())
{
    <div class="alert alert-info">You have not created any delegated access grants.</div>
}
else
{
    <div class="list-group">
        @foreach (var grant in Model.Grants)
        {
            <div class="list-group-item">
                <div class="d-flex justify-content-between gap-3">
                    <div>
                        <h2 class="h6 mb-1">Delegate: @grant.DelegateName</h2>
                        <div class="text-muted small">@grant.TenantName · @grant.Status · expires @grant.ExpiresAt.ToString("u")</div>
                        <p class="mb-1">@grant.Purpose</p>
                        @foreach (var capability in grant.Capabilities) { <span class="badge bg-primary me-1">@capability</span> }
                    </div>
                    @if (grant.Status is MrWhoOidc.Auth.Persistence.DelegatedAccessGrantStatus.PendingAcceptance or MrWhoOidc.Auth.Persistence.DelegatedAccessGrantStatus.Active or MrWhoOidc.Auth.Persistence.DelegatedAccessGrantStatus.Suspended)
                    {
                        <form method="post" asp-page-handler="RevokeGrant" asp-route-grantId="@grant.Id">
                            <input type="hidden" name="reason" value="Revoked by delegator" />
                            <button type="submit" class="btn btn-outline-danger">Revoke</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
}

<a href="@(tenantPrefix)/account/delegated-access" class="btn btn-link mt-3">Back to delegated access</a>