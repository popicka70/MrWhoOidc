@page "/account/delegated-access"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Account.DelegatedAccess.IndexModel
@{
    ViewData["Title"] = "Delegated Access";
    ViewData["ActiveAccountTab"] = "delegated-access";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Enabled ? $"/t/{currentTenant.Slug}" : "";
}

<div class="page-header">
    <div class="page-header__content">
        <h1 class="page-header__title"><i class="ph-fill ph-identity-card icon-md icon-primary"></i> Delegated Access</h1>
        <p class="page-header__subtitle">Grant specific, time-bounded capabilities or review authority delegated to you.</p>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning" role="alert">@TempData["Error"]</div>
}

<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5">Granted by me</h2>
                <p class="text-muted">@Model.GrantedByMe.Count grant(s)</p>
                <a href="@(tenantPrefix)/account/delegated-access/granted-by-me" class="btn btn-outline-primary">View grants</a>
                <a href="@(tenantPrefix)/account/delegated-access/create" class="btn btn-primary">Create grant</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5">Delegated to me</h2>
                <p class="text-muted">@Model.DelegatedToMe.Count grant(s)</p>
                <a href="@(tenantPrefix)/account/delegated-access/delegated-to-me" class="btn btn-outline-primary">View grants</a>
            </div>
        </div>
    </div>
</div>

<div class="alert alert-info mt-3">
    Delegated access never shares credentials or tenant-administrator authority. Invitations must be accepted through their secure invitation link.
</div>