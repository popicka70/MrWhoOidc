@page "/account/delegated-access/create"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Account.DelegatedAccess.CreateModel
@{
    ViewData["Title"] = "Create Delegated Access Grant";
    ViewData["ActiveAccountTab"] = "delegated-access";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Enabled
        ? $"/t/{currentTenant.Slug}"
        : "";
}

<div class="mt-2">
    <div class="page-header">
        <div class="page-header__content">
            <h1 class="page-header__title">
                <i class="ph-fill ph-plus icon-md icon-primary"></i>
                Create Delegated Access Grant
            </h1>
            <p class="page-header__subtitle">
                Grant specific capabilities to another member in your organization.
                Each grant is explicit, scoped, time-bounded, and revocable.
            </p>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["Warning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Security Warning (prominent) -->
    <div class="card border-danger mb-4">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">
                <i class="ph ph-shield-exclamation me-2"></i>
                Important Security Notice
                </h5>
                <div class="card-body">
                    <div class="alert alert-danger mb-0">
                        <i class="ph ph-warning me-2"></i>
                        <strong>Credentials and administrative authority are NOT shared.</strong>
                        Delegated access grants specific capabilities only — never your password, MFA keys,
                        WebAuthn credentials, recovery identity, or tenant administration authority.
                        Each grant is explicitly accepted, scoped, time-bounded, and revocable.
                    </div>
                </div>
        </div>
    </div>

    <form method="post" asp-antiforgery="true" asp-page-handler="CreateGrant">
        <div class="card shadow-sm mb-3">
            <div class="card-header"><h2 class="h5 mb-0">Delegate</h2></div>
            <div class="card-body">
                @if (Model.EligibleDelegates.Any())
                {
                    <select class="form-select" name="delegateId" required>
                        <option value="">Select a member</option>
                        @foreach (var candidate in Model.EligibleDelegates)
                        {
                            <option value="@candidate.Id">@candidate.Name (@candidate.Username)</option>
                        }
                    </select>
                }
                else
                {
                    <div class="alert alert-warning mb-0">No other active members are available in this tenant.</div>
                }
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header"><h2 class="h5 mb-0">Capabilities</h2></div>
            <div class="card-body">
                @foreach (var capability in Model.AvailableCapabilities)
                {
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="capabilities" value="@capability.Name" id="cap-@capability.Name" />
                        <label class="form-check-label" for="cap-@capability.Name">
                            <strong>@capability.DisplayName</strong>
                            <span class="d-block text-muted small">@capability.Description</span>
                        </label>
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header"><h2 class="h5 mb-0">Purpose and expiry</h2></div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="purpose" class="form-label">Purpose</label>
                    <input type="text" class="form-control" id="purpose" name="purpose" required maxlength="500" />
                </div>
                <div>
                    <label for="expiryDays" class="form-label">Expiry in days</label>
                    <input type="number" class="form-control" id="expiryDays" name="expiryDays" value="1" min="1" max="7" required />
                    <div class="form-text">The invitation expires earlier if the configured acceptance window is shorter.</div>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-success" disabled="@(!Model.EligibleDelegates.Any() || !Model.AvailableCapabilities.Any())">
            <i class="ph ph-plus me-2"></i>Create grant
        </button>
    </form>

    <!-- Quick Tips -->
    <div class="card mt-4 border-info">
        <div class="card-header bg-info text-white">
            <h6 class="mb-0">
                            <i class="ph ph-lightbulb me-2"></i>
                            Tips
                            </h6>
                <div class="card-body">
                    <ul class="mb-0">
                        <li>
                            <strong>Delegate must accept:</strong> After creating the grant, the delegate will receive an invitation to review and accept.
                        </li>
                        <li>
                            <strong>Immediate revocation:</strong> You can revoke this grant at any time before it expires.
                        </li>
                        <li>
                            <strong>Credentials stay yours:</strong> The delegate cannot access your password, MFA keys, or administrative authority.
                        </li>
                        <li>
                            <strong>Time bounded:</strong> Grants automatically expire after the set period. Shorter durations recommended.
                        </li>
                    </ul>
                </div>
        </div>
    </div>
</div>

@section Scripts {
    <script nonce="@(HttpContext.Items["csp-nonce"] as string ?? string.Empty)">
        setTimeout(function() {
            var alerts = document.querySelectorAll('.alert-dismissible');
            alerts.forEach(function(alert) {
                var bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>
}
