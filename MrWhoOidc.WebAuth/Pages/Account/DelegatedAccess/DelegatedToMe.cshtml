@page "/account/delegated-access/delegated-to-me"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@inject IConfiguration Configuration
@model MrWhoOidc.WebAuth.Pages.Account.DelegatedAccess.DelegatedToMeModel
@{
    ViewData["Title"] = "Grants Delegated to Me";
    ViewData["ActiveAccountTab"] = "delegated-access";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Enabled ? $"/t/{currentTenant.Slug}" : "";
    var razorClientDelegatedUrl = Configuration["DelegationDemo:RazorClientUrl"] ?? "https://localhost:5003/Delegated";
}

<h1 class="mb-3">Grants Delegated to Me</h1>
@if (Model.Message != null)
{
    <div class="alert alert-info">@Model.Message</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (!Model.Grants.Any())
{
    <div class="alert alert-info">No grants have been delegated to you.</div>
}
else
{
    <div class="list-group">
        @foreach (var grant in Model.Grants)
        {
            <div class="list-group-item">
                <div class="d-flex justify-content-between gap-3">
                    <div>
                        <h2 class="h6 mb-1">Delegator: @grant.DelegatorName</h2>
                        <div class="text-muted small">
                            @grant.TenantName · @grant.ClientName
                            @if (grant.OidcClientId != null)
                            {
                                <code>@grant.OidcClientId</code>
                            }
                            · @grant.Status · expires @grant.ExpiresAt.ToString("u")
                        </div>
                        <p class="mb-1">@grant.Purpose</p>
                        @foreach (var capability in grant.Capabilities)
                        {
                            <span class="badge bg-primary me-1">@capability</span>
                        }
                    </div>
                    <div>
                        @if (grant.Status == MrWhoOidc.Auth.Persistence.DelegatedAccessGrantStatus.Active)
                        {
                            <a asp-page="Activate" asp-route-id="@grant.Id" class="btn btn-outline-success">Activate</a>
                            @if (string.Equals(grant.OidcClientId, "blazor-web", StringComparison.Ordinal))
                            {
                                var demoUrl = $"{razorClientDelegatedUrl}?delegationId={grant.Id}";
                                <a href="@demoUrl" class="btn btn-outline-primary mt-2">Open RazorClient demo</a>
                            }
                        }
                        @if (grant.Status is MrWhoOidc.Auth.Persistence.DelegatedAccessGrantStatus.Active or MrWhoOidc.Auth.Persistence.DelegatedAccessGrantStatus.Suspended)
                        {
                            <form method="post" asp-page-handler="RelinquishGrant" asp-route-grantId="@grant.Id" class="mt-2">
                                <input type="hidden" name="reason" value="Relinquished by delegate" />
                                <button type="submit" class="btn btn-outline-danger">Relinquish</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<a href="@(tenantPrefix)/account/delegated-access" class="btn btn-link mt-3">Back to delegated access</a>