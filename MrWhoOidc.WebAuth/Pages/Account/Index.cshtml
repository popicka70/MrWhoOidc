@page "/account"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Account.IndexModel
@{
    ViewData["Title"] = "My Account";
    ViewData["ActiveAccountTab"] = "index";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Enabled 
        ? $"/t/{currentTenant.Slug}" 
        : "";
}

<h1 class="mb-3">My Account</h1>
<partial name="~/Pages/Account/_AccountTabs.cshtml" />

<div class="row g-4">
    <!-- Profile Card -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="ph-duotone ph-user-circle text-primary"></i> Profile
                </h5>
                <dl class="mb-3">
                    <dt class="small text-muted">Name</dt>
                    <dd class="mb-2">@(Model.Name ?? "(not set)")</dd>
                    
                    <dt class="small text-muted">Username</dt>
                    <dd class="mb-2"><code>@Model.Username</code></dd>
                    
                    <dt class="small text-muted">Email</dt>
                    <dd class="mb-0">
                        @Model.Email
                        @if (Model.EmailVerified)
                        {
                            <span class="badge bg-success ms-1"><i class="ph-duotone ph-check-circle"></i> Verified</span>
                        }
                        else
                        {
                            <span class="badge bg-warning ms-1"><i class="ph-duotone ph-warning-circle"></i> Not Verified</span>
                        }
                    </dd>
                </dl>
                <a href="@(tenantPrefix)/account/profile" class="btn btn-sm btn-outline-primary">
                    <i class="ph-duotone ph-pencil-simple me-1"></i>Edit Profile
                </a>
            </div>
            <div class="card-footer text-muted small">
                <i class="ph-duotone ph-calendar-blank me-1"></i>Member since @Model.AccountCreatedAt.ToString("MMM d, yyyy")
            </div>
        </div>
    </div>

    <!-- Organization Card -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="ph-duotone ph-buildings text-primary"></i> Organization
                </h5>
                <p class="card-text text-muted">
                    You are currently managing <strong>@(currentTenant?.Name ?? "Default")</strong>.
                </p>
                <div class="d-grid gap-2">
                    <a href="/select-tenant" class="btn btn-sm btn-outline-secondary">
                        <i class="ph-duotone ph-arrows-left-right me-1"></i>Switch Organization
                    </a>
                    <a href="@(tenantPrefix)/account/create-tenant" class="btn btn-sm btn-outline-primary">
                        <i class="ph-duotone ph-plus me-1"></i>Create New Organization
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Security Card -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="ph-duotone ph-shield @(Model.MfaEnabled ? "text-success" : "text-warning")"></i> Security
                </h5>
                <dl class="mb-3">
                    <dt class="small text-muted">Multi-Factor Authentication</dt>
                    <dd class="mb-2">
                        @if (Model.MfaEnabled)
                        {
                            <span class="badge bg-success">
                                <i class="ph-duotone ph-check-circle"></i> Enabled
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning">
                                <i class="ph-duotone ph-warning"></i> Disabled
                            </span>
                        }
                    </dd>
                    
                    <dt class="small text-muted">Security Keys (WebAuthn)</dt>
                    <dd class="mb-2">
                        @if (Model.WebAuthnCredentialsCount > 0)
                        {
                            <span class="badge bg-success">
                                <i class="ph-duotone ph-shield-check"></i> @Model.WebAuthnCredentialsCount key@(Model.WebAuthnCredentialsCount == 1 ? "" : "s")
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                <i class="ph-duotone ph-shield"></i> None
                            </span>
                        }
                    </dd>
                    
                    <dt class="small text-muted">Password</dt>
                    <dd class="mb-0">
                        <i class="ph-duotone ph-key"></i> •••••••••
                    </dd>
                </dl>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="@(tenantPrefix)/mfa" class="btn btn-sm btn-outline-primary">
                        <i class="ph-duotone ph-shield me-1"></i>MFA
                    </a>
                    <a href="@(tenantPrefix)/account/web-authn" class="btn btn-sm btn-outline-primary">
                        <i class="ph-duotone ph-shield-check me-1"></i>Keys
                    </a>
                    <a href="@(tenantPrefix)/password" class="btn btn-sm btn-outline-secondary">
                        <i class="ph-duotone ph-key me-1"></i>Password
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Sessions Card -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="ph-duotone ph-device-mobile text-info"></i> Active Sessions
                </h5>
                <div class="display-6 my-3">@Model.ActiveSessionsCount</div>
                <p class="card-text text-muted small mb-3">
                    Active devices with access to your account
                </p>
                <a href="@(tenantPrefix)/account/sessions" class="btn btn-sm btn-outline-primary">
                    <i class="ph-duotone ph-eye me-1"></i>View All Sessions
                </a>
            </div>
        </div>
    </div>

    <!-- Consents Card -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="ph-duotone ph-check-square text-success"></i> Authorized Apps
                </h5>
                <div class="display-6 my-3">@Model.ActiveConsentsCount</div>
                <p class="card-text text-muted small mb-3">
                    Applications with access to your data
                </p>
                <a href="@(tenantPrefix)/account/consents" class="btn btn-sm btn-outline-primary">
                    <i class="ph-duotone ph-eye me-1"></i>Manage Consents
                </a>
            </div>
        </div>
    </div>

    <!-- Linked Accounts Card -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="ph-duotone ph-link text-primary"></i> Linked Accounts
                </h5>
                <div class="display-6 my-3">@Model.LinkedAccountsCount</div>
                <p class="card-text text-muted small mb-3">
                    External identities linked to your account
                </p>
                <a href="@(tenantPrefix)/account/linked-accounts" class="btn btn-sm btn-outline-primary">
                    <i class="ph-duotone ph-eye me-1"></i>View Linked Accounts
                </a>
            </div>
        </div>
    </div>

    <!-- Alternative Emails Card -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="ph-duotone ph-envelope-simple text-secondary"></i> Alternative Emails
                </h5>
                <div class="display-6 my-3">@Model.AlternativeEmailsCount</div>
                <p class="card-text text-muted small mb-3">
                    Additional email addresses for your account
                </p>
                <a href="@(tenantPrefix)/account/emails" class="btn btn-sm btn-outline-primary">
                    <i class="ph-duotone ph-eye me-1"></i>Manage Emails
                </a>
            </div>
        </div>
    </div>
</div>

<div class="alert alert-info mt-4" role="alert">
    <h5 class="alert-heading"><i class="ph-duotone ph-info me-2"></i>Account Management</h5>
    <p class="mb-0">
        Use the tabs above or cards to manage your profile, security settings, active sessions, authorized applications, and more.
        If you need help, contact your administrator.
    </p>
</div>
