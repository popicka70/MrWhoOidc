@page "/account/confirm-email"
@using MrWhoOidc.Auth.Services
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Account.ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm Email";
    var result = Model.Result;
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Enabled
        ? $"/t/{currentTenant.Slug}"
        : string.Empty;

    var heading = "Email confirmation";
    var message = "We could not process this confirmation link.";
    var detail = "The link may be incomplete or already used. Try copying the full URL from your email.";
    var alertClass = "alert-danger";
    var iconClass = "ph ph-x-octagon";

    if (result is not null)
    {
        switch (result.Status)
        {
            case EmailConfirmationVerifyStatus.Success:
                heading = "Email confirmed";
                message = "Your email address was confirmed successfully.";
                detail = "Thanks for verifying your email address. You can return to your account and continue using the service.";
                alertClass = "alert-success";
                iconClass = "ph ph-check-circle";
                break;
            case EmailConfirmationVerifyStatus.AlreadyVerified:
                heading = "Already verified";
                message = "This email address is already verified.";
                detail = "You do not need to take any further action.";
                alertClass = "alert-info";
                iconClass = "ph ph-info";
                break;
            case EmailConfirmationVerifyStatus.Expired:
                heading = "Link expired";
                message = "This confirmation link has expired.";
                detail = "Request a new confirmation email from your account settings.";
                alertClass = "alert-warning";
                iconClass = "ph ph-hourglass-split";
                break;
            case EmailConfirmationVerifyStatus.EmailMismatch:
                heading = "Address changed";
                message = "We could not verify this address because it no longer matches our records.";
                detail = "If you recently changed the email address, request a new confirmation link.";
                alertClass = "alert-warning";
                iconClass = "ph ph-warning";
                break;
            case EmailConfirmationVerifyStatus.Cancelled:
            case EmailConfirmationVerifyStatus.NotFound:
            case EmailConfirmationVerifyStatus.InvalidToken:
                heading = "Invalid link";
                message = "This confirmation link is no longer valid.";
                detail = "Please request a new confirmation email from your account settings.";
                alertClass = "alert-danger";
                iconClass = "ph ph-x-octagon";
                break;
        }
    }
}

<h1 class="mb-3">Email Confirmation</h1>

<div class="row g-4 justify-content-center">
    <div class="col-12 col-xl-8 col-lg-9">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-lg-5">
                <div class="d-flex flex-column flex-md-row align-items-start gap-3 mb-4">
                    <div class="rounded-circle border d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width: 3.25rem; height: 3.25rem;">
                        <i class="@iconClass fs-3" aria-hidden="true"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h2 class="h3 mb-2">@heading</h2>
                        @if (!string.IsNullOrWhiteSpace(result?.Email))
                        {
                            <p class="text-muted mb-0">
                                Address: <span class="fw-semibold text-body">@result.Email</span>
                            </p>
                        }
                    </div>
                </div>

                <div class="alert @alertClass mb-3" role="alert">
                    @message
                </div>

                <p class="mb-4 text-muted">@detail</p>

                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-primary" href="@Url.Page("/account/emails")">
                        <i class="ph ph-envelope-simple-check me-2"></i>
                        Manage email addresses
                    </a>
                    <a class="btn btn-outline-secondary" href="@(string.IsNullOrEmpty(tenantPrefix) ? "/account" : $"{tenantPrefix}/account")">
                        <i class="ph ph-arrow-left me-2"></i>
                        Back to account
                    </a>
                </div>
            </div>
        </div>

        <div class="card mt-3 border-0 bg-light-subtle">
            <div class="card-body">
                <h6 class="card-title mb-2"><i class="ph ph-info me-2"></i>What next</h6>
                <ul class="mb-0 ps-3 small text-muted">
                    <li>Return to your account to review verified and pending email addresses.</li>
                    <li>If the link was invalid or expired, request a new verification message from the Emails page.</li>
                    <li>If delivery fails again, check the latest WebAuth logs for the SMTP provider response.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
