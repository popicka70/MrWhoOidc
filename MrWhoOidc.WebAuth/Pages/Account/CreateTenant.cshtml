@page "/account/create-tenant"
@model MrWhoOidc.WebAuth.Pages.Account.CreateTenantModel
@{
    ViewData["Title"] = "Create Organization";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-transparent border-bottom-0 pt-4 pb-0">
                    <h2 class="h4 mb-0">Create New Organization</h2>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-4">
                        Create a new organization to manage users and applications. You will be the administrator of this organization.
                    </p>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Input.Name" class="form-label"></label>
                            <input asp-for="Input.Name" class="form-control" placeholder="e.g. My Company" autofocus />
                            <span asp-validation-for="Input.Name" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="ph ph-plus me-1"></i> Create Organization
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
