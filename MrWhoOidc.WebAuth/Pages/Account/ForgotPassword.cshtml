@page
@model MrWhoOidc.WebAuth.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="card-body p-4">
        <div class="auth-card__header">
            <i class="bi bi-key icon-xl icon-primary"></i>
            <h2 class="auth-card__title">Forgot your password?</h2>
            <p class="auth-card__subtitle">
                Enter your email address and we'll send you a link to reset your password.
            </p>
        </div>

        @if (Model.EmailSent)
        {
            <div class="alert alert-success" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong>Check your email!</strong>
                <p class="mb-0 mt-2">
                    If an account exists with that email address, we've sent password reset instructions.
                    The link will expire in 60 minutes.
                </p>
            </div>
            
            <div class="alert alert-info mt-3" role="alert">
                <i class="bi bi-info-circle me-2"></i>
                <strong>Note:</strong> This password reset will apply to all your tenants.
                After resetting, you can use the new password to sign in to any tenant where you have access.
            </div>

            <div class="mt-4 text-center">
                <a asp-page="/Login" class="btn btn-primary">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Return to Sign In
                </a>
            </div>
        }
        else
        {
            <form method="post" asp-antiforgery="true">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <ul class="mb-0">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <div class="form-group mb-3">
                    <label asp-for="Input.Email" class="form-label">
                        <i class="bi bi-envelope icon-sm"></i> Email Address
                    </label>
                    <input asp-for="Input.Email" 
                           class="form-control" 
                           type="email"
                           autocomplete="email"
                           placeholder="your.email@example.com"
                           autofocus />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 auth-btn">
                    <i class="bi bi-envelope-arrow-up me-2"></i>Send Reset Link
                </button>
            </form>

            <div class="mt-4 text-center">
                <a asp-page="/Login" class="text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i>Back to Sign In
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
