@page "/account/sessions"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject Microsoft.Extensions.Options.IOptions<MrWhoOidc.Auth.MultiTenancy.MultiTenancyOptions> MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Account.SessionsModel
@{
    ViewData["Title"] = "Active Sessions";
    ViewData["ActiveAccountTab"] = "sessions";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Value.Enabled 
        ? $"/t/{currentTenant.Slug}" 
        : "";
}

<h1 class="mb-3">Active Sessions</h1>
<partial name="~/Pages/Account/_AccountTabs.cshtml" />

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="bi bi-info-circle me-2"></i>@Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0"><i class="bi bi-phone me-2"></i>Your Active Sessions</h5>
                @if (Model.Sessions.Count > 1)
                {
                    <form method="post" asp-page-handler="RevokeAll" onsubmit="return confirm('Are you sure you want to revoke all other sessions? You will remain logged in on this device.');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-x-circle me-1"></i>Revoke All Others
                        </button>
                    </form>
                }
            </div>
            <div class="card-body p-0">
                @if (Model.Sessions.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var session in Model.Sessions)
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center mb-2">
                                            @if (session.IsCurrent)
                                            {
                                                <span class="badge bg-success me-2">
                                                    <i class="bi bi-check-circle-fill"></i> Current Session
                                                </span>
                                            }
                                            @if (session.IsCurrentDevice)
                                            {
                                                <span class="badge bg-primary me-2">
                                                    <i class="bi @session.DeviceIcon"></i> This Device
                                                </span>
                                            }
                                            @if (!session.IsCurrent && !session.IsCurrentDevice)
                                            {
                                                <i class="bi bi-circle me-2"></i>
                                            }
                                            <h6 class="mb-0">
                                                <i class="bi bi-key me-1"></i>
                                                Token Session
                                            </h6>
                                        </div>
                                        
                                        @* Device & Location Info *@
                                        <div class="mb-2">
                                            <div class="d-flex align-items-center text-muted small">
                                                <i class="bi @session.DeviceIcon me-1"></i>
                                                <span class="me-3"><strong>@session.Browser</strong> on <strong>@session.Os</strong></span>
                                                @if (!string.IsNullOrEmpty(session.IpAddress))
                                                {
                                                    <span>
                                                        <i class="bi bi-geo-alt me-1"></i>
                                                        <code>@session.IpAddress</code>
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                        
                                        <dl class="row small mb-0">
                                            <dt class="col-sm-3 text-muted">Client</dt>
                                            <dd class="col-sm-9"><code>@session.ClientId</code></dd>
                                            
                                            <dt class="col-sm-3 text-muted">Token Type</dt>
                                            <dd class="col-sm-9">
                                                <span class="badge bg-secondary">@session.TokenType</span>
                                            </dd>
                                            
                                            <dt class="col-sm-3 text-muted">JTI</dt>
                                            <dd class="col-sm-9">
                                                @if (!string.IsNullOrEmpty(session.Jti))
                                                {
                                                    <small><code>@session.Jti</code></small>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not available</span>
                                                }
                                            </dd>
                                            
                                            <dt class="col-sm-3 text-muted">Created</dt>
                                            <dd class="col-sm-9">
                                                <i class="bi bi-clock me-1"></i>
                                                @session.CreatedAt.ToString("MMM d, yyyy 'at' h:mm tt")
                                            </dd>
                                            
                                            <dt class="col-sm-3 text-muted">Expires</dt>
                                            <dd class="col-sm-9">
                                                <i class="bi bi-hourglass-split me-1"></i>
                                                @session.ExpiresAt.ToString("MMM d, yyyy 'at' h:mm tt")
                                                @{
                                                    var remaining = session.ExpiresAt - DateTimeOffset.UtcNow;
                                                    if (remaining.TotalHours < 24)
                                                    {
                                                        <span class="text-warning">
                                                            (expires in @remaining.Hours hours)
                                                        </span>
                                                    }
                                                }
                                            </dd>
                                        </dl>
                                    </div>
                                    <div class="ms-3">
                                        @if (!session.IsCurrent)
                                        {
                                            <form method="post" asp-page-handler="Revoke" asp-route-sessionId="@session.Id" onsubmit="return confirm('Are you sure you want to revoke this session?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-x-circle"></i> Revoke
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark">
                                                <i class="bi bi-shield-check"></i> Active
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-phone text-muted" style="font-size: 3rem;"></i>
                        <p class="text-muted mt-3">No active sessions found</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card bg-light">
            <div class="card-body">
                <h6 class="card-title"><i class="bi bi-info-circle me-2"></i>About Sessions</h6>
                <p class="small mb-2">
                    Sessions represent active tokens issued to applications that can access your account.
                    Each session shows the device, browser, and location where it was created.
                </p>
                <p class="small mb-2">
                    <strong><i class="bi bi-check-circle-fill text-success"></i> Current Session:</strong> The token session you're using right now. You cannot revoke it from here.
                </p>
                <p class="small mb-2">
                    <strong><i class="bi bi-display text-primary"></i> This Device:</strong> Sessions created from the same browser on this device.
                </p>
                <p class="small mb-2">
                    <strong>Other Sessions:</strong> Sessions from other devices or browsers. Revoke them if you don't recognize the device, location, or browser.
                </p>
                <p class="small mb-0">
                    <strong>Tip:</strong> Regularly review sessions and look for unfamiliar IP addresses or devices.
                </p>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <h6 class="card-title"><i class="bi bi-shield-exclamation me-2"></i>Security Notice</h6>
                <p class="small mb-2">
                    If you see sessions you don't recognize, revoke them immediately and change your password.
                </p>
                <div class="d-grid gap-2">
                    <a href="@(tenantPrefix)/Password" class="btn btn-sm btn-outline-warning">
                        <i class="bi bi-key me-1"></i>Change Password
                    </a>
                    <a href="@(tenantPrefix)/Mfa" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-shield-lock me-1"></i>Enable MFA
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
