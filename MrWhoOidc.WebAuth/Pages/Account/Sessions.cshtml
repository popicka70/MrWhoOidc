@page "/account/sessions"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Account.SessionsModel
@{
    ViewData["Title"] = "Active Sessions";
    ViewData["ActiveAccountTab"] = "sessions";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Enabled 
        ? $"/t/{currentTenant.Slug}" 
        : "";
}

<h1 class="mb-3"><i class="ph ph-monitor me-2"></i>Active Sessions</h1>
<partial name="~/Pages/Account/_AccountTabs.cshtml" />

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="ph ph-info me-2"></i>@Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0"><i class="ph ph-device-mobile me-2"></i>Your Active Sessions</h5>
                @if (!Model.StoreDisabled && Model.Sessions.Count(s => !s.RevokedAt.HasValue) > 1)
                {
                    <form method="post" asp-page-handler="RevokeAll" onsubmit="return confirm('Are you sure you want to end all other sessions? You will remain signed in on this device.');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="ph ph-x-circle me-1"></i>End All Others
                        </button>
                    </form>
                }
            </div>
            <div class="card-body p-0">
                @if (Model.StoreDisabled)
                {
                    <div class="text-center py-5">
                        <i class="ph ph-info text-muted icon-xl"></i>
                        <p class="text-muted mt-3">The server-side session store is turned off for this deployment.</p>
                    </div>
                }
                else if (Model.Sessions.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var session in Model.Sessions)
                        {
                            var ended = session.RevokedAt.HasValue;
                            <div class="list-group-item @(ended ? "opacity-50" : "")">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center mb-2">
                                            @if (session.IsCurrent)
                                            {
                                                <span class="badge bg-success me-2">
                                                    <i class="ph-fill ph-check-circle"></i> Current Session
                                                </span>
                                            }
                                            @if (session.IsCurrentDevice)
                                            {
                                                <span class="badge bg-primary me-2">
                                                    <i class="bi @session.DeviceIcon"></i> This Device
                                                </span>
                                            }
                                            @if (ended)
                                            {
                                                <span class="badge bg-secondary me-2">
                                                    <i class="ph ph-prohibit"></i> Ended
                                                </span>
                                            }
                                            <h6 class="mb-0">
                                                <i class="ph ph-key me-1"></i>
                                                Signed-in session
                                            </h6>
                                        </div>
                                        @* Device & Location Info *@
                                        <div class="mb-2">
                                            <div class="d-flex align-items-center text-muted small">
                                                <i class="bi @session.DeviceIcon me-1"></i>
                                                <span class="me-3"><strong>@session.Browser</strong> on <strong>@session.Os</strong></span>
                                                @if (!string.IsNullOrEmpty(session.IpHash))
                                                {
                                                    <span title="The hash of the address the session was created from. The address itself is not stored.">
                                                        <i class="ph ph-fingerprint me-1"></i>
                                                        <code>@session.IpHash</code>
                                                    </span>
                                                }
                                            </div>
                                        </div>

                                        <dl class="row small mb-0">
                                            <dt class="col-sm-3 text-muted">Applications</dt>
                                            <dd class="col-sm-9">
                                                @if (session.ClientIds.Count > 0)
                                                {
                                                    <div class="d-flex flex-wrap gap-1">
                                                        @foreach (var clientId in session.ClientIds)
                                                        {
                                                            <span class="badge bg-secondary">@clientId</span>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No application used this session</span>
                                                }
                                            </dd>

                                            <dt class="col-sm-3 text-muted">Signed in</dt>
                                            <dd class="col-sm-9">
                                                <i class="ph ph-clock me-1"></i>
                                                @session.AuthTime.ToString("MMM d, yyyy 'at' h:mm tt")
                                            </dd>

                                            <dt class="col-sm-3 text-muted">Last used</dt>
                                            <dd class="col-sm-9">
                                                <i class="ph ph-clock me-1"></i>
                                                @session.LastSeenAt.ToString("MMM d, yyyy 'at' h:mm tt")
                                            </dd>

                                            <dt class="col-sm-3 text-muted">Expires</dt>
                                            <dd class="col-sm-9">
                                                <i class="ph ph-hourglass-split me-1"></i>
                                                @session.ExpiresAt.ToString("MMM d, yyyy 'at' h:mm tt")
                                                <span class="text-muted">(idle deadline: @session.IdleExpiresAt.ToString("MMM d, yyyy 'at' h:mm tt"))</span>
                                            </dd>

                                            @if (ended)
                                            {
                                                <dt class="col-sm-3 text-muted">Ended</dt>
                                                <dd class="col-sm-9">
                                                    <i class="ph ph-prohibit me-1"></i>
                                                    @session.RevokedAt!.Value.ToString("MMM d, yyyy 'at' h:mm tt")
                                                    @if (!string.IsNullOrEmpty(session.RevokedReason))
                                                    {
                                                        <span class="text-muted">(@session.RevokedReason)</span>
                                                    }
                                                </dd>
                                            }
                                        </dl>
                                    </div>
                                    <div class="ms-3">
                                        @if (!ended && !session.IsCurrent)
                                        {
                                            <form method="post" asp-page-handler="Revoke" asp-route-sessionId="@session.Id" onsubmit="return confirm('Are you sure you want to end this session? The applications that used it must sign in again.');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="ph ph-x-circle"></i> End
                                                </button>
                                            </form>
                                        }
                                        else if (session.IsCurrent)
                                        {
                                            <span class="badge bg-light text-dark">
                                                <i class="ph ph-shield-check"></i> Active
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="ph ph-device-mobile text-muted icon-xl"></i>
                        <p class="text-muted mt-3">No active sessions found</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card bg-light">
            <div class="card-body">
                <h6 class="card-title"><i class="ph ph-info me-2"></i>About Sessions</h6>
                <p class="small mb-2">
                    A session is one sign-in to this identity provider. It ends when you sign out, when the
                    password changes, or when it reaches its deadline.
                </p>
                <p class="small mb-2">
                    <strong><i class="ph-fill ph-check-circle text-success"></i> Current Session:</strong> The session you are using right now. You cannot end it from here; sign out to end it.
                </p>
                <p class="small mb-2">
                    <strong><i class="ph ph-display text-primary"></i> This Device:</strong> Sessions created from the same browser on this device.
                </p>
                <p class="small mb-2">
                    <strong>Other Sessions:</strong> Sessions from other devices or browsers. End them if you don't recognize the device or browser.
                </p>
                <p class="small mb-0">
                    <strong>Tip:</strong> Ending a session also ends the tokens it produced: the applications that used it ask you to sign in again.
                </p>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <h6 class="card-title"><i class="ph ph-shield-exclamation me-2"></i>Security Notice</h6>
                <p class="small mb-2">
                    If you see sessions you don't recognize, end them immediately and change your password.
                </p>
                <div class="d-grid gap-2">
                    <a href="@(tenantPrefix)/Password" class="btn btn-sm btn-outline-warning">
                        <i class="ph ph-key me-1"></i>Change Password
                    </a>
                    <a href="@(tenantPrefix)/Mfa" class="btn btn-sm btn-outline-primary">
                        <i class="ph ph-shield me-1"></i>Enable MFA
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
