@page "/account/access-denied"
@model MrWhoOidc.WebAuth.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="auth-container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-shield-x me-2"></i>Access Denied
                    </h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger" role="alert">
                        <h5 class="alert-heading">You don't have permission to access this resource</h5>
                        <hr>
                        <p class="mb-0">
                            You attempted to access a resource that requires additional permissions.
                            This may be because:
                        </p>
                        <ul class="mt-2">
                            <li>You don't have the required role or permission</li>
                            <li>The resource belongs to a different tenant</li>
                            <li>Your session has expired</li>
                        </ul>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ReturnUrl))
                    {
                        <div class="alert alert-info" role="alert">
                            <strong>Attempted URL:</strong> @Model.ReturnUrl
                        </div>
                    }

                    <div class="d-grid gap-2 d-md-flex justify-content-md-start mt-4">
                        <a href="@Model.HomeUrl" class="btn btn-primary">
                            <i class="bi bi-house-door me-1"></i>Go to Home
                        </a>
                        @if (!string.IsNullOrEmpty(Model.DashboardUrl))
                        {
                            <a href="@Model.DashboardUrl" class="btn btn-outline-secondary">
                                <i class="bi bi-speedometer2 me-1"></i>Go to Dashboard
                            </a>
                        }
                        @if (Model.IsAuthenticated)
                        {
                            <a href="@Model.AccountUrl" class="btn btn-outline-secondary">
                                <i class="bi bi-person me-1"></i>My Account
                            </a>
                        }
                        else
                        {
                            <a href="@Model.LoginUrl" class="btn btn-success">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
                            </a>
                        }
                    </div>

                    @if (Model.IsAuthenticated)
                    {
                        <div class="mt-4 p-3 bg-light rounded">
                            <h6 class="text-muted">Need Help?</h6>
                            <p class="mb-0 small">
                                If you believe you should have access to this resource, please contact your administrator.
                                Provide them with the attempted URL shown above.
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
