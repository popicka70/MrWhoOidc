@page "/account/linked-accounts"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Account.LinkedAccountsModel
@{
    ViewData["Title"] = "Linked Accounts";
    ViewData["ActiveAccountTab"] = "linked";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Enabled 
        ? $"/t/{currentTenant.Slug}" 
        : "";
}

<h1 class="mb-3">Linked Accounts</h1>
<partial name="~/Pages/Account/_AccountTabs.cshtml" />

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="ph ph-info me-2"></i>@Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0"><i class="ph ph-link me-2"></i>External Identities</h5>
            </div>
            <div class="card-body p-0">
                @if (Model.LinkedAccounts.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var account in Model.LinkedAccounts)
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center mb-2">
                                            <i class="ph ph-identification-badge me-2 fs-5 text-primary"></i>
                                            <h6 class="mb-0">@account.ProviderName</h6>
                                        </div>
                                        <dl class="row small mb-0">
                                            <dt class="col-sm-3 text-muted">Issuer</dt>
                                            <dd class="col-sm-9">
                                                <small class="text-break">@account.Issuer</small>
                                            </dd>
                                            
                                            <dt class="col-sm-3 text-muted">Subject</dt>
                                            <dd class="col-sm-9">
                                                <code>@account.Subject</code>
                                            </dd>
                                            
                                            <dt class="col-sm-3 text-muted">Linked</dt>
                                            <dd class="col-sm-9">
                                                <i class="ph ph-clock me-1"></i>
                                                @account.LinkedAt.ToString("MMM d, yyyy 'at' h:mm tt")
                                            </dd>
                                            
                                            <dt class="col-sm-3 text-muted">Last Used</dt>
                                            <dd class="col-sm-9">
                                                <i class="ph ph-arrow-repeat me-1"></i>
                                                @account.LastSeenAt.ToString("MMM d, yyyy 'at' h:mm tt")
                                                @{
                                                    var timeSinceLastSeen = DateTimeOffset.UtcNow - account.LastSeenAt;
                                                    if (timeSinceLastSeen.TotalDays < 1)
                                                    {
                                                        <span class="badge bg-success">Recently active</span>
                                                    }
                                                    else if (timeSinceLastSeen.TotalDays > 30)
                                                    {
                                                        <span class="badge bg-secondary">Inactive for @((int)timeSinceLastSeen.TotalDays) days</span>
                                                    }
                                                }
                                            </dd>
                                        </dl>
                                    </div>
                                    <div class="ms-3">
                                        <form method="post" asp-page-handler="Unlink" asp-route-accountId="@account.Id" 
                                              onsubmit="return confirm('Are you sure you want to unlink this account? You may need a password or another linked account to maintain access.');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Unlink account">
                                                <i class="ph ph-x-circle"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="ph ph-link text-muted icon-2xl"></i>
                        <p class="text-muted mt-3">No external accounts linked yet.</p>
                         <p class="small text-muted">
                             Link external accounts (like Google or Azure AD) to sign in more easily.
                         </p>
                     </div>
                }
            </div>
        </div>
    </div>
    
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header">
                <h6 class="card-title mb-0"><i class="ph ph-plus-circle text-primary me-2"></i>Link New Account</h6>
            </div>
            <div class="card-body">
                <p class="small text-muted mb-3">
                    Connect your current account to another identity provider. You will be asked to sign in to the selected provider; if successful, it will be linked to this profile.
                </p>
                <div class="d-grid gap-2">
                    @foreach (var provider in Model.AvailableProviders)
                    {
                        <a href="/auth/external/start?provider=@provider.Name&link=true&returnUrl=@(tenantPrefix)account/linked-accounts" 
                           class="btn btn-sm btn-outline-secondary text-start d-flex align-items-center justify-content-between">
                            <span>@provider.DisplayName</span>
                            <i class="ph ph-arrow-right"></i>
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h6 class="card-title">
                    <i class="ph ph-info text-info me-1"></i>
                    About Linked Accounts
                </h6>
                <p class="small text-muted mb-3">
                    Linked accounts allow you to sign in using external identity providers without needing to remember a separate password.
                </p>
                <h6 class="small fw-semibold mb-2">
                    <i class="ph ph-check-circle text-success me-1"></i>
                    Benefits
                </h6>
                <ul class="small text-muted mb-3">
                    <li>Sign in faster with one click</li>
                    <li>No need to remember another password</li>
                    <li>Use the same identity across multiple services</li>
                </ul>
                <hr class="my-3">
                <h6 class="small fw-semibold mb-2">
                    <i class="ph ph-shield-exclamation text-warning me-1"></i>
                    Important
                </h6>
                <p class="small text-muted mb-0">
                    Ensure you maintain at least one way to access your account (either a password or at least one linked account) before unlinking.
                </p>
            </div>
        </div>
        
        <div class="card mt-3">
            <div class="card-body">
                <h6 class="card-title">
                    <i class="ph ph-question-circle text-primary me-1"></i>
                    Need Help?
                </h6>
                <p class="small text-muted mb-2">
                    Having trouble with linked accounts?
                </p>
                <ul class="small text-muted mb-0">
                    <li>Make sure you're logged into the external provider</li>
                    <li>Check that the external provider is configured</li>
                    <li>Contact support if you're unable to link or unlink an account</li>
                </ul>
            </div>
        </div>
    </div>
</div>
