@page
@model MrWhoOidc.WebAuth.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="card-body p-4">
        <div class="auth-card__header">
            <i class="ph ph-key icon-xl icon-primary"></i>
            <h2 class="auth-card__title">Reset your password</h2>
        </div>

        @if (Model.ResetComplete)
        {
            <div class="alert alert-success" role="alert">
                <i class="ph-fill ph-check-circle me-2"></i>
                <strong>Password Reset Complete!</strong>
                <p class="mb-0 mt-2">
                    Your password has been successfully reset. You can now sign in with your new password.
                </p>
            </div>
            
            <div class="alert alert-info mt-3" role="alert">
                <i class="ph ph-info me-2"></i>
                <strong>Note:</strong> This new password applies to all your tenants.
                Use it to sign in to any tenant where you have access.
            </div>

            <div class="mt-4 text-center">
                <a asp-page="/Login" class="btn btn-primary">
                    <i class="ph ph-sign-in me-2"></i>Sign In
                </a>
            </div>
        }
        else if (!Model.TokenValid)
        {
            <div class="alert alert-danger" role="alert">
                <i class="ph ph-warning-fill me-2"></i>
                <strong>Invalid Reset Link</strong>
                <p class="mb-0 mt-2">
                    @(Model.ErrorMessage ?? "This password reset link is invalid or has expired.")
                </p>
            </div>

            <div class="mt-4 text-center">
                <a asp-page="/Account/ForgotPassword" class="btn btn-primary">
                    <i class="ph ph-envelope-simple-arrow-up me-2"></i>Request New Reset Link
                </a>
            </div>
        }
        else
        {
            <p class="auth-card__subtitle">
                Enter your new password below. This password will apply to all your tenants.
            </p>

            <form method="post" asp-antiforgery="true">
                <input type="hidden" asp-for="Token" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="ph ph-warning-fill me-2"></i>
                        <ul class="mb-0">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <div class="form-group mb-3">
                    <label asp-for="Input.NewPassword" class="form-label">
                        <i class="ph ph-lock icon-sm"></i> New Password
                    </label>
                    <input asp-for="Input.NewPassword" 
                           class="form-control" 
                           type="password"
                           autocomplete="new-password"
                           autofocus />
                    <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                    <div class="form-text">
                        Password must be at least 8 characters long.
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Input.ConfirmPassword" class="form-label">
                        <i class="ph ph-lock-fill icon-sm"></i> Confirm Password
                    </label>
                    <input asp-for="Input.ConfirmPassword" 
                           class="form-control" 
                           type="password"
                           autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="alert alert-info" role="alert">
                    <i class="ph ph-info me-2"></i>
                    <strong>Global Password:</strong> This new password will apply to all your tenants.
                    After resetting, you can use it to sign in to any tenant where you have access.
                </div>

                <button type="submit" class="btn btn-primary w-100 auth-btn">
                    <i class="ph ph-check me-2"></i>Reset Password
                </button>
            </form>

            <div class="mt-4 text-center">
                <a asp-page="/Login" class="text-decoration-none">
                    <i class="ph ph-arrow-left me-1"></i>Back to Sign In
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
