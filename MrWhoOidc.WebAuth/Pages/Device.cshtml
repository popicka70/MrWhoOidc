@page "/device"
@model MrWhoOidc.WebAuth.Pages.DeviceModel
@{
    ViewData["Title"] = "Device Authorization";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="card-body p-4">
        @if (Model.ShowUserCodeInput)
        {
            <div class="auth-card__header">
                <i class="bi bi-phone icon-xl icon-primary"></i>
                <h2 class="auth-card__title">Authorize Device</h2>
                <p class="auth-card__subtitle">
                    Enter the code displayed on your device to continue.
                </p>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage
                </div>
            }

            <form method="get" asp-antiforgery="true">
                <div class="mb-4">
                    <label for="user_code" class="form-label">Device Code</label>
                    <input type="text" class="form-control form-control-lg text-center text-uppercase"
                           id="user_code" name="user_code" placeholder="XXXX-XXXX"
                           value="@Model.UserCode" maxlength="10" autocomplete="off"
                           style="letter-spacing: 0.3em; font-family: monospace;" required />
                    <div class="form-text">Enter the code shown on your device (e.g., ABCD-EFGH)</div>
                </div>
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-arrow-right me-2"></i>Continue
                </button>
            </form>
        }
        else if (Model.ShowConfirmation)
        {
            <div class="auth-card__header">
                <i class="bi bi-shield-check icon-xl icon-primary"></i>
                <h2 class="auth-card__title">Confirm Device Access</h2>
                <p class="auth-card__subtitle">
                    You are about to authorize a device to access your account.
                </p>
            </div>

            <div class="mb-4">
                <div class="card bg-light">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-app me-2"></i>
                            <strong>Application:</strong>
                            <span class="ms-2">@Model.ClientName</span>
                        </div>
                        @if (Model.RequestedScopes.Any())
                        {
                            <div class="mt-3">
                                <strong>Requested Permissions:</strong>
                                <ul class="list-unstyled mt-2 mb-0">
                                    @foreach (var scope in Model.RequestedScopes)
                                    {
                                        <li class="d-flex align-items-center py-1">
                                            <i class="bi bi-check2 text-success me-2"></i>
                                            @scope
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <form method="post" asp-antiforgery="true">
                <input type="hidden" name="user_code" value="@Model.UserCode" />
                <div class="action-buttons">
                    <button type="submit" name="action" value="approve" class="btn btn-success flex-fill">
                        <i class="bi bi-check-lg me-2"></i>Authorize Device
                    </button>
                    <button type="submit" name="action" value="deny" class="btn btn-outline-danger flex-fill">
                        <i class="bi bi-x-lg me-2"></i>Deny
                    </button>
                </div>
            </form>
        }
        else if (Model.ShowSuccess)
        {
            <div class="auth-card__header">
                <i class="bi bi-check-circle icon-xl icon-success"></i>
                <h2 class="auth-card__title">Device Authorized</h2>
                <p class="auth-card__subtitle">
                    The device has been successfully authorized. You can close this window
                    and return to your device.
                </p>
            </div>
        }
        else if (Model.ShowDenied)
        {
            <div class="auth-card__header">
                <i class="bi bi-x-circle icon-xl icon-danger"></i>
                <h2 class="auth-card__title">Authorization Denied</h2>
                <p class="auth-card__subtitle">
                    You have denied the device authorization request.
                    You can close this window.
                </p>
            </div>
        }
    </div>
</div>
