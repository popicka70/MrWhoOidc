@page "{*path}"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject Microsoft.Extensions.Options.IOptions<MrWhoOidc.Auth.MultiTenancy.MultiTenancyOptions> MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.NotFoundModel
@{
    ViewData["Title"] = "Not Found";
    Response.StatusCode = 404;
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Value.Enabled 
        ? $"/t/{currentTenant.Slug}" 
        : "";
}

<div class="card border-warning">
    <div class="card-body p-4">
        <div class="text-center mb-4">
            <i class="bi bi-exclamation-circle-fill icon-2xl icon-warning"></i>
        </div>
        
        <h1 class="text-warning text-center mb-2">404 - Page Not Found</h1>
        <h5 class="text-center text-muted mb-4">The page you're looking for doesn't exist.</h5>

        @if (currentTenant != null)
        {
            <div class="alert alert-info">
                <i class="bi bi-building icon-sm me-2"></i>
                <strong>Tenant Context:</strong> @currentTenant.Name (@currentTenant.Slug)
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.RequestedPath))
        {
            <div class="card mb-4">
                <div class="card-body">
                    <p class="mb-2"><strong>Requested Path:</strong></p>
                    <code class="d-block p-2 bg-light">@Model.RequestedPath</code>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.SuggestedPath))
        {
            <div class="alert alert-warning">
                <div class="d-flex align-items-start">
                    <i class="bi bi-lightbulb-fill icon-lg me-3 mt-1"></i>
                    <div>
                        <h5 class="alert-heading mb-2">Did you mean this URL?</h5>
                        <p class="mb-2">
                            This site uses <strong>kebab-case</strong> URL convention. Your requested URL contains PascalCase segments.
                        </p>
                        <p class="mb-2"><strong>Try this instead:</strong></p>
                        <div class="d-flex align-items-center gap-2">
                            <code class="flex-grow-1 p-2 bg-light border">@Model.SuggestedPath</code>
                            <a href="@Model.SuggestedPath" class="btn btn-sm btn-warning">
                                <i class="bi bi-box-arrow-up-right"></i> Go There
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
        
        <div class="text-center mt-4">
            <a href="@(tenantPrefix)/" class="btn btn-primary">
                <i class="bi bi-house"></i> Return Home
            </a>
            @if (User?.Identity?.IsAuthenticated ?? false)
            {
                <a href="@(tenantPrefix)/Account" class="btn btn-outline-primary">
                    <i class="bi bi-person-circle"></i> My Account
                </a>
            }
        </div>
    </div>
</div>
