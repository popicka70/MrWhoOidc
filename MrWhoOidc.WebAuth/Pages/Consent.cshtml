@page "/consent"
@model MrWhoOidc.WebAuth.Pages.ConsentModel
@{
    ViewData["Title"] = "Consent";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="card-body p-4">
        <div class="auth-card__header">
            <i class="ph ph-shield-check icon-xl icon-primary"></i>
            <h2 class="auth-card__title">Authorization Request</h2>
            <p class="auth-card__subtitle">
                Application <strong>@Model.ClientId</strong> is requesting access to your account.
            </p>
        </div>

        <h5 class="mb-3">Requested Permissions:</h5>
        <ul class="list-group mb-4">
        @foreach (var scope in Model.Scopes)
        {
            <li class="list-group-item d-flex align-items-center">
                <i class="ph ph-check icon-sm icon-success me-2"></i>
                <span>@scope</span>
            </li>
        }
        </ul>

        <form method="post" asp-antiforgery="true">
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
            <input type="hidden" name="ClientId" value="@Model.ClientId" />
            @foreach (var scope in Model.Scopes)
            {
                <input type="hidden" name="Scopes" value="@scope" />
            }
            <div class="action-buttons">
                <button type="submit" class="btn btn-success flex-fill">
                    <i class="ph ph-check"></i> Allow Access
                </button>
                <a class="btn btn-outline-danger flex-fill" href="@Model.CancelUrl">
                    <i class="ph ph-x"></i> Deny
                </a>
            </div>
        </form>
    </div>
</div>
