@page "/consent"
@model MrWhoOidc.WebAuth.Pages.ConsentModel
@{
    ViewData["Title"] = "Consent";
}

<h2>Consent</h2>
<p>Application <strong>@Model.ClientId</strong> is requesting access to:</p>
<ul>
@foreach (var scope in Model.Scopes)
{
    <li>@scope</li>
}
</ul>

<form method="post" action="/consent" asp-antiforgery="true">
    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
    <input type="hidden" name="ClientId" value="@Model.ClientId" />
    @foreach (var scope in Model.Scopes)
    {
        <input type="hidden" name="Scopes" value="@scope" />
    }
    <button type="submit" class="btn btn-primary">Allow</button>
    <a class="btn btn-secondary" href="@Model.CancelUrl">Deny</a>
</form>
