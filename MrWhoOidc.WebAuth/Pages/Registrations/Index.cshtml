@page
@model MrWhoOidc.WebAuth.Pages.Registrations.IndexModel
@{
    ViewData["Title"] = Model.PageHeading;
    var loginPath = Model.IsTenantRegistrationPath && !string.IsNullOrWhiteSpace(Model.CurrentTenantSlug)
        ? $"/t/{Uri.EscapeDataString(Model.CurrentTenantSlug)}/login"
        : "/Login";
    var tenantSubmitStyle = Model.IsTenantRegistrationPath && !string.IsNullOrWhiteSpace(Model.TenantBranding.PrimaryColor)
        ? $"background-color: {Model.TenantBranding.PrimaryColor}; border-color: {Model.TenantBranding.PrimaryColor};"
        : null;
}

<div class="card registration-card@(Model.IsTenantRegistrationPath ? " registration-card--tenant" : string.Empty)">
    <div class="card-header">
        <div class="d-flex align-items-center gap-3">
            @if (Model.IsTenantRegistrationPath && !string.IsNullOrWhiteSpace(Model.TenantBranding.LogoUrl))
            {
                <img src="@Model.TenantBranding.LogoUrl" alt="@Model.TenantBranding.TenantName logo" style="max-height: 44px; max-width: 160px; object-fit: contain;" />
            }
            <h2 class="mb-0">
                <i class="ph ph-user-plus me-2"></i>
                @Model.PageHeading
            </h2>
        </div>
    </div>
    <div class="card-body p-4">
        @if (!string.IsNullOrWhiteSpace(Model.PageIntro) || (Model.IsTenantRegistrationPath && !string.IsNullOrWhiteSpace(Model.HeroImageUrl)))
        {
            <div class="row align-items-center g-4 mb-4">
                @if (!string.IsNullOrWhiteSpace(Model.PageIntro))
                {
                    <div class="@(string.IsNullOrWhiteSpace(Model.HeroImageUrl) ? "col-12" : "col-lg-7")">
                        <p class="lead mb-0">@Model.PageIntro</p>
                    </div>
                }
                @if (Model.IsTenantRegistrationPath && !string.IsNullOrWhiteSpace(Model.HeroImageUrl))
                {
                    <div class="@(string.IsNullOrWhiteSpace(Model.PageIntro) ? "col-12" : "col-lg-5")">
                        <img src="@Model.HeroImageUrl" alt="" class="img-fluid rounded border" style="max-height: 220px; width: 100%; object-fit: cover;" />
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success">
                <i class="ph ph-check-circle me-2"></i>
                @Model.SuccessMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.InfoMessage))
        {
            <div class="alert alert-info">
                <i class="ph ph-info me-2"></i>
                @Model.InfoMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-warning">
                <i class="ph ph-warning me-2"></i>
                @Model.ErrorMessage
                <a href="@(string.IsNullOrWhiteSpace(Model.ReturnUrl) ? loginPath : $"{loginPath}?returnUrl={Uri.EscapeDataString(Model.ReturnUrl)}")" class="alert-link ms-2">
                    Sign in instead
                </a>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.TenantRegistrationUrl))
        {
            <div class="alert alert-info">
                <i class="ph ph-arrow-square-out me-2"></i>
                <a class="alert-link" href="@Model.TenantRegistrationUrl">Open tenant registration</a>
            </div>
        }

        @if (Model.Invitation is { IsAcceptable: true } invitation)
        {
            <div class="alert alert-info d-flex align-items-start gap-2">
                <i class="ph ph-envelope-simple-open mt-1"></i>
                <div>
                    <strong>You were invited to join @invitation.TenantName.</strong><br />
                    Register with <strong>@invitation.Email</strong> to accept the invitation.
                </div>
            </div>
        }

        @if (Model.IsRegistrationAvailable)
        {
        @* External IdP Registration Section *@
        @if (Model.Invitation is null && Model.RegistrationIdps.Any())
        {
            <div class="mb-4">
                <h5 class="mb-3">
                    <i class="ph ph-shield me-2"></i>
                    Register with External Provider
                </h5>
                <div class="d-grid gap-2 provider-list" role="list" aria-label="External identity providers for registration">
                    @foreach (var idp in Model.RegistrationIdps)
                    {
                        // Construct the external start URL with registration callback
                        var callbackUrl = $"{Model.RegistrationPath}?mode=idp_callback";
                        if (!string.IsNullOrEmpty(Model.ReturnUrl))
                        {
                            callbackUrl += $"&returnUrl={Uri.EscapeDataString(Model.ReturnUrl)}";
                        }
                        var startPath = Model.IsTenantRegistrationPath && !string.IsNullOrWhiteSpace(Model.CurrentTenantSlug)
                            ? $"/t/{Uri.EscapeDataString(Model.CurrentTenantSlug)}/Auth/External/Start"
                            : "/Auth/External/Start";
                        var startUrl = $"{startPath}?provider={Uri.EscapeDataString(idp.Name)}&returnUrl={Uri.EscapeDataString(callbackUrl)}";
                        
                        var buttonStyle = "";
                        if (!string.IsNullOrEmpty(idp.ButtonBackgroundColor))
                        {
                            buttonStyle += $"background-color: {idp.ButtonBackgroundColor};";
                        }
                        if (!string.IsNullOrEmpty(idp.ButtonTextColor))
                        {
                            buttonStyle += $"color: {idp.ButtonTextColor}; border-color: {idp.ButtonTextColor};";
                        }
                        else if (!string.IsNullOrEmpty(idp.ButtonBackgroundColor))
                        {
                            buttonStyle += $"border-color: {idp.ButtonBackgroundColor};";
                        }

                        <a class="btn btn-outline-primary w-100 auth-btn d-flex align-items-center justify-content-start provider-btn"
                           href="@startUrl"
                           role="listitem"
                           aria-label="Register with @idp.DisplayName"
                           data-provider-name="@idp.Name"
                           style="@buttonStyle">
                            @if (idp.HasLogoData)
                            {
                                <img src="/api/providers/@idp.Id/logo?v=@idp.UpdatedAt.ToUnixTimeSeconds()" alt="" class="me-2 auth-provider-logo" style="width: 24px; height: 24px; object-fit: contain;" />
                            }
                            else if (!string.IsNullOrEmpty(idp.LogoUrl))
                            {
                                <img src="@idp.LogoUrl" alt="" class="me-2 auth-provider-logo" style="width: 24px; height: 24px; object-fit: contain;" />
                            }
                            else
                            {
                                <i class="ph ph-shield me-2 text-secondary" style="font-size:1.5rem;"></i>
                            }
                            <span class="flex-grow-1">Continue with @idp.DisplayName</span>
                        </a>
                    }
                </div>
            </div>

            <div class="d-flex align-items-center my-4">
                <hr class="flex-grow-1" />
                <span class="mx-3 text-muted">or register manually</span>
                <hr class="flex-grow-1" />
            </div>
        }

        <form method="post" asp-page-handler="Create" class="row g-3">
            <input type="hidden" asp-for="ReturnUrl" />
            <input type="hidden" asp-for="Invite" />
            <div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>
            <div class="col-md-6">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" readonly="@(Model.Invitation is not null ? "readonly" : null)" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Input.FirstName" class="form-label"></label>
                <input asp-for="Input.FirstName" class="form-control" />
                <span asp-validation-for="Input.FirstName" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Input.LastName" class="form-label"></label>
                <input asp-for="Input.LastName" class="form-control" />
                <span asp-validation-for="Input.LastName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.Password" class="form-label">Password (optional)</label>
                <input asp-for="Input.Password" class="form-control" type="password" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <!-- Tenant Creation Section -->
            <div class="col-12" style="@(Model.Invitation is not null || Model.IsTenantRegistrationPath ? "display: none;" : null)">
                <div class="form-check">
                    <input asp-for="Input.CreateTenant" class="form-check-input" type="checkbox" id="createTenantCheck" />
                    <label class="form-check-label fw-bold" for="createTenantCheck">
                        <i class="ph ph-buildings me-2"></i>
                        Create new tenant and become admin
                    </label>
                    <small class="form-text text-muted d-block">
                        Check this option if you want to create a new organization and automatically become its administrator.
                    </small>
                </div>
            </div>

            <div id="tenantFields" class="col-12" style="display: none;">
                <div class="border rounded p-3 bg-light">
                    <h5 class="mb-3">
                        <i class="ph ph-buildings-gear me-2"></i>
                        Tenant Information
                    </h5>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="Input.TenantSlug" class="form-label">Tenant Slug *</label>
                            <input asp-for="Input.TenantSlug" class="form-control" placeholder="mycompany" />
                            <small class="form-text text-muted">URL-safe identifier (lowercase, no spaces)</small>
                            <span asp-validation-for="Input.TenantSlug" class="text-danger"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Input.TenantName" class="form-label">Tenant Name *</label>
                            <input asp-for="Input.TenantName" class="form-control" placeholder="My Company Inc." />
                            <span asp-validation-for="Input.TenantName" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Input.TenantDescription" class="form-label">Description (optional)</label>
                            <textarea asp-for="Input.TenantDescription" class="form-control" rows="2" placeholder="Brief description of your organization"></textarea>
                            <span asp-validation-for="Input.TenantDescription" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-success" style="@tenantSubmitStyle">
                    <i class="ph ph-check"></i> Submit Registration
                </button>
                <a href="@loginPath" class="btn btn-outline-secondary ms-2">
                    <i class="ph ph-arrow-left"></i> Back to Login
                </a>
            </div>
        </form>
        }
    </div>
</div>

@section Scripts{
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
    <script nonce="@(HttpContext.Items["csp-nonce"] as string ?? string.Empty)">
        const createTenantCheck = document.getElementById('createTenantCheck');
        const tenantSlugInput = document.getElementById('Input_TenantSlug');
        const tenantNameInput = document.getElementById('Input_TenantName');
        const tenantDescriptionInput = document.getElementById('Input_TenantDescription');

        createTenantCheck?.addEventListener('change', function() {
            const tenantFields = document.getElementById('tenantFields');
            if (this.checked) {
                tenantFields.style.display = 'block';
                tenantSlugInput?.focus();
            } else {
                tenantFields.style.display = 'none';
                if (tenantSlugInput) tenantSlugInput.value = '';
                if (tenantNameInput) tenantNameInput.value = '';
                if (tenantDescriptionInput) tenantDescriptionInput.value = '';
            }
        });

        tenantSlugInput?.addEventListener('input', function() {
            this.value = this.value.toLowerCase().replace(/[^a-z0-9\-]/g, '');
        });
    </script>
}
