@page
@model ErrorModel
@{
    Layout = null;
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Error - MrWhoOidc</title>
    <style>
        :root { color-scheme: light; font-family: Georgia, "Times New Roman", serif; }
        body { margin: 0; background: #f4f6f5; color: #18211d; }
        main { width: min(36rem, calc(100% - 2rem)); margin: 12vh auto 0; border-top: 4px solid #b42318; background: #fff; padding: 2rem; box-shadow: 0 12px 32px rgba(24, 33, 29, .12); }
        h1 { margin: 0 0 .75rem; font-size: 2rem; letter-spacing: 0; }
        p { line-height: 1.6; }
        .request-id { margin-top: 1.5rem; padding: .75rem; background: #f7f0df; overflow-wrap: anywhere; }
        a { display: inline-block; margin-top: 1.5rem; color: #fff; background: #176b4d; padding: .7rem 1rem; text-decoration: none; }
        a:focus-visible { outline: 3px solid #111; outline-offset: 3px; }
    </style>
</head>
<body>
    <main>
        <h1>Something went wrong</h1>
        <p>The request could not be completed. Try again, or provide the request ID to your administrator.</p>
        @if (Model.ShowRequestId)
        {
            <p class="request-id"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
        }
        <a href="/">Return home</a>
    </main>
</body>
</html>
