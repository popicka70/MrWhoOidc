@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="card">
    <div class="card-header">
        <h1 class="mb-0">
            <i class="ph ph-shield icon-md text-primary me-2"></i>
            @ViewData["Title"]
        </h1>
    </div>
    <div class="card-body p-4">
        <p class="lead">Your privacy is important to us.</p>
        <p>Use this page to detail your site's privacy policy and how you handle user data in compliance with applicable regulations.</p>
        
        <div class="alert alert-info mt-4">
            <i class="ph ph-info icon-sm me-2"></i>
            <strong>Note:</strong> This is a placeholder page. Please customize it with your actual privacy policy.
        </div>
    </div>
</div>
