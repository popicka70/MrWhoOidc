@page "/login"
@model MrWhoOidc.WebAuth.Pages.LoginModel
@using System.Linq
@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="card-body p-4">
        <div class="auth-card__header">
            @if (!string.IsNullOrEmpty(Model.TenantBranding?.LogoUrl))
            {
                <img src="@Model.TenantBranding.LogoUrl" 
                     alt="@Model.TenantBranding.TenantName Logo" 
                     class="auth-card__logo" />
                <h2 class="auth-card__title">Sign in to @Model.TenantBranding.TenantName</h2>
            }
            else
            {
                <i class="bi bi-box-arrow-in-right icon-xl icon-primary"></i>
                <h2 class="auth-card__title">Sign in to your account</h2>
            }
            @if (!string.IsNullOrEmpty(Model.Email))
            {
                <p class="auth-card__subtitle">
                    Signing in as <strong>@Model.Email</strong>
                    <br/>
                    <a asp-page="/DiscoverTenant" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none small">
                        <i class="bi bi-arrow-left me-1"></i>Not you?
                    </a>
                </p>
            }
            else
            {
                <p class="auth-card__subtitle">Enter your credentials to continue</p>
            }
        </div>

        <form method="post" asp-antiforgery="true">
            <input type="hidden" asp-for="ReturnUrl" />
            <input type="hidden" asp-for="Email" />
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }
            <div class="form-group">
                <label asp-for="Username" class="form-label">
                    <i class="bi bi-person icon-sm"></i> Username or Email
                </label>
                <input asp-for="Username" 
                       class="form-control" 
                       autocomplete="username" 
                       placeholder="alice or alice@example.com"
                       readonly="@(!string.IsNullOrEmpty(Model.Email))" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Password" class="form-label">
                    <i class="bi bi-lock icon-sm"></i> Password
                </label>
                <input asp-for="Password" 
                       class="form-control" 
                       type="password" 
                       autocomplete="current-password"
                       autofocus="@(!string.IsNullOrEmpty(Model.Email))" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            
            <!-- WebAuthn Alternative -->
            <div class="text-center mb-3">
                <div class="position-relative">
                    <hr class="my-3">
                    <span class="position-absolute top-50 start-50 translate-middle bg-white px-2 text-muted small">
                        or
                    </span>
                </div>
                <a asp-page="/Auth/WebAuthn" 
                   asp-route-returnUrl="@Model.ReturnUrl" 
                   asp-route-username="@Model.Username"
                   class="btn btn-outline-primary w-100 mb-3">
                    <i class="bi bi-shield-check me-2"></i>
                    Sign in with Security Key
                </a>
            </div>
            
            <button type="submit" class="btn btn-primary w-100 auth-btn">
                <i class="bi bi-box-arrow-in-right"></i> Sign in
            </button>
        </form>

        <div class="mt-4 d-flex justify-content-between">
            <a asp-page="/Registrations/Index" class="text-decoration-none">
                <i class="bi bi-person-plus me-1"></i>Register new user
            </a>
            <a asp-page="/Password/Index" class="text-decoration-none">
                <i class="bi bi-key me-1"></i>Change password
            </a>
        </div>
    </div>
</div>
