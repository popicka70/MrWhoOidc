@page "/login"
@model MrWhoOidc.WebAuth.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="card-body p-4">
        <div class="text-center mb-4">
            <i class="bi bi-box-arrow-in-right text-primary" style="font-size: 3rem;"></i>
            <h2 class="mt-3 mb-2 auth-heading">Sign in to your account</h2>
            @if (!string.IsNullOrEmpty(Model.Email))
            {
                <p class="text-muted">
                    Signing in as <strong>@Model.Email</strong>
                    <br/>
                    <a asp-page="/DiscoverTenant" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none small">
                        <i class="bi bi-arrow-left me-1"></i>Not you?
                    </a>
                </p>
            }
            else
            {
                <p class="text-muted">Enter your credentials to continue</p>
            }
        </div>

        <form method="post" asp-antiforgery="true">
            <input type="hidden" asp-for="ReturnUrl" />
            <input type="hidden" asp-for="Email" />
            <div class="mb-3">
                <label asp-for="Username" class="form-label">
                    <i class="bi bi-person me-1"></i>Username or Email
                </label>
                <input asp-for="Username" 
                       class="form-control" 
                       autocomplete="username" 
                       placeholder="alice or alice@example.com"
                       readonly="@(!string.IsNullOrEmpty(Model.Email))" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Password" class="form-label">
                    <i class="bi bi-lock me-1"></i>Password
                </label>
                <input asp-for="Password" 
                       class="form-control" 
                       type="password" 
                       autocomplete="current-password"
                       autofocus="@(!string.IsNullOrEmpty(Model.Email))" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100 auth-btn">
                <i class="bi bi-box-arrow-in-right"></i> Sign in
            </button>
        </form>

        <div class="mt-4 d-flex justify-content-between">
            <a asp-page="/Registrations/Index" class="text-decoration-none">
                <i class="bi bi-person-plus me-1"></i>Register new user
            </a>
            <a asp-page="/Password/Index" class="text-decoration-none">
                <i class="bi bi-key me-1"></i>Change password
            </a>
        </div>
    </div>
</div>
