@page "/mfa"
@inject MrWhoOidc.Auth.MultiTenancy.ITenantAccessor TenantAccessor
@inject MrWhoOidc.Auth.MultiTenancy.IMultiTenancyOptions MultiTenancyOptions
@model MrWhoOidc.WebAuth.Pages.Mfa.IndexModel
@{
    ViewData["Title"] = "Security";
    ViewData["ActiveAccountTab"] = "security";
    var currentTenant = TenantAccessor.CurrentTenant;
    var tenantPrefix = currentTenant != null && MultiTenancyOptions.Enabled 
        ? $"/t/{currentTenant.Slug}" 
        : "";
}

<h1 class="mb-3">Security</h1>
<partial name="~/Pages/Account/_AccountTabs.cshtml" />

<h2 class="mt-4">Two-factor authentication (TOTP)</h2>

@if (!string.IsNullOrEmpty(Model.InfoBanner))
{
    <div class="alert alert-secondary" role="alert">
        @Model.InfoBanner
    </div>
}

@if (!string.IsNullOrEmpty(Model.QrCodeUri))
{
    <p>Scan this QR code with your authenticator app, then enter a code to confirm:</p>
    <div id="qrcode" class="mb-3 d-inline-block p-3 bg-white border rounded" role="img" aria-label="Authenticator app setup QR code">
        <img id="mfaQrCodeImage" src="@Model.QrCodeDataUri" alt="Authenticator app setup QR code" width="180" height="180" />
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.ManualSetupKey))
    {
        <p class="small text-muted mb-3">
            Manual setup key:
            <code>@Model.ManualSetupKey</code>
        </p>
    }
}

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info">@Model.Message</div>
}

<form method="post">
    <input type="hidden" asp-for="Action" />
    @if (!Model.Enabled)
    {
        <div class="mb-3">
            <button type="submit" class="btn btn-primary btn-set-action" data-action-value="enable">Enable TOTP</button>
        </div>
    }
    else
    {
        <div class="mb-3">
            <label asp-for="VerificationCode" class="form-label">Verification code</label>
            <input asp-for="VerificationCode" class="form-control" autocomplete="one-time-code" />
            <span asp-validation-for="VerificationCode" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <button type="submit" class="btn btn-success btn-set-action" data-action-value="confirm">Confirm</button>
            <button type="submit" class="btn btn-danger btn-set-action" data-action-value="disable">Disable TOTP</button>
        </div>
    }
</form>

@section Scripts {
    <script nonce="@(HttpContext.Items["csp-nonce"] as string ?? string.Empty)">
        document.querySelectorAll('.btn-set-action').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.getElementById('Action').value = this.getAttribute('data-action-value');
            });
        });
    </script>
}
