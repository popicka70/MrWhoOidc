@page "/auth/external/error"
@model MrWhoOidc.WebAuth.Pages.Auth.External.ErrorModel
@{
    Layout = null; // Standalone minimal layout for error clarity
    var cid = Model.CorrelationId;
    var msg = Model.Message;
    var code = Model.Code;
    var clientId = Model.ClientId;
    var returnUrl = Model.ReturnUrl;
    var pickerUrl = (!string.IsNullOrEmpty(clientId) && !string.IsNullOrEmpty(returnUrl))
        ? $"/Auth/Providers/Select?client_id={System.Uri.EscapeDataString(clientId)}&ReturnUrl={System.Uri.EscapeDataString(returnUrl)}&cid={System.Uri.EscapeDataString(cid ?? string.Empty)}"
        : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Sign-in error</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body { background: #f8f9fa; }
        .error-container { max-width: 720px; margin: 3rem auto; }
        code { user-select: all; }
    </style>
</head>
<body>
    <div class="error-container">
        <div class="alert alert-danger d-flex align-items-start gap-2">
            <div>
                <h1 class="h4 mb-2">Sign-in failed</h1>
                <p class="mb-1">@msg</p>
                @if(!string.IsNullOrEmpty(code)) { <p class="text-muted small mb-1">Error code: <strong>@code</strong></p>; }
                @if(!string.IsNullOrEmpty(cid)) { <p class="text-muted small mb-1">Correlation ID: <code>@cid</code></p>; }
                <p class="text-muted small">Include the correlation ID if you contact support.</p>
            </div>
        </div>
        <div class="d-flex gap-2">
            @if(pickerUrl is not null) {
                <a class="btn btn-outline-primary" href="@pickerUrl">Choose a different provider</a>
            }
            @if(!string.IsNullOrEmpty(returnUrl)) {
                <a class="btn btn-secondary" href="@returnUrl">Back to application</a>
            }
        </div>
    </div>
</body>
</html>
