@page
@model MrWhoOidc.WebAuth.Pages.Auth.Providers.SelectModel
@{
    ViewData["Title"] = "Select Identity Provider";
}

<h2>Select your identity provider</h2>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (Model.Items.Count == 0)
{
    <p>No external providers are available for this client. <a href="/login?ReturnUrl=@Model.ReturnUrlEncoded">Use local login</a>.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-3">
        @foreach (var p in Model.Items)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body d-flex align-items-center justify-content-between">
                        <div>
                            <div class="fw-bold">@p.Display</div>
                            <div class="text-muted small">@p.Name</div>
                        </div>
                        <div>
                            <form method="post" asp-page-handler="Choose" class="d-inline">
                                <input type="hidden" name="provider" value="@p.Name" />
                                <button class="btn btn-primary">Continue</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="mt-3">
    <a href="/login?ReturnUrl=@Model.ReturnUrlEncoded" class="btn btn-link">Use local login instead</a>
</div>
