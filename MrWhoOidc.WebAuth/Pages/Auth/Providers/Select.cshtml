@page "/auth/providers/select"
@model MrWhoOidc.WebAuth.Pages.Auth.Providers.SelectModel
@using MrWhoOidc.WebAuth.Services
@{
    ViewData["Title"] = "Select provider";
    ViewData["HideNavbar"] = true;
    var scheme = StyleSchemes.Resolve(string.IsNullOrWhiteSpace(Model.StyleKey) ? Model.ClientStyleKey : Model.StyleKey);
}

<main class="mx-auto @scheme.CssClass provider-picker-container" style="max-width: 720px;" role="main" aria-labelledby="providerPickerHeading">
    @if (!string.IsNullOrEmpty(Model.ClientName))
    {
        <div class="small text-muted text-center mb-1">You are signing in to</div>
        <div class="h5 text-center mb-2">@Model.ClientName @if(!string.IsNullOrEmpty(Model.RealmName)){<span class="text-muted">(@Model.RealmName)</span>}</div>
    }

    <h1 id="providerPickerHeading" class="text-center auth-heading h4">Select your identity provider</h1>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger mt-3">@Model.Error</div>
    }

    @if (!string.IsNullOrEmpty(Model.Info))
    {
        <div class="alert alert-info mt-3">
            @Model.Info
            @if (!string.IsNullOrEmpty(Model.CorrelationId))
            {
                <div class="small text-muted mt-1">Correlation ID: <code>@Model.CorrelationId</code></div>
            }
        </div>
    }

    @if (!Model.AllowLocalLogin && Model.Providers.Count == 0)
    {
        <div class="alert alert-warning mt-3">No providers available for this client.</div>
    }
    else
    {
        <div class="card auth-card mt-3 shadow-sm" role="region" aria-label="Identity provider selection">
            <div class="card-body">
                @{
                    var recommended = Model.Providers.FirstOrDefault(p => p.IsRecommended);
                }
                @if (recommended is not null)
                {
                    <div class="alert alert-warning py-2 px-3 small d-flex align-items-center provider-recommendation" role="status" aria-live="polite" id="recommended-provider-banner">
                        <i class="bi bi-star-fill me-2" aria-hidden="true"></i>
                        <div>
                            <span class="fw-semibold">Recommended:</span>
                            <span class="ms-1">@recommended.Display</span>
                            @if (string.Equals(Model.RecommendationSource, "last", StringComparison.Ordinal))
                            {
                                <span class="text-muted ms-2">based on your last sign-in</span>
                            }
                            else if (string.Equals(Model.RecommendationSource, "hint", StringComparison.Ordinal))
                            {
                                <span class="text-muted ms-2">based on a sign-in hint</span>
                            }
                        </div>
                    </div>
                }
                <div class="d-grid gap-2 provider-list" role="list" aria-describedby="@(Model.RecommendationAriaDescription is not null ? "sr-recommended-text" : null)">
                    @if (Model.RecommendationAriaDescription is not null)
                    {
                        <div class="visually-hidden" id="sr-recommended-text">@Model.RecommendationAriaDescription</div>
                    }
                    @foreach (var p in Model.Providers)
                    {
                        var url = $"/Auth/External/Start?provider={Uri.EscapeDataString(p.Name)}&clientId={Uri.EscapeDataString(Model.Client_Id!)}&returnUrl={Uri.EscapeDataString(Model.ReturnUrl)}";
                        var aria = p.IsRecommended ? $"Recommended provider {p.Display}" : $"{p.Display}";
                        var describedBy = p.IsRecommended ? "sr-recommended-text" : null;
                        <a class="btn btn-outline-primary w-100 auth-btn d-flex align-items-center justify-content-start provider-btn provider-option @(p.IsRecommended ? "provider-option-recommended" : null)"
                           role="listitem"
                           href="@url"
                           aria-label="@aria"
                           @(describedBy is null ? null : Html.Raw($"aria-describedby=\"{describedBy}\""))
                           @(p.IsRecommended ? Html.Raw("data-autofocus=\"true\"") : null)
                           data-provider-name="@p.Name">
                            @if (!string.IsNullOrEmpty(p.LogoUrl))
                            {
                                <img src="@p.LogoUrl" alt="" class="me-2 auth-provider-logo" />
                            }
                            else
                            {
                                <i class="bi bi-shield-lock me-2 text-secondary" style="font-size:1.25rem;"></i>
                            }
                            <span class="flex-grow-1">@p.Display</span>
                            @if (p.IsRecommended)
                            {
                                <span class="badge rounded-pill bg-warning-subtle text-dark border border-warning ms-2 d-flex align-items-center provider-badge" title="Recommended provider" data-source="@Model.RecommendationSource">
                                    <i class="bi bi-star-fill me-1" aria-hidden="true"></i>
                                    <span class="provider-badge-text">Recommended</span>
                                </span>
                            }
                        </a>
                    }
                    @if (Model.AllowLocalLogin)
                    {
                        var loginUrl = "/login?ReturnUrl=" + Uri.EscapeDataString(Model.ReturnUrl);
                        <a class="btn btn-outline-primary w-100 auth-btn d-flex align-items-center justify-content-start provider-btn" href="@loginUrl" role="listitem" aria-label="Sign in with username and password" data-provider-name="_local">
                            <i class="bi bi-person me-2"></i> <span>Sign in with username/password</span>
                        </a>
                    }
                    @if (Model.AllowQrLogin)
                    {
                        // The ReturnUrl is like: /authorize?request_uri=...
                        // We need to append &qr to the actual query string, not the encoded part
                        // Since ReturnUrl already has "?", we append "&qr" directly (no encoding needed for our parameter)
                        var qrUrl = Model.ReturnUrl + "&qr";
                        // DEBUG
                        System.Console.WriteLine($"[QR Button] Original ReturnUrl='{Model.ReturnUrl}'");
                        System.Console.WriteLine($"[QR Button] Final qrUrl='{qrUrl}'");
                        <a class="btn btn-outline-primary w-100 auth-btn d-flex align-items-center justify-content-start provider-btn" href="@qrUrl" role="listitem" aria-label="Sign in with QR code" data-provider-name="_qr">
                            <i class="bi bi-qr-code me-2"></i> <span>Sign in with QR code</span>
                        </a>
                    }
                </div>

                <hr class="my-3" />

                                <a class="btn btn-outline-primary w-100 auth-cta register-btn" asp-page="/Registrations/Index" asp-route-returnUrl="@Model.ReturnUrl" role="button" aria-label="Register a new account">
                    <i class="bi bi-person-plus me-2"></i>
                    Register a new account
                </a>
            </div>
        </div>
    }
</main>

<script>
    (function() {
        // Progressive enhancement: focus recommended provider if present for keyboard users
        try {
            var el = document.querySelector('.provider-option[data-autofocus="true"]');
            if (el) {
                // Delay focus slightly to allow CSS/layout settle
                setTimeout(function(){ el.focus(); }, 50);
            }
        } catch { /* noop */ }
    })();
</script>

