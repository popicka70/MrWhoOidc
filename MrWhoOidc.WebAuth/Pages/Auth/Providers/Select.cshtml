@page
@model MrWhoOidc.WebAuth.Pages.Auth.Providers.SelectModel
@using MrWhoOidc.WebAuth.Services
@{
    ViewData["Title"] = "Select provider";
    ViewData["HideNavbar"] = true;
    var scheme = StyleSchemes.Resolve(string.IsNullOrWhiteSpace(Model.StyleKey) ? Model.ClientStyleKey : Model.StyleKey);
}

<div class="mx-auto @scheme.CssClass" style="max-width: 600px;">
    @if (!string.IsNullOrEmpty(Model.ClientName))
    {
        <div class="small text-muted text-center mb-1">You are signing in to</div>
        <div class="h5 text-center mb-2">@Model.ClientName @if(!string.IsNullOrEmpty(Model.RealmName)){<span class="text-muted">(@Model.RealmName)</span>}</div>
    }

    <h2 class="text-center auth-heading">Select your identity provider</h2>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger mt-3">@Model.Error</div>
    }

    @if (!Model.AllowLocalLogin && Model.Providers.Count == 0)
    {
        <div class="alert alert-warning mt-3">No providers available for this client.</div>
    }
    else
    {
        <div class="card auth-card mt-3 shadow-sm">
            <div class="list-group list-group-flush">
                @foreach (var p in Model.Providers)
                {
                    var url = $"/Auth/External/Start?provider={Uri.EscapeDataString(p.Name)}&clientId={Uri.EscapeDataString(Model.Client_Id!)}&returnUrl={Uri.EscapeDataString(Model.ReturnUrl)}";
                    <a class="list-group-item list-group-item-action d-flex align-items-center auth-option" href="@url">
                        @if (!string.IsNullOrEmpty(p.LogoUrl))
                        {
                            <img src="@p.LogoUrl" alt="@p.Display" class="me-2" style="height:24px;width:24px;object-fit:contain" />
                        }
                        else
                        {
                            <i class="bi bi-shield-lock me-2 text-secondary" style="font-size:1.25rem;"></i>
                        }
                        <span>@p.Display</span>
                    </a>
                }
                @if (Model.AllowLocalLogin)
                {
                    var loginUrl = "/login?ReturnUrl=" + Uri.EscapeDataString(Model.ReturnUrl);
                    <a class="list-group-item list-group-item-action d-flex align-items-center auth-option" href="@loginUrl">
                        <i class="bi bi-person me-2"></i> <span>Sign in with username/password</span>
                    </a>
                }
                @if (Model.AllowQrLogin)
                {
                    var qrUrl = "/Auth/Qr?ReturnUrl=" + Uri.EscapeDataString(Model.ReturnUrl);
                    <a class="list-group-item list-group-item-action d-flex align-items-center auth-option" href="@qrUrl">
                        <i class="bi bi-qr-code me-2"></i> <span>Sign in with QR code</span>
                    </a>
                }
            </div>
            <div class="card-body">
                <a class="btn btn-outline-primary w-100 auth-cta" asp-page="/Registrations/Index">
                    <i class="bi bi-person-plus me-2"></i>
                    Register a new account
                </a>
            </div>
        </div>
    }
</div>
