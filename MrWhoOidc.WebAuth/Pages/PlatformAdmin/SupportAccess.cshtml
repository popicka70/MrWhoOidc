@page "/platform-admin/support-access"
@model MrWhoOidc.WebAuth.Pages.PlatformAdmin.SupportAccessModel
@{
    ViewData["Title"] = "Tenant Support Access";
}

<div class="mt-2">
    <div class="page-header">
        <div class="page-header__content">
            <h1 class="page-header__title">
                <i class="ph ph-mask-happy icon-md icon-primary"></i>
                Tenant Support Access
            </h1>
            <p class="page-header__subtitle">View and manage the system for tenant troubleshooting and support</p>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Current Support Access Status -->
            @if (Model.CurrentSupportAccess != null)
    {
        <div class="card border-danger mb-4">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">
                    <i class="ph ph-warning-fill me-2"></i>
                    Currently Supporting Tenant
                    </h5>
                    </div>
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h4 class="mb-2">@Model.CurrentSupportAccess.TenantName</h4>
                                <div class="d-flex flex-wrap gap-3 mb-2">
                                    <div>
                                        <strong>Reason:</strong>
                                        <span class="ms-1">@Model.CurrentSupportAccess.Reason</span>
                                    </div>
                                    @if (Model.CurrentSupportAccess.TicketReference != null)
                                    {
                                        <div>
                                            <strong>Ticket:</strong>
                                        <span class="ms-1">@Model.CurrentSupportAccess.TicketReference</span>
                                        </div>
                                        }
                                    <div>
                                        <strong>Expires:</strong>
                                        <span class="ms-1">@Model.CurrentSupportAccess.RemainingTime</span>
                                        </div>
                                    <div>
                                        <strong>Duration:</strong>
                                        <span class="ms-1">@Model.CurrentSupportAccess.Duration</span>
                                        </div>
                                    </div>
                                <div class="alert alert-warning mb-0">
                                    <i class="ph ph-shield me-2"></i>
                                    <strong>Read-Only Mode:</strong> All write operations are disabled while support access is active.
                                </div>
                            </div>
                            <div class="col-md-4 text-end">
                                <form method="post" asp-page="/StopSupportAccess" class="d-inline">
                                    <button type="submit" class="btn btn-danger btn-lg">
                                        <i class="ph ph-x-circle me-2"></i>End Support Access
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                }
            }

    <!-- Tenant Selection Card -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="ph ph-buildings me-2"></i>Select Tenant for Support Access
            </h5>
        </div>
        <div class="card-body">
            <div class="alert alert-info">
                <i class="ph ph-info me-2"></i>
                <strong>What is tenant support access?</strong>
                Tenant support access allows you to view the system as a tenant administrator would see it,
                with <strong>read-only access</strong>. This is useful for:
                <ul class="mb-0 mt-2">
                    <li>Troubleshooting tenant-specific issues</li>
                    <li>Verifying configurations and permissions</li>
                    <li>Understanding the tenant admin experience</li>
                </ul>
            </div>

            @if (!Model.Tenants.Any())
            {
                <div class="alert alert-warning">
                    <i class="ph ph-warning me-2"></i>
                    No tenants found. Create a tenant first.
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var tenant in Model.Tenants)
                    {
                        <div class="col-md-6 col-lg-4 mb-3">
                            <div class="card h-100 @(tenant.IsActive ? "" : "border-secondary")">
                                <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <h5 class="card-title mb-0">@tenant.Name</h5>
                                                @if (!tenant.IsActive)
                                                {
                                                    <span class="badge bg-secondary">Inactive</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                            </div>
                                            
                                            <p class="card-text">
                                                <small class="text-muted">
                                                    <strong>Slug:</strong> <code>@tenant.Slug</code>
                                                </small>
                                            </p>

                                            <div class="d-flex justify-content-between align-items-center text-muted small mb-3">
                                                <span>
                                                    <i class="ph ph-users me-1"></i>@tenant.UserCount users
                                                </span>
                                                <span>
                                                    <i class="ph ph-box me-1"></i>@tenant.ClientCount clients
                                                </span>
                                            </div>

            @if (Model.CurrentSupportAccess?.TenantId == tenant.Id)
            {
                                                <button class="btn btn-danger btn-sm w-100" disabled>
                                                     <i class="ph ph-check-circle me-1"></i>Currently Supporting
                                                 </button>
                                             }
                                             else if (tenant.IsActive)
                                             {
                                                 <form method="post" asp-page-handler="StartSupportAccess">
                                                     <input type="hidden" name="tenantId" value="@tenant.Id" />
                                                     <div class="mb-2">
                                                         <label for="reason" class="form-label">Reason <span class="text-danger">(required)</span></label>
                                                         <input type="text" class="form-control" id="reason" name="reason" required="true" placeholder="Why are you starting support access?" maxlength="500">
                                                     </div>
                                                     <div class="mb-2">
                                                         <label for="ticketRef" class="form-label">Ticket Reference <span class="text-muted">(optional)</span></label>
                                                         <input type="text" class="form-control" id="ticketRef" name="ticketReference" placeholder="Support ticket #..." maxlength="100">
                                                     </div>
                                                     <div class="mb-2">
                                                         <label for="expiryMinutes" class="form-label">Expiry Minutes</label>
                                                         <input type="number" class="form-control" id="expiryMinutes" name="expiryMinutes" value="15" min="1" max="60">
                                                     </div>
                                                     <button type="submit" class="btn btn-primary btn-sm w-100">
                                                         <i class="ph ph-mask-happy me-1"></i>Start Support Access
                                                     </button>
                                                 </form>
                                             }
                                            else
                                            {
                                                <button class="btn btn-secondary btn-sm w-100" disabled>
                                                    <i class="ph ph-lock me-1"></i>Tenant Inactive
                                                </button>
                                            }
                                        </div>
                                        <div class="card-footer text-muted small">
                                            Created: @tenant.CreatedAt.ToString("yyyy-MM-dd")
                                            </div>
                                        </div>
                                        }
                                    </div>
                                </div>
                                }
                            </div>
            }

    <!-- Quick Tips -->
    <div class="card mt-4 border-info">
        <div class="card-header bg-info text-white">
            <h6 class="mb-0">
                <i class="ph ph-lightbulb me-2"></i>Quick Tips
            </h6>
        </div>
        <div class="card-body">
            <ul class="mb-0">
                <li>
                            <strong>Read-Only Mode:</strong> While support access is active, you can view all tenant data but cannot create, edit, or delete anything.
                    </li>
                    <li>
                        <strong>Navigation:</strong> Once support access is active, use the regular Admin menu to navigate tenant-specific pages.
                    </li>
                    <li>
                        <strong>Exit Anytime:</strong> Click the "End Support Access" button in the red banner to stop support access.
                    </li>
                    <li>
                        <strong>Audit Trail:</strong> All support access sessions are logged for security and compliance.
                    </li>
                </ul>
                </div>
            </div>
</div>

@section Scripts {
    <script nonce="@(HttpContext.Items["csp-nonce"] as string ?? string.Empty)">
        // Auto-dismiss alerts after 5 seconds
        setTimeout(function() {
            var alerts = document.querySelectorAll('.alert-dismissible');
            alerts.forEach(function(alert) {
                var bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>
}
