@page "/platform-admin"
@model MrWhoOidc.WebAuth.Pages.PlatformAdmin.IndexModel
@{
    ViewData["Title"] = "Platform Administration";
}

<div class="content-container py-4">
    <div class="page-header">
        <div class="page-header__content">
            <h1 class="page-header__title">
                <i class="ph-fill ph-gear icon-md icon-primary"></i>
                Platform Administration
            </h1>
            <p class="page-header__subtitle">Manage tenants, monitor system health, and configure platform-wide settings</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="ph-fill ph-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="ph ph-warning-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Quick Stats -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Total Tenants</h6>
                            <h3 class="mb-0 text-primary">@Model.TotalTenants</h3>
                        </div>
                        <div class="fs-1 text-primary opacity-50">
                            <i class="ph ph-buildings"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Active Tenants</h6>
                            <h3 class="mb-0 text-success">@Model.ActiveTenants</h3>
                        </div>
                        <div class="fs-1 text-success opacity-50">
                            <i class="ph ph-check-circle"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Total Users</h6>
                            <h3 class="mb-0 text-warning">@Model.TotalUsers</h3>
                        </div>
                        <div class="fs-1 text-warning opacity-50">
                            <i class="ph ph-users"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Total Clients</h6>
                            <h3 class="mb-0 text-info">@Model.TotalClients</h3>
                        </div>
                        <div class="fs-1 text-info opacity-50">
                            <i class="ph ph-grid"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="ph ph-lightning-charge-fill me-2"></i>Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <!-- Seed Sample Tenant -->
                        <div class="col-md-4">
                            <div class="card h-100 border-0 bg-light">
                                <div class="card-body">
                                    <h6 class="card-title">
                                        <i class="ph ph-plus-circle text-success me-2"></i>Seed Sample Tenant
                                    </h6>
                                    <p class="card-text small text-muted">
                                        Quickly create a fully-configured sample tenant with admin user, clients, and scopes for demos or testing.
                                        @if (!Model.IsMultiTenantMode)
                                        {
                                            <span class="badge bg-warning text-dark ms-1">Multi-tenant mode only</span>
                                        }
                                    </p>
                                    <button type="button" 
                                            class="btn btn-success btn-sm" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#seedTenantModal"
                                            disabled="@(!Model.IsMultiTenantMode)">
                                        <i class="ph ph-magic me-1"></i>Seed Tenant
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- View All Tenants -->
                        <div class="col-md-4">
                            <div class="card h-100 border-0 bg-light">
                                <div class="card-body">
                                    <h6 class="card-title">
                                        <i class="ph ph-buildings text-primary me-2"></i>Manage Tenants
                                    </h6>
                                    <p class="card-text small text-muted">
                                        View, create, edit, and manage all tenants in the system. Monitor tenant status and configuration.
                                    </p>
                                    <a href="/platform-admin/tenants" class="btn btn-primary btn-sm">
                                        <i class="ph ph-list-ul me-1"></i>View Tenants
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- System Health -->
                        <div class="col-md-4">
                            <div class="card h-100 border-0 bg-light">
                                <div class="card-body">
                                    <h6 class="card-title">
                                        <i class="ph ph-heart-pulse text-danger me-2"></i>System Health
                                    </h6>
                                    <p class="card-text small text-muted">
                                        Check system health, backchannel logout status, and monitor overall platform performance.
                                    </p>
                                    <a href="/health" class="btn btn-outline-danger btn-sm" target="_blank">
                                        <i class="ph ph-activity me-1"></i>Health Check
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="ph ph-clock-counter-clockwise me-2"></i>Recent Tenants</h5>
                </div>
                <div class="card-body">
                    @if (Model.RecentTenants.Any())
                    {
                        <div class="table-responsive">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Slug</th>
                                        <th>Name</th>
                                        <th>Status</th>
                                        <th>Created</th>
                                        <th>Users</th>
                                        <th>Clients</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tenant in Model.RecentTenants)
                                    {
                                        <tr>
                                            <td><code>@tenant.Slug</code></td>
                                            <td>@tenant.Name</td>
                                            <td>
                                                @if (tenant.Status == MrWhoOidc.Auth.Persistence.TenantStatus.Active)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else if (tenant.Status == MrWhoOidc.Auth.Persistence.TenantStatus.Suspended)
                                                {
                                                    <span class="badge bg-warning">Suspended</span>
                                                }
                                                else if (tenant.Status == MrWhoOidc.Auth.Persistence.TenantStatus.PendingSetup)
                                                {
                                                    <span class="badge bg-info">Pending</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@tenant.Status</span>
                                                }
                                            </td>
                                            <td class="text-muted small">@tenant.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>@tenant.UserCount</td>
                                            <td>@tenant.ClientCount</td>
                                            <td>
                                                <a href="/platform-admin/tenants/edit/@tenant.Id" class="btn btn-sm btn-outline-primary">
                                                    <i class="ph ph-pencil-simple"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="ph ph-inbox fs-1"></i>
                            <p class="mt-2">No tenants found. Create your first tenant to get started!</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Seed Tenant Modal -->
<div class="modal fade" id="seedTenantModal" tabindex="-1" aria-labelledby="seedTenantModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="SeedTenant">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title" id="seedTenantModalLabel">
                        <i class="ph ph-magic me-2"></i>Seed Sample Tenant
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info">
                        <i class="ph ph-info me-2"></i>
                        <strong>What gets created:</strong> A fully-configured tenant with default/admin realms, admin role, admin user, 
                        admin client, web client, and standard OIDC scopes.
                    </div>

                    <div class="mb-3">
                        <label for="tenantSlug" class="form-label">Tenant Slug <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="tenantSlug" name="tenantSlug" 
                               placeholder="e.g., acme-corp" pattern="[a-z0-9-]+" required>
                        <div class="form-text">Lowercase, numbers, and hyphens only. Used in URLs: /t/{slug}/...</div>
                    </div>

                    <div class="mb-3">
                        <label for="tenantName" class="form-label">Tenant Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="tenantName" name="tenantName" 
                               placeholder="e.g., Acme Corporation" required>
                        <div class="form-text">Display name for the tenant</div>
                    </div>

                    <div class="mb-3">
                        <label for="adminEmail" class="form-label">Admin Email</label>
                        <input type="email" class="form-control" id="adminEmail" name="adminEmail" 
                               placeholder="Leave empty for admin@@[slug].local">
                        <div class="form-text">Optional. Defaults to admin@@[slug].local</div>
                    </div>

                    <div class="mb-3">
                        <label for="adminPassword" class="form-label">Admin Password</label>
                        <input type="password" class="form-control" id="adminPassword" name="adminPassword" 
                               placeholder="Leave empty for Admin123!">
                        <div class="form-text">Optional. Defaults to Admin123! (⚠️ development only)</div>
                    </div>

                    <div class="alert alert-warning mb-0">
                        <i class="ph ph-warning me-2"></i>
                        <strong>Security Note:</strong> Change the default password immediately in production environments!
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="ph ph-magic me-1"></i>Seed Tenant
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script nonce="@(HttpContext.Items["csp-nonce"] as string ?? string.Empty)">
        // Auto-focus tenant slug input when modal opens
        document.getElementById('seedTenantModal').addEventListener('shown.bs.modal', function () {
            document.getElementById('tenantSlug').focus();
        });

        // Convert slug to lowercase and remove invalid characters
        document.getElementById('tenantSlug').addEventListener('input', function (e) {
            e.target.value = e.target.value.toLowerCase().replace(/[^a-z0-9-]/g, '');
        });
    </script>
}
