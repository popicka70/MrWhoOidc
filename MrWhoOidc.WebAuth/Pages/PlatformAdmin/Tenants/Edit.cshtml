@page "{id:guid}"
@model MrWhoOidc.WebAuth.Pages.PlatformAdmin.Tenants.EditModel
@{
    ViewData["Title"] = $"Edit Tenant: {Model.Input.Name}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="m-0">
            <i class="bi bi-pencil text-primary me-2"></i>
            Edit Tenant
        </h1>
        <p class="text-muted mb-0">
            <code>@Model.Input.Slug</code>
        </p>
    </div>
    <div>
        <a class="btn btn-outline-secondary me-2" asp-page="Index">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
        <button type="submit" form="editTenantForm" class="btn btn-success">
            <i class="bi bi-check-circle"></i> Save Changes
        </button>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <strong>Validation Error:</strong> Please correct the errors below.
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="post" id="editTenantForm">
    <input type="hidden" asp-for="Input.Id" />
    
    <div class="card mb-4">
        <div class="card-header">
            <i class="bi bi-info-circle me-2"></i>Basic Information
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Slug</label>
                    <input type="text" class="form-control" value="@Model.Input.Slug" disabled />
                    <div class="form-text">Slug cannot be changed after creation</div>
                </div>
                
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.Name" class="form-label">Name <span class="text-danger">*</span></label>
                    <input asp-for="Input.Name" class="form-control" />
                    <span asp-validation-for="Input.Name" class="text-danger small"></span>
                </div>
            </div>
            
            <div class="mb-3">
                <label asp-for="Input.Description" class="form-label">Description</label>
                <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Input.Description" class="text-danger small"></span>
            </div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.AdminEmail" class="form-label">Admin Email</label>
                    <input asp-for="Input.AdminEmail" type="email" class="form-control" />
                    <div class="form-text">Primary contact email</div>
                    <span asp-validation-for="Input.AdminEmail" class="text-danger small"></span>
                </div>
                
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.IssuerUri" class="form-label">
                        Issuer URI <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Input.IssuerUri" type="text" class="form-control" placeholder="https://localhost:8443/t/pop-app" />
                    <div class="form-text">
                        <i class="bi bi-info-circle me-1"></i>
                        Full issuer URL for this tenant (used in OIDC discovery). Must match the URL pattern used in your deployment.
                    </div>
                    <span asp-validation-for="Input.IssuerUri" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>
    
    <div class="card mb-4">
        <div class="card-header">
            <i class="bi bi-gear me-2"></i>Configuration
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.Status" class="form-label">Status</label>
                    <select asp-for="Input.Status" class="form-select">
                        <option value="1">Active</option>
                        <option value="2">Suspended</option>
                        <option value="3">Pending Setup</option>
                        <option value="4">Deleted</option>
                    </select>
                    <span asp-validation-for="Input.Status" class="text-danger small"></span>
                </div>
                
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.BillingPlan" class="form-label">Billing Plan</label>
                    <select asp-for="Input.BillingPlan" class="form-select">
                        <option value="">None</option>
                        <option value="Free">Free</option>
                        <option value="Starter">Starter</option>
                        <option value="Pro">Pro</option>
                        <option value="Enterprise">Enterprise</option>
                    </select>
                    <span asp-validation-for="Input.BillingPlan" class="text-danger small"></span>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.MaxUsers" class="form-label">Max Users</label>
                    <input asp-for="Input.MaxUsers" type="number" class="form-control" />
                    <div class="form-text">Current: @Model.CurrentUserCount users</div>
                    <span asp-validation-for="Input.MaxUsers" class="text-danger small"></span>
                </div>
                
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.MaxClients" class="form-label">Max Clients</label>
                    <input asp-for="Input.MaxClients" type="number" class="form-control" />
                    <div class="form-text">Current: @Model.CurrentClientCount clients</div>
                    <span asp-validation-for="Input.MaxClients" class="text-danger small"></span>
                </div>
            </div>
            
            <div class="mb-3">
                <label asp-for="Input.MaxIdentityProviders" class="form-label">Max Identity Providers</label>
                <input asp-for="Input.MaxIdentityProviders" type="number" class="form-control" />
                <div class="form-text">Current: @Model.CurrentIdPCount identity providers</div>
                <span asp-validation-for="Input.MaxIdentityProviders" class="text-danger small"></span>
            </div>
        </div>
    </div>
    
    <div class="card mb-4">
        <div class="card-header">
            <i class="bi bi-palette me-2"></i>Branding
        </div>
        <div class="card-body">
            <!-- Icon/Logo Section -->
            <div class="mb-4">
                <label class="form-label">Tenant Icon</label>
                
                <!-- Current Icon Display -->
                <div id="current-icon-display" class="mb-3">
                    @if (Model.HasUploadedIcon)
                    {
                        <div class="d-flex align-items-center gap-3">
                            <img id="current-icon-img" src="/api/icon/@Model.Input.TenantIconId" alt="Current tenant icon" 
                                 class="image-preview" />
                            <div>
                                <div class="text-success"><i class="bi bi-check-circle me-1"></i>Uploaded icon</div>
                                <button type="button" id="delete-icon-btn" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash me-1"></i>Delete Icon
                                </button>
                            </div>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(Model.Input.LogoUrl))
                    {
                        <div class="d-flex align-items-center gap-3">
                            <img id="current-logo-img" src="@Model.Input.LogoUrl" alt="Logo from URL" 
                                 class="image-preview" />
                            <div>
                                <div class="text-info"><i class="bi bi-link me-1"></i>From URL</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">
                            <i class="bi bi-image me-1"></i>No icon configured
                        </div>
                    }
                </div>

                <!-- Upload Section -->
                <div class="border rounded p-3 bg-light">
                    <h6 class="mb-3">Upload New Icon</h6>
                    <div class="mb-3">
                        <input type="file" id="icon-upload" accept="image/*" class="form-control" />
                        <div class="form-text">
                            Supported formats: PNG, JPG, SVG, WebP, GIF. Max size: 2MB. Recommended: 200x60px.
                        </div>
                    </div>
                    
                    <!-- Upload Preview -->
                    <div id="upload-preview" style="display: none;" class="mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <img id="preview-img" alt="Upload preview" 
                                 class="image-preview" style="border-color: var(--color-success);" />
                            <div>
                                <div class="text-success"><i class="bi bi-cloud-arrow-up me-1"></i>Ready to upload</div>
                                <button type="button" id="upload-icon-btn" class="btn btn-sm btn-success">
                                    <i class="bi bi-upload me-1"></i>Upload Icon
                                </button>
                                <button type="button" id="cancel-upload-btn" class="btn btn-sm btn-secondary ms-2">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Upload Progress -->
                    <div id="upload-progress" style="display: none;" class="mb-3">
                        <div class="progress">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" 
                                 role="progressbar" style="width: 0%"></div>
                        </div>
                        <div class="text-muted small mt-1">Uploading...</div>
                    </div>
                </div>

                <!-- Fallback URL option -->
                <div class="mt-3">
                    <label asp-for="Input.LogoUrl" class="form-label">
                        Or use Logo URL 
                        <small class="text-muted">(fallback if no icon uploaded)</small>
                    </label>
                    <input asp-for="Input.LogoUrl" type="url" class="form-control" 
                           placeholder="https://example.com/logo.png" />
                    <span asp-validation-for="Input.LogoUrl" class="text-danger small"></span>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.PrimaryColor" class="form-label">Primary Color</label>
                    <input asp-for="Input.PrimaryColor" type="color" class="form-control form-control-color" />
                </div>
                
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.AccentColor" class="form-label">Accent Color</label>
                    <input asp-for="Input.AccentColor" type="color" class="form-control form-control-color" />
                </div>
            </div>
        </div>
    </div>
    
    <div class="card mb-4">
        <div class="card-header">
            <i class="bi bi-clock-history me-2"></i>Metadata
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Created</label>
                    <input type="text" class="form-control" value="@Model.Input.CreatedAt.ToString("yyyy-MM-dd HH:mm")" disabled />
                </div>
                
                <div class="col-md-4 mb-3">
                    <label class="form-label">Suspended At</label>
                    <input type="text" class="form-control" value="@(Model.Input.SuspendedAt?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")" disabled />
                </div>
                
                <div class="col-md-4 mb-3">
                    <label class="form-label">Deleted At</label>
                    <input type="text" class="form-control" value="@(Model.Input.DeletedAt?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")" disabled />
                </div>
            </div>
        </div>
    </div>
    
    <div class="d-flex justify-content-between">
        <div>
            <a class="btn btn-secondary" asp-page="Index">
                <i class="bi bi-x-circle"></i> Cancel
            </a>
            
            @if (Model.Input.Status != MrWhoOidc.Auth.Persistence.TenantStatus.Deleted)
            {
                <button type="submit" asp-page-handler="Suspend" class="btn btn-warning" 
                        onclick="return confirm('Are you sure you want to suspend this tenant? Users will not be able to access it.');">
                    <i class="bi bi-pause-circle"></i> 
                    @(Model.Input.Status == MrWhoOidc.Auth.Persistence.TenantStatus.Suspended ? "Activate" : "Suspend")
                </button>
            }
        </div>
        
        <div>
            @if (Model.Input.Status != MrWhoOidc.Auth.Persistence.TenantStatus.Deleted && Model.CurrentUserCount == 0)
            {
                <button type="submit" asp-page-handler="Delete" class="btn btn-danger me-2" 
                        onclick="return confirm('Are you sure you want to delete this tenant? This action cannot be undone.');">
                    <i class="bi bi-trash"></i> Delete Tenant
                </button>
            }
            
            <button type="submit" class="btn btn-success">
                <i class="bi bi-check-circle"></i> Save Changes
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        // Tenant Icon Upload Functionality
        (function() {
            const fileInput = document.getElementById('icon-upload');
            const uploadPreview = document.getElementById('upload-preview');
            const previewImg = document.getElementById('preview-img');
            const uploadBtn = document.getElementById('upload-icon-btn');
            const cancelBtn = document.getElementById('cancel-upload-btn');
            const deleteBtn = document.getElementById('delete-icon-btn');
            const uploadProgress = document.getElementById('upload-progress');
            const currentIconDisplay = document.getElementById('current-icon-display');
            const tenantId = '@Model.Input.Id';
            const currentTenantSlug = '@Model.CurrentTenantSlug';

            // File selection handler
            fileInput.addEventListener('change', function(e) {
                console.log('File input changed');
                const file = e.target.files[0];
                if (!file) {
                    console.log('No file selected');
                    hideUploadPreview();
                    return;
                }

                console.log('File selected:', {
                    name: file.name,
                    size: file.size,
                    type: file.type
                });

                // Validate file type
                if (!file.type.startsWith('image/')) {
                    console.warn('Invalid file type:', file.type);
                    alert('Please select an image file.');
                    fileInput.value = '';
                    return;
                }

                // Validate file size (2MB)
                if (file.size > 2 * 1024 * 1024) {
                    console.warn('File too large:', file.size);
                    alert('File size must be less than 2MB.');
                    fileInput.value = '';
                    return;
                }

                console.log('File validation passed, showing preview');
                // Show preview
                const reader = new FileReader();
                reader.onload = function(e) {
                    console.log('File read complete, updating preview');
                    previewImg.src = e.target.result;
                    showUploadPreview();
                };
                reader.readAsDataURL(file);
            });

            // Upload button handler
            uploadBtn.addEventListener('click', async function() {
                console.log('Upload button clicked');
                const file = fileInput.files[0];
                if (!file) {
                    console.warn('No file selected for upload');
                    return;
                }

                console.log('Starting upload for file:', {
                    name: file.name,
                    size: file.size,
                    type: file.type,
                    tenantId: tenantId
                });

                try {
                    showUploadProgress();
                    
                    const formData = new FormData();
                    formData.append('file', file);

                    const requestUrl = `/t/${currentTenantSlug}/admin/api/tenants/${tenantId}/icon`;
                    console.log('Making POST request to:', requestUrl);

                    const response = await fetch(requestUrl, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    });

                    console.log('Response received:', {
                        status: response.status,
                        statusText: response.statusText,
                        ok: response.ok,
                        headers: [...response.headers.entries()]
                    });

                    if (response.ok) {
                        const result = await response.json();
                        console.log('Upload successful:', result);
                        
                        // Update UI to show uploaded icon
                        location.reload(); // Simple approach - reload page to show new icon
                    } else {
                        const error = await response.text(); // Use text() first in case it's not JSON
                        console.error('Upload failed:', {
                            status: response.status,
                            statusText: response.statusText,
                            body: error
                        });
                        
                        try {
                            const errorJson = JSON.parse(error);
                            alert('Upload failed: ' + (errorJson.detail || errorJson.title || 'Unknown error'));
                        } catch {
                            alert('Upload failed: ' + error);
                        }
                    }
                } catch (error) {
                    console.error('Upload error:', error);
                    alert('Upload failed: ' + error.message);
                } finally {
                    hideUploadProgress();
                    hideUploadPreview();
                    fileInput.value = '';
                }
            });

            // Cancel button handler
            cancelBtn.addEventListener('click', function() {
                hideUploadPreview();
                fileInput.value = '';
            });

            // Delete icon button handler
            if (deleteBtn) {
                deleteBtn.addEventListener('click', async function() {
                    if (!confirm('Are you sure you want to delete the current icon?')) {
                        return;
                    }

                    try {
                        const response = await fetch(`/t/${currentTenantSlug}/admin/api/tenants/${tenantId}/icon`, {
                            method: 'DELETE',
                            headers: {
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                            }
                        });

                        if (response.ok) {
                            location.reload(); // Reload to show updated state
                        } else {
                            const error = await response.json();
                            alert('Delete failed: ' + (error.detail || 'Unknown error'));
                        }
                    } catch (error) {
                        alert('Delete failed: ' + error.message);
                    }
                });
            }

            // Helper functions
            function showUploadPreview() {
                uploadPreview.style.display = 'block';
            }

            function hideUploadPreview() {
                uploadPreview.style.display = 'none';
            }

            function showUploadProgress() {
                uploadProgress.style.display = 'block';
                uploadBtn.disabled = true;
                cancelBtn.disabled = true;
            }

            function hideUploadProgress() {
                uploadProgress.style.display = 'none';
                uploadBtn.disabled = false;
                cancelBtn.disabled = false;
            }
        })();
    </script>
}
