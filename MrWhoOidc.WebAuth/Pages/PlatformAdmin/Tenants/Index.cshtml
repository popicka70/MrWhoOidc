@page "/platform-admin/tenants"
@model MrWhoOidc.WebAuth.Pages.PlatformAdmin.Tenants.IndexModel
@{
    ViewData["Title"] = "Tenants";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="m-0">
            <i class="ph ph-buildings text-primary me-2"></i>
            Tenants
        </h1>
        <p class="text-muted mb-0">Manage multi-tenant instances</p>
    </div>
    <div class="btn-group">
        <a class="btn btn-outline-primary" asp-page="Import">
            <i class="ph ph-upload"></i> Import Tenants
        </a>
        <a class="btn btn-success" asp-page="Create">
            <i class="ph ph-plus"></i> Add Tenant
        </a>
    </div>
</div>

@if (Model.TenantRows.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="ph ph-buildings icon-xl text-muted mb-2"></i>
            <p class="text-muted mb-1">No tenants found.</p>
            <p class="text-muted small mb-3">
                @(string.IsNullOrEmpty(Model.Search)
                    ? "Create your first tenant to get started — its users, clients and realms are isolated from every other organization."
                    : $"No tenants match “{Model.Search}”.")
            </p>
            <a class="btn btn-primary" asp-page="Create">
                <i class="ph ph-plus me-1"></i>Add Tenant
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-2 mb-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label mb-1" for="tenantSearchInput">
                <i class="ph ph-magnifying-glass me-1"></i>Search
            </label>
            <input type="search" id="tenantSearchInput" class="form-control" placeholder="Name or slug…"
                   value="@Model.Search" />
        </div>
        <div class="col-md-4">
            <label class="form-label mb-1" for="tenantStatusFilter">
                <i class="ph ph-funnel me-1"></i>Status
            </label>
            <select id="tenantStatusFilter" class="form-select">
                <option value="">All</option>
                <option value="active">Active</option>
                <option value="suspended">Suspended</option>
                <option value="pending">Pending setup</option>
            </select>
        </div>
        <div class="col-md-3 text-md-end">
            <small class="text-muted d-block">@Model.TenantRows.Count tenant(s)</small>
        </div>
    </div>

    <div class="card">
        <div class="table-responsive table-responsive-cards">
            <table class="data-table align-middle mb-0" id="tenantsTable">
                <thead>
                    <tr>
                        <th>
                            <i class="ph ph-tag me-1"></i>Slug
                        </th>
                        <th>
                            <i class="ph ph-buildings me-1"></i>Name
                        </th>
                        <th class="d-none d-md-table-cell">
                            <i class="ph ph-link me-1"></i>Issuer
                        </th>
                        <th class="d-none d-md-table-cell">Status</th>
                        <th class="d-none d-lg-table-cell">Users</th>
                        <th class="d-none d-lg-table-cell">Clients</th>
                        <th class="d-none d-lg-table-cell">Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var t in Model.TenantRows)
                {
                    var statusKey = t.Status switch
                    {
                        MrWhoOidc.Auth.Persistence.TenantStatus.Active => "active",
                        MrWhoOidc.Auth.Persistence.TenantStatus.Suspended => "suspended",
                        MrWhoOidc.Auth.Persistence.TenantStatus.PendingSetup => "pending",
                        _ => "other"
                    };
                    <tr data-status="@statusKey"
                        data-search="@(t.Name.ToLowerInvariant()) @(t.Slug.ToLowerInvariant())">
                        <td data-label="Slug">
                            <code class="text-primary">@t.Slug</code>
                            @if (t.IsDefaultTenant)
                            {
                                <span class="badge text-bg-secondary ms-1" title="The platform's default tenant — it cannot be suspended or deleted">Default</span>
                            }
                        </td>
                        <td data-label="Name">
                            <strong>@t.Name</strong>
                            @if (!string.IsNullOrEmpty(t.Description))
                            {
                                <br />
                                <small class="text-muted">@t.Description</small>
                            }
                        </td>
                        <td data-label="Issuer" class="d-none d-md-table-cell">
                            <small><code>@t.IssuerUri</code></small>
                        </td>
                        <td data-label="Status" class="d-none d-md-table-cell">
                            @switch (t.Status)
                            {
                                case MrWhoOidc.Auth.Persistence.TenantStatus.Active:
                                    <span class="badge text-bg-success">
                                        <i class="ph ph-check-circle"></i> Active
                                    </span>
                                    break;
                                case MrWhoOidc.Auth.Persistence.TenantStatus.Suspended:
                                    <span class="badge text-bg-warning">
                                        <i class="ph ph-pause-circle"></i> Suspended
                                    </span>
                                    break;
                                case MrWhoOidc.Auth.Persistence.TenantStatus.PendingSetup:
                                    <span class="badge text-bg-info">
                                        <i class="ph ph-hourglass-split"></i> Pending Setup
                                    </span>
                                    break;
                                case MrWhoOidc.Auth.Persistence.TenantStatus.Deleted:
                                    <span class="badge text-bg-danger">
                                        <i class="ph ph-trash"></i> Deleted
                                    </span>
                                    break;
                            }
                        </td>
                        <td data-label="Users" class="d-none d-lg-table-cell">
                            <span class="badge text-bg-secondary">@t.UserCount</span>
                            @if (t.MaxUsers > 0)
                            {
                                <small class="text-muted">/ @t.MaxUsers</small>
                            }
                        </td>
                        <td data-label="Clients" class="d-none d-lg-table-cell">
                            <span class="badge text-bg-secondary">@t.ClientCount</span>
                            @if (t.MaxClients > 0)
                            {
                                <small class="text-muted">/ @t.MaxClients</small>
                            }
                        </td>
                        <td data-label="Created" class="d-none d-lg-table-cell">
                            <small class="text-muted">@t.CreatedAt.ToString("yyyy-MM-dd")</small>
                        </td>
                        <td data-label="Actions" class="text-end">
            <form method="post" asp-page="/PlatformAdmin/SupportAccess" asp-page-handler="StartSupportAccess" id="support-access-form-@t.Id" style="display:none;">
                <input type="hidden" name="tenantId" value="@t.Id" />
            </form>
            <form method="post" asp-page="Index" asp-page-handler="ToggleStatus" id="toggle-status-form-@t.Id" style="display:none;">
                <input type="hidden" name="id" value="@t.Id" />
            </form>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn btn-outline-secondary btn-support-access" title="Start support access" data-form-id="support-access-form-@t.Id">Support access</button>
                                <a class="btn btn-outline-secondary" asp-page="Edit" asp-route-id="@t.Id" title="Edit">Edit</a>
                                <a class="btn btn-outline-secondary" asp-page="Export" asp-route-id="@t.Id" title="Export Configuration">Export</a>
                                @if (t.IsDefaultTenant)
                                {
                                    <button type="button" class="btn btn-outline-secondary" disabled
                                            title="The default tenant cannot be suspended — platform administration lives there.">
                                        <i class="ph ph-pause-circle me-1"></i>Suspend
                                    </button>
                                }
                                else if (t.Status == MrWhoOidc.Auth.Persistence.TenantStatus.Active)
                                {
                                    <button type="button" class="btn btn-outline-warning" title="Suspend this tenant — its URLs stop resolving"
                                            data-form-id="toggle-status-form-@t.Id" data-toggle-status="true">
                                        <i class="ph ph-pause-circle me-1"></i>Suspend
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-success" title="Re-enable this tenant"
                                            data-form-id="toggle-status-form-@t.Id" data-toggle-status="true">
                                        <i class="ph ph-play-circle me-1"></i>Enable
                                    </button>
                                }
                                @if (!t.IsDefaultTenant)
                                {
                                    <a class="btn btn-outline-danger" asp-page="Delete" asp-route-id="@t.Id" title="Delete tenant (soft delete)">Del</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="mt-4">
    <div class="card">
        <div class="card-header">
            <i class="ph ph-info me-2"></i>Multi-Tenancy Information
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h6>Current Mode</h6>
                    <p class="mb-2">
                        <span class="badge text-bg-primary">@Model.CurrentMode</span>
                    </p>
                    <small class="text-muted">
                        @if (Model.CurrentMode == "MultiTenant")
                        {
                            <span>Tenants are accessed via <code>/t/{tenant-slug}/...</code> URLs</span>
                        }
                        else
                        {
                            <span>Single tenant mode active</span>
                        }
                    </small>
                </div>
                <div class="col-md-6">
                    <h6>Default Tenant</h6>
                    <p class="mb-2">
                        @if (!string.IsNullOrEmpty(Model.DefaultTenantSlug))
                        {
                            <code>@Model.DefaultTenantSlug</code>
                        }
                        else
                        {
                            <span class="text-muted">None configured</span>
                        }
                    </p>
                    <small class="text-muted">Fallback tenant for non-prefixed routes</small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script nonce="@(HttpContext.Items["csp-nonce"] as string ?? string.Empty)">
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.btn-impersonate').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var form = document.getElementById(this.getAttribute('data-form-id'));
                    if (form) form.submit();
                });
            });

            // Suspend/Enable buttons submit their tenant's hidden toggle-status form.
            document.querySelectorAll('[data-toggle-status]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var form = document.getElementById(this.getAttribute('data-form-id'));
                    if (form) form.submit();
                });
            });

            // Live search and status filter: rows are filtered instantly as you type, with no
            // round-trip to the server. A hard Enter submits the server-side search too.
            var searchInput = document.getElementById('tenantSearchInput');
            var statusFilter = document.getElementById('tenantStatusFilter');
            var table = document.getElementById('tenantsTable');
            if (!searchInput || !table) return;

            var rows = Array.prototype.slice.call(table.querySelectorAll('tbody tr'));

            function applyFilters() {
                var needle = (searchInput.value || '').trim().toLowerCase();
                var status = statusFilter ? statusFilter.value : '';
                rows.forEach(function (row) {
                    var matchesSearch = !needle || (row.getAttribute('data-search') || '').indexOf(needle) !== -1;
                    var matchesStatus = !status || row.getAttribute('data-status') === status;
                    row.style.display = (matchesSearch && matchesStatus) ? '' : 'none';
                });
            }

            searchInput.addEventListener('input', applyFilters);
            if (statusFilter) statusFilter.addEventListener('change', applyFilters);
            searchInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    var url = new URL(window.location.href);
                    url.search = searchInput.value ? '?Search=' + encodeURIComponent(searchInput.value) : '';
                    window.location.href = url.toString();
                }
            });
            applyFilters();
        });
    </script>
}
