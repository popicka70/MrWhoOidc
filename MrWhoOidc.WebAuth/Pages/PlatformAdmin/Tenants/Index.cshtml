@page "/platform-admin/tenants"
@model MrWhoOidc.WebAuth.Pages.PlatformAdmin.Tenants.IndexModel
@{
    ViewData["Title"] = "Tenants";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="m-0">
            <i class="bi bi-building text-primary me-2"></i>
            Tenants
        </h1>
        <p class="text-muted mb-0">Manage multi-tenant instances</p>
    </div>
    <div class="btn-group">
        <a class="btn btn-outline-primary" asp-page="Import">
            <i class="bi bi-upload"></i> Import Tenant
        </a>
        <a class="btn btn-success" asp-page="Create">
            <i class="bi bi-plus-lg"></i> Create Tenant
        </a>
    </div>
</div>

@if (Model.TenantRows.Count == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        No tenants found. Create your first tenant to get started.
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive table-responsive-cards">
            <table class="data-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>
                            <i class="bi bi-tag me-1"></i>Slug
                        </th>
                        <th>
                            <i class="bi bi-building me-1"></i>Name
                        </th>
                        <th class="d-none d-md-table-cell">
                            <i class="bi bi-link-45deg me-1"></i>Issuer
                        </th>
                        <th class="d-none d-md-table-cell">Status</th>
                        <th class="d-none d-lg-table-cell">Users</th>
                        <th class="d-none d-lg-table-cell">Clients</th>
                        <th class="d-none d-lg-table-cell">Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var t in Model.TenantRows)
                {
                    <tr>
                        <td data-label="Slug">
                            <code class="text-primary">@t.Slug</code>
                        </td>
                        <td data-label="Name">
                            <strong>@t.Name</strong>
                            @if (!string.IsNullOrEmpty(t.Description))
                            {
                                <br />
                                <small class="text-muted">@t.Description</small>
                            }
                        </td>
                        <td data-label="Issuer" class="d-none d-md-table-cell">
                            <small><code>@t.IssuerUri</code></small>
                        </td>
                        <td data-label="Status" class="d-none d-md-table-cell">
                            @switch (t.Status)
                            {
                                case MrWhoOidc.Auth.Persistence.TenantStatus.Active:
                                    <span class="badge text-bg-success">
                                        <i class="bi bi-check-circle"></i> Active
                                    </span>
                                    break;
                                case MrWhoOidc.Auth.Persistence.TenantStatus.Suspended:
                                    <span class="badge text-bg-warning">
                                        <i class="bi bi-pause-circle"></i> Suspended
                                    </span>
                                    break;
                                case MrWhoOidc.Auth.Persistence.TenantStatus.PendingSetup:
                                    <span class="badge text-bg-info">
                                        <i class="bi bi-hourglass-split"></i> Pending Setup
                                    </span>
                                    break;
                                case MrWhoOidc.Auth.Persistence.TenantStatus.Deleted:
                                    <span class="badge text-bg-danger">
                                        <i class="bi bi-trash"></i> Deleted
                                    </span>
                                    break;
                            }
                        </td>
                        <td data-label="Users" class="d-none d-lg-table-cell">
                            <span class="badge text-bg-secondary">@t.UserCount</span>
                            @if (t.MaxUsers > 0)
                            {
                                <small class="text-muted">/ @t.MaxUsers</small>
                            }
                        </td>
                        <td data-label="Clients" class="d-none d-lg-table-cell">
                            <span class="badge text-bg-secondary">@t.ClientCount</span>
                            @if (t.MaxClients > 0)
                            {
                                <small class="text-muted">/ @t.MaxClients</small>
                            }
                        </td>
                        <td data-label="Created" class="d-none d-lg-table-cell">
                            <small class="text-muted">@t.CreatedAt.ToString("yyyy-MM-dd")</small>
                        </td>
                        <td data-label="Actions" class="text-end">
                            <form method="post" asp-page="/PlatformAdmin/Impersonation" asp-page-handler="StartImpersonation" id="impersonate-form-@t.Id" style="display:none;">
                                <input type="hidden" name="tenantId" value="@t.Id" />
                            </form>
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-outline-secondary" title="View as Tenant Admin" onclick="document.getElementById('impersonate-form-@t.Id').submit()">Impersonate</button>
                                <a class="btn btn-outline-secondary" asp-page="Edit" asp-route-id="@t.Id" title="Edit">Edit</a>
                                <a class="btn btn-outline-secondary" asp-page="Export" asp-route-id="@t.Id" title="Export Configuration">Export</a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="mt-4">
    <div class="card">
        <div class="card-header">
            <i class="bi bi-info-circle me-2"></i>Multi-Tenancy Information
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h6>Current Mode</h6>
                    <p class="mb-2">
                        <span class="badge text-bg-primary">@Model.CurrentMode</span>
                    </p>
                    <small class="text-muted">
                        @if (Model.CurrentMode == "MultiTenant")
                        {
                            <text>Tenants are accessed via <code>/t/{slug}/*</code> URLs</text>
                        }
                        else
                        {
                            <text>Single tenant mode active</text>
                        }
                    </small>
                </div>
                <div class="col-md-6">
                    <h6>Default Tenant</h6>
                    <p class="mb-2">
                        @if (!string.IsNullOrEmpty(Model.DefaultTenantSlug))
                        {
                            <code>@Model.DefaultTenantSlug</code>
                        }
                        else
                        {
                            <span class="text-muted">None configured</span>
                        }
                    </p>
                    <small class="text-muted">Fallback tenant for non-prefixed routes</small>
                </div>
            </div>
        </div>
    </div>
</div>
