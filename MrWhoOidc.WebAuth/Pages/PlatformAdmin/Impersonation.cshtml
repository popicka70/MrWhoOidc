@page "/platform-admin/impersonation"
@model MrWhoOidc.WebAuth.Pages.PlatformAdmin.ImpersonationModel
@{
    ViewData["Title"] = "Tenant Impersonation";
}

<div class="content-container mt-4">
    <div class="page-header">
        <div class="page-header__content">
            <h1 class="page-header__title">
                <i class="ph ph-mask-happy icon-md icon-primary"></i>
                Tenant Impersonation
            </h1>
            <p class="page-header__subtitle">View and manage the system as a tenant administrator</p>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Current Impersonation Status -->
            @if (Model.CurrentImpersonation != null)
            {
                <div class="card border-danger mb-4">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0">
                            <i class="ph ph-warning-fill me-2"></i>
                            Currently Impersonating
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h4 class="mb-2">@Model.CurrentImpersonation.TenantName</h4>
                                <div class="d-flex flex-wrap gap-3 mb-2">
                                    <div>
                                        <strong>Tenant ID:</strong>
                                        <code class="ms-1">@Model.CurrentImpersonation.TenantId</code>
                                    </div>
                                    <div>
                                        <strong>Slug:</strong>
                                        <code class="ms-1">@Model.CurrentImpersonation.TenantSlug</code>
                                    </div>
                                    <div>
                                        <strong>Duration:</strong>
                                        <span class="ms-1">@Model.CurrentImpersonation.Duration</span>
                                    </div>
                                </div>
                                <div class="alert alert-warning mb-0">
                                    <i class="ph ph-shield me-2"></i>
                                    <strong>Read-Only Mode:</strong> All write operations are disabled while impersonating.
                                </div>
                            </div>
                            <div class="col-md-4 text-end">
                                <form method="post" asp-page="/StopImpersonation" class="d-inline">
                                    <button type="submit" class="btn btn-danger btn-lg">
                                        <i class="ph ph-x-circle me-2"></i>Exit Impersonation
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Tenant Selection Card -->
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="ph ph-buildings me-2"></i>Select Tenant to Impersonate
                    </h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="ph ph-info me-2"></i>
                        <strong>What is impersonation?</strong>
                        Impersonation allows you to view the system as a tenant administrator would see it,
                        with <strong>read-only access</strong>. This is useful for:
                        <ul class="mb-0 mt-2">
                            <li>Troubleshooting tenant-specific issues</li>
                            <li>Verifying configurations and permissions</li>
                            <li>Understanding the tenant admin experience</li>
                        </ul>
                    </div>

                    @if (!Model.Tenants.Any())
                    {
                        <div class="alert alert-warning">
                            <i class="ph ph-warning me-2"></i>
                            No tenants found. Create a tenant first.
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            @foreach (var tenant in Model.Tenants)
                            {
                                <div class="col-md-6 col-lg-4 mb-3">
                                    <div class="card h-100 @(tenant.IsActive ? "" : "border-secondary")">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <h5 class="card-title mb-0">@tenant.Name</h5>
                                                @if (!tenant.IsActive)
                                                {
                                                    <span class="badge bg-secondary">Inactive</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                            </div>
                                            
                                            <p class="card-text">
                                                <small class="text-muted">
                                                    <strong>Slug:</strong> <code>@tenant.Slug</code>
                                                </small>
                                            </p>

                                            <div class="d-flex justify-content-between align-items-center text-muted small mb-3">
                                                <span>
                                                    <i class="ph ph-users me-1"></i>@tenant.UserCount users
                                                </span>
                                                <span>
                                                    <i class="ph ph-box me-1"></i>@tenant.ClientCount clients
                                                </span>
                                            </div>

                                            @if (Model.CurrentImpersonation?.TenantId == tenant.Id)
                                            {
                                                <button class="btn btn-danger btn-sm w-100" disabled>
                                                    <i class="ph ph-check-circle me-1"></i>Currently Impersonating
                                                </button>
                                            }
                                            else if (tenant.IsActive)
                                            {
                                                <form method="post" asp-page-handler="StartImpersonation">
                                                    <input type="hidden" name="tenantId" value="@tenant.Id" />
                                                    <button type="submit" class="btn btn-primary btn-sm w-100">
                                                        <i class="ph ph-mask-happy me-1"></i>Start Impersonation
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <button class="btn btn-secondary btn-sm w-100" disabled>
                                                    <i class="ph ph-lock me-1"></i>Tenant Inactive
                                                </button>
                                            }
                                        </div>
                                        <div class="card-footer text-muted small">
                                            Created: @tenant.CreatedAt.ToString("yyyy-MM-dd")
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Quick Tips -->
            <div class="card mt-4 border-info">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0">
                        <i class="ph ph-lightbulb me-2"></i>Quick Tips
                    </h6>
                </div>
                <div class="card-body">
                    <ul class="mb-0">
                        <li>
                            <strong>Read-Only Mode:</strong> While impersonating, you can view all tenant data but cannot create, edit, or delete anything.
                        </li>
                        <li>
                            <strong>Navigation:</strong> Once impersonating, use the regular Admin menu to navigate tenant-specific pages.
                        </li>
                        <li>
                            <strong>Exit Anytime:</strong> Click the "Exit Read-Only Mode" button in the red banner at the top to stop impersonating.
                        </li>
                        <li>
                            <strong>Audit Trail:</strong> All impersonation sessions are logged for security and compliance.
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-dismiss alerts after 5 seconds
        setTimeout(function() {
            var alerts = document.querySelectorAll('.alert-dismissible');
            alerts.forEach(function(alert) {
                var bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>
}
