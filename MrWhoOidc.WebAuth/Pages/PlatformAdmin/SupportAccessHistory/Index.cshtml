@page "/platform-admin/support-access/history"
@model MrWhoOidc.WebAuth.Pages.PlatformAdmin.SupportAccessHistory.IndexModel
@{
    ViewData["Title"] = "Support Access History";
}

<div class="page-header">
    <div class="page-header__content">
        <h1 class="page-header__title"><i class="ph ph-clock-counter-clockwise icon-md icon-primary"></i> Support Access History</h1>
        <p class="page-header__subtitle">Audit history of platform administrator support access sessions.</p>
    </div>
    @if (Model.Sessions.Any())
    {
        <form method="post" asp-page-handler="ExportCsv">
            <input type="hidden" name="startDate" value="@Model.Filter.StartDate?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="endDate" value="@Model.Filter.EndDate?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="adminUsername" value="@Model.Filter.AdminUsername" />
            <input type="hidden" name="tenantSlug" value="@Model.Filter.TenantSlug" />
            <button type="submit" class="btn btn-outline-primary"><i class="ph ph-download me-1"></i>Export CSV</button>
        </form>
    }
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3"><label for="startDate" class="form-label">Start Date</label><input type="date" class="form-control" id="startDate" name="startDate" value="@Model.Filter.StartDate?.ToString("yyyy-MM-dd")" /></div>
            <div class="col-md-3"><label for="endDate" class="form-label">End Date</label><input type="date" class="form-control" id="endDate" name="endDate" value="@Model.Filter.EndDate?.ToString("yyyy-MM-dd")" /></div>
            <div class="col-md-3"><label for="adminUsername" class="form-label">Admin Username</label><input type="text" class="form-control" id="adminUsername" name="adminUsername" value="@Model.Filter.AdminUsername" /></div>
            <div class="col-md-3"><label for="tenantSlug" class="form-label">Tenant Slug</label><input type="text" class="form-control" id="tenantSlug" name="tenantSlug" value="@Model.Filter.TenantSlug" /></div>
            <div class="col-12"><button type="submit" class="btn btn-primary">Apply Filters</button> <a asp-page="Index" class="btn btn-outline-secondary">Clear</a></div>
        </form>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card"><div class="card-body"><div class="text-muted">Total Sessions</div><div class="h3 mb-0">@Model.TotalSessions</div></div></div></div>
    <div class="col-md-4"><div class="card"><div class="card-body"><div class="text-muted">Active Now</div><div class="h3 mb-0">@Model.ActiveSessions</div></div></div></div>
    <div class="col-md-4"><div class="card"><div class="card-body"><div class="text-muted">Showing</div><div class="h3 mb-0">@Model.Sessions.Count</div></div></div></div>
</div>

@if (!Model.Sessions.Any())
{
    <div class="alert alert-info">No support access sessions match the selected filters.</div>
}
else
{
    <div class="table-responsive">
        <table class="data-table">
            <thead><tr><th>Actor</th><th>Tenant</th><th>Reason</th><th>Started</th><th>Expires</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var session in Model.Sessions)
                {
                    <tr>
                        <td><strong>@session.AdminName</strong><br /><small class="text-muted">@session.PlatformAdminUserAccountId</small></td>
                        <td><strong>@session.TenantName</strong><br /><code>@session.TenantSlug</code></td>
                        <td>
                            @session.Reason
                            @if (session.TicketReference != null)
                            {
                                <small class="text-muted">(@session.TicketReference)</small>
                            }
                        </td>
                        <td>@session.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@session.ExpiresAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td><span class="badge bg-secondary">@session.Status</span></td>
                        <td>
                            @if (session.Status == MrWhoOidc.Auth.Persistence.SupportAccessStatus.Active)
                            {
                                <form method="post" asp-page-handler="Revoke" class="d-flex gap-2 align-items-center">
                                    <input type="hidden" name="sessionId" value="@session.SessionId" />
                                    <input type="hidden" name="page" value="@Model.CurrentPage" />
                                    <input type="hidden" name="startDate" value="@Model.Filter.StartDate?.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" name="endDate" value="@Model.Filter.EndDate?.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" name="adminUsername" value="@Model.Filter.AdminUsername" />
                                    <input type="hidden" name="tenantSlug" value="@Model.Filter.TenantSlug" />
                                    <input type="text" name="reason" value="Security response" maxlength="500" required class="form-control form-control-sm" aria-label="Revocation reason" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Revoke</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Support access history pages" class="mt-3">
            <ul class="pagination justify-content-center">
                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                {
                    <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : null)">
                        <a class="page-link" asp-page="Index" asp-route-page="@pageNumber" asp-route-startDate="@Model.Filter.StartDate?.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.Filter.EndDate?.ToString("yyyy-MM-dd")" asp-route-adminUsername="@Model.Filter.AdminUsername" asp-route-tenantSlug="@Model.Filter.TenantSlug">@pageNumber</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
