@page "/LoginTotp"
@model MrWhoOidc.WebAuth.Pages.LoginTotpModel
@{
    ViewData["Title"] = "Two-factor verification";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="card-body p-4">
        <div class="auth-card__header">
            <i class="bi bi-shield-lock icon-xl icon-primary"></i>
            <h2 class="auth-card__title">Two-factor verification</h2>
            <p class="auth-card__subtitle">Enter your authentication code</p>
        </div>

        <form method="post" asp-antiforgery="true">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="form-group">
                <label asp-for="Code" class="form-label">
                    <i class="bi bi-key icon-sm"></i> Authentication Code
                </label>
                <input asp-for="Code" class="form-control" autocomplete="one-time-code" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-check-lg"></i> Verify
            </button>
        </form>
    </div>
</div>
