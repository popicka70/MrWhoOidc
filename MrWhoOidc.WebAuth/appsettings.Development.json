{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Antiforgery": "Debug",
      "Microsoft.AspNetCore.Mvc.RazorPages": "Debug",
      "Microsoft.AspNetCore.Server.Kestrel": "Debug",
      "Microsoft.AspNetCore.Server.Kestrel.BadRequests": "Debug",
      "MrWhoOidc.WebAuth.Services.TenantSwitchingService": "Debug",
      "MrWhoOidc.WebAuth.Pages.SwitchTenantModel": "Debug",
      "MrWhoOidc.WebAuth.Middleware.TenantResolutionMiddleware": "Debug",
      "MrWhoOidc.Auth.MultiTenancy.ModeAwareTenantResolver": "Debug"
    }
  },
  "MultiTenancy": {
    "Enabled": true,
    "DefaultTenantSlug": "default"
  },
  "Oidc": {
    "Issuer": "https://localhost:7208",
    "AllowedCorsOrigins": [
      "http://localhost:5173",
      "http://localhost:3000",
      "http://localhost:5174"
    ]
  },
  "Auth": {
    "AllowRefreshTokenIntrospection": true,
    "DefaultClaimMappings": [
      { "ExternalClaim": "sub", "LocalClaim": "sub", "Order": 0 },
      { "ExternalClaim": "email", "LocalClaim": "email", "Order": 1 },
      { "ExternalClaim": "name", "LocalClaim": "name", "Order": 2 }
    ],
    "ExposeClientJwks": true,
    "ExposeProviderJwks": true,
    "ExposeAggregatedProviderJwks": true,
    "ClientJwksCacheSeconds": 120,
    "ProviderJwksCacheSeconds": 120,
    "ProviderJwksIncludeEncryption": false,
    "EnableTokenExchange": true
  },
  "Licensing": {
    "CacheExpirationMinutes": 5,
    "GracePeriodDays": 7,
    "StrictValidation": false,
    "DefaultTier": "community"
  },
  "Features": {
    "UserAccount": {
      "UserAccountDecouplingEnabled": true,
      "TenantPickerUxEnabled": false
    }
  }
}
