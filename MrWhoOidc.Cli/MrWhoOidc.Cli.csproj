<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    
    <!-- Global Tool Configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mrwho-cli</ToolCommandName>
    <PackageId>MrWhoOidc.Cli</PackageId>
    <Version>1.0.2</Version>
    <Authors>MrWhoOidc Project</Authors>
    <Description>CLI tool for managing MrWhoOidc OIDC server with MCP (Model Context Protocol) support for LLM integration</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/MrWhoProjects/MrWhoOidc</RepositoryUrl>
    <PackageTags>oidc;cli;mcp;admin;openid-connect;identity</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MrWhoOidc.Auth\MrWhoOidc.Auth.csproj" />
  </ItemGroup>

</Project>
