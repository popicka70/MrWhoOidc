<Project>

  <!--
    Neutralize upstream's packaging/signing configuration for vendored builds.
    Upstream delay-signs assemblies with a public key for the author's SignPath
    pipeline; delay-signed assemblies fail strong-name validation outside that
    pipeline, so signing must be off here. Packing/symbol-package/doc generation are
    irrelevant for a ProjectReference consumer.
  -->
  <PropertyGroup>
    <SignAssembly>false</SignAssembly>
    <DelaySign>false</DelaySign>
    <AssemblyOriginatorKeyFile />
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>false</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- The vendored csproj 'None' pack items point at repository-root files that are
       not vendored (isopoh.png). Not packing makes them irrelevant, but keep the
       build from emitting them into outputs. -->
  <ItemGroup>
    <None Remove="..\..\images\isopoh.png" />
  </ItemGroup>

  <!--
    Upstream's build-time analyzers (Sonar ~100 MB, StyleCop, ConfigureAwaitChecker,
    SourceLink) are PrivateAssets for a frozen vendored snapshot: they add minutes to
    every clean Docker/CI build and are not needed to compile. Runtime dependencies
    (System.Memory, System.Text.RegularExpressions for netstandard2.0) are kept.
  -->
  <ItemGroup>
    <PackageReference Remove="ConfigureAwaitChecker.Analyzer" />
    <PackageReference Remove="Microsoft.SourceLink.GitHub" />
    <PackageReference Remove="SonarAnalyzer.CSharp" />
    <PackageReference Remove="StyleCop.Analyzers" />
    <PackageReference Remove="StyleCop.Analyzers.Unstable" />
  </ItemGroup>

</Project>
