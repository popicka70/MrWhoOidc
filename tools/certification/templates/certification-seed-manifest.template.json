{
  "version": 1,
  "platformSettings": {
    "dynamicClientRegistrationEnabled": true
  },
  "platformInitialAccessTokens": [
    {
      "token": "__DCR_INITIAL_ACCESS_TOKEN__",
      "description": "OIDF certification dynamic registration"
    }
  ],
  "tenants": [
    {
      "slug": "default",
      "name": "Default Tenant",
      "dynamicClientRegistrationRealm": "default",
      "users": [
        {
          "username": "oidf-cert-user",
          "email": "oidf-cert-user@mrwho.local",
          "password": "__CERT_USER_PASSWORD__",
          "emailVerified": true,
          "clients": [
            {
              "clientId": "oidf-basic-primary",
              "realm": "admin"
            },
            {
              "clientId": "oidf-basic-secondary",
              "realm": "admin"
            },
            {
              "clientId": "oidf-basic-client-secret-post",
              "realm": "admin"
            }
          ]
        }
      ],
      "clients": [
        {
          "clientId": "oidf-basic-primary",
          "clientName": "OIDF Basic Primary",
          "realm": "admin",
          "requirePkce": false,
          "requireConsent": false,
          "allowLocalLogin": true,
          "allowExternalIdp": false,
          "clientSecret": "__OIDF_BASIC_PRIMARY_SECRET__",
          "allowedLoginRedirectUris": [
            "https://__SUITE_HOST__/test/a/__ALIAS__/callback"
          ],
          "allowedLogoutRedirectUris": [
            "https://__SUITE_HOST__/test/a/__ALIAS__/post_logout_redirect"
          ],
          "frontChannelLogoutUri": "https://__SUITE_HOST__/test/a/__ALIAS__/frontchannel_logout",
          "frontChannelLogoutSessionRequired": true,
          "backChannelLogoutUri": "https://__SUITE_HOST__/test/a/__ALIAS__/backchannel_logout",
          "backChannelLogoutSessionRequired": true,
          "allowedScopes": [
            "openid",
            "profile",
            "email"
          ]
        },
        {
          "clientId": "oidf-basic-secondary",
          "clientName": "OIDF Basic Secondary",
          "realm": "admin",
          "requirePkce": false,
          "requireConsent": false,
          "allowLocalLogin": true,
          "allowExternalIdp": false,
          "clientSecret": "__OIDF_BASIC_SECONDARY_SECRET__",
          "allowedLoginRedirectUris": [
            "https://__SUITE_HOST__/test/a/__ALIAS__/callback"
          ],
          "allowedLogoutRedirectUris": [
            "https://__SUITE_HOST__/test/a/__ALIAS__/post_logout_redirect"
          ],
          "frontChannelLogoutUri": "https://__SUITE_HOST__/test/a/__ALIAS__/frontchannel_logout",
          "frontChannelLogoutSessionRequired": true,
          "backChannelLogoutUri": "https://__SUITE_HOST__/test/a/__ALIAS__/backchannel_logout",
          "backChannelLogoutSessionRequired": true,
          "allowedScopes": [
            "openid",
            "profile",
            "email"
          ]
        },
        {
          "clientId": "oidf-basic-client-secret-post",
          "clientName": "OIDF Basic Client Secret Post",
          "realm": "admin",
          "requirePkce": false,
          "requireConsent": false,
          "allowLocalLogin": true,
          "allowExternalIdp": false,
          "clientSecret": "__OIDF_BASIC_SECRET_POST_SECRET__",
          "allowedLoginRedirectUris": [
            "https://__SUITE_HOST__/test/a/__ALIAS__/callback"
          ],
          "allowedLogoutRedirectUris": [
            "https://__SUITE_HOST__/test/a/__ALIAS__/post_logout_redirect"
          ],
          "frontChannelLogoutUri": "https://__SUITE_HOST__/test/a/__ALIAS__/frontchannel_logout",
          "frontChannelLogoutSessionRequired": true,
          "backChannelLogoutUri": "https://__SUITE_HOST__/test/a/__ALIAS__/backchannel_logout",
          "backChannelLogoutSessionRequired": true,
          "allowedScopes": [
            "openid",
            "profile",
            "email"
          ]
        }
      ]
    }
  ]
}