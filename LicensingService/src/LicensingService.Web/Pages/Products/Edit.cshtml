@page "{id:guid}"
@model LicensingService.Web.Pages.Products.EditModel
@{
    ViewData["Title"] = "Edit Product";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-pencil me-2"></i>Edit Product</h1>
    <a asp-page="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>Back to List
    </a>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-info-circle me-2"></i>Product Information
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="UpdateProduct">
                    <input type="hidden" asp-for="Product.Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Product.Identifier" class="form-label">Identifier</label>
                        <input asp-for="Product.Identifier" class="form-control" readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Product.DisplayName" class="form-label">Display Name</label>
                        <input asp-for="Product.DisplayName" class="form-control" />
                        <span asp-validation-for="Product.DisplayName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Product.Description" class="form-label">Description</label>
                        <textarea asp-for="Product.Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Product.Status" class="form-label">Status</label>
                        <select asp-for="Product.Status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-2"></i>Save Changes
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-sliders me-2"></i>Option Definitions</span>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addOptionModal">
                    <i class="bi bi-plus-circle me-2"></i>Add Option
                </button>
            </div>
            <div class="card-body p-0">
                @if (!Model.Options.Any())
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-sliders fs-1 d-block mb-2"></i>
                        No option definitions yet.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Key</th>
                                    <th>Name</th>
                                    <th>Type</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var opt in Model.Options)
                                {
                                    <tr>
                                        <td><code>@opt.OptionKey</code></td>
                                        <td>@opt.DisplayName</td>
                                        <td>
                                            <span class="badge bg-secondary">@opt.DataType</span>
                                        </td>
                                        <td class="text-end">
                                            <form method="post" asp-page-handler="DeleteOption" class="d-inline">
                                                <input type="hidden" name="optionId" value="@opt.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" 
                                                        onclick="return confirm('Delete this option?')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Add Option Modal -->
<div class="modal fade" id="addOptionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AddOption">
                <div class="modal-header">
                    <h5 class="modal-title">Add Option Definition</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Option Key</label>
                        <input type="text" name="optionKey" class="form-control" 
                               placeholder="e.g., max_users" required pattern="^[a-z0-9_]+$" />
                        <div class="form-text">Lowercase with underscores only</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Display Name</label>
                        <input type="text" name="displayName" class="form-control" 
                               placeholder="e.g., Maximum Users" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Data Type</label>
                        <select name="dataType" class="form-select" required>
                            <option value="String">String</option>
                            <option value="Number">Number</option>
                            <option value="Boolean">Boolean</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Default Value</label>
                        <input type="text" name="defaultValue" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="description" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Option</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
