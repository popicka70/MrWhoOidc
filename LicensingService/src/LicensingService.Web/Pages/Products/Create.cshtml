@page
@model LicensingService.Web.Pages.Products.CreateModel
@{
    ViewData["Title"] = "Create Product";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-box-seam me-2"></i>Create Product</h1>
    <a asp-page="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>Back to List
    </a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Product.Identifier" class="form-label">Identifier</label>
                        <input asp-for="Product.Identifier" class="form-control" placeholder="e.g., mrwho-oidc" />
                        <span asp-validation-for="Product.Identifier" class="text-danger"></span>
                        <div class="form-text">Unique identifier (lowercase, alphanumeric with hyphens)</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Product.DisplayName" class="form-label">Display Name</label>
                        <input asp-for="Product.DisplayName" class="form-control" placeholder="e.g., MrWho OIDC Server" />
                        <span asp-validation-for="Product.DisplayName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Product.Description" class="form-label">Description</label>
                        <textarea asp-for="Product.Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Product.Status" class="form-label">Status</label>
                        <select asp-for="Product.Status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-2"></i>Create Product
                        </button>
                        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-info-circle me-2"></i>Tip
            </div>
            <div class="card-body">
                <p class="mb-0">After creating the product, you can add option definitions on the Edit page.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
