@page
@model LicensingService.Web.Pages.Customers.IndexModel
@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-people me-2"></i>Customers</h1>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>Add Customer
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" name="search" value="@Model.Search" 
                           placeholder="Search by name, identifier, or email..." />
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select" name="status">
                    <option value="">All Statuses</option>
                    <option value="Active" selected="@(Model.StatusFilter == "Active")">Active</option>
                    <option value="Inactive" selected="@(Model.StatusFilter == "Inactive")">Inactive</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="bi bi-funnel me-2"></i>Filter
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Identifier</th>
                    <th>Display Name</th>
                    <th>Contact Email</th>
                    <th>Status</th>
                    <th>Licenses</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Customers.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            No customers found.
                        </td>
                    </tr>
                }
                @foreach (var customer in Model.Customers)
                {
                    <tr>
                        <td><code>@customer.Identifier</code></td>
                        <td>@customer.DisplayName</td>
                        <td>@customer.ContactEmail</td>
                        <td>
                            <span class="badge @(customer.Status == "Active" ? "bg-success" : "bg-secondary")">
                                @customer.Status
                            </span>
                        </td>
                        <td>
                            <a asp-page="/Licenses/Index" asp-route-customerId="@customer.Id">
                                @(Model.LicenseCounts.GetValueOrDefault(customer.Id, 0)) licenses
                            </a>
                        </td>
                        <td>@customer.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td class="text-end">
                            <a asp-page="Details" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-page="Edit" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
