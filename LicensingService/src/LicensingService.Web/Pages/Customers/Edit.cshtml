@page "{id:guid}"
@model LicensingService.Web.Pages.Customers.EditModel
@{
    ViewData["Title"] = "Edit Customer";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-pencil me-2"></i>Edit Customer</h1>
    <a asp-page="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>Back to List
    </a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="Customer.Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Customer.Identifier" class="form-label">Identifier</label>
                        <input asp-for="Customer.Identifier" class="form-control" readonly />
                        <div class="form-text">Identifier cannot be changed after creation</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Customer.DisplayName" class="form-label">Display Name</label>
                        <input asp-for="Customer.DisplayName" class="form-control" />
                        <span asp-validation-for="Customer.DisplayName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Customer.ContactEmail" class="form-label">Contact Email</label>
                        <input asp-for="Customer.ContactEmail" type="email" class="form-control" />
                        <span asp-validation-for="Customer.ContactEmail" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Customer.Status" class="form-label">Status</label>
                        <select asp-for="Customer.Status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-2"></i>Save Changes
                        </button>
                        <a asp-page="Details" asp-route-id="@Model.Customer.Id" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
