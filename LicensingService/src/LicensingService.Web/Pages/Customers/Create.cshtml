@page
@model LicensingService.Web.Pages.Customers.CreateModel
@{
    ViewData["Title"] = "Create Customer";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-person-plus me-2"></i>Create Customer</h1>
    <a asp-page="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>Back to List
    </a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Customer.Identifier" class="form-label">Identifier</label>
                        <input asp-for="Customer.Identifier" class="form-control" placeholder="e.g., acme-corp" />
                        <span asp-validation-for="Customer.Identifier" class="text-danger"></span>
                        <div class="form-text">Unique identifier (lowercase, alphanumeric with hyphens)</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Customer.DisplayName" class="form-label">Display Name</label>
                        <input asp-for="Customer.DisplayName" class="form-control" placeholder="e.g., Acme Corporation" />
                        <span asp-validation-for="Customer.DisplayName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Customer.ContactEmail" class="form-label">Contact Email</label>
                        <input asp-for="Customer.ContactEmail" type="email" class="form-control" placeholder="e.g., licensing@acme.com" />
                        <span asp-validation-for="Customer.ContactEmail" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Customer.Status" class="form-label">Status</label>
                        <select asp-for="Customer.Status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Customer.Notes" class="form-label">Notes</label>
                        <textarea asp-for="Customer.Notes" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-2"></i>Create Customer
                        </button>
                        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
