@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-speedometer2 me-2"></i>Dashboard</h1>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-primary h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-subtitle text-muted mb-2">Total Customers</h6>
                        <h2 class="card-title mb-0">@Model.CustomerCount</h2>
                    </div>
                    <i class="bi bi-people fs-1 text-primary"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-page="/Customers/Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-success h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-subtitle text-muted mb-2">Total Products</h6>
                        <h2 class="card-title mb-0">@Model.ProductCount</h2>
                    </div>
                    <i class="bi bi-box-seam fs-1 text-success"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-page="/Products/Index" class="btn btn-sm btn-outline-success">View All</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-info h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-subtitle text-muted mb-2">Active Licenses</h6>
                        <h2 class="card-title mb-0">@Model.ActiveLicenseCount</h2>
                    </div>
                    <i class="bi bi-key fs-1 text-info"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-page="/Licenses/Index" class="btn btn-sm btn-outline-info">View All</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-clock-history me-2"></i>Expiring Soon (30 days)
            </div>
            <div class="card-body">
                @if (Model.ExpiringLicenses.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Customer</th>
                                    <th>Product</th>
                                    <th>Expires</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var license in Model.ExpiringLicenses.Take(5))
                                {
                                    <tr>
                                        <td>@license.Customer?.DisplayName</td>
                                        <td>@license.Product?.DisplayName</td>
                                        <td>
                                            <span class="text-warning">
                                                @license.ValidUntil.ToString("MMM dd, yyyy")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No licenses expiring in the next 30 days.</p>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-lightning me-2"></i>Quick Actions
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-page="/Customers/Create" class="btn btn-outline-primary">
                        <i class="bi bi-plus-circle me-2"></i>Add New Customer
                    </a>
                    <a asp-page="/Products/Create" class="btn btn-outline-success">
                        <i class="bi bi-plus-circle me-2"></i>Add New Product
                    </a>
                    <a asp-page="/Licenses/Issue" class="btn btn-outline-info">
                        <i class="bi bi-key me-2"></i>Issue New License
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
