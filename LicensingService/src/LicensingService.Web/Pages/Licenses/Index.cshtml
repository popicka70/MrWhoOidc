@page
@model LicensingService.Web.Pages.Licenses.IndexModel
@{
    ViewData["Title"] = "Licenses";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-key me-2"></i>Licenses</h1>
    <a asp-page="Issue" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>Issue License
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Customer</label>
                <select class="form-select" name="customerId">
                    <option value="">All Customers</option>
                    @foreach (var customer in Model.Customers)
                    {
                        <option value="@customer.Id" selected="@(Model.CustomerId == customer.Id)">
                            @customer.DisplayName
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Product</label>
                <select class="form-select" name="productId">
                    <option value="">All Products</option>
                    @foreach (var product in Model.Products)
                    {
                        <option value="@product.Id" selected="@(Model.ProductId == product.Id)">
                            @product.DisplayName
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Status</label>
                <select class="form-select" name="status">
                    <option value="">All Statuses</option>
                    <option value="Active" selected="@(Model.Status == "Active")">Active</option>
                    <option value="Expired" selected="@(Model.Status == "Expired")">Expired</option>
                    <option value="Revoked" selected="@(Model.Status == "Revoked")">Revoked</option>
                    <option value="Renewed" selected="@(Model.Status == "Renewed")">Renewed</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Tier</label>
                <input type="text" class="form-control" name="tier" value="@Model.Tier" placeholder="e.g., Professional" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="bi bi-funnel me-2"></i>Filter
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Customer</th>
                    <th>Product</th>
                    <th>Tier</th>
                    <th>Status</th>
                    <th>Valid From</th>
                    <th>Valid Until</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Licenses.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            No licenses found.
                        </td>
                    </tr>
                }
                @foreach (var license in Model.Licenses)
                {
                    <tr>
                        <td>
                            <a asp-page="/Customers/Details" asp-route-id="@license.CustomerId">
                                @license.Customer?.DisplayName
                            </a>
                        </td>
                        <td>@license.Product?.DisplayName</td>
                        <td>
                            <span class="badge bg-primary">@license.Tier</span>
                        </td>
                        <td>
                            @{
                                var statusClass = license.Status switch
                                {
                                    LicensingService.Core.Entities.LicenseStatus.Active => "bg-success",
                                    LicensingService.Core.Entities.LicenseStatus.Revoked => "bg-danger",
                                    LicensingService.Core.Entities.LicenseStatus.Expired => "bg-warning",
                                    LicensingService.Core.Entities.LicenseStatus.Renewed => "bg-info",
                                    LicensingService.Core.Entities.LicenseStatus.Upgraded => "bg-info",
                                    LicensingService.Core.Entities.LicenseStatus.Downgraded => "bg-info",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @statusClass">@license.Status</span>
                        </td>
                        <td>@license.ValidFrom.ToString("MMM dd, yyyy")</td>
                        <td>
                            @if (license.ValidUntil < DateTimeOffset.UtcNow.AddDays(30) && license.Status == LicensingService.Core.Entities.LicenseStatus.Active)
                            {
                                <span class="text-warning">
                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                    @license.ValidUntil.ToString("MMM dd, yyyy")
                                </span>
                            }
                            else
                            {
                                @license.ValidUntil.ToString("MMM dd, yyyy")
                            }
                        </td>
                        <td class="text-end">
                            <a asp-page="Details" asp-route-id="@license.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalCount > Model.Licenses.Count)
    {
        <div class="card-footer text-muted">
            Showing @Model.Licenses.Count of @Model.TotalCount licenses
        </div>
    }
</div>
