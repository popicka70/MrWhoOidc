@page
@model LicensingService.Web.Pages.Licenses.IssueModel
@{
    ViewData["Title"] = "Issue License";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-key me-2"></i>Issue New License</h1>
    <a asp-page="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>Back to List
    </a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="License.CustomerId" class="form-label">Customer</label>
                        <select asp-for="License.CustomerId" class="form-select" required>
                            <option value="">Select a customer...</option>
                            @foreach (var customer in Model.Customers)
                            {
                                <option value="@customer.Id">@customer.DisplayName (@customer.Identifier)</option>
                            }
                        </select>
                        <span asp-validation-for="License.CustomerId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="License.ProductId" class="form-label">Product</label>
                        <select asp-for="License.ProductId" class="form-select" required>
                            <option value="">Select a product...</option>
                            @foreach (var product in Model.Products)
                            {
                                <option value="@product.Id">@product.DisplayName (@product.Identifier)</option>
                            }
                        </select>
                        <span asp-validation-for="License.ProductId" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="License.Tier" class="form-label">Tier</label>
                            <select asp-for="License.Tier" class="form-select">
                                <option value="Community">Community</option>
                                <option value="Professional" selected>Professional</option>
                                <option value="Enterprise">Enterprise</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="License.Scope" class="form-label">Scope</label>
                            <select asp-for="License.Scope" class="form-select">
                                <option value="site" selected>Site</option>
                                <option value="tenant">Tenant</option>
                                <option value="global">Global</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="License.ValidFrom" class="form-label">Valid From</label>
                            <input asp-for="License.ValidFrom" type="date" class="form-control" />
                            <div class="form-text">Defaults to today if not specified</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="License.ValidUntil" class="form-label">Valid Until</label>
                            <input asp-for="License.ValidUntil" type="date" class="form-control" required />
                            <span asp-validation-for="License.ValidUntil" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Options (JSON)</label>
                        <textarea asp-for="License.OptionsJson" class="form-control font-monospace" rows="3" 
                                  placeholder='{"max_users": 10, "feature_x": true}'></textarea>
                        <div class="form-text">Optional product-specific options in JSON format</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-key me-2"></i>Issue License
                        </button>
                        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-info-circle me-2"></i>License Tiers
            </div>
            <div class="card-body">
                <dl class="mb-0">
                    <dt>Community</dt>
                    <dd class="text-muted">Basic features, ideal for evaluation</dd>
                    <dt>Professional</dt>
                    <dd class="text-muted">Full features for production use</dd>
                    <dt>Enterprise</dt>
                    <dd class="text-muted">Advanced features with premium support</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
