# ==============================================================================
# MrWhoOidc Docker Deployment Configuration
# ==============================================================================
# 
# This file contains environment variables for deploying MrWhoOidc via Docker Compose.
# Copy this file to `.env` and customize the values for your environment.
#
# SECURITY WARNING: Never commit the `.env` file to version control!
#
# ==============================================================================

# ------------------------------------------------------------------------------
# Required Configuration
# ------------------------------------------------------------------------------

# PostgreSQL Database Password
# SECURITY: Use a strong, randomly generated password (32+ characters recommended)
# Example: openssl rand -base64 32
POSTGRES_PASSWORD=changeme_use_strong_password_here

# OIDC Public Base URL
# The public URL where your OIDC server will be accessible
# IMPORTANT: Must match the actual URL clients will use (affects token issuer)
# Examples:
#   - Development: https://localhost:8443
#   - Production: https://auth.example.com
OIDC_PUBLIC_BASE_URL=https://localhost:8443

# TLS Certificate Password
# Password for the PFX certificate file mounted in ./certs/
# For development, generate a local dev cert and use its password:
#   dotnet dev-certs https -ep ./certs/aspnetapp.pfx -p "changeit"
#   (the ./certs/ directory is gitignored; dev certs are NOT shipped with the repo)
# For production, use the password from your certificate provider
CERT_PASSWORD=changeit

# Bootstrap Token
# One-time token used to initialize a fresh production deployment via POST /bootstrap.
# Leave empty after bootstrap completes.
# Local development with docker-compose.dev.yml does not require this value because the dev stack auto-seeds the default tenant.
BOOTSTRAP_TOKEN=

# Auto-seed Admin Password (dev stacks only)
# Only effective when Testing__EnableAutoSeed=true (docker-compose.dev.yml defaults to enabled).
# If set, the auto-seeded admin account (admin@mrwho.local) will use this password instead
# of a randomly generated one. Must be at least 8 characters.
# Note: docker-compose.dev.yml defaults SEED_ADMIN_PASSWORD to "Admin123!" so the dev admin
# login is admin@mrwho.local / Admin123!. Override via the environment to use a different password.
#SEED_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# Optional Configuration
# ------------------------------------------------------------------------------

# ASP.NET Core Environment
# Values: Development, Staging, Production
# Default: Production
#ASPNETCORE_ENVIRONMENT=Production

# Redis Configuration (Performance Enhancement)
# Enable Redis for caching and session management
# Note: Requires uncommenting Redis service in docker-compose.yml
#REDIS_ENABLED=false
#REDIS_CONNECTION_STRING=redis:6379,abortConnect=false

# Email Configuration (SMTP)
# Enable email notifications for password resets, etc.
#MAIL_ENABLED=false
#MAIL_SMTP_HOST=smtp.example.com
#MAIL_SMTP_PORT=587
#MAIL_SMTP_USE_SSL=true
#MAIL_FROM_ADDRESS=no-reply@example.com
#MAIL_FROM_NAME=MrWhoOidc
#MAIL_SMTP_USERNAME=
#MAIL_SMTP_PASSWORD=
# Note: These are Docker Compose shell variables.
# The app receives them as Mail__Username and Mail__Password.

# Logging Configuration
# Minimum log level: Trace, Debug, Information, Warning, Error, Critical
#LOGGING_LEVEL=Information

# ------------------------------------------------------------------------------
# DataProtection Key-Ring Encryption (Production)
# ------------------------------------------------------------------------------
# The DataProtection key-ring (used for antiforgery tokens, cookies, etc.) is persisted
# in the same PostgreSQL database as the OIDC signing keys. In production the app refuses
# to start unless the key-ring is encrypted at rest with an X.509 certificate, OR you
# explicitly accept the risk of storing it unencrypted.
#
# Option A (recommended): encrypt the key-ring with an X.509 certificate.
#   Generate or obtain a PFX and mount it into the container, then set:
#DATAPROTECTION_CERTIFICATE_PATH=/https/dataprotection.pfx
#DATAPROTECTION_CERTIFICATE_PASSWORD=your_cert_password
#   On platforms that only provide text secrets, store the PFX as one-line Base64:
#DATAPROTECTION_CERTIFICATE_BASE64=base64_of_dataprotection.pfx
#
# Option B (explicit opt-in): store the key-ring unencrypted in the database.
# SECURITY: Only use this if you accept that a single DB compromise exposes both the
# wrapped signing keys and the means to unwrap them.
#DATAPROTECTION_ALLOW_UNENCRYPTED_KEY_RING=false

# ------------------------------------------------------------------------------
# Advanced Configuration
# ------------------------------------------------------------------------------

# Forwarded Headers / Reverse Proxy Hardening (Recommended when behind a proxy)
# These options control whether the app honors X-Forwarded-* headers.
# Defaults are safe-by-default (loopback-only) unless you configure KnownProxies/KnownNetworks
# or enable UnsafeTrustAll.
#
# Enable/disable forwarded headers processing
#FORWARDED_HEADERS_ENABLED=true
#
# Require X-Forwarded-For/Proto/Host to have the same number of values
#FORWARDED_HEADERS_REQUIRE_HEADER_SYMMETRY=false
#
# Number of proxy hops to trust when parsing X-Forwarded-* headers
#FORWARDED_HEADERS_FORWARD_LIMIT=1
#
# Last-resort escape hatch: trust forwarded headers from any proxy.
# SECURITY: Only enable when the app is not directly reachable by clients.
#FORWARDED_HEADERS_UNSAFE_TRUST_ALL=false
#
# Enforce a host allow-list at runtime (recommended in production)
#FORWARDED_HEADERS_ENFORCE_HOST_ALLOW_LIST=false
#
# Provide up to 3 allowed hosts (used for both X-Forwarded-Host allow-listing and host enforcement)
# Examples: auth.example.com, *.example.com
#FORWARDED_HEADERS_ALLOWED_HOST_0=auth.example.com
#FORWARDED_HEADERS_ALLOWED_HOST_1=
#FORWARDED_HEADERS_ALLOWED_HOST_2=
#
# Provide up to 3 known proxy IPs (recommended) if your reverse proxy has stable IPs
#FORWARDED_HEADERS_KNOWN_PROXY_0=10.0.0.10
#FORWARDED_HEADERS_KNOWN_PROXY_1=
#FORWARDED_HEADERS_KNOWN_PROXY_2=
#
# Provide up to 2 known networks in CIDR form (recommended) if your proxy is in a stable subnet
#FORWARDED_HEADERS_KNOWN_NETWORK_0=10.0.0.0/24
#FORWARDED_HEADERS_KNOWN_NETWORK_1=

# Database Connection String Override
# Uncomment to customize the PostgreSQL connection string
# Default uses POSTGRES_PASSWORD variable above
#CONNECTION_STRING_AUTHDB=Host=postgres;Port=5432;Database=authdb;Username=oidc;Password=${POSTGRES_PASSWORD}

# Kestrel Web Server Configuration
# Uncomment to customize certificate paths
#ASPNETCORE_Kestrel__Certificates__Default__Path=/https/aspnetapp.pfx
#ASPNETCORE_Kestrel__Certificates__Default__Password=${CERT_PASSWORD}

# Rate Limiting (Admin API)
# Customize rate limiting for admin endpoints
#RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Session Configuration
# Customize session timeout (in minutes)
#SESSION_TIMEOUT_MINUTES=60

# ==============================================================================
# Quick Start
# ==============================================================================
#
# This .env.example belongs to the MrWhoOidc source repository.
#
# Default recommendation:
#   If you want to run the published Docker image, do not start here.
#   Use the public deployment repository instead:
#     mkdir -p "$HOME/src"
#     cd "$HOME/src"
#     git clone https://github.com/popicka70/MrWho.git
#     cd "$HOME/src/MrWho"
#
# Use this file only when you intentionally cloned MrWhoOidc to build from source.
# Do not clone into /tmp. Use a persistent directory such as $HOME/src.
#
# 1. Confirm you are in the MrWhoOidc source repository root:
#    pwd
#    test -f docker-compose.dev.yml && test -f .env.example && echo "MrWhoOidc source repo ready"
#
# 2. Copy this file:
#    cp .env.example .env
#
# 3. Edit .env and set at minimum:
#    - POSTGRES_PASSWORD (strong random password)
#    - OIDC_PUBLIC_BASE_URL (your deployment URL)
#    - CERT_PASSWORD (if using custom certificate)
#
# 4. Place TLS certificate:
#    - Development: Certificate already in ./certs/
#    - Production: Place your certificate at ./certs/your-cert.pfx
#                  Update docker-compose.yml volume mount if needed
#
# 5. Start the source-built development stack:
#    docker compose -f docker-compose.dev.yml up -d --build
#    If your installation only provides the legacy standalone binary, use:
#      docker-compose -f docker-compose.dev.yml up -d --build
#
# 6. Verify the source-built development stack:
#    curl -k https://localhost:8443/t/default/.well-known/openid-configuration
#    bash ./scripts/verify-installation.sh
#
# Development note:
#    docker-compose.dev.yml auto-seeds the default tenant and admin account.
#    No BOOTSTRAP_TOKEN is required for the dev stack.
#
# Published-image note:
#    For production-style deployment from the published image, use the MrWho repo.
#    That path uses `docker compose up -d` and a one-time /bootstrap call on an empty database.
#
# For explicit step-by-step instructions, see: docs/for-developers/quickstart-15-min.md
#
# ==============================================================================
