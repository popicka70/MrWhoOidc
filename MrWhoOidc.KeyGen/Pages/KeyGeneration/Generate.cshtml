@page
@model MrWhoOidc.KeyGen.Pages.KeyGeneration.GenerateModel
@{
    ViewData["Title"] = "Generate Key Pair";
}

<h1>Generate Key Pair</h1>
<p class="lead">Generate RSA or ECDSA key pairs for OIDC client JAR/JARM usage.</p>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <strong>Error:</strong> @Model.ErrorMessage
    </div>
}

@if (Model.KeyGenerated)
{
    <div class="alert alert-success" role="alert">
        <h4 class="alert-heading">Key Pair Generated Successfully!</h4>
        <p><strong>Key ID (kid):</strong> <code>@Model.GeneratedKid</code></p>
        <hr />
        <div class="d-grid gap-2 d-md-flex">
            <button type="button" class="btn btn-primary" onclick="downloadPrivateKey()">
                <i class="bi bi-download"></i> Download Private Key (JWK)
            </button>
            <button type="button" class="btn btn-outline-secondary" onclick="downloadPublicKey()">
                <i class="bi bi-download"></i> Download Public Key (JWKS)
            </button>
        </div>
        <p class="mt-3 mb-0">
            <small class="text-danger">
                <strong>⚠️ Security Notice:</strong> The private key is only available on this page. Once you navigate away, it cannot be retrieved. Save it securely now.
            </small>
        </p>
    </div>
    
    <!-- Hidden data for JavaScript download -->
    <div id="privateKeyData" data-jwk="@Model.PrivateKeyJwk" hidden></div>
    <div id="publicKeyData" data-jwk="@Model.PublicKeyJwks" hidden></div>
    
    <hr />
    <a asp-page="/KeyGeneration/List" class="btn btn-outline-primary">View All Keys</a>
    <a asp-page="/KeyGeneration/Generate" class="btn btn-outline-secondary">Generate Another Key</a>
}
else
{
    <form method="post">
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Algorithm" class="form-label">Algorithm</label>
                    <select asp-for="Algorithm" class="form-select" id="algorithmSelect">
                        <option value="">-- Select Algorithm --</option>
                        <optgroup label="RSA">
                            <option value="RS256">RS256 (RSA with SHA-256)</option>
                            <option value="RS384">RS384 (RSA with SHA-384)</option>
                            <option value="RS512">RS512 (RSA with SHA-512)</option>
                            <option value="PS256">PS256 (RSA-PSS with SHA-256)</option>
                        </optgroup>
                        <optgroup label="ECDSA">
                            <option value="ES256">ES256 (ECDSA with P-256 and SHA-256)</option>
                            <option value="ES384">ES384 (ECDSA with P-384 and SHA-384)</option>
                            <option value="ES512">ES512 (ECDSA with P-521 and SHA-512)</option>
                        </optgroup>
                    </select>
                    <span asp-validation-for="Algorithm" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row" id="rsaOptions" style="display: none;">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="KeySize" class="form-label">Key Size (bits)</label>
                    <select asp-for="KeySize" class="form-select">
                        <option value="">-- Select Key Size --</option>
                        <option value="2048">2048</option>
                        <option value="3072">3072</option>
                        <option value="4096">4096</option>
                    </select>
                    <span asp-validation-for="KeySize" class="text-danger"></span>
                    <div class="form-text">Recommended: 2048 for compatibility, 3072+ for high security.</div>
                </div>
            </div>
        </div>

        <div class="row" id="ecOptions" style="display: none;">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Curve" class="form-label">Elliptic Curve</label>
                    <select asp-for="Curve" class="form-select">
                        <option value="">-- Select Curve --</option>
                        <option value="P-256">P-256 (256-bit, fastest)</option>
                        <option value="P-384">P-384 (384-bit, balanced)</option>
                        <option value="P-521">P-521 (521-bit, highest security)</option>
                    </select>
                    <span asp-validation-for="Curve" class="text-danger"></span>
                    <div class="form-text">Recommended: P-256 for most use cases.</div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-key"></i> Generate Key Pair
                </button>
                <a asp-page="/Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
    </form>

    <div class="mt-4">
        <h5>About Key Generation</h5>
        <ul>
            <li><strong>RSA:</strong> Widely supported, larger keys (2048+ bits). Use RS256 for maximum compatibility.</li>
            <li><strong>ECDSA:</strong> Smaller keys with equivalent security. P-256 recommended for performance.</li>
            <li><strong>Private keys:</strong> Downloaded once as JWK format. Store securely and never share.</li>
            <li><strong>Public keys:</strong> Downloaded as JWKS format. Can be shared and imported into OIDC server.</li>
        </ul>
    </div>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('algorithmSelect').addEventListener('change', function() {
            const algorithm = this.value;
            const rsaOptions = document.getElementById('rsaOptions');
            const ecOptions = document.getElementById('ecOptions');
            
            if (algorithm.startsWith('RS') || algorithm.startsWith('PS')) {
                rsaOptions.style.display = 'block';
                ecOptions.style.display = 'none';
            } else if (algorithm.startsWith('ES')) {
                rsaOptions.style.display = 'none';
                ecOptions.style.display = 'block';
            } else {
                rsaOptions.style.display = 'none';
                ecOptions.style.display = 'none';
            }
        });
        
        function downloadPrivateKey() {
            const data = document.getElementById('privateKeyData').getAttribute('data-jwk');
            const kid = '@Model.GeneratedKid';
            downloadFile(data, `private-key-${kid}.json`, 'application/json');
        }
        
        function downloadPublicKey() {
            const data = document.getElementById('publicKeyData').getAttribute('data-jwk');
            const kid = '@Model.GeneratedKid';
            downloadFile(data, `public-key-${kid}.json`, 'application/json');
        }
        
        function downloadFile(content, filename, contentType) {
            const blob = new Blob([content], { type: contentType });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }
    </script>
}
