@page "{kid}"
@model MrWhoOidc.KeyGen.Pages.KeyGeneration.DetailsModel
@{
    ViewData["Title"] = $"Key Details - {Model.Key?.Kid}";
}

@if (Model.Key == null)
{
    <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">Key Not Found</h4>
        <p>The requested key could not be found.</p>
        <hr>
        <p class="mb-0">
            <a asp-page="/KeyGeneration/List" class="btn btn-primary">Back to Key List</a>
        </p>
    </div>
}
else
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-page="/KeyGeneration/List">Key Management</a></li>
            <li class="breadcrumb-item active" aria-current="page">Details</li>
        </ol>
    </nav>

    <h1 class="mb-4">Key Pair Details</h1>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">🔑 Key Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Key ID (kid)</dt>
                        <dd class="col-sm-8"><code>@Model.Key.Kid</code></dd>

                        <dt class="col-sm-4">Algorithm</dt>
                        <dd class="col-sm-8"><span class="badge bg-primary">@Model.Key.Algorithm</span></dd>

                        <dt class="col-sm-4">Key Type</dt>
                        <dd class="col-sm-8">@Model.Key.KeyType</dd>

                        <dt class="col-sm-4">Key Size / Curve</dt>
                        <dd class="col-sm-8">
                            @if (Model.Key.KeyType == "RSA")
                            {
                                <text>@Model.Key.KeySize bits</text>
                            }
                            else
                            {
                                <text>@Model.Key.Curve</text>
                            }
                        </dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            @if (Model.Key.Status == "Active")
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Revoked</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Created At</dt>
                        <dd class="col-sm-8">@Model.Key.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>

                        @if (!string.IsNullOrEmpty(Model.Key.CreatedBy))
                        {
                            <dt class="col-sm-4">Created By</dt>
                            <dd class="col-sm-8">@Model.Key.CreatedBy</dd>
                        }

                        @if (Model.Key.Status == "Revoked" && Model.Key.RevokedAt.HasValue)
                        {
                            <dt class="col-sm-4">Revoked At</dt>
                            <dd class="col-sm-8">@Model.Key.RevokedAt.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>
                        }

                        <dt class="col-sm-4">Total Downloads</dt>
                        <dd class="col-sm-8">@Model.Key.DownloadCount</dd>
                    </dl>

                    <div class="mt-3">
                        <a href="/api/keys/@Model.Key.Kid/public" class="btn btn-outline-secondary" download>
                            📥 Download Public Key
                        </a>
                        @if (Model.Key.Status == "Active")
                        {
                            <form method="post" asp-page-handler="Revoke" class="d-inline" 
                                  onsubmit="return confirm('Are you sure you want to revoke this key? This action cannot be undone.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger">
                                    🚫 Revoke Key
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">📜 Download History</h5>
                </div>
                <div class="card-body">
                    @if (!Model.DownloadRecords.Any())
                    {
                        <p class="text-muted mb-0">No downloads recorded yet.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Type</th>
                                        <th>Downloaded At</th>
                                        <th>IP Address</th>
                                        <th>User Agent</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var record in Model.DownloadRecords)
                                    {
                                        <tr>
                                            <td><span class="badge bg-secondary">@record.DownloadType</span></td>
                                            <td>@record.DownloadedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                            <td><code class="small">@(record.IpAddress ?? "Unknown")</code></td>
                                            <td><span class="small text-muted">@(string.IsNullOrEmpty(record.UserAgent) ? "Unknown" : (record.UserAgent.Length > 50 ? record.UserAgent.Substring(0, 47) + "..." : record.UserAgent))</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">📋 Public Key (JWKS)</h5>
                </div>
                <div class="card-body">
                    <pre class="small bg-light p-3 rounded" style="max-height: 400px; overflow-y: auto;"><code>@Model.Key.PublicKeyJwks</code></pre>
                    <button type="button" class="btn btn-sm btn-outline-primary w-100 mt-2" onclick="copyPublicKey()">
                        📋 Copy to Clipboard
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<script>
    function copyPublicKey() {
        var text = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Key?.PublicKeyJwks ?? ""));
        navigator.clipboard.writeText(text).then(function() {
            alert('Public key copied to clipboard!');
        }, function() {
            alert('Failed to copy public key.');
        });
    }
</script>
