@page
@model MrWhoOidc.KeyGen.Pages.KeyGeneration.ListModel
@{
    ViewData["Title"] = "Key Management";
}

<h1>Key Management</h1>
<p class="lead">View and manage generated key pairs.</p>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="mb-3">
    <a asp-page="/KeyGeneration/Generate" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Generate New Key Pair
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">🔍 Filters</h5>
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label for="statusFilter" class="form-label">Status</label>
                <select class="form-select" id="statusFilter" name="status">
                    <option value="">All Statuses</option>
                    <option value="Active">Active</option>
                    <option value="Revoked">Revoked</option>
                </select>
            </div>
            <div class="col-md-4">
                <label for="algorithmFilter" class="form-label">Algorithm</label>
                <select class="form-select" id="algorithmFilter" name="algorithm">
                    <option value="">All Algorithms</option>
                    <option value="RS256">RS256</option>
                    <option value="RS384">RS384</option>
                    <option value="RS512">RS512</option>
                    <option value="ES256">ES256</option>
                    <option value="ES384">ES384</option>
                    <option value="ES512">ES512</option>
                    <option value="PS256">PS256</option>
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-secondary w-100">Apply Filters</button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Keys.Any())
{
    <div class="alert alert-info" role="alert">
        No key pairs have been generated yet. <a asp-page="/KeyGeneration/Generate">Generate your first key pair</a>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Key ID (kid)</th>
                    <th>Algorithm</th>
                    <th>Key Type</th>
                    <th>Key Size/Curve</th>
                    <th>Created</th>
                    <th>Status</th>
                    <th>Downloads</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var key in Model.Keys)
                {
                    <tr class="@(key.Status == "Revoked" ? "table-secondary" : "")">
                        <td>
                            <a asp-page="/KeyGeneration/Details" asp-route-kid="@key.Kid">
                                <code>@key.Kid</code>
                            </a>
                        </td>
                        <td><span class="badge bg-primary">@key.Algorithm</span></td>
                        <td>@key.KeyType</td>
                        <td>
                            @(key.KeyType == "RSA" ? $"{key.KeySize} bits" : key.Curve)
                        </td>
                        <td>@key.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @if (key.Status == "Active")
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Revoked</span>
                            }
                        </td>
                        <td>@key.DownloadCount</td>
                        <td>
                            <a href="/api/keys/@key.Kid/public" class="btn btn-sm btn-outline-secondary" download>
                                📥 Public
                            </a>
                            @if (key.Status == "Active")
                            {
                                <form method="post" asp-page-handler="Revoke" asp-route-kid="@key.Kid" class="d-inline" 
                                      onsubmit="return confirm('Are you sure you want to revoke this key? This action cannot be undone.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        🚫 Revoke
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">(Revoked @key.RevokedAt?.ToString("yyyy-MM-dd"))</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <div class="text-muted">
            <small>
                Showing @Model.Keys.Count of @Model.TotalCount key pair(s) (Page @Model.CurrentPage of @Model.TotalPages).
                Active: @Model.Keys.Count(k => k.Status == "Active"), 
                Revoked: @Model.Keys.Count(k => k.Status == "Revoked")
            </small>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination mb-0">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="?page=@(Model.CurrentPage - 1)&pageSize=@Model.PageSize">Previous</a>
                    </li>

                    @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" href="?page=@i&pageSize=@Model.PageSize">@i</a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="?page=@(Model.CurrentPage + 1)&pageSize=@Model.PageSize">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
