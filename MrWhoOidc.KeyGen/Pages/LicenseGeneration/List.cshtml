@page
@model MrWhoOidc.KeyGen.Pages.LicenseGeneration.ListModel
@{
    ViewData["Title"] = "License Management";
}

<h1 class="mb-4">License Management</h1>

<div class="row mb-3">
    <div class="col-md-12">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label for="tierFilter" class="form-label">Filter by Tier</label>
                <select class="form-select" id="tierFilter" name="tier" asp-for="TierFilter">
                    <option value="">All Tiers</option>
                    <option value="Free">Free</option>
                    <option value="Developer">Developer</option>
                    <option value="Pro">Pro</option>
                    <option value="Enterprise">Enterprise</option>
                </select>
            </div>
            <div class="col-md-4">
                <label for="orgFilter" class="form-label">Filter by Organization</label>
                <input type="text" class="form-control" id="orgFilter" name="organization" 
                       asp-for="OrganizationFilter" placeholder="Search organization...">
            </div>
            <div class="col-md-3">
                <label for="statusFilter" class="form-label">Expiry Status</label>
                <select class="form-select" id="statusFilter" name="status" asp-for="StatusFilter">
                    <option value="">All Licenses</option>
                    <option value="valid">Valid (Not Expired)</option>
                    <option value="expired">Expired</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">🔍 Filter</button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Licenses.Any())
{
    <div class="alert alert-info" role="alert">
        <h5 class="alert-heading">No License Tokens Found</h5>
        <p class="mb-0">
            No license tokens match your current filters. 
            <a href="/LicenseGeneration/Generate" class="alert-link">Generate your first license token</a>.
        </p>
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Token ID</th>
                            <th>Tier</th>
                            <th>Scope</th>
                            <th>Organization</th>
                            <th>Features</th>
                            <th>Valid From</th>
                            <th>Expires At</th>
                            <th>Status</th>
                            <th>Generated</th>
                            <th>Generated By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var license in Model.Licenses)
                        {
                            var isExpired = license.ValidUntil < DateTimeOffset.UtcNow;
                            var isNotYetValid = license.ValidFrom > DateTimeOffset.UtcNow;
                            <tr class="@(isExpired ? "table-secondary" : "")">
                                <td>
                                    <code class="small">@license.TokenId.Substring(0, 8)...</code>
                                    <button type="button" class="btn btn-sm btn-link p-0" 
                                            onclick="copyToClipboard('@license.TokenId')" 
                                            title="Copy full token ID">
                                        📋
                                    </button>
                                </td>
                                <td>
                                    @{
                                        var tierBadgeClass = license.Tier switch
                                        {
                                            "Free" => "bg-secondary",
                                            "Developer" => "bg-info",
                                            "Pro" => "bg-primary",
                                            "Enterprise" => "bg-success",
                                            _ => "bg-light text-dark"
                                        };
                                    }
                                    <span class="badge @tierBadgeClass">@license.Tier</span>
                                </td>
                                <td>
                                    @{
                                        var isTenantScope = license.Scope?.Equals("tenant", System.StringComparison.OrdinalIgnoreCase) == true;
                                        var scopeBadge = isTenantScope ? "bg-info" : "bg-secondary";
                                    }
                                    <span class="badge @scopeBadge">@(license.Scope?.Equals("tenant", System.StringComparison.OrdinalIgnoreCase) == true ? "Tenant" : "Platform")</span>
                                    @if (!string.IsNullOrWhiteSpace(license.TenantSlug))
                                    {
                                        <div class="small text-muted">@license.TenantSlug</div>
                                    }
                                    else if (license.TenantId.HasValue)
                                    {
                                        <div class="small text-muted">@license.TenantId</div>
                                    }
                                </td>
                                <td>@license.Organization</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(license.Features))
                                    {
                                        <span class="small text-muted">@license.Features</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="small">@license.ValidFrom.ToString("yyyy-MM-dd")</span>
                                </td>
                                <td>
                                    <span class="small">@license.ValidUntil.ToString("yyyy-MM-dd")</span>
                                </td>
                                <td>
                                    @if (isExpired)
                                    {
                                        <span class="badge bg-danger">Expired</span>
                                    }
                                    else if (isNotYetValid)
                                    {
                                        <span class="badge bg-warning text-dark">Not Yet Valid</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Valid</span>
                                    }
                                </td>
                                <td>
                                    <span class="small text-muted">@license.GeneratedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(license.GeneratedBy))
                                    {
                                        <span class="small">@license.GeneratedBy</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3">
                <div class="text-muted small">
                    Showing @Model.Licenses.Count license(s)
                </div>
                <div>
                    <a href="/LicenseGeneration/Generate" class="btn btn-primary">
                        ➕ Generate New License
                    </a>
                </div>
            </div>
        </div>
    </div>
}

<script>
    function copyToClipboard(text) {
        navigator.clipboard.writeText(text).then(function() {
            alert('Token ID copied to clipboard: ' + text);
        }, function() {
            alert('Failed to copy token ID');
        });
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
